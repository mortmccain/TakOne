# =============================================================================
# .env.example — template for secrets.
#
# HOW TO USE:
#   1. Copy this file to .env:
#        cp .env.example .env
#   2. Edit .env and REPLACE the placeholder password with a real one.
#   3. NEVER commit .env to git. (It's already in .gitignore — but
#      double-check.)
#
# WHY .env EXISTS:
#   docker-compose.yml references ${SQL_SA_PASSWORD}. Docker Compose
#   reads that variable from the shell environment OR from a .env file
#   in the same directory. Putting secrets in .env keeps them out of
#   docker-compose.yml (which IS committed to git) and out of the
#   Docker image (which would be visible to anyone who pulls it).
# =============================================================================

# SQL Server SA (system administrator) password.
#
# SQL Server REQUIRES a strong password or it will refuse to boot:
#   - At least 8 characters
#   - Must contain 3 of: uppercase, lowercase, digits, symbols
#   - Cannot contain the user's account name or parts of the
#     user's full name that exceed 2 consecutive characters
#
# Pick something random. Use a password manager (Bitwarden, 1Password,
# KeePass) to generate + store it. DON'T reuse a personal password.
#
# Example of a strong password: Kj7$mP9!nQ4vLw2x
# (Don't use that exact one — it's in a public file.)
SQL_SA_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
