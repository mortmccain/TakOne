<?xml version="1.0" encoding="utf-8"?>
<!-- IdentityErrorMessages.fa-IR.resx — Persian (Farsi) strings for ASP.NET
     Identity error messages, consumed by TakOneIdentityErrorDescriber.

     Each key mirrors an IdentityErrorDescriber method (e.g. the
     PasswordRequiresNonAlphanumeric method's code is
     "PasswordRequiresNonAlphanumeric" — same name as the key here).

     The Code field on IdentityError is left as Identity's default (e.g.
     "PasswordRequiresNonAlphanumeric") so log greps and error-code
     switches keep working. Only the user-facing Description is localized.

     Placeholders like {0} are filled in by the describer at call time:
       {0} = a numeric or string value supplied by Identity (length, min
             unique chars, the offending username/email, etc.) -->
<root>
  <xsd:schema id="root" xmlns="" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
    <xsd:import namespace="http://www.w3.org/XML/1998/namespace" />
    <xsd:element name="root" msdata:IsDataSet="true">
      <xsd:complexType>
        <xsd:choice maxOccurs="unbounded">
          <xsd:element name="resheader">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="resmimetype">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="assembly">
            <xsd:complexType>
              <xsd:attribute name="alias" type="xsd:string" />
              <xsd:attribute name="name" type="xsd:string" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="data">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
                <xsd:element name="comment" type="xsd:string" minOccurs="0" msdata:Ordinal="2" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" msdata:Ordinal="1" />
              <xsd:attribute name="type" type="xsd:string" msdata:Ordinal="3" />
              <xsd:attribute name="mimetype" type="xsd:string" msdata:Ordinal="4" />
              <xsd:attribute ref="xml:space" />
            </xsd:complexType>
          </xsd:element>
        </xsd:choice>
      </xsd:complexType>
    </xsd:element>
  </xsd:schema>

  <resheader name="resmimetype">
    <value>text/microsoft-resx</value>
  </resheader>
  <resheader name="version">
    <value>2.0</value>
  </resheader>
  <resheader name="reader">
    <value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>
  <resheader name="writer">
    <value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>

  <!-- ── پیچیدگی رمز عبور ── -->

  <data name="PasswordTooShort" xml:space="preserve">
    <value>رمز عبور باید حداقل {0} کاراکتر باشد.</value>
    <comment>{0} = RequiredLength</comment>
  </data>
  <data name="PasswordRequiresNonAlphanumeric" xml:space="preserve">
    <value>رمز عبور باید حداقل شامل یک کاراکتر غیر الفبایی-عددی باشد.</value>
  </data>
  <data name="PasswordRequiresDigit" xml:space="preserve">
    <value>رمز عبور باید حداقل شامل یک رقم ('۰'-'۹') باشد.</value>
  </data>
  <data name="PasswordRequiresUpper" xml:space="preserve">
    <value>رمز عبور باید حداقل شامل یک حرف بزرگ انگلیسی ('A'-'Z') باشد.</value>
  </data>
  <data name="PasswordRequiresLower" xml:space="preserve">
    <value>رمز عبور باید حداقل شامل یک حرف کوچک انگلیسی ('a'-'z') باشد.</value>
  </data>
  <data name="PasswordRequiresUniqueChars" xml:space="preserve">
    <value>رمز عبور باید حداقل شامل {0} کاراکتر متمایز باشد.</value>
    <comment>{0} = RequiredUniqueChars</comment>
  </data>

  <!-- ── کاربر / ایمیل تکراری ── -->

  <data name="DuplicateUserName" xml:space="preserve">
    <value>کد پرسنلی «{0}» قبلاً ثبت شده است.</value>
    <comment>{0} = the offending UserName. Project uses WorkerId as UserName.</comment>
  </data>
  <data name="DuplicateEmail" xml:space="preserve">
    <value>ایمیل «{0}» قبلاً ثبت شده است.</value>
    <comment>{0} = the offending Email</comment>
  </data>

  <!-- ── فرمت کاربر / ایمیل نامعتبر ── -->

  <data name="InvalidUserName" xml:space="preserve">
    <value>کد پرسنلی «{0}» نامعتبر است. کد پرسنلی فقط می‌تواند شامل حروف، اعداد، خط تیره و زیرخط باشد.</value>
    <comment>{0} = the offending UserName</comment>
  </data>
  <data name="InvalidEmail" xml:space="preserve">
    <value>ایمیل «{0}» یک آدرس ایمیل معتبر نیست.</value>
    <comment>{0} = the offending Email</comment>
  </data>

  <!-- ── توکن / بازنشانی رمز عبور ── -->

  <data name="InvalidToken" xml:space="preserve">
    <value>لینک بازنشانی نامعتبر یا منقضی شده است. لطفاً یک لینک جدید درخواست کنید.</value>
    <comment>Used by UserManager.ResetPasswordAsync and ConfirmEmailAsync when the token doesn't validate.</comment>
  </data>
  <data name="PasswordMismatch" xml:space="preserve">
    <value>رمز عبور فعلی اشتباه است.</value>
    <comment>Used by UserManager.ChangePasswordAsync when oldPassword doesn't match.</comment>
  </data>

  <!-- ── پیش‌فرض ──
       Used by the describer's DefaultError method for any IdentityResult
       failure that doesn't have a specific override. -->

  <data name="DefaultError" xml:space="preserve">
    <value>خطای غیرمنتظره‌ای رخ داد. لطفاً دوباره تلاش کنید.</value>
  </data>
</root>
