<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- NOT PublishSingleFile — the app runs via `dotnet TakOne.MigrationFixer.dll`
         so it doesn't need to be a single-file executable. PublishSingleFile=true
         requires UseAppHost=true, which conflicts with the /p:UseAppHost=false
         flag the Dockerfile uses for all publish steps. -->
    <SelfContained>false</SelfContained>
    <!-- Suppress nullable warnings — this is a tiny utility, not a production app. -->
    <NoWarn>CS8600;CS8603;CS8604;CS8625</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same SqlClient version the main app uses — shared framework provides the rest. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.1" />
  </ItemGroup>

</Project>
