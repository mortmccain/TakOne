    // ── Expand toggles ──────────────────────────────────────────────────
    //
    // Each non-leaf node (Category, SubCategory) carries a chevron button
    // in its oval. Clicking it toggles that node's entry in the
    // _expandedCategories / _expandedSubs HashSet, which controls whether
    // the .tree-children container renders. v5 originally had NO chevron,
    // so users couldn't expand categories — they saw only top-level
    // categories with no way to drill into sub-cats. That was the
    // "categories are shown but nothing else" bug.
    //
    // These methods are also called from StartAddSub / StartAddSubSub to
    // auto-expand the parent when the user opens an inline add form, so
    // the new child appears in the right place.

    private void ToggleExpandCategory(Guid categoryId)
    {
        if (!_expandedCategories.Remove(categoryId))
        {
            _expandedCategories.Add(categoryId);
        }
        _needsConnectorUpdate = true;
    }

    private void ToggleExpandSub(Guid subCategoryId)
    {
        if (!_expandedSubs.Remove(subCategoryId))
        {
            _expandedSubs.Add(subCategoryId);
        }
        _needsConnectorUpdate = true;
    }

