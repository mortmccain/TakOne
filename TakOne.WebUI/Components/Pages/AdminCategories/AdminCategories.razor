    // ── Activate / Deactivate toggle ────────────────────────────────────
    //
    // Each node has a single toggle icon. If the node is active, the
    // icon is "block" and clicking dispatches Deactivate (which also
    // cascades to children for Category/SubCategory). If the node is
    // inactive, the icon is "check_circle" and clicking dispatches
    // Activate (which does NOT cascade — children must be reactivated
    // individually, per the domain's intentional design).

    private async Task HandleToggleCategoryActiveAsync(CategoryDto category)
    {
        _isToggling = true;
        try
        {
            var result = category.IsActive
                ? await MessageBus.InvokeAsync<Result>(new DeactivateCategoryCommand(category.Id))
                : await MessageBus.InvokeAsync<Result>(new ActivateCategoryCommand(category.Id));

            if (result.IsSuccess)
            {
                await Toast.Success(
                    string.Format(CultureInfo.CurrentCulture,
                        category.IsActive ? Loc["CategoryDeactivated"] : Loc["CategoryActivated"],
                        category.Name),
                    summary: category.IsActive ? Loc["CategoryDeactivatedTitle"] : Loc["CategoryActivatedTitle"]);
                await LoadCategoriesAsync();
            }
            else
            {
                await Toast.Error(ErrorDisplay.Localize(result.Error) ?? Loc["Error_ToggleFailed"], summary: Loc["ErrorTitle"]);
            }
        }
        catch
        {
            await Toast.UnexpectedError(UnexpectedErrorCodes.AdminCategories_ToggleCategoryFailure, summary: Loc["ErrorTitle"]);
        }
        finally
        {
            _isToggling = false;
        }
    }

