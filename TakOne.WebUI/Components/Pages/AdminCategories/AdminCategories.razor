@* AdminCategories.razor — Phase 3.3 v3 (file-explorer tree)

   Staff-facing category management page at route `/Admin/Categories`.
   Reached from the sidebar's "Admin → Manage Categories" link (already
   wired in MainLayout.razor). Role-gated to Admin / Manager via
   [Authorize(Roles=...)] — Employees cannot create categories (the
   CreateCategoryCommand requires Manager or Admin role).

   v3 — File-explorer tree (replaces v2 "Idea A" indented cards):
     Renders the category hierarchy as a VS Code / file-explorer style
     tree with proper connector lines (vertical line down the inline-start
     side of each branch + horizontal elbow linking it to each child node).
     One node per row, expand/collapse chevrons, depth signaled by icon
     color + nesting rather than border colors.

     Behavior:
       - Top-level Categories are ALWAYS visible (they're the tree roots).
       - SubCategories are COLLAPSED by default (empty _expandedCategories
         set). User clicks the chevron to expand.
       - SubSubCategories are also collapsed by default (empty _expandedSubs
         set). User expands a Sub to see them.
       - Each Category / Sub row has an inline "+ Add child" button on the
         inline-end side. Clicking it replaces the button with an inline
         textbox + Save/Cancel (no visual jump — the form sits in the same
         spot the button was).
       - Duplicate-name errors from the backend are surfaced via
         Toast.Error and the inline form stays open so the user can rename
         and retry.

   RTL (Persian) SUPPORT:
     All indentation + connector lines use CSS logical properties
     (padding-inline-start, inset-inline-start, margin-inline-start)
     which auto-flip when the page is rendered with dir="rtl". The
     collapse chevron is mirrored via a [dir="rtl"] selector so it
     points left-when-collapsed in Persian (instead of right). No
     per-locale code or duplicated stylesheets.

   Hierarchy:
     Category  → has many SubCategories
     SubCategory → has many SubSubCategories
     SubSubCategory → leaf (no further children)

   STYLE CONSISTENCY:
     Matches CreateUser.razor — same outer RadzenCard (Variant.Filled,
     padding 1.25rem), same primary-color icons, same button palette:
       - Add buttons    → ButtonStyle.Success + Variant.Outlined (green = add)
       - Save buttons   → ButtonStyle.Primary  + Variant.Filled
       - Cancel buttons → ButtonStyle.Secondary + Variant.Outlined
*@

@page "/Admin/Categories"
@attribute [Authorize(Roles = "Admin,Manager")]

@using System.Globalization
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Radzen
@using Wolverine
@using TakOne.Application.Common.Interfaces
@using TakOne.Application.Categories.Commands.CreateCategory
@using TakOne.Application.Categories.Commands.SubcategoryCommands.CreateSubCategory
@using TakOne.Application.Categories.Commands.SubSubCategoryCommands.CreateSubSubCategory
@using TakOne.Application.Categories.DTOs
@using TakOne.Application.Categories.Queries.GetActiveCategories
@using TakOne.SharedKernel.Common
@using TakOne.WebUI.Services
@inject IMessageBus MessageBus
@inject ICurrentUserService CurrentUser
@inject NavigationManager Navigation
@inject IStringLocalizer<AdminCategories> Loc
@inject ToastService Toast

<PageTitle>@Loc["PageTitle"]</PageTitle>

<HeadContent>
    <style>
            .admin-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
                flex-wrap: wrap;
            }

            /* ── File-explorer tree (v3) ──────────────────────────────────
                           Structure:
                             .tree-root
                               └─ .tree-node[data-depth="0"]   (Category — always visible)
                                   ├─ .tree-node-row            (chevron + icon + name + meta + add-btn)
                                   └─ .tree-children             (only rendered when expanded)
                                        ├─ .tree-node[data-depth="1"]   (SubCategory)
                                        │    ├─ .tree-node-row
                                        │    └─ .tree-children
                                        │         ├─ .tree-node[data-depth="2"]  (SubSubCategory leaf)
                                        │         └─ inline add form OR + Add button
                                        └─ inline add form OR + Add button

                           Connector lines are drawn with ::before pseudo-elements:
                             - .tree-children::before draws a vertical line down the
                               inline-start side, linking the parent to all its children.
                             - .tree-node[data-depth]:not([data-depth="0"])::before
                               draws a horizontal elbow from the vertical line to each
                               child node.

                           All positioning uses CSS LOGICAL properties
                           (padding-inline-start, inset-inline-start) so the tree
                           auto-flips in RTL (Persian) layout — the vertical line
                           moves to the right side, elbows point left, indentation
                           pushes children to the left. No [dir="rtl"] overrides
                           needed for the lines. */

            .tree-root {
                margin-top: 0.5rem;
            }

            .tree-node {
                position: relative;
            }

                /* Elbow connector — horizontal line from the vertical
                               parent line to this node. Only rendered for non-root
                               nodes (depth > 0). Root nodes (depth 0) have no parent
                               line to connect to. */
                .tree-node[data-depth]:not([data-depth="0"])::before {
                    content: '';
                    position: absolute;
                    inset-inline-start: -0.625rem;
                    top: 0.875rem;
                    width: 0.625rem;
                    height: 1px;
                    background: var(--rz-border-color, rgba(0, 0, 0, 0.10));
                    pointer-events: none;
                }

            .tree-node-row {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                padding: 0.5rem 0.625rem;
                border-radius: var(--rz-border-radius, 6px);
                transition: background-color 0.12s ease;
                flex-wrap: wrap;
            }

                .tree-node-row:hover {
                    background-color: var(--rz-hover-background-color, rgba(0, 0, 0, 0.04));
                }

            .node-icon {
                font-size: 1.125rem;
                flex-shrink: 0;
            }

            .node-name {
                font-weight: 600;
                font-size: 0.9375rem;
                color: var(--rz-text-primary-color);
            }

                .node-name.is-inactive {
                    color: var(--rz-text-secondary-color);
                    font-weight: 500;
                }

            .node-meta {
                color: var(--rz-text-secondary-color);
                font-size: 0.8125rem;
                margin-inline-start: 0.25rem;
            }

            .node-actions {
                display: flex;
                align-items: center;
                gap: 0.25rem;
                margin-inline-start: auto;
            }

            /* Chevron — clickable, rotates when collapsed.
                           LTR: expanded = down (0deg), collapsed = right (-90deg)
                           RTL: expanded = down (0deg), collapsed = left  (+90deg)
                           The [dir="rtl"] selector handles the mirror. */
            .chevron-btn {
                cursor: pointer;
                color: var(--rz-text-secondary-color);
                padding: 0.125rem;
                border-radius: var(--rz-border-radius-sm, 4px);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                border: none;
                background: transparent;
            }

                .chevron-btn:hover {
                    background-color: var(--rz-hover-background-color, rgba(0, 0, 0, 0.06));
                    color: var(--rz-text-primary-color);
                }

                .chevron-btn.is-collapsed .chevron-icon {
                    transform: rotate(-90deg);
                }

            [dir="rtl"] .chevron-btn.is-collapsed .chevron-icon {
                transform: rotate(90deg);
            }

            .chevron-icon {
                transition: transform 0.15s ease;
                font-size: 1.125rem;
            }

            /* Spacer that occupies the chevron's slot on leaf nodes
                           (no children to expand) so leaf icons align with their
                           siblings' icons. */
            .chevron-spacer {
                width: 1.375rem;
                flex-shrink: 0;
            }

            /* Children container — indented + vertical line.
                           padding-inline-start creates the indent; the ::before
                           pseudo-element draws the vertical connector line down
                           the inline-start edge, linking the parent to every
                           child node's elbow. */
            .tree-children {
                position: relative;
                padding-inline-start: 1.25rem;
            }

                .tree-children::before {
                    content: '';
                    position: absolute;
                    inset-inline-start: 0.625rem;
                    top: 0;
                    bottom: 0.5rem;
                    width: 1px;
                    background: var(--rz-border-color, rgba(0, 0, 0, 0.10));
                    pointer-events: none;
                }

            /* Inline add form — appears in place of the "+ Add child"
                           button (no visual jump). Uses the same RadzenFormField +
                           RadzenTextBox pattern as CreateUser.razor. */
            .inline-add-form {
                display: flex;
                gap: 0.5rem;
                align-items: flex-end;
                flex-wrap: wrap;
                padding: 0.5rem 0.625rem;
                margin-top: 0.25rem;
            }

                .inline-add-form .name-field {
                    flex: 1 1 200px;
                    min-width: 180px;
                }

            /* "+ Add child" button — sits at the bottom of the children
                           container, indented to match the children. Subtle styling
                           (text + icon, no heavy border) so it doesn't compete
                           visually with the actual nodes. */
            .add-child-btn {
                margin-top: 0.25rem;
            }

            /* Top-level create form — matches CreateUser.razor's outer
                           RadzenCard pattern. */
            .create-form {
                display: flex;
                gap: 0.75rem;
                align-items: flex-end;
                flex-wrap: wrap;
            }

                .create-form .name-field {
                    flex: 1 1 280px;
                    min-width: 220px;
                }
    </style>
</HeadContent>

<RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
    @* ── Page header ── *@
    <div class="admin-header">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
            <RadzenIcon Icon="category" Style="font-size: 1.75rem; color: var(--rz-primary);" />
            <RadzenText Text="@Loc["PageHeading"]" TextStyle="TextStyle.H5" Style="font-weight: 600; margin: 0;" />
        </RadzenStack>
    </div>

    @* ── Top-level create form ──
       Same pattern as v1/v2: a RadzenCard with an EditForm for creating
       a new top-level Category. Persists immediately on submit. *@
    <RadzenCard Variant="Variant.Filled" Style="padding: 1.25rem;">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Style="margin-bottom: 0.75rem;">
            <RadzenIcon Icon="add_circle_outline" Style="color: var(--rz-primary);" />
            <RadzenText Text="@Loc["CreateFormTitle"]" TextStyle="TextStyle.Subtitle1" Style="font-weight: 600; margin: 0;" />
        </RadzenStack>

        <EditForm Model="@_newCategoryModel" OnValidSubmit="@HandleCreateCategoryAsync" FormName="createCategory">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrEmpty(_createError))
            {
                <RadzenAlert Title="@Loc["ErrorTitle"]"
                             Text="@_createError"
                             AlertStyle="AlertStyle.Danger"
                             Variant="Variant.Filled"
                             ShowIcon="true"
                             Style="margin-bottom: 1rem;" />
            }

            <div class="create-form">
                <RadzenFormField Text="@Loc["FieldName"]" Class="name-field">
                    <RadzenTextBox @bind-Value="_newCategoryModel.Name"
                                   Placeholder="@Loc["FieldNamePlaceholder"]"
                                   TValue="string"
                                   Style="width: 100%;" />
                </RadzenFormField>

                <RadzenButton Text="@Loc["CreateButton"]"
                              Icon="add"
                              ButtonType="ButtonType.Submit"
                              ButtonStyle="ButtonStyle.Primary"
                              Variant="Variant.Filled"
                              Disabled="@_isCreating" />
            </div>
        </EditForm>
    </RadzenCard>

    @* ── Loading state ── *@
    @if (_isLoading)
    {
        <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center"
                     Style="height: 40vh;" Gap="1rem">
            <RadzenProgressBarCircular ShowValue="false"
                                       Mode="ProgressBarMode.Indeterminate"
                                       Size="ProgressBarCircularSize.Large" />
            <RadzenText Text="@Loc["LoadingText"]"
                        TextStyle="TextStyle.Caption"
                        Style="color: var(--rz-text-secondary-color);" />
        </RadzenStack>
    }

    @* ── Error state ── *@
    else if (!string.IsNullOrEmpty(_loadError))
    {
        <RadzenAlert Title="@Loc["ErrorTitle"]"
                     Text="@_loadError"
                     AlertStyle="AlertStyle.Danger"
                     Variant="Variant.Filled"
                     ShowIcon="true">
            <RadzenButton Text="@Loc["RetryButton"]"
                          Icon="refresh"
                          ButtonStyle="ButtonStyle.Primary"
                          Variant="Variant.Outlined"
                          Click="@LoadCategoriesAsync"
                          Style="margin-top: 0.5rem;" />
        </RadzenAlert>
    }

    @* ── Empty state ── *@
    else if (_categories.Count == 0)
    {
        <RadzenCard Variant="Variant.Filled" Style="padding: 3rem; text-align: center;">
            <RadzenStack AlignItems="AlignItems.Center" Gap="1rem">
                <RadzenIcon Icon="category" Style="font-size: 3rem; color: var(--rz-text-secondary-color);" />
                <RadzenText Text="@Loc["EmptyTitle"]" TextStyle="TextStyle.H6" />
                <RadzenText Text="@Loc["EmptyMessage"]"
                            Style="color: var(--rz-text-secondary-color); max-width: 420px;" />
            </RadzenStack>
        </RadzenCard>
    }

    @* ── Category tree (v3 file-explorer) ── *@
    else
    {
        <div class="tree-root">
            @foreach (var category in _categories)
            {
                var categoryExpanded = _expandedCategories.Contains(category.Id);
                var addingSubHere = _addingSubTo == category.Id;

                @* ── Category node (depth 0 — tree root) ── *@
                <div class="tree-node" data-depth="0" @key(category.Id)>
                    <div class="tree-node-row">
                        @* Collapse chevron — only if category has children *@
                        @if (category.SubCategories.Count > 0)
                        {
                            <button type="button"
                                    class="chevron-btn @(categoryExpanded ? "" : "is-collapsed")"
                                    role="button"
                                    tabindex="0"
                                    aria-label="@(categoryExpanded ? Loc["Collapse"] : Loc["Expand"])"
                                    aria-expanded="@categoryExpanded"
                                    @onclick="@(() => ToggleExpandCategory(category.Id))"
                                    @onkeypress="@(e => { if (e.Key == "Enter" || e.Key == " ") ToggleExpandCategory(category.Id); })">
                                <RadzenIcon Icon="expand_more" Class="chevron-icon" />
                            </button>
                        }
                        else
                        {
                            <span class="chevron-spacer" aria-hidden="true"></span>
                        }
                        <RadzenIcon Icon="folder" Class="node-icon" Style="color: var(--rz-primary);" />
                        <span class="node-name @(category.IsActive ? "" : "is-inactive")">@category.Name</span>
                        @if (!category.IsActive)
                        {
                            <RadzenBadge Text="@Loc["InactiveBadge"]"
                                         IsPill="true"
                                         BadgeStyle="BadgeStyle.Warning" />
                        }
                        <span class="node-meta">
                            @string.Format(CultureInfo.CurrentCulture,
                                Loc["SubcategoryCount"],
                                category.SubCategories.Count)
                        </span>
                        <span class="node-actions">
                            <RadzenButton Text="@Loc["AddSubCategoryButton"]"
                                          Icon="add"
                                          ButtonStyle="ButtonStyle.Success"
                                          Variant="Variant.Outlined"
                                          Size="ButtonSize.Small"
                                          Disabled="@_isCreating"
                                          Click="@(() => StartAddSub(category.Id))" />
                        </span>
                    </div>
                </div>

                @* ── Children container (sub-cats + add-sub form) ──
                   Rendered OUTSIDE the .tree-node so the .tree-children
                   indent + vertical line apply to the children, not the
                   parent. Only rendered when the category is expanded. *@
                @if (categoryExpanded)
                {
                    <div class="tree-children">
                        @* Sub-category nodes (depth 1) *@
                        @foreach (var sub in category.SubCategories)
                        {
                            var subExpanded = _expandedSubs.Contains(sub.Id);
                            var addingSubSubHere = _addingSubSubTo == sub.Id;

                            <div class="tree-node" data-depth="1" @key(sub.Id)>
                                <div class="tree-node-row">
                                    @if (sub.SubSubCategories.Count > 0)
                                    {
                                        <button type="button"
                                                class="chevron-btn @(subExpanded ? "" : "is-collapsed")"
                                                role="button"
                                                tabindex="0"
                                                aria-label="@(subExpanded ? Loc["Collapse"] : Loc["Expand"])"
                                                aria-expanded="@subExpanded"
                                                @onclick="@(() => ToggleExpandSub(sub.Id))"
                                                @onkeypress="@(e => { if (e.Key == "Enter" || e.Key == " ") ToggleExpandSub(sub.Id); })">
                                            <RadzenIcon Icon="expand_more" Class="chevron-icon" />
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="chevron-spacer" aria-hidden="true"></span>
                                    }
                                    <RadzenIcon Icon="folder" Class="node-icon" Style="color: var(--rz-success);" />
                                    <span class="node-name @(sub.IsActive ? "" : "is-inactive")">@sub.Name</span>
                                    @if (!sub.IsActive)
                                    {
                                        <RadzenBadge Text="@Loc["InactiveBadge"]"
                                                     IsPill="true"
                                                     BadgeStyle="BadgeStyle.Warning" />
                                    }
                                    <span class="node-meta">
                                        @string.Format(CultureInfo.CurrentCulture,
                                            Loc["SubsubcategoryCount"],
                                            sub.SubSubCategories.Count)
                                    </span>
                                    <span class="node-actions">
                                        <RadzenButton Text="@Loc["AddSubSubCategoryButton"]"
                                                      Icon="add"
                                                      ButtonStyle="ButtonStyle.Success"
                                                      Variant="Variant.Outlined"
                                                      Size="ButtonSize.Small"
                                                      Disabled="@_isCreating"
                                                      Click="@(() => StartAddSubSub(sub.Id))" />
                                    </span>
                                </div>
                            </div>

                            @* Sub-sub-children container — only when sub is expanded *@
                            @if (subExpanded)
                            {
                                <div class="tree-children">
                                    @* Sub-sub-category nodes (depth 2 — leaf) *@
                                    @foreach (var ssub in sub.SubSubCategories)
                                    {
                                        <div class="tree-node" data-depth="2" @key(ssub.Id)>
                                            <div class="tree-node-row">
                                                <span class="chevron-spacer" aria-hidden="true"></span>
                                                <RadzenIcon Icon="circle"
                                                            Class="node-icon"
                                                            Style="color: var(--rz-warning); font-size: 0.625rem;" />
                                                <span class="node-name @(ssub.IsActive ? "" : "is-inactive")">@ssub.Name</span>
                                                @if (!ssub.IsActive)
                                                {
                                                    <RadzenBadge Text="@Loc["InactiveBadge"]"
                                                                 IsPill="true"
                                                                 BadgeStyle="BadgeStyle.Warning" />
                                                }
                                            </div>
                                        </div>
                                    }

                                    @* Inline "add sub-sub-category" form OR the
                                       "+ Add" button — same slot, no visual jump. *@
                                    @if (addingSubSubHere)
                                    {
                                        <div class="inline-add-form">
                                            <RadzenFormField Text="@Loc["FieldSubSubCategoryName"]" Class="name-field">
                                                <RadzenTextBox @bind-Value="_newSubSubName"
                                                               Placeholder="@Loc["FieldSubSubCategoryNamePlaceholder"]"
                                                               TValue="string"
                                                               Style="width: 100%;"
                                                               @onkeypress="@(async e => { if (e.Key == "Enter") await HandleCreateSubSubAsync(category.Id, sub.Id); })" />
                                            </RadzenFormField>
                                            <RadzenButton Text="@Loc["SaveButton"]"
                                                          Icon="check"
                                                          ButtonStyle="ButtonStyle.Primary"
                                                          Variant="Variant.Filled"
                                                          Size="ButtonSize.Small"
                                                          Disabled="@(_isCreating && _creatingFor == $"subsub:{sub.Id}")"
                                                          Click="@(() => HandleCreateSubSubAsync(category.Id, sub.Id))" />
                                            <RadzenButton Text="@Loc["CancelButton"]"
                                                          Icon="close"
                                                          ButtonStyle="ButtonStyle.Secondary"
                                                          Variant="Variant.Outlined"
                                                          Size="ButtonSize.Small"
                                                          Disabled="@(_isCreating && _creatingFor == $"subsub:{sub.Id}")"
                                                          Click="@CancelAddSubSub" />
                                        </div>
                                    }
                                    else
                                    {
                                        <RadzenButton Text="@Loc["AddSubSubCategoryButton"]"
                                                      Icon="add"
                                                      ButtonStyle="ButtonStyle.Success"
                                                      Variant="Variant.Outlined"
                                                      Size="ButtonSize.Small"
                                                      Class="add-child-btn"
                                                      Disabled="@_isCreating"
                                                      Click="@(() => StartAddSubSub(sub.Id))" />
                                    }
                                </div>
                            }
                        }

                        @* Inline "add sub-category" form OR the "+ Add"
                           button — same slot, no visual jump. *@
                        @if (addingSubHere)
                        {
                            <div class="inline-add-form">
                                <RadzenFormField Text="@Loc["FieldSubCategoryName"]" Class="name-field">
                                    <RadzenTextBox @bind-Value="_newSubName"
                                                   Placeholder="@Loc["FieldSubCategoryNamePlaceholder"]"
                                                   TValue="string"
                                                   Style="width: 100%;"
                                                   @onkeypress="@(async e => { if (e.Key == "Enter") await HandleCreateSubAsync(category.Id); })" />
                                </RadzenFormField>
                                <RadzenButton Text="@Loc["SaveButton"]"
                                              Icon="check"
                                              ButtonStyle="ButtonStyle.Primary"
                                              Variant="Variant.Filled"
                                              Size="ButtonSize.Small"
                                              Disabled="@(_isCreating && _creatingFor == $"sub:{category.Id}")"
                                              Click="@(() => HandleCreateSubAsync(category.Id))" />
                                <RadzenButton Text="@Loc["CancelButton"]"
                                              Icon="close"
                                              ButtonStyle="ButtonStyle.Secondary"
                                              Variant="Variant.Outlined"
                                              Size="ButtonSize.Small"
                                              Disabled="@(_isCreating && _creatingFor == $"sub:{category.Id}")"
                                              Click="@CancelAddSub" />
                            </div>
                        }
                        else
                        {
                            <RadzenButton Text="@Loc["AddSubCategoryButton"]"
                                          Icon="add"
                                          ButtonStyle="ButtonStyle.Success"
                                          Variant="Variant.Outlined"
                                          Size="ButtonSize.Small"
                                          Class="add-child-btn"
                                          Disabled="@_isCreating"
                                          Click="@(() => StartAddSub(category.Id))" />
                        }
                    </div>
                }
            }
        </div>
    }
</RadzenStack>

@code {
    // ── Form model ──────────────────────────────────────────────────────

    private sealed class NewCategoryFormModel
    {
        // Validation mirrors CreateCategoryCommandValidator (NotEmpty +
        // MaximumLength(100)). The cross-aggregate name-uniqueness check
        // is the handler's responsibility (requires DB access).
        [Required(ErrorMessage = "Category name is required.")]
        [StringLength(100, ErrorMessage = "Category name cannot exceed 100 characters.")]
        public string Name { get; set; } = string.Empty;
    }

    private NewCategoryFormModel _newCategoryModel = new();

    // ── State ────────────────────────────────────────────────────────────

    private List<CategoryDto> _categories = new();
    private bool _isLoading = true;
    private string? _loadError;
    private bool _isCreating;
    private string? _createError;

    // ── Inline add-form state (Phase 3.3 v3 — file-explorer tree) ───────
    //
    // _addingSubTo / _addingSubSubTo: when non-null, an inline add form
    //   is open under that parent. Only one form open at a time per level
    //   (you can't add a sub to category A and category B simultaneously
    //   — the UI would get confusing).
    // _newSubName / _newSubSubName: bound to the inline textboxes.
    // _creatingFor: tracks WHICH form is currently submitting, so we can
    //   disable only that form's buttons (not every button on the page)
    //   while a creation is in flight. Format: "sub:{catId}" or
    //   "subsub:{subId}".
    //
    // EXPAND STATE (v3 — flipped from v2's collapse semantics):
    //   _expandedCategories / _expandedSubs: HashSet of node IDs whose
    //   children are VISIBLE. Default: empty (top-level Categories only —
    //   SubCategories and SubSubCategories are collapsed by default).
    //   User clicks the chevron to expand → ID added to set → children
    //   render. Click again to collapse → ID removed → children hidden.
    //   This matches the user's "top-level only expanded" preference and
    //   is more natural than v2's "everything expanded by default".

    private Guid? _addingSubTo;
    private string _newSubName = string.Empty;
    private Guid? _addingSubSubTo;
    private string _newSubSubName = string.Empty;
    private string? _creatingFor;
    private readonly HashSet<Guid> _expandedCategories = new();
    private readonly HashSet<Guid> _expandedSubs = new();

    // ── Lifecycle ────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        await LoadCategoriesAsync();
    }

    // ── Data loading ────────────────────────────────────────────────────

    private async Task LoadCategoriesAsync()
    {
        _isLoading = true;
        _loadError = null;

        try
        {
            var result = await MessageBus.InvokeAsync<Result<List<CategoryDto>>>(
                new GetActiveCategoriesQuery());

            if (result.IsSuccess)
            {
                _categories = result.Value;
            }
            else
            {
                _loadError = result.Error ?? Loc["Error_FailedToLoad"];
            }
        }
        catch
        {
            _loadError = Loc["Error_FailedToLoad"];
        }
        finally
        {
            _isLoading = false;
        }
    }

    // ── Create category (top-level) ─────────────────────────────────────

    private async Task HandleCreateCategoryAsync()
    {
        _createError = null;

        if (string.IsNullOrWhiteSpace(_newCategoryModel.Name))
        {
            _createError = Loc["Error_NameRequired"];
            return;
        }

        _isCreating = true;
        _creatingFor = "cat";

        try
        {
            var command = new CreateCategoryCommand(_newCategoryModel.Name.Trim());
            var result = await MessageBus.InvokeAsync<Result<Guid>>(command);

            if (result.IsSuccess)
            {
                await Toast.Success(
                    string.Format(CultureInfo.CurrentCulture, Loc["CreateSuccess"], _newCategoryModel.Name),
                    summary: Loc["CreateSuccessTitle"]);

                // Clear the form for the next entry.
                _newCategoryModel = new NewCategoryFormModel();

                // Reload the list so the new category appears.
                await LoadCategoriesAsync();
            }
            else
            {
                // Most likely: name already exists. Surface the backend's
                // friendly message via toast AND the inline alert (so the
                // user sees it even if they navigated away from the toast).
                _createError = result.Error ?? Loc["Error_GenericCreate"];
                await Toast.Error(_createError, summary: Loc["ErrorTitle"]);
            }
        }
        catch
        {
            _createError = Loc["Error_GenericCreate"];
            await Toast.Error(_createError, summary: Loc["ErrorTitle"]);
        }
        finally
        {
            _isCreating = false;
            _creatingFor = null;
        }
    }

    // ── Create sub-category (inline under a category) ───────────────────

    private void StartAddSub(Guid categoryId)
    {
        _addingSubTo = categoryId;
        _newSubName = string.Empty;
    }

    private void CancelAddSub()
    {
        _addingSubTo = null;
        _newSubName = string.Empty;
    }

    private async Task HandleCreateSubAsync(Guid categoryId)
    {
        if (string.IsNullOrWhiteSpace(_newSubName))
        {
            await Toast.Error(Loc["Error_SubNameRequired"], summary: Loc["ErrorTitle"]);
            return;
        }

        var trimmedName = _newSubName.Trim();

        _isCreating = true;
        _creatingFor = $"sub:{categoryId}";

        try
        {
            var command = new CreateSubCategoryCommand(categoryId, trimmedName);
            var result = await MessageBus.InvokeAsync<Result<Guid>>(command);

            if (result.IsSuccess)
            {
                // Find the parent category name for the toast message.
                var parentName = _categories.FirstOrDefault(c => c.Id == categoryId)?.Name ?? "";

                await Toast.Success(
                    string.Format(CultureInfo.CurrentCulture, Loc["SubCategoryCreated"], trimmedName, parentName),
                    summary: Loc["SubCategoryCreatedTitle"]);

                // Close the inline form + reload the tree. Make sure the
                // parent category stays expanded so the user sees the new
                // sub appear under it.
                _addingSubTo = null;
                _newSubName = string.Empty;
                _expandedCategories.Add(categoryId);
                await LoadCategoriesAsync();
            }
            else
            {
                // Backend returns friendly DomainException messages for
                // duplicate names + inactive parents. Surface via toast;
                // keep the form open so the user can rename + retry.
                await Toast.Error(result.Error ?? Loc["Error_CreateSub"], summary: Loc["ErrorTitle"]);
            }
        }
        catch
        {
            await Toast.Error(Loc["Error_CreateSub"], summary: Loc["ErrorTitle"]);
        }
        finally
        {
            _isCreating = false;
            _creatingFor = null;
        }
    }

    // ── Create sub-sub-category (inline under a sub-category) ───────────

    private void StartAddSubSub(Guid subCategoryId)
    {
        _addingSubSubTo = subCategoryId;
        _newSubSubName = string.Empty;
    }

    private void CancelAddSubSub()
    {
        _addingSubSubTo = null;
        _newSubSubName = string.Empty;
    }

    private async Task HandleCreateSubSubAsync(Guid categoryId, Guid subCategoryId)
    {
        if (string.IsNullOrWhiteSpace(_newSubSubName))
        {
            await Toast.Error(Loc["Error_SubSubNameRequired"], summary: Loc["ErrorTitle"]);
            return;
        }

        var trimmedName = _newSubSubName.Trim();

        _isCreating = true;
        _creatingFor = $"subsub:{subCategoryId}";

        try
        {
            var command = new CreateSubSubCategoryCommand(categoryId, subCategoryId, trimmedName);
            var result = await MessageBus.InvokeAsync<Result<Guid>>(command);

            if (result.IsSuccess)
            {
                // Find the parent sub-category name for the toast.
                var parentSub = _categories
                    .FirstOrDefault(c => c.Id == categoryId)?
                    .SubCategories.FirstOrDefault(s => s.Id == subCategoryId)?.Name ?? "";

                await Toast.Success(
                    string.Format(CultureInfo.CurrentCulture, Loc["SubSubCategoryCreated"], trimmedName, parentSub),
                    summary: Loc["SubSubCategoryCreatedTitle"]);

                // Close the inline form + reload the tree. Make sure both
                // the category AND the sub stay expanded so the user sees
                // the new sub-sub appear in the right place.
                _addingSubSubTo = null;
                _newSubSubName = string.Empty;
                _expandedCategories.Add(categoryId);
                _expandedSubs.Add(subCategoryId);
                await LoadCategoriesAsync();
            }
            else
            {
                await Toast.Error(result.Error ?? Loc["Error_CreateSubSub"], summary: Loc["ErrorTitle"]);
            }
        }
        catch
        {
            await Toast.Error(Loc["Error_CreateSubSub"], summary: Loc["ErrorTitle"]);
        }
        finally
        {
            _isCreating = false;
            _creatingFor = null;
        }
    }

    // ── Expand toggles ──────────────────────────────────────────────────

    private void ToggleExpandCategory(Guid categoryId)
    {
        if (!_expandedCategories.Remove(categoryId))
        {
            _expandedCategories.Add(categoryId);
        }
    }

    private void ToggleExpandSub(Guid subCategoryId)
    {
        if (!_expandedSubs.Remove(subCategoryId))
        {
            _expandedSubs.Add(subCategoryId);
        }
    }
}
