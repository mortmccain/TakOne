                    </button>
                }
                else
                {
                    <button type="button"
                            class="action-btn"
                            title="@Loc["EditButton"]"
                            aria-label="@Loc["EditButton"]"
                            disabled="@_isRenaming"
                            @onclick="@(() => StartRenameSub(categoryId, sub))">
                        <RadzenIcon Icon="edit" />
                    </button>
                    <button type="button"
                            class="action-btn @(sub.IsActive ? "action-toggle-will-deactivate" : "action-toggle-will-activate")"
                            title="@(sub.IsActive ? Loc["DeactivateButton"] : Loc["ActivateButton"])"
                            aria-label="@(sub.IsActive ? Loc["DeactivateButton"] : Loc["ActivateButton"])"
                            disabled="@_isToggling"
                            @onclick="@(() => HandleToggleSubActiveAsync(categoryId, sub))">
                        <RadzenIcon Icon="@(sub.IsActive ? "block" : "check_circle")" />
                    </button>
                }
            </span>
        </div>

        @if (isExpanded)
        {
            <div class="list-children">
                @foreach (var ssub in sub.SubSubCategories)
                {
                    @RenderSubSubListItem(categoryId, sub.Id, ssub)
                }

                <div class="list-add-row">
                    @if (isAddingSubSub)
                    {
                        <div class="inline-add-form">
                            <input class="name-input"
                                   value="@_newSubSubName"
                                   @oninput="@(e => _newSubSubName = e.Value?.ToString() ?? "")"
                                   @onkeypress="@(async e => { if (e.Key == "Enter") await HandleCreateSubSubAsync(categoryId, sub.Id); })"
                                   @ref="_subSubInputRef" />
                            <button type="button"
                                    class="action-btn"
                                    title="@Loc["SaveButton"]"
                                    disabled="@(_isCreating && _creatingFor == $"subsub:{sub.Id}")"
                                    @onclick="@(() => HandleCreateSubSubAsync(categoryId, sub.Id))">
                                <RadzenIcon Icon="check" />
                            </button>
                            <button type="button"
                                    class="action-btn"
                                    title="@Loc["CancelButton"]"
                                    disabled="@(_isCreating && _creatingFor == $"subsub:{sub.Id}")"
                                    @onclick="@CancelAddSubSub">
                                <RadzenIcon Icon="close" />
                            </button>
                        </div>
                    }
                    else
                    {
                        <button type="button"
                                class="group-add-btn"
                                title="@Loc["AddSubSubCategoryButton"]"
                                aria-label="@Loc["AddSubSubCategoryButton"]"
                                disabled="@_isCreating"
                                @onclick="@(() => StartAddSubSub(sub.Id))">
                            <span class="add-icon-circle">
                                <RadzenIcon Icon="add" />
                            </span>
                            <span class="add-label">@Loc["AddSubSubCategoryButton"]</span>
                        </button>
                    }
                </div>
            </div>
        }
    };

    // ── List-view render: SubSubCategory (depth 2 — leaf) ──
    private RenderFragment RenderSubSubListItem(Guid categoryId, Guid subId, SubSubCategoryDto ssub) => __builder =>
    {
        var nodeId = "subsub:" + ssub.Id.ToString();
        var isRenaming = _renamingNode == nodeId;

        <div class="list-row @(ssub.IsActive ? "" : "is-inactive")">
            @if (isRenaming)
            {
                <input class="rename-input"
                       value="@_renameValue"
                       @oninput="@(e => _renameValue = e.Value?.ToString() ?? "")"
                       @onkeypress="@(async e => { if (e.Key == "Enter") await HandleRenameSubSubAsync(categoryId, subId, ssub.Id); })"
                       @ref="_renameInputRef" />
            }
            else
            {
                @* No chevron for leaf nodes — they have no children to
                   expand. A spacer keeps the icon aligned with siblings
                   that DO have chevrons (visual column alignment). *@
                <span class="chevron-spacer" style="display: inline-block; width: 1.25rem; flex-shrink: 0;"></span>
                <RadzenIcon Icon="circle" Class="node-icon" Style="color: var(--rz-warning); font-size: 0.625rem;" />
                <span class="list-node-label">@ssub.Name</span>
            }
            <span class="row-actions">
                @if (isRenaming)
                {
                    <button type="button"
                            class="action-btn"
                            title="@Loc["SaveButton"]"
                            disabled="@(_isRenaming && _renamingNode == nodeId)"
                            @onclick="@(() => HandleRenameSubSubAsync(categoryId, subId, ssub.Id))">
                        <RadzenIcon Icon="check" />
                    </button>
                    <button type="button"
                            class="action-btn"
                            title="@Loc["CancelButton"]"
                            disabled="@(_isRenaming && _renamingNode == nodeId)"
                            @onclick="@CancelRename">
                        <RadzenIcon Icon="close" />
                    </button>
                }
                else
                {
                    <button type="button"
                            class="action-btn"
                            title="@Loc["EditButton"]"
                            aria-label="@Loc["EditButton"]"
                            disabled="@_isRenaming"
                            @onclick="@(() => StartRenameSubSub(categoryId, subId, ssub))">
                        <RadzenIcon Icon="edit" />
                    </button>
                    <button type="button"
                            class="action-btn @(ssub.IsActive ? "action-toggle-will-deactivate" : "action-toggle-will-activate")"
                            title="@(ssub.IsActive ? Loc["DeactivateButton"] : Loc["ActivateButton"])"
                            aria-label="@(ssub.IsActive ? Loc["DeactivateButton"] : Loc["ActivateButton"])"
                            disabled="@_isToggling"
                            @onclick="@(() => HandleToggleSubSubActiveAsync(categoryId, subId, ssub))">
                        <RadzenIcon Icon="@(ssub.IsActive ? "block" : "check_circle")" />
                    </button>
                }
            </span>
        </div>
    };


@code {
    // ── State ────────────────────────────────────────────────────────────

    // ── View mode (v6) ──
    // Tree = horizontal node-tree with SVG bezier connectors.
    // List = classic file-explorer layout with indentation + elbow lines (default).
    // The user can switch between them via the .view-switcher in the header.
    // Both views share ALL other state (categories, expand/collapse, rename,
    // activate, add) so switching mid-task works seamlessly.
    //
    // v6.1: List is the DEFAULT view now (was Tree). The list view is denser
    // and reads more naturally for staff managing a large catalog — the tree
    // view remains available via the switcher for users who prefer the
    // spatial node-diagram layout. When the user switches TO Tree view,
    // SetViewMode triggers a connector re-measure + JS rebind (the canvas
    // was unmounted while in List view, so the old _connectors are stale).
    private ViewMode _viewMode = ViewMode.List;

    /// <summary>
    /// Toggles between Tree and List view. Called by the .view-switcher
    /// buttons in the page header. We don't need to call StateHasChanged
    /// explicitly because @onclick triggers a re-render automatically.
    /// We DO need to mark connectors as stale when switching TO Tree view
    /// so the JS re-measures node positions (the canvas was unmounted
    /// while in List view, so the old connector paths are stale).
    /// </summary>
    private void SetViewMode(ViewMode mode)
    {
        if (_viewMode == mode) return;
        _viewMode = mode;
        // When switching back to Tree view, force a connector re-measure
        // on the next render (the canvas was unmounted while in List
        // view, so the old _connectors list is stale and the JS
        // ResizeObserver hasn't seen a resize event to trigger redraw).
        if (mode == ViewMode.Tree)
        {
            _needsConnectorUpdate = true;
            _jsBound = false;  // also re-bind JS (canvas ref changed)
        }
    }

    private List<CategoryDto> _categories = new();
    private bool _isLoading = true;
    private string? _loadError;
    private bool _isCreating;
    private bool _isRenaming;
    private bool _isToggling;

    // ── Inline add-form state ───────────────────────────────────────────
    //
    // _addingTopLevel: when true, the inline add form is open at the
    //   bottom of the root-level categories list. The user is creating
    //   a new top-level Category.
    // _addingSubTo / _addingSubSubTo: when non-null, an inline add form
    //   is open at the bottom of THAT parent's children list.
    // _newCategoryName / _newSubName / _newSubSubName: bound to the
    //   inline textboxes.
    // _creatingFor: tracks WHICH form is currently submitting, so we
    //   can disable only that form's buttons. Format: "cat" (top-level),
    //   "sub:{catId}", or "subsub:{subId}".
    // _expandedCategories / _expandedSubs: HashSet of node IDs whose
    //   children are VISIBLE. Default: empty (top-level only). Auto-
    //   expanded when the user opens an inline add form on that node so
    //   the new child appears in the right place.
    private bool _addingTopLevel;
    private string _newCategoryName = string.Empty;
    private Guid? _addingSubTo;
    private string _newSubName = string.Empty;
    private Guid? _addingSubSubTo;
    private string _newSubSubName = string.Empty;
    private string? _creatingFor;
    private readonly HashSet<Guid> _expandedCategories = new();
    private readonly HashSet<Guid> _expandedSubs = new();

    // ── Inline rename state ─────────────────────────────────────────────
    private string? _renamingNode;
    private string _renameValue = string.Empty;

    // ── JS interop ──────────────────────────────────────────────────────
    private ElementReference _canvasRef;
    private ElementReference _renameInputRef;
    private ElementReference _topLevelInputRef;
    private ElementReference _subInputRef;
    private ElementReference _subSubInputRef;
    private DotNetObjectReference<AdminCategories>? _dotNetRef;
    private List<ConnectorInfo> _connectors = new();
    private bool _needsConnectorUpdate = true;

    // Tracks whether the JS redraw listener (ResizeObserver + dir
    // MutationObserver) has been successfully bound to the .tree-canvas
    // element. We can't bind on firstRender unconditionally because the
    // canvas only renders in the "else" branch (after loading completes
    // AND at least one category exists). On firstRender the page is
    // typically still showing the loading spinner, so _canvasRef is an
    // empty ElementReference — passing it to bindRedraw throws
    // "Failed to execute 'observe' on 'ResizeObserver': parameter 1 is
    // not of type 'Element'" and crashes the circuit.
    //
    // We retry on every render where _canvasRef.Context is non-null
    // until the binding succeeds. Once bound, _jsBound short-circuits
    // further attempts.
    private bool _jsBound;

    // ── Lifecycle ────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        await LoadCategoriesAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Bind the JS redraw listener once the canvas element is
        // actually in the DOM. _canvasRef.Context is null when the
        // .tree-canvas div hasn't been rendered yet (loading / empty /
        // error states). The first time the tree state renders, the
        // ElementReference becomes bound and we can safely bind JS.
        if (!_jsBound && _canvasRef.Context is not null)
        {
            _jsBound = true;
            // v6: Dispose any previous DotNetObjectReference before
            // creating a new one. When the user switches from List to
            // Tree view, _jsBound is reset to false by SetViewMode,
            // causing this block to re-execute. Without disposing the
            // old _dotNetRef, we would leak one per view switch.
            _dotNetRef?.Dispose();
            _dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("adminCategoriesTree.bindRedraw", _canvasRef, _dotNetRef);
            }
            catch
            {
                // If JS interop fails (e.g. circuit disposing), reset
                // so we retry on the next render.
                _jsBound = false;
            }
        }

        // Focus whichever inline input is currently active so the user
        // can start typing immediately.
        await FocusActiveInputAsync();

        if (_needsConnectorUpdate && _canvasRef.Context is not null)
        {
            _needsConnectorUpdate = false;
            try
            {
                var paths = await JS.InvokeAsync<List<ConnectorInfo>>(
                    "adminCategoriesTree.measureConnectors", _canvasRef);
                _connectors = paths;
                StateHasChanged();
            }
            catch
            {
                // JS interop can fail during circuit disposal or initial
                // prerender. Safe to ignore — the next render will retry.
            }
        }
    }

    private async Task FocusActiveInputAsync()
    {
        try
        {
            if (_renamingNode is not null && _renameInputRef.Context is not null)
            {
                await _renameInputRef.FocusAsync();
                return;
            }
            if (_addingTopLevel && _topLevelInputRef.Context is not null)
            {
                await _topLevelInputRef.FocusAsync();
                return;
            }
            if (_addingSubTo is not null && _subInputRef.Context is not null)
            {
                await _subInputRef.FocusAsync();
                return;
            }
            if (_addingSubSubTo is not null && _subSubInputRef.Context is not null)
            {
                await _subSubInputRef.FocusAsync();
                return;
            }
        }
        catch
        {
            // Focus may fail during render — safe to ignore.
        }
    }

    /// <summary>
    /// JS-invokable callback. Called by adminCategoriesTree.js whenever
    /// the canvas resizes or the document direction changes (language
    /// switch). Updates the connector paths without triggering a re-measure
    /// loop.
    /// </summary>
    [JSInvokable]
    public Task UpdateConnectors(List<ConnectorInfo> paths)
    {
        _connectors = paths ?? new();
        StateHasChanged();
        return Task.CompletedTask;
    }

    // ── Connector info (returned by JS) ─────────────────────────────────

    public sealed class ConnectorInfo
    {
        public string ParentId { get; set; } = string.Empty;
        public string ChildId { get; set; } = string.Empty;
        public string Path { get; set; } = string.Empty;
    }

    // ── Data loading ────────────────────────────────────────────────────

    private async Task LoadCategoriesAsync()
    {
        _isLoading = true;
        _loadError = null;

        try
        {
            // Use GetAllCategoriesQuery (NOT GetActiveCategoriesQuery) so
            // deactivated Categories / SubCategories / SubSubCategories
            // STAY on the page — the markup renders them with a red
            // outline + an "activate" toggle so the admin can reactivate
            // them. GetActiveCategoriesQuery would filter out deactivated
            // top-level Categories entirely, making them (and their whole
            // subtrees, since the .Include only fires for categories that
            // pass the .Where filter) vanish from the page — which is the
            // v5 bug the user reported.
            var result = await MessageBus.InvokeAsync<Result<List<CategoryDto>>>(
                new GetAllCategoriesQuery());

            if (result.IsSuccess)
            {
                _categories = result.Value;
            }
            else
            {
                _loadError = ErrorDisplay.Localize(result.Error) ?? Loc["Error_FailedToLoad"];
            }
        }
        catch
        {
            _loadError = Loc["Error_FailedToLoad"];
        }
        finally
        {
            _isLoading = false;
            _needsConnectorUpdate = true;
        }
    }

    // ── Create category (top-level, inline + at end of root list) ───────

    private void StartAddTopLevel()
    {
        _addingTopLevel = true;
        _newCategoryName = string.Empty;
        _needsConnectorUpdate = true;
    }

    private void CancelAddTopLevel()
    {
        _addingTopLevel = false;
        _newCategoryName = string.Empty;
        _needsConnectorUpdate = true;
    }

    private async Task HandleCreateCategoryAsync()
    {
        if (string.IsNullOrWhiteSpace(_newCategoryName))
        {
            await Toast.Error(Loc["Error_NameRequired"], summary: Loc["ErrorTitle"]);
            return;
        }

        var trimmedName = _newCategoryName.Trim();
        _isCreating = true;
        _creatingFor = "cat";

        try
        {
            var command = new CreateCategoryCommand(trimmedName);
            var result = await MessageBus.InvokeAsync<Result<Guid>>(command);

            if (result.IsSuccess)
            {
                await Toast.Success(
                    string.Format(CultureInfo.CurrentCulture, Loc["CreateSuccess"], trimmedName),
                    summary: Loc["CreateSuccessTitle"]);

                _addingTopLevel = false;
                _newCategoryName = string.Empty;
                await LoadCategoriesAsync();
            }
            else
            {
                await Toast.Error(ErrorDisplay.Localize(result.Error) ?? Loc["Error_GenericCreate"], summary: Loc["ErrorTitle"]);
            }
        }
        catch
        {
            await Toast.UnexpectedError(UnexpectedErrorCodes.AdminCategories_CreateCategoryFailure, summary: Loc["ErrorTitle"]);
        }
        finally
        {
            _isCreating = false;
            _creatingFor = null;
        }
    }

    // ── Create sub-category (inline + at end of category's sub list) ────

    private void StartAddSub(Guid categoryId)
    {
        _addingSubTo = categoryId;
        _newSubName = string.Empty;
        _expandedCategories.Add(categoryId);
        _needsConnectorUpdate = true;
    }

    private void CancelAddSub()
    {
        _addingSubTo = null;
        _newSubName = string.Empty;
        _needsConnectorUpdate = true;
    }

    private async Task HandleCreateSubAsync(Guid categoryId)
    {
        if (string.IsNullOrWhiteSpace(_newSubName))
        {
            await Toast.Error(Loc["Error_SubNameRequired"], summary: Loc["ErrorTitle"]);
            return;
        }

        var trimmedName = _newSubName.Trim();
        _isCreating = true;
        _creatingFor = $"sub:{categoryId}";

        try
        {
            var command = new CreateSubCategoryCommand(categoryId, trimmedName);
            var result = await MessageBus.InvokeAsync<Result<Guid>>(command);

            if (result.IsSuccess)
            {
                var parentName = _categories.FirstOrDefault(c => c.Id == categoryId)?.Name ?? "";

                await Toast.Success(
                    string.Format(CultureInfo.CurrentCulture, Loc["SubCategoryCreated"], trimmedName, parentName),
                    summary: Loc["SubCategoryCreatedTitle"]);

                _addingSubTo = null;
                _newSubName = string.Empty;
                _expandedCategories.Add(categoryId);
                await LoadCategoriesAsync();
            }
            else
            {
                await Toast.Error(ErrorDisplay.Localize(result.Error) ?? Loc["Error_CreateSub"], summary: Loc["ErrorTitle"]);
            }
        }
        catch
        {
            await Toast.UnexpectedError(UnexpectedErrorCodes.AdminCategories_CreateSubCategoryFailure, summary: Loc["ErrorTitle"]);
        }
        finally
        {
            _isCreating = false;
            _creatingFor = null;
        }
    }

    // ── Create sub-sub-category (inline + at end of sub's sub-sub list) ─

    private void StartAddSubSub(Guid subCategoryId)
    {
        _addingSubSubTo = subCategoryId;
        _newSubSubName = string.Empty;
        _expandedSubs.Add(subCategoryId);
        _needsConnectorUpdate = true;
    }

    private void CancelAddSubSub()
    {
        _addingSubSubTo = null;
        _newSubSubName = string.Empty;
        _needsConnectorUpdate = true;
    }

    private async Task HandleCreateSubSubAsync(Guid categoryId, Guid subCategoryId)
    {
        if (string.IsNullOrWhiteSpace(_newSubSubName))
        {
            await Toast.Error(Loc["Error_SubSubNameRequired"], summary: Loc["ErrorTitle"]);
            return;
        }

        var trimmedName = _newSubSubName.Trim();
        _isCreating = true;
        _creatingFor = $"subsub:{subCategoryId}";

        try
        {
            var command = new CreateSubSubCategoryCommand(categoryId, subCategoryId, trimmedName);
            var result = await MessageBus.InvokeAsync<Result<Guid>>(command);

            if (result.IsSuccess)
            {
                var parentSub = _categories
                    .FirstOrDefault(c => c.Id == categoryId)?
                    .SubCategories.FirstOrDefault(s => s.Id == subCategoryId)?.Name ?? "";

                await Toast.Success(
                    string.Format(CultureInfo.CurrentCulture, Loc["SubSubCategoryCreated"], trimmedName, parentSub),
                    summary: Loc["SubSubCategoryCreatedTitle"]);

                _addingSubSubTo = null;
                _newSubSubName = string.Empty;
                _expandedCategories.Add(categoryId);
                _expandedSubs.Add(subCategoryId);
                await LoadCategoriesAsync();
            }
            else
            {
                await Toast.Error(ErrorDisplay.Localize(result.Error) ?? Loc["Error_CreateSubSub"], summary: Loc["ErrorTitle"]);
            }
        }
        catch
        {
            await Toast.UnexpectedError(UnexpectedErrorCodes.AdminCategories_CreateSubSubCategoryFailure, summary: Loc["ErrorTitle"]);
        }
        finally
        {
            _isCreating = false;
            _creatingFor = null;
        }
    }

