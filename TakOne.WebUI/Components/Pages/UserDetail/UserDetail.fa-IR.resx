  <data name="HelpPanel_RemoveRole" xml:space="preserve">
    <value>حذف نقش — یک نقش از این کاربر حذف می‌شود. نمی‌توانید نقش «مدیر سیستم» خودتان را حذف کنید.</value>
  </data>
  <data name="HelpPanel_AssignGroup" xml:space="preserve">
