    // Both builders reuse the shared CsvBuilder (RFC 4180 escaping +
    // invariant numbers) and the takDownload.csv JS helper (UTF-8 + BOM)
    // — the exact same write-side machinery the grid exports use, so the
    // templates round-trip through CsvParser byte-for-byte.

    /// <summary>
    /// Builds and downloads a sample product-import CSV: the EXACT
    /// positional 10-column format the import expects — the same
    /// localized headers AND column order the AdminProducts export writes
    /// (reused from that page's localizer, so the two can never drift) —
    /// plus two example rows, including one WITHOUT a picture (empty
    /// directory + file-name cells) to show the columns are optional.
    /// </summary>
    private async Task DownloadProductCsvTemplateAsync()
    {
        try
        {
            var builder = new CsvBuilder();
            builder.AddHeader(
                ProductsLoc["ColName"],
                ProductsLoc["ColCategory"],
                ProductsLoc["ColSubCategory"],
                ProductsLoc["ColSubSubCategory"],
                ProductsLoc["ColPrice"],
                ProductsLoc["ColCurrency"],
                ProductsLoc["ColStock"],
                ProductsLoc["ColStatus"],
                ProductsLoc["ColPictureDirectory"],
                ProductsLoc["ColPictureFileName"]);

            // Sample rows. Values are deliberately obvious placeholders so
            // an accidentally-imported template is instantly recognizable
            // (and deletable) in the products grid. Status mirrors what the
            // export writes (localized in-stock/out-of-stock label); the
            // import reads but ignores it (stock status is derived from
            // the stock quantity).
            builder.AddRow(
                "Example Product A", "Example Category", "Example Sub-Category", "Example Sub-Sub-Category",
                100.5m, "IRR", 10, ProductsLoc["StatusInStockBadge"],
                "uploads/products", "example-product-a.jpg");
            builder.AddRow(
                "Example Product B", "Example Category", "Example Sub-Category", string.Empty,
                250m, "IRR", 0, ProductsLoc["StatusOutOfStockBadge"],
                string.Empty, string.Empty);

            await JS.InvokeVoidAsync("takDownload.csv", "takone-products-import-template.csv", builder.ToString());
        }
        catch (Exception)
        {
            // JS interop can fail after a circuit reconnect — same policy
            // as the grid exports: a visible toast beats a dead button.
            await Toast.Warning(Loc["DownloadError"], summary: Loc["ErrorTitle"]);
        }
    }

