    /// <summary>
    /// One theme entry in the selector grid. See _availableThemes above
    /// for the field-by-field rationale.
    /// </summary>
    private sealed record ThemeOption(
        string Id,
        string Icon,
        bool IsDark,
        string NameKey,
        string HintKey,
        string Category);

    /// <summary>
    /// Ordered list of theme categories — each renders as a small all-caps
    /// header above its group of theme cards. The order here controls the
    /// order the groups appear in the UI (Tak first, then Radzen).
    ///
    /// Id must match the Category field on ThemeOption entries. Header is
    /// a resx key (looked up via Loc[...]) so the category labels are
    /// localized too.
    /// </summary>
    private readonly List<ThemeCategory> _themeCategories = new()
    {
        new ThemeCategory(Id: "Tak",    HeaderKey: "ThemeCategory_Tak"),
        new ThemeCategory(Id: "Radzen", HeaderKey: "ThemeCategory_Radzen"),
    };

    /// <summary>
    /// One category group in the theme selector. See _themeCategories
    /// above for the field-by-field rationale.
    /// </summary>
    private sealed record ThemeCategory(string Id, string HeaderKey);

    /// <summary>
    /// Resolves the localized header for a category. Used by the markup's
    /// @category.Header binding so the razor file doesn't need to know
    /// about the resx-key indirection.
    /// </summary>
    private string GetCategoryHeader(ThemeCategory category) => Loc[category.HeaderKey];

    // ── Lifecycle ──────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Resolve the current user's Id via AuthStateProvider — NOT
            // ICurrentUserService, which reads from HttpContext (null over
            // the SignalR circuit in interactive Blazor Server mode).
            // Same pattern as UserDetail.razor.
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user?.Identity?.IsAuthenticated != true)
            {
                _loadError = Loc["Error_NotAuthenticated"];
                return;
            }

            // The UserId claim is set by our custom IClaimsPrincipalFactory
            // in Infrastructure — it's the Domain User's Guid Id. Fallback
            // to NameIdentifier for safety.
            var idClaim = user.FindFirst("UserId")?.Value
                          ?? user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

            if (!Guid.TryParse(idClaim, out var userId))
            {
                _loadError = Loc["Error_NotAuthenticated"];
                return;
            }

            var query = new GetUserByIdQuery { UserId = userId };
            var result = await MessageBus.InvokeAsync<Result<UserDto>>(query);

            if (result.IsSuccess)
            {
                _user = result.Value;
            }
            else
            {
                // The handler returns "User '...' was not found." for both
                // genuinely-missing users and not-allowed-to-see — we
                // surface a generic message to avoid leaking which.
                _loadError = Loc["Error_GenericLoad"];
            }

            // ── Notification preferences (Round 3) — loaded independently
            // so a prefs failure never takes the account card down with
            // it. The query resolves the CURRENT user server-side (no
            // client-supplied Id — anti-CSRF). ──
            await LoadNotificationPreferencesAsync();
        }
        catch
        {
            _loadError = Loc["Error_GenericLoad"];
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>
    /// After the first interactive render, read the actually-applied theme
    /// from theme.js (window.takTheme.get) and update _currentTheme so the
    /// active theme's card shows .is-selected. Same pattern as
    /// MainLayout.razor's OnAfterRenderAsync.
    ///
    /// WHY OnAfterRenderAsync (not OnInitializedAsync):
    ///   - OnInitializedAsync runs TWICE in InteractiveServer + prerender:
    ///     once during static prerender (no circuit yet — JS interop throws),
    ///     and once after hydration (circuit ready — JS interop works).
    ///   - OnAfterRenderAsync(firstRender: true) runs ONLY ONCE, after the
    ///     circuit is established. JS interop definitely works here.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var saved = await JS.InvokeAsync<string>("takTheme.get");
            if (!string.IsNullOrEmpty(saved) && saved != _currentTheme)
            {
                _currentTheme = saved;
                StateHasChanged();
            }
        }
        catch
        {
            // JS interop failed (e.g. theme.js didn't load) — leave
            // _currentTheme at its "tak-light" default. The user can
            // still click theme cards; only the persistence would fail.
        }
    }

    // ── Theme selection ────────────────────────────────────────────────

    /// <summary>
    /// Called when the user clicks a theme card. Calls theme.js's
    /// takTheme.set(themeName) to swap the CSS <link> + persist to
    /// localStorage, then updates _currentTheme so the .is-selected class
    /// moves to the clicked card. No page reload needed — theme.js swaps
    /// the stylesheet in-place and the whole page re-paints.
    /// </summary>
    private async Task HandleSelectThemeAsync(string themeId)
    {
        if (themeId == _currentTheme)
        {
            return; // no-op — clicking the already-active theme
        }

        try
        {
            await JS.InvokeVoidAsync("takTheme.set", themeId);
            _currentTheme = themeId;
            _themeToast = string.Format(CultureInfo.CurrentCulture, Loc["ThemeApplied"], GetThemeName(themeId));
        }
        catch
        {
            // JS interop failed — show an error toast so the user knows.
            _themeToast = Loc["Error_ThemeSwitch"];
        }
    }

    // ── Notification preferences (Round 3) ─────────────────────────────

    /// <summary>
    /// Loads the complete per-kind preference list. A failure sets
    /// <see cref="_prefsLoadError"/> (inline alert) and leaves the list
    /// null — it never throws out to OnInitializedAsync, so the account +
    /// theme cards keep working.
    /// </summary>
    private async Task LoadNotificationPreferencesAsync()
    {
        try
        {
            var result = await MessageBus.InvokeAsync<
                Result<IReadOnlyList<NotificationPreferenceDto>>>(
                new GetNotificationPreferencesQuery());

            if (result.IsSuccess)
            {
                _notificationPreferences = result.Value.ToList();
            }
            else
            {
                _prefsLoadError = Loc["NotifPrefsErrorLoad"];
            }
        }
        catch
        {
            _prefsLoadError = Loc["NotifPrefsErrorLoad"];
        }
    }

    /// <summary>
    /// Handles a RadzenSwitch Change for one kind. OPTIMISTIC update (the
    /// switch is already visually flipped by Radzen before this runs) +
    /// dispatch of the upsert command; on failure the local state is
    /// REVERTED and an error toast explains what happened. Muting takes
    /// effect on the next notification created for the user — it is not
    /// retroactive (existing rows stay in the feed).
    /// </summary>
    private async Task HandleNotifPrefToggleAsync(NotificationKind kind, bool isMuted)
    {
        if (_notificationPreferences is null || _isSavingPref)
        {
            return;
        }

        _isSavingPref = true;

        // Optimistic local update — the switch's own visual state already
        // flipped; this keeps the rest of the list consistent with it.
        var entry = _notificationPreferences.FirstOrDefault(p => p.Kind == kind);
        if (entry is not null)
        {
            var index = _notificationPreferences.IndexOf(entry);
            _notificationPreferences[index] = new NotificationPreferenceDto
            {
                Kind = kind,
                IsMuted = isMuted
            };
        }

        try
        {
            var result = await MessageBus.InvokeAsync<Result>(
                new SetNotificationMutedCommand(kind, isMuted));

            if (!result.IsSuccess)
            {
                RevertNotifPref(kind);
                await Toast.Warning(
                    Loc["NotifPrefsErrorSave"],
                    summary: Loc["ErrorTitle"]);
            }
        }
        catch
        {
            RevertNotifPref(kind);
            await Toast.Warning(
                Loc["NotifPrefsErrorSave"],
                summary: Loc["ErrorTitle"]);
        }
        finally
        {
            _isSavingPref = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Reverts the local optimistic state for one kind after a failed
    /// save (so the switch reflects the persisted truth, not the wish).
    /// </summary>
    private void RevertNotifPref(NotificationKind kind)
    {
        if (_notificationPreferences is null)
        {
            return;
        }

        var entry = _notificationPreferences.FirstOrDefault(p => p.Kind == kind);
        if (entry is not null)
        {
            var index = _notificationPreferences.IndexOf(entry);
            _notificationPreferences[index] = new NotificationPreferenceDto
            {
                Kind = kind,
                IsMuted = !entry.IsMuted
            };
        }
    }

    /// <summary>
    /// Material Symbols icon per kind — same mapping as the Notifications
    /// page's GetIconName, so the icon the user mutes in Settings is the
    /// same icon they see in the feed. Kept as a small local copy (not a
    /// shared service) to match the page's self-contained helper style.
    /// </summary>
    private static string GetNotifPrefIcon(NotificationKind kind) => kind switch
    {
        NotificationKind.SaleSubmitted => "shopping_cart",
        NotificationKind.SaleApproved => "check_circle",
        NotificationKind.SaleInvoiced => "receipt_long",
        NotificationKind.SaleCancelled => "cancel",
        NotificationKind.Broadcast => "campaign",
        NotificationKind.AppUpdate => "system_update",
        NotificationKind.GroupChanged => "swap_horiz",
        _ => "notifications"
    };

