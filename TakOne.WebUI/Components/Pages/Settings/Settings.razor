    };

    // ── Display helpers ────────────────────────────────────────────────

    /// <summary>
    /// Returns the CSS class for a theme card: "usertype-option is-selected"
    /// for the active theme, "usertype-option" for others. Mirrors
    /// CreateUser.razor's GetToggleClass exactly so the visual style is
    /// identical to the gender buttons.
    /// </summary>
    private static string GetToggleClass(bool selected)
    {
        return selected ? "usertype-option is-selected" : "usertype-option";
    }

    /// <summary>
    /// Returns the inline border style for a theme card: solid primary
    /// border + padding when selected, neutral border + padding otherwise.
    /// Mirrors CreateUser.razor's GetToggleBorderStyle so the border
    /// treatment matches the gender buttons.
    /// </summary>
    private static string GetToggleBorderStyle(bool selected)
    {
        var borderColor = selected ? "var(--rz-primary)" : "var(--rz-border-color)";
        return $"padding: 1rem; cursor: pointer; border: 2px solid {borderColor};";
    }

    /// <summary>
    /// Returns the icon color style for a theme card: primary color when
    /// selected, secondary text color otherwise. Mirrors CreateUser.razor's
    /// GetToggleIconStyle.
    /// </summary>
    private static string GetToggleIconStyle(bool selected)
    {
        var color = selected ? "var(--rz-primary)" : "var(--rz-text-secondary-color)";
        return $"color: {color}; font-size: 1.75rem;";
    }

    /// <summary>
    /// Returns the name text style for a theme card: primary color + bold
    /// when selected, normal text color otherwise. Mirrors CreateUser.razor's
    /// GetToggleTextStyle.
    /// </summary>
    private static string GetToggleTextStyle(bool selected)
    {
        var color = selected ? "var(--rz-primary)" : "var(--rz-text-color)";
        return $"font-weight: 600; margin: 0; color: {color};";
    }

    /// <summary>
    /// Returns the localized display name for a theme Id. Used in the
    /// card body + the "Theme applied" toast. Looks up the ThemeOption
    /// by Id and returns its localized NameKey value — falls back to the
    /// raw Id if the theme isn't in _availableThemes (defensive; should
    /// never happen because the cards only render known themes).
    /// </summary>
    private string GetThemeName(string themeId)
    {
        var theme = _availableThemes.FirstOrDefault(t => t.Id == themeId);
        return theme is null ? themeId : Loc[theme.NameKey];
    }

    /// <summary>
    /// Returns the localized short hint for a theme Id — shown as a small
    /// caption under the theme name in the card. Same lookup pattern as
    /// GetThemeName; falls back to empty string if the theme isn't found.
    /// </summary>
    private string GetThemeHint(string themeId)
    {
        var theme = _availableThemes.FirstOrDefault(t => t.Id == themeId);
        return theme is null ? string.Empty : Loc[theme.HintKey];
    }

    /// <summary>
    /// Returns the localized label for a Gender enum value. Same pattern
    /// as UserDetail.razor's GetGenderLabel.
    /// </summary>
    private string GetGenderLabel(Gender gender) => gender switch
    {
        Gender.Male => Loc["GenderMale"],
        Gender.Female => Loc["GenderFemale"],
        _ => gender.ToString()
    };

