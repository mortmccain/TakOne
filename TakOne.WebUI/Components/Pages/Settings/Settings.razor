    /// </summary>
    private string GetNotifPrefDesc(NotificationKind kind) => kind switch
    {
        NotificationKind.SaleSubmitted => Loc["NotifPrefDesc_Submitted"],
        NotificationKind.SaleApproved => Loc["NotifPrefDesc_Approved"],
        NotificationKind.SaleInvoiced => Loc["NotifPrefDesc_Invoiced"],
        NotificationKind.SaleCancelled => Loc["NotifPrefDesc_Cancelled"],
        NotificationKind.Broadcast => Loc["NotifPrefDesc_Broadcast"],
        NotificationKind.AppUpdate => Loc["NotifPrefDesc_AppUpdate"],
        NotificationKind.GroupChanged => Loc["NotifPrefDesc_GroupChanged"],
