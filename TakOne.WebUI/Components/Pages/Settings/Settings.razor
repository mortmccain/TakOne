    /// <summary>
    /// Formats a byte count as a compact human size ("4.2 MB") — the
    /// pending-picture chips. Invariant digits: file sizes are data, not
    /// localized UI text.
    /// </summary>
    private static string FormatFileSize(long bytes)
    {
        string[] units = { "B", "KB", "MB", "GB" };
        var size = (double)bytes;
        var unit = 0;
        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }
        return $"{size:0.#} {units[unit]}";
    }

    /// <summary>
    /// User-CSV picker: parse + NORMALIZE the file (the export writes
    /// LOCALIZED gender and status labels — map them back to the neutral
    /// enum/bool here, where the localizer lives), dispatch
    /// ImportUsersCommand, and merge the handler's per-row report with
    /// local parse failures.
    ///
    /// COLUMN ORDER (positional — must mirror the manage-users export):
    /// Worker ID, Full name, Gender, Group, Roles (semicolon-joined),
    /// Status.
    /// </summary>
    private async Task OnUserCsvSelectedAsync(InputFileChangeEventArgs e)
    {
        // Reset the previous run's UI state.
        _userImportError = null;
        _userImportRows = null;
        _userImportCreated = _userImportSkipped = _userImportFailed = 0;

        if (e.FileCount == 0)
        {
            return;
        }

        var file = e.File;
        var rows = new List<UserImportRowDto>();
        var localFailures = new List<UserImportRowResultDto>();

        try
        {
            var csv = await ReadTextFileAsync(file, MaxCsvFileSizeBytes);
            var records = CsvParser.Parse(csv);

            if (records.Count < 2)
            {
                _userImportError = Loc["ImportErrorNoDataRows"];
                return;
            }

            for (var i = 1; i < records.Count; i++)
            {
                var fields = records[i];
                var rowNumber = i;

                if (fields.Length < 6)
                {
                    localFailures.Add(new UserImportRowResultDto
                    {
                        RowNumber = rowNumber,
                        WorkerId = fields.Length > 0 ? fields[0] : string.Empty,
                        Outcome = UserImportRowOutcome.Failed,
                        Message = Loc["ImportErrorShortRow"]
                    });
                    continue;
                }

                // ── Normalize the LOCALIZED cells (gender + status) into
                //    neutral values. Accepts the canonical English keys,
                //    the CURRENT culture's labels, and the known fa-IR
                //    labels — covering same-deployment round-trips and
                //    cross-culture imports alike.
                if (!TryNormalizeGender(fields[2], out var gender))
                {
                    localFailures.Add(new UserImportRowResultDto
                    {
                        RowNumber = rowNumber,
                        WorkerId = fields[0],
                        Outcome = UserImportRowOutcome.Failed,
                        Message = Loc["ImportErrorBadGender"]
                    });
                    continue;
                }

                // Status: empty cell defaults to Active (an export always
                // writes it, but hand-made files may not).
                var isActive = NormalizeStatus(fields[5]);

                // Roles: semicolon-joined inside one cell ("Employee;
                // Customer") → trimmed, non-empty list.
                var roles = fields[4]
                    .Split(';', System.StringSplitOptions.TrimEntries | System.StringSplitOptions.RemoveEmptyEntries)
                    .ToList();

                rows.Add(new UserImportRowDto
                {
                    WorkerId = fields[0],
                    FullName = fields[1],
                    Gender = gender,
                    GroupName = fields[3],
                    Roles = roles,
                    IsActive = isActive,
                    RowNumber = rowNumber
                });
            }
        }
        catch (System.IO.IOException ex)
        {
            _userImportError = Loc["ImportErrorReadFailed", ex.Message];
            return;
        }

        if (rows.Count == 0)
        {
            _userImportRows = localFailures;
            _userImportFailed = localFailures.Count;
            return;
        }

        _isImportingUsers = true;
        try
        {
            var result = await MessageBus.InvokeAsync<Result<UserImportResultDto>>(new ImportUsersCommand(rows));

            if (result.IsSuccess)
            {
                var report = result.Value;
                _userImportCreated = report.CreatedCount;
                _userImportSkipped = report.SkippedCount;
                _userImportFailed = report.FailedCount + localFailures.Count;

                _userImportRows = report.RowResults.Concat(localFailures).ToList();

                await Toast.Success(Loc["UserImportDone", report.CreatedCount, report.SkippedCount, report.FailedCount + localFailures.Count], summary: Loc["PageHeading"]);
            }
            else
            {
                _userImportError = result.Error;
            }
        }
        catch (Exception)
        {
            _userImportError = Loc["ImportErrorGeneric"];
        }
        finally
        {
            _isImportingUsers = false;
        }
    }

    /// <summary>
    /// Maps a CSV gender cell back to the Gender enum. Accepts the
    /// canonical English keys ("Male"/"Female"), the current culture's
    /// localized labels (via the localizer — the common same-deployment
    /// round-trip), and the known fa-IR label values (so an fa-IR export
    /// imports cleanly even under an en-US UI). Values must stay in sync
    /// with AdminUsers.en-US.resx / AdminUsers.fa-IR.resx
    /// (GenderMale/GenderFemale).
    /// </summary>
    private bool TryNormalizeGender(string cell, out Gender gender)
    {
        var value = cell?.Trim() ?? string.Empty;

        if (string.Equals(value, "Male", StringComparison.OrdinalIgnoreCase)
            || string.Equals(value, Loc["GenderMale"], StringComparison.Ordinal)
            || value == "مرد")
        {
            gender = Gender.Male;
            return true;
        }

        if (string.Equals(value, "Female", StringComparison.OrdinalIgnoreCase)
            || string.Equals(value, Loc["GenderFemale"], StringComparison.Ordinal)
            || value == "زن")
        {
            gender = Gender.Female;
            return true;
        }

        gender = Gender.Male;
        return false;
    }

    /// <summary>
    /// Maps a CSV status cell to the active flag. Active/فعال (either
    /// case) → true; Inactive/غیرفعال → false; anything else (including
    /// empty) → true (new accounts default to active). Values in sync with
    /// AdminUsers.resx (StatusActive/StatusInactive).
    /// </summary>
    private static bool NormalizeStatus(string cell)
    {
        var value = cell?.Trim() ?? string.Empty;

        if (string.Equals(value, "Inactive", StringComparison.OrdinalIgnoreCase) || value == "غیرفعال")
        {
            return false;
        }

        return true;
    }

