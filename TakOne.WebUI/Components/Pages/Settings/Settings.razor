    // ── Admin tools (admin-only) ──────────────────────────────────────────

    /// <summary>
    /// Whether the current user is in the Admin role — gates the
    /// admin-tools section (product import, bulk picture upload, user
    /// import). Resolved in OnInitializedAsync from the Blazor auth
    /// state; the commands are ALSO [RequireRoles(Admin)]-gated
    /// server-side, so this is UX gating, not the security boundary.
    /// </summary>
    private bool _isAdmin;

    /// <summary>
    /// Hard cap on CSV import-file size: 5 MB is ~50k rows of either
    /// export format — far beyond the 2,000-row command cap, so the cap
    /// (not the file size) is always the binding limit.
    /// </summary>
    private const int MaxCsvFileSizeBytes = 5 * 1024 * 1024;

    /// <summary>
    /// Hard cap on ONE bulk picture upload batch. Keeps the circuit's
    /// buffered memory bounded (50 × 5 MB worst case) and forces very
    /// large restores to arrive in reviewable chunks.
    /// </summary>
    private const int MaxPicturesPerBatch = 50;

    /// <summary>
    /// Max size of ONE uploaded picture — mirrors the backend's
    /// FileStorage:MaxImageSizeBytes default (5 MB). The backend
    /// re-validates (magic bytes + bounded stream); this is the
    /// client-side pre-filter so obviously-oversized files are rejected
    /// without buffering them.
    /// </summary>
    private const int MaxPictureFileSizeBytes = 5 * 1024 * 1024;

    /// <summary>
    /// Content types the picture bulk-upload accepts — the SAME allowlist
    /// LocalFileStorage sniffs for (JPEG / PNG / WebP). Declared here for
    /// the client-side pre-filter; the backend's magic-byte sniff remains
    /// the authority.
    /// </summary>
    private static readonly HashSet<string> AllowedPictureContentTypes = new(StringComparer.OrdinalIgnoreCase)
    {
        "image/jpeg",
        "image/png",
        "image/webp"
    };

    // ── Product CSV import state ───────────────────────────────────────────

    /// <summary>True while the product import command is in flight.</summary>
    private bool _isImportingProducts;

    /// <summary>Non-null when the product import failed before any row was processed (unreadable file, no data rows, dispatch failure).</summary>
    private string? _productImportError;

    /// <summary>Per-row product-import report (handler results + any local parse failures), in file order.</summary>
    private List<ProductImportRowResultDto>? _productImportRows;

    /// <summary>Tallies for the product import result badges.</summary>
    private int _productImportCreated;
    private int _productImportUpdated;
    private int _productImportFailed;

    // ── Bulk picture upload state ──────────────────────────────────────────

    /// <summary>One buffered picture awaiting the explicit Upload click.</summary>
    private sealed record PendingPicture(string FileName, string ContentType, byte[] Bytes);

    /// <summary>One rejected/failed picture from a batch, with a human-readable reason.</summary>
    private sealed record PictureUploadFailure(string FileName, string Message);

    /// <summary>Pictures selected but not yet uploaded (buffered immediately — the IBrowserFile streams die with the JS registry; same lesson as CreateProduct.razor).</summary>
    private List<PendingPicture> _pendingPictures = new();

    /// <summary>True while the batch is streaming to storage.</summary>
    private bool _isUploadingPictures;

    /// <summary>Pictures uploaded successfully in the last batch.</summary>
    private int _picturesUploaded;

    /// <summary>Progress counter during an upload (done / total).</summary>
    private int _pictureUploadDone;

    /// <summary>Per-file failures from the last batch (invalid content, oversize, storage error).</summary>
    private List<PictureUploadFailure> _pictureUploadFailures = new();

    // ── User CSV import state ───────────────────────────────────────────

    /// <summary>True while the user import command is in flight.</summary>
    private bool _isImportingUsers;

    /// <summary>Non-null when the user import failed before any row was processed.</summary>
    private string? _userImportError;

    /// <summary>Per-row user-import report (handler results + local parse failures), in file order.</summary>
    private List<UserImportRowResultDto>? _userImportRows;

    /// <summary>Tallies for the user import result badges.</summary>
    private int _userImportCreated;
    private int _userImportSkipped;
    private int _userImportFailed;

    /// <summary>
    /// Reads an InputFile's text content as UTF-8 (BOM-tolerant — the
    /// export's download helper prepends one; CsvParser strips it).
    /// Shared by both CSV import pickers.
    /// </summary>
    private static async Task<string> ReadTextFileAsync(IBrowserFile file, int maxBytes)
    {
        await using var stream = file.OpenReadStream(maxAllowedSize: maxBytes);
        using var reader = new System.IO.StreamReader(stream, System.Text.Encoding.UTF8);
        return await reader.ReadToEndAsync();
    }

    /// <summary>
    /// Product-CSV picker: parse + normalize the file, dispatch
    /// ImportProductsCommand, and merge the handler's per-row report
    /// with any local parse failures.
    ///
    /// COLUMN ORDER (positional — must mirror the AdminProducts export):
    /// Name, Category, SubCategory, SubSubCategory, Price, Currency,
    /// Stock, Status, Picture directory, Picture file name. The Status
    /// and Picture-directory columns are read but ignored (stock status
    /// is derived from stock; the URL is rebuilt from the file name).
    /// </summary>
    private async Task OnProductCsvSelectedAsync(InputFileChangeEventArgs e)
    {
        // Reset the previous run's UI state.
        _productImportError = null;
        _productImportRows = null;
        _productImportCreated = _productImportUpdated = _productImportFailed = 0;

        if (e.FileCount == 0)
        {
            return; // picker cancelled — keep the previous state
        }

        var file = e.File;
        var rows = new List<ProductImportRowDto>();
        var localFailures = new List<ProductImportRowResultDto>();

        try
        {
            var csv = await ReadTextFileAsync(file, MaxCsvFileSizeBytes);
            var records = CsvParser.Parse(csv);

            // Row 0 is the header; every record after it is a data row.
            if (records.Count < 2)
            {
                _productImportError = Loc["ImportErrorNoDataRows"];
                return;
            }

            for (var i = 1; i < records.Count; i++)
            {
                var fields = records[i];
                var rowNumber = i; // 1-based DATA-row number (header = 0)

                // Guard the positional contract: the export always writes
                // 10 columns; a short row means a broken/edited file — the
                // row is reported, not silently mis-mapped.
                if (fields.Length < 10)
                {
                    localFailures.Add(new ProductImportRowResultDto
                    {
                        RowNumber = rowNumber,
                        Name = fields.Length > 0 ? fields[0] : string.Empty,
                        Outcome = ProductImportRowOutcome.Failed,
                        Message = Loc["ImportErrorShortRow"]
                    });
                    continue;
                }

                if (!CsvParser.TryParseInvariantDecimal(fields[4], out var price)
                    || !CsvParser.TryParseInvariantInt(fields[6], out var stock))
                {
                    localFailures.Add(new ProductImportRowResultDto
                    {
                        RowNumber = rowNumber,
                        Name = fields[0],
                        Outcome = ProductImportRowOutcome.Failed,
                        Message = Loc["ImportErrorBadNumber"]
                    });
                    continue;
                }

                rows.Add(new ProductImportRowDto
                {
                    Name = fields[0],
                    CategoryName = fields[1],
                    SubCategoryName = fields[2],
                    SubSubCategoryName = fields[3],
                    PriceAmount = price,
                    Currency = fields[5],
                    StockQuantity = stock,
                    PictureFileName = fields[9],
                    RowNumber = rowNumber
                });
            }
        }
        catch (System.IO.IOException ex)
        {
            _productImportError = Loc["ImportErrorReadFailed", ex.Message];
            return;
        }

        // All rows failed local parsing — nothing to dispatch.
        if (rows.Count == 0)
        {
            _productImportRows = localFailures;
            _productImportFailed = localFailures.Count;
            return;
        }

        _isImportingProducts = true;
        try
        {
            var result = await MessageBus.InvokeAsync<Result<ProductImportResultDto>>(new ImportProductsCommand(rows));

            if (result.IsSuccess)
            {
                var report = result.Value;
                _productImportCreated = report.CreatedCount;
                _productImportUpdated = report.UpdatedCount;
                _productImportFailed = report.FailedCount + localFailures.Count;

                // Handler rows first (file order), then local failures —
                // both are already ordered by row number within themselves.
                _productImportRows = report.RowResults.Concat(localFailures).ToList();

                await Toast.Success(Loc["ProductImportDone", report.CreatedCount, report.UpdatedCount, report.FailedCount + localFailures.Count], summary: Loc["PageHeading"]);
            }
            else
            {
                _productImportError = result.Error;
            }
        }
        catch (Exception)
        {
            _productImportError = Loc["ImportErrorGeneric"];
        }
        finally
        {
            _isImportingProducts = false;
        }
    }

    /// <summary>
    /// Bulk-picture picker: buffer every selected image immediately (the
    /// IBrowserFile streams die with the JS registry — same lesson as
    /// CreateProduct.razor), pre-filter content type + size, and hand the
    /// batch to the explicit Upload button.
    /// </summary>
    private async Task OnPicturesSelectedAsync(InputFileChangeEventArgs e)
    {
        _pictureUploadFailures = new List<PictureUploadFailure>();
        _picturesUploaded = 0;
        _pictureUploadDone = 0;

        if (e.FileCount == 0)
        {
            return; // picker cancelled — keep the previous batch
        }

        var accepted = new List<PendingPicture>(e.FileCount);
        var rejected = new List<PictureUploadFailure>();

        foreach (var file in e.GetMultipleFiles(MaxPicturesPerBatch))
        {
            // ── Pre-filter: content type + size (client-side mirror of the
            //    backend's checks — the backend's magic-byte sniff stays
            //    the authority). Rejected files become per-file failure
            //    entries in the results list, not silent drops.
            if (!AllowedPictureContentTypes.Contains(file.ContentType))
            {
                rejected.Add(new PictureUploadFailure(file.Name, Loc["PictureUploadErrorType"]));
                continue;
            }

            if (file.Size > MaxPictureFileSizeBytes)
            {
                rejected.Add(new PictureUploadFailure(file.Name, Loc["PictureUploadErrorSize"]));
                continue;
            }

            try
            {
                await using var stream = file.OpenReadStream(maxAllowedSize: MaxPictureFileSizeBytes);
                using var ms = new System.IO.MemoryStream();
                await stream.CopyToAsync(ms);
                accepted.Add(new PendingPicture(file.Name, file.ContentType, ms.ToArray()));
            }
            catch (System.IO.IOException)
            {
                rejected.Add(new PictureUploadFailure(file.Name, Loc["PictureUploadErrorRead"]));
            }
        }

        _pendingPictures = accepted;

        if (rejected.Count > 0)
        {
            // Surface the pre-filter rejections in the results ledger
            // (same shape as upload failures — file name + reason).
            _pictureUploadFailures = rejected;
            await Toast.Warning(Loc["PictureUploadSomeRejected", rejected.Count], summary: Loc["PageHeading"]);
        }
    }

    /// <summary>
    /// Uploads the buffered batch: one SaveWithOriginalNameAsync per file
    /// (name-preserving — the restore contract), collecting per-file
    /// failures instead of aborting the batch.
    /// </summary>
    private async Task UploadPendingPicturesAsync()
    {
        if (_pendingPictures.Count == 0 || _isUploadingPictures)
        {
            return;
        }

        _isUploadingPictures = true;
        _picturesUploaded = 0;
        _pictureUploadDone = 0;
        var failures = new List<PictureUploadFailure>();

        try
        {
            var batch = _pendingPictures;
            foreach (var picture in batch)
            {
                try
                {
                    using var stream = new System.IO.MemoryStream(picture.Bytes, writable: false);
                    await FileStorage.SaveWithOriginalNameAsync(
                        stream, picture.FileName, picture.ContentType, CancellationToken.None);
                    _picturesUploaded++;
                }
                catch (System.IO.InvalidDataException ex)
                {
                    // Backend rejected the file (bad magic bytes, type
                    // mismatch, oversize, unusable name). The pre-filter
                    // already catches most of these — this is the
                    // server-side backstop.
                    failures.Add(new PictureUploadFailure(picture.FileName, ex.Message));
                }
                catch (Exception)
                {
                    // Storage I/O failure — also per-file, not fatal.
                    failures.Add(new PictureUploadFailure(picture.FileName, Loc["PictureUploadErrorStorage"]));
                }
                finally
                {
                    _pictureUploadDone++;
                    StateHasChanged(); // progress text updates per file
                }
            }

            _pictureUploadFailures = failures;
            _pendingPictures = new List<PendingPicture>();

            if (failures.Count == 0)
            {
                await Toast.Success(Loc["PictureUploadDone", _picturesUploaded], summary: Loc["PageHeading"]);
            }
            else
            {
                await Toast.Warning(Loc["PictureUploadDoneWithFailures", _picturesUploaded, failures.Count], summary: Loc["PageHeading"]);
            }
        }
        finally
        {
            _isUploadingPictures = false;
        }
    }

    /// <summary>
    /// Discards the buffered batch without uploading (the picker's Clear
    /// button).
    /// </summary>
    private void ClearPendingPictures()
    {
        _pendingPictures = new List<PendingPicture>();
        _pictureUploadFailures = new List<PictureUploadFailure>();
        _picturesUploaded = 0;
        _pictureUploadDone = 0;
    }

    /// <summary>
    /// Formats a byte count as a compact human size ("4.2 MB") — the
    /// pending-picture chips. Invariant digits: file sizes are data, not
    /// localized UI text.
    /// </summary>
    private static string FormatFileSize(long bytes)
    {
        string[] units = { "B", "KB", "MB", "GB" };
        var size = (double)bytes;
        var unit = 0;
        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }
        return $"{size:0.#} {units[unit]}";
    }

    /// <summary>
    /// User-CSV picker: parse + NORMALIZE the file (the export writes
    /// LOCALIZED gender and status labels — map them back to the neutral
    /// enum/bool here, where the localizer lives), dispatch
    /// ImportUsersCommand, and merge the handler's per-row report with
    /// local parse failures.
    ///
    /// COLUMN ORDER (positional — must mirror the manage-users export):
    /// Worker ID, Full name, Gender, Group, Roles (semicolon-joined),
    /// Status.
    /// </summary>
    private async Task OnUserCsvSelectedAsync(InputFileChangeEventArgs e)
    {
        // Reset the previous run's UI state.
        _userImportError = null;
        _userImportRows = null;
        _userImportCreated = _userImportSkipped = _userImportFailed = 0;

        if (e.FileCount == 0)
        {
            return;
        }

        var file = e.File;
        var rows = new List<UserImportRowDto>();
        var localFailures = new List<UserImportRowResultDto>();

        try
        {
            var csv = await ReadTextFileAsync(file, MaxCsvFileSizeBytes);
            var records = CsvParser.Parse(csv);

            if (records.Count < 2)
            {
                _userImportError = Loc["ImportErrorNoDataRows"];
                return;
            }

            for (var i = 1; i < records.Count; i++)
            {
                var fields = records[i];
                var rowNumber = i;

                if (fields.Length < 6)
                {
                    localFailures.Add(new UserImportRowResultDto
                    {
                        RowNumber = rowNumber,
                        WorkerId = fields.Length > 0 ? fields[0] : string.Empty,
                        Outcome = UserImportRowOutcome.Failed,
                        Message = Loc["ImportErrorShortRow"]
                    });
                    continue;
                }

                // ── Normalize the LOCALIZED cells (gender + status) into
                //    neutral values. Accepts the canonical English keys,
                //    the CURRENT culture's labels, and the known fa-IR
                //    labels — covering same-deployment round-trips and
                //    cross-culture imports alike.
                if (!TryNormalizeGender(fields[2], out var gender))
                {
                    localFailures.Add(new UserImportRowResultDto
                    {
                        RowNumber = rowNumber,
                        WorkerId = fields[0],
                        Outcome = UserImportRowOutcome.Failed,
                        Message = Loc["ImportErrorBadGender"]
                    });
                    continue;
                }

                // Status: empty cell defaults to Active (an export always
                // writes it, but hand-made files may not).
                var isActive = NormalizeStatus(fields[5]);

                // Roles: semicolon-joined inside one cell ("Employee;
                // Customer") → trimmed, non-empty list.
                var roles = fields[4]
                    .Split(';', System.StringSplitOptions.TrimEntries | System.StringSplitOptions.RemoveEmptyEntries)
                    .ToList();

                rows.Add(new UserImportRowDto
                {
                    WorkerId = fields[0],
                    FullName = fields[1],
                    Gender = gender,
                    GroupName = fields[3],
                    Roles = roles,
                    IsActive = isActive,
                    RowNumber = rowNumber
                });
            }
        }
        catch (System.IO.IOException ex)
        {
            _userImportError = Loc["ImportErrorReadFailed", ex.Message];
            return;
        }

        if (rows.Count == 0)
        {
            _userImportRows = localFailures;
            _userImportFailed = localFailures.Count;
            return;
        }

        _isImportingUsers = true;
        try
        {
            var result = await MessageBus.InvokeAsync<Result<UserImportResultDto>>(new ImportUsersCommand(rows));

            if (result.IsSuccess)
            {
                var report = result.Value;
                _userImportCreated = report.CreatedCount;
                _userImportSkipped = report.SkippedCount;
                _userImportFailed = report.FailedCount + localFailures.Count;

                _userImportRows = report.RowResults.Concat(localFailures).ToList();

                await Toast.Success(Loc["UserImportDone", report.CreatedCount, report.SkippedCount, report.FailedCount + localFailures.Count], summary: Loc["PageHeading"]);
            }
            else
            {
                _userImportError = result.Error;
            }
        }
        catch (Exception)
        {
            _userImportError = Loc["ImportErrorGeneric"];
        }
        finally
        {
            _isImportingUsers = false;
        }
    }

    /// <summary>
    /// Maps a CSV gender cell back to the Gender enum. Accepts the
    /// canonical English keys ("Male"/"Female"), the current culture's
    /// localized labels (via the localizer — the common same-deployment
    /// round-trip), and the known fa-IR label values (so an fa-IR export
    /// imports cleanly even under an en-US UI). Values must stay in sync
    /// with AdminUsers.en-US.resx / AdminUsers.fa-IR.resx
    /// (GenderMale/GenderFemale).
    /// </summary>
    private bool TryNormalizeGender(string cell, out Gender gender)
    {
        var value = cell?.Trim() ?? string.Empty;

        if (string.Equals(value, "Male", StringComparison.OrdinalIgnoreCase)
            || string.Equals(value, Loc["GenderMale"], StringComparison.Ordinal)
            || value == "مرد")
        {
            gender = Gender.Male;
            return true;
        }

        if (string.Equals(value, "Female", StringComparison.OrdinalIgnoreCase)
            || string.Equals(value, Loc["GenderFemale"], StringComparison.Ordinal)
            || value == "زن")
        {
            gender = Gender.Female;
            return true;
        }

        gender = Gender.Male;
        return false;
    }

    /// <summary>
    /// Maps a CSV status cell to the active flag. Active/فعال (either
    /// case) → true; Inactive/غیرفعال → false; anything else (including
    /// empty) → true (new accounts default to active). Values in sync with
    /// AdminUsers.resx (StatusActive/StatusInactive).
    /// </summary>
    private static bool NormalizeStatus(string cell)
    {
        var value = cell?.Trim() ?? string.Empty;

        if (string.Equals(value, "Inactive", StringComparison.OrdinalIgnoreCase) || value == "غیرفعال")
        {
            return false;
        }

        return true;
    }

}