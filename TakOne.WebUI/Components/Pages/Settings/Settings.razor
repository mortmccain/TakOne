<PageTitle>@Loc["PageTitle"]</PageTitle>

<HeadContent>
    <style>
            /* Layout — 12-col grid on desktop/tablet, stacks on mobile.
                                       Same shape as UserDetail.razor. */
            .settings-grid {
                display: grid;
                grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
                gap: 1.5rem;
                align-items: start;
            }

            @@media (max-width: 992px) {
                .settings-grid {
                    grid-template-columns: 1fr;
                    gap: 1rem;
                }
            }

            /* Page header — title + subtitle. */
            .settings-header {
                display: flex;
                align-items: center;
                gap: 0.75rem;
                margin-bottom: 0.5rem;
            }

                .settings-header .settings-title {
                    font-size: 1.6rem;
                    font-weight: 700;
                    margin: 0;
                    line-height: 1.2;
                }

            .settings-subtitle {
                color: var(--rz-text-secondary-color);
                margin: 0 0 1rem 0;
                font-size: 0.9rem;
            }

            /* Account profile grid — 2-col label/value layout. Mirrors
                                       UserDetail.razor's .profile-grid so the two pages feel
                                       visually consistent. */
            .profile-grid {
                display: grid;
                grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
                gap: 0.75rem 1.5rem;
                align-items: baseline;
            }

            @@media (max-width: 540px) {
                .profile-grid {
                    grid-template-columns: 1fr;
                    gap: 0.25rem 0;
                }
            }

            .profile-label {
                color: var(--rz-text-secondary-color);
                font-size: 0.8125rem;
                font-weight: 500;
            }

            .profile-value {
                color: var(--rz-text-color);
                font-size: 0.9375rem;
                word-break: break-word;
            }

            .profile-value-mono {
                font-family: var(--rz-monospace-font-family, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);
            }

            .profile-value-muted {
                color: var(--rz-text-secondary-color);
                font-style: italic;
            }

            /* Section card — title bar with icon. */
            .section-title {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                font-weight: 600;
                margin-bottom: 0.75rem;
            }

            /* Theme selector — responsive auto-fill grid of card buttons.
                                       Mirrors CreateUser.razor's .usertype-toggle pattern exactly:
                                       each theme is a RadzenCard with the .usertype-option class;
                                       the selected theme's card additionally gets .is-selected.
                                       Selected = primary-tinted background + solid primary border.
                                       Unselected = outlined with the neutral border color.

                                       The grid uses auto-fill + minmax(170px, 1fr) so the cards
                                       wrap onto as many rows as needed. With 12 themes total
                                       (2 Tak + 10 Radzen built-in), this gives 4-6 columns on
                                       desktop, 2-3 on tablet, 1 on mobile — no overflow, no
                                       squashed cards. Each card has the theme's display name +
                                       a small sun/moon icon to hint at light vs dark. */
            .theme-toggle {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
                gap: 0.75rem;
            }

            /* Category header — small all-caps label above each theme
                                       group ("Tak themes", "Radzen themes"). Visually groups the
                                       2 custom Tak themes apart from the 10 built-in Radzen ones
                                       so the user understands which is which at a glance. */
            .theme-category-header {
                font-size: 0.75rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.04em;
                color: var(--rz-text-secondary-color);
                margin: 0.5rem 0 0.25rem 0;
            }

            /* .usertype-option is reused from CreateUser.razor. Re-declared
                                       here so this page is self-contained (CreateUser's CSS lives
                                       inside that page's scoped style block, not globally). */
            .usertype-option {
                transition: background-color 0.15s ease, border-color 0.15s ease;
            }

                .usertype-option.is-selected {
                    background-color: var(--rz-primary-lighter, rgba(var(--rz-primary-rgb, 67, 56, 202), 0.08));
                    border-color: var(--rz-primary) !important;
                }

            /* Theme card body — icon + name + hint stacked. */
            .theme-card-body {
                display: flex;
                flex-direction: column;
                gap: 0.35rem;
                text-align: center;
            }

            .theme-card-name {
                font-weight: 600;
                margin: 0;
            }

            .theme-card-hint {
                color: var(--rz-text-secondary-color);
                font-size: 0.75rem;
                margin: 0;
            }

            /* Action row — the "Change password" button + spacer. */
            .action-row {
                display: flex;
                gap: 0.75rem;
                flex-wrap: wrap;
                margin-top: 0.75rem;
            }

            /* ── Notification preferences card (Round 3) ─────────────
               One row per NotificationKind: leading icon in a tinted
               squircle (same visual family as the Notifications page's
               .notif-icon), kind label + short description, and a
               RadzenSwitch on the trailing edge. Rows separate with a
               hairline so the list reads as a table without being one. */
            .notif-prefs-list {
                display: flex;
                flex-direction: column;
                margin-top: 0.75rem;
            }

            .notif-pref-row {
                display: flex;
                align-items: center;
                gap: 0.85rem;
                padding: 0.6rem 0.25rem;
                border-bottom: 1px solid var(--rz-border-color);
            }

            .notif-pref-row:last-child {
                border-bottom: none;
            }

            .notif-pref-icon {
                display: flex;
                align-items: center;
                justify-content: center;
                width: 2.35rem;
                height: 2.35rem;
                border-radius: 10px;
                flex: none;
                background: var(--rz-secondary-background-color, var(--rz-base-background-color));
                color: var(--rz-primary);
            }

            .notif-pref-text {
                flex: 1;
                min-width: 0;
            }

            .notif-pref-name {
                font-weight: 600;
                font-size: 0.9rem;
            }

            .notif-pref-desc {
                color: var(--rz-text-secondary-color);
                font-size: 0.75rem;
                line-height: 1.35;
            }

            .notif-pref-hint {
                margin-top: 0.6rem;
                color: var(--rz-text-secondary-color);
                font-size: 0.78rem;
                line-height: 1.5;
            }

            /* Loading + error + not-found states reuse Radzen's alert
                                       components — same pattern as ProductDetail.razor. */

            /* ── Admin tools section ────────────────────────────────
               Full-width section below the 2-col settings grid. One
               card per bulk tool; the cards wrap on a responsive
               auto-fill grid (3-up on desktop, 1-up on mobile). */
            .admin-tools-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
                gap: 1rem;
                align-items: start;
            }

            /* Section heading for the admin area — same visual family
               as .settings-header but smaller. */
            .admin-section-title {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                font-size: 1.15rem;
                font-weight: 700;
                margin: 0 0 0.25rem 0;
            }

            .admin-section-subtitle {
                color: var(--rz-text-secondary-color);
                font-size: 0.85rem;
                margin: 0 0 0.75rem 0;
            }

            /* Dropzone-style file pickers — visually consistent with
               CreateProduct.razor's .picture-dropzone (re-declared here
               because that page's styles are scoped to its own file). */
            .import-dropzone {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                gap: 0.35rem;
                padding: 1.25rem 1rem;
                border: 2px dashed var(--rz-border-color);
                border-radius: 10px;
                cursor: pointer;
                text-align: center;
                transition: border-color 0.15s ease, background-color 0.15s ease;
            }

            .import-dropzone:hover,
            .import-dropzone:focus-within {
                border-color: var(--rz-primary);
                background: var(--rz-primary-lighter, rgba(var(--rz-primary-rgb, 67, 56, 202), 0.06));
            }

            .import-dropzone-input {
                position: absolute;
                width: 1px;
                height: 1px;
                opacity: 0;
                overflow: hidden;
                clip: rect(0 0 0 0);
            }

            .import-dropzone-title {
                font-weight: 600;
                font-size: 0.9rem;
            }

            .import-dropzone-hint {
                color: var(--rz-text-secondary-color);
                font-size: 0.78rem;
                line-height: 1.4;
            }

            /* Selected-file chips (bulk picture picker shows one chip per
               buffered image). */
            .import-file-list {
                display: flex;
                flex-direction: column;
                gap: 0.35rem;
                margin-top: 0.6rem;
                /* Long lists scroll INSIDE the card instead of stretching
                   the page — same policy as the notification list. */
                max-height: 15rem;
                overflow-y: auto;
            }

            .import-file-chip {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                padding: 0.35rem 0.6rem;
                border: 1px solid var(--rz-border-color);
                border-radius: 8px;
                font-size: 0.8rem;
                background: var(--rz-secondary-background-color, var(--rz-base-background-color));
            }

            .import-file-chip .import-file-name {
                flex: 1;
                min-width: 0;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
                direction: ltr; /* hex file names stay LTR even in fa-IR/RTL */
            }

            .import-file-chip .import-file-size {
                color: var(--rz-text-secondary-color);
                font-size: 0.72rem;
                flex: none;
            }

            /* Per-row import results — a compact scrollable ledger. */
            .import-results {
                margin-top: 0.75rem;
            }

            .import-results-summary {
                display: flex;
                flex-wrap: wrap;
                gap: 0.5rem;
                margin-bottom: 0.5rem;
            }

            .import-results-list {
                display: flex;
                flex-direction: column;
                gap: 0.3rem;
                max-height: 15rem;
                overflow-y: auto;
                font-size: 0.8rem;
            }

            .import-result-row {
                display: flex;
                align-items: baseline;
                gap: 0.5rem;
                padding: 0.3rem 0.45rem;
                border-bottom: 1px solid var(--rz-border-color);
            }

            .import-result-row:last-child {
                border-bottom: none;
            }

            .import-result-line {
                color: var(--rz-text-secondary-color);
                font-family: var(--rz-monospace-font-family, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);
                font-size: 0.72rem;
                flex: none;
                direction: ltr;
            }

            .import-result-name {
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
                min-width: 0;
            }

            .import-result-msg {
                color: var(--rz-danger, #dc3545);
                font-size: 0.74rem;
                overflow-wrap: anywhere;
            }

            /* ── Admin tools polish (template/report downloads, steps) ── */

            /* Numbered step badge on each admin card title — gives the
               three tools a stable 1-2-3 order so the intended workflow
               (upload pictures → import products / import users) reads
               at a glance. Primary-filled circle, contrast text. */
            .admin-step-badge {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 1.5rem;
                height: 1.5rem;
                border-radius: 50%;
                background: var(--rz-primary);
                color: var(--rz-primary-contrast-color, #fff);
                font-size: 0.78rem;
                font-weight: 700;
                flex: none;
                direction: ltr; /* digits stay LTR in fa-IR/RTL */
            }

            /* Inline text-style action (template + report downloads).
               Rendered as a small primary-colored link-button so it reads
               as a secondary affordance next to the primary Upload/Import
               actions — NOT another filled button competing for attention. */
            .admin-inline-action {
                display: inline-flex;
                align-items: center;
                gap: 0.35rem;
                padding: 0.25rem 0.1rem;
                margin-top: 0.35rem;
                border: none;
                background: none;
                color: var(--rz-primary);
                font-size: 0.82rem;
                font-weight: 500;
                cursor: pointer;
                border-radius: 6px;
                transition: color 0.15s ease;
            }

                .admin-inline-action:hover {
                    color: var(--rz-primary-dark, var(--rz-primary));
                    text-decoration: underline;
                    text-underline-offset: 3px;
                }

                .admin-inline-action:focus-visible {
                    outline: 2px solid var(--rz-primary);
                    outline-offset: 2px;
                }

                .admin-inline-action[disabled] {
                    color: var(--rz-text-disabled-color, var(--rz-text-secondary-color));
                    cursor: not-allowed;
                    text-decoration: none;
                }

            /* Dropzone icon — the cloud_upload glyph inside a soft primary
               circle (same visual family as .notif-pref-icon). Gives the
               dropzone a proper visual anchor instead of a bare glyph. */
            .import-dropzone-icon {
                display: flex;
                align-items: center;
                justify-content: center;
                width: 2.75rem;
                height: 2.75rem;
                border-radius: 50%;
                background: var(--rz-primary-lighter, rgba(var(--rz-primary-rgb, 67, 56, 202), 0.1));
                color: var(--rz-primary);
                transition: transform 0.15s ease;
            }

            /* Dropzone affordance: gentle lift on hover, press-down on
               click — the standard "this whole thing is clickable" cues. */
            .import-dropzone:hover .import-dropzone-icon {
                transform: translateY(-2px) scale(1.05);
            }

            .import-dropzone:active {
                transform: translateY(1px);
            }

            /* Focus ring for keyboard users tabbing into the picker. */
            .import-dropzone:focus-within {
                box-shadow: 0 0 0 3px var(--rz-primary-lighter, rgba(var(--rz-primary-rgb, 67, 56, 202), 0.25));
            }

            /* Thin themed scrollbars for the two scrollable ledgers (pending
               files + per-row results) — the default browser scrollbar is
               visually heavy inside the compact cards. Firefox + WebKit. */
            .import-file-list,
            .import-results-list {
                scrollbar-width: thin;
                scrollbar-color: var(--rz-border-color) transparent;
                padding-inline-end: 0.25rem;
            }

                .import-file-list::-webkit-scrollbar,
                .import-results-list::-webkit-scrollbar {
                    width: 8px;
                }

                .import-file-list::-webkit-scrollbar-thumb,
                .import-results-list::-webkit-scrollbar-thumb {
                    background: var(--rz-border-color);
                    border-radius: 4px;
                }

                    .import-file-list::-webkit-scrollbar-thumb:hover,
                    .import-results-list::-webkit-scrollbar-thumb:hover {
                        background: var(--rz-text-secondary-color);
                    }

                .import-file-list::-webkit-scrollbar-track,
                .import-results-list::-webkit-scrollbar-track {
                    background: transparent;
                }

            /* Pending-file chip: per-file remove button (✕) — lets the
               admin drop a wrongly-picked file without clearing the whole
               selection. Bare icon button; danger-tinted on hover. */
            .import-file-remove {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 1.4rem;
                height: 1.4rem;
                margin-inline-start: auto;
                border: none;
                border-radius: 50%;
                background: transparent;
                color: var(--rz-text-secondary-color);
                cursor: pointer;
                flex: none;
                transition: background-color 0.15s ease, color 0.15s ease;
            }

                .import-file-remove:hover {
                    background: var(--rz-danger-light, rgba(220, 53, 69, 0.12));
                    color: var(--rz-danger, #dc3545);
                }

                .import-file-remove:focus-visible {
                    outline: 2px solid var(--rz-danger, #dc3545);
                    outline-offset: 1px;
                }

            /* Per-row result rows: hover highlight so the eye can track a
               row across the ledger's full width while auditing failures. */
            .import-result-row {
                border-radius: 6px;
                transition: background-color 0.1s ease;
            }

                .import-result-row:hover {
                    background: var(--rz-secondary-background-color, var(--rz-base-background-color));
                }

            /* Info callout — the default-password formula notice on the
               user-import card. Primary-tinted panel with a key icon; the
               formula example renders as LTR monospace (it's literal
               password text, never localized). */
            .admin-info-callout {
                display: flex;
                align-items: flex-start;
                gap: 0.6rem;
                padding: 0.6rem 0.75rem;
                margin: 0.25rem 0 0.75rem 0;
                border-radius: 8px;
                background: var(--rz-primary-lighter, rgba(var(--rz-primary-rgb, 67, 56, 202), 0.08));
                border: 1px solid var(--rz-primary-lighter, rgba(var(--rz-primary-rgb, 67, 56, 202), 0.2));
                font-size: 0.8rem;
                line-height: 1.45;
            }

                .admin-info-callout .admin-info-icon {
                    color: var(--rz-primary);
                    flex: none;
                    font-size: 1.1rem;
                }

                .admin-info-callout .admin-info-body {
                    min-width: 0;
                }

                .admin-info-callout .admin-info-code {
                    display: inline-block;
                    margin-top: 0.2rem;
                    padding: 0.15rem 0.45rem;
                    border-radius: 6px;
                    background: var(--rz-secondary-background-color, var(--rz-base-background-color));
                    font-family: var(--rz-monospace-font-family, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);
                    font-size: 0.78rem;
                    direction: ltr; /* the formula + example are literal LTR text */
                    unicode-bidi: embed;
                }

            /* ── Backup status card ─────────────────────────────────
               2×2 health-stat grid (last run / next slot / retention /
               files): muted small-caps-ish label on top, strong value
               below, optional sub-line (duration, schedule note) and an
               outcome badge. Collapses to a single column on narrow
               cards (the admin-tools grid reflows at 300px). */
            .backup-stats-grid {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 0.75rem 1rem;
                margin-bottom: 0.75rem;
            }

            @@media (max-width: 420px) {
                .backup-stats-grid {
                    grid-template-columns: 1fr;
                }
            }

            .backup-stat {
                display: flex;
                flex-direction: column;
                align-items: flex-start;
                gap: 0.15rem;
                min-width: 0;
            }

            .backup-stat-label {
                font-size: 0.7rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                color: var(--rz-text-secondary-color);
            }

            .backup-stat-value {
                font-size: 0.92rem;
                font-weight: 600;
                color: var(--rz-text-color);
                line-height: 1.35;
                overflow-wrap: anywhere;
            }

            .backup-stat-sub {
                font-size: 0.74rem;
                color: var(--rz-text-secondary-color);
                font-weight: 400;
            }

            /* Stored-files ledger — one row per *.bak: save icon, mono
               LTR file name (flexes + ellipsizes), size, Tehran time.
               Same scroll policy + thin themed scrollbar as the import
               ledgers; capped at 14 files by the retention sweep. */
            .backup-file-list {
                display: flex;
                flex-direction: column;
                gap: 0.3rem;
                max-height: 14rem;
                overflow-y: auto;
                margin-top: 0.5rem;
                padding-inline-end: 0.25rem;
                scrollbar-width: thin;
                scrollbar-color: var(--rz-border-color) transparent;
            }

                .backup-file-list::-webkit-scrollbar {
                    width: 8px;
                }

                .backup-file-list::-webkit-scrollbar-thumb {
                    background: var(--rz-border-color);
                    border-radius: 4px;
                }

                    .backup-file-list::-webkit-scrollbar-thumb:hover {
                        background: var(--rz-text-secondary-color);
                    }

                .backup-file-list::-webkit-scrollbar-track {
                    background: transparent;
                }

            .backup-file-row {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                padding: 0.3rem 0.45rem;
                border: 1px solid var(--rz-border-color);
                border-radius: 8px;
                font-size: 0.78rem;
                background: var(--rz-secondary-background-color, var(--rz-base-background-color));
                transition: background-color 0.1s ease;
            }

                .backup-file-row:hover {
                    background: var(--rz-primary-lighter, rgba(var(--rz-primary-rgb, 67, 56, 202), 0.06));
                }

            .backup-file-name {
                flex: 1;
                min-width: 0;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
                font-family: var(--rz-monospace-font-family, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);
                font-size: 0.74rem;
                direction: ltr; /* file names are literal LTR text */
                unicode-bidi: embed;
            }

            .backup-file-size {
                color: var(--rz-text-secondary-color);
                font-size: 0.72rem;
                flex: none;
            }

            .backup-file-date {
                color: var(--rz-text-secondary-color);
                font-size: 0.72rem;
                flex: none;
            }

            /* ── Run-history ledger ─────────────────────────────────
               One row per COMPLETED run (newest first): trigger icon
               (clock = scheduled slot, hand = manual "Back up now"),
               Tehran start time + duration, outcome badge, and — when
               the run failed — the error short-form (full message in
               the native tooltip via the title attribute). Shares the
               stored-files ledger's scroll policy + thin themed
               scrollbar; bounded by the retention window. */
            .backup-run-list {
                display: flex;
                flex-direction: column;
                gap: 0.3rem;
                max-height: 11rem;
                overflow-y: auto;
                margin-top: 0.5rem;
                padding-inline-end: 0.25rem;
                scrollbar-width: thin;
                scrollbar-color: var(--rz-border-color) transparent;
            }

                .backup-run-list::-webkit-scrollbar {
                    width: 8px;
                }

                .backup-run-list::-webkit-scrollbar-thumb {
                    background: var(--rz-border-color);
                    border-radius: 4px;
                }

                    .backup-run-list::-webkit-scrollbar-thumb:hover {
                        background: var(--rz-text-secondary-color);
                    }

                .backup-run-list::-webkit-scrollbar-track {
                    background: transparent;
                }

            .backup-run-row {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                padding: 0.3rem 0.45rem;
                border: 1px solid var(--rz-border-color);
                border-radius: 8px;
                font-size: 0.78rem;
                background: var(--rz-secondary-background-color, var(--rz-base-background-color));
                transition: background-color 0.1s ease, border-color 0.15s ease;
                flex-wrap: wrap; /* narrow admin-tools cards wrap instead of overflowing */
            }

                .backup-run-row:hover {
                    background: var(--rz-primary-lighter, rgba(var(--rz-primary-rgb, 67, 56, 202), 0.06));
                }

                /* Failed runs keep a danger border + a faint danger tint
                   so a bad slot is findable while scrolling without
                   reading badges. */
                .backup-run-row.backup-run-failed {
                    border-color: var(--rz-danger-color, #f44336);
                    background: color-mix(in srgb, var(--rz-danger-color, #f44336) 5%, var(--rz-secondary-background-color, var(--rz-base-background-color)));
                }

                    .backup-run-row.backup-run-failed:hover {
                        background: color-mix(in srgb, var(--rz-danger-color, #f44336) 10%, var(--rz-secondary-background-color, var(--rz-base-background-color)));
                    }

            .backup-run-icon {
                font-size: 1rem;
                flex: none;
            }

                .backup-run-icon.backup-run-icon-manual {
                    color: var(--rz-primary);
                }

                .backup-run-icon.backup-run-icon-scheduled {
                    color: var(--rz-text-secondary-color);
                }

            .backup-run-time {
                flex: none;
                font-weight: 600;
                white-space: nowrap;
            }

            .backup-run-duration {
                color: var(--rz-text-secondary-color);
                font-size: 0.72rem;
                flex: none;
                white-space: nowrap;
            }

            .backup-run-name {
                flex: 1;
                min-width: 4rem; /* keeps at least a stub of the name visible when wrapped on narrow cards */
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
                font-family: var(--rz-monospace-font-family, ui-monospace, SFMono-Regular, Menlo, Consolas, monospace);
                font-size: 0.72rem;
                color: var(--rz-text-secondary-color);
                direction: ltr; /* file names are literal LTR text */
                unicode-bidi: embed;
            }

            .backup-run-name:empty {
                display: none; /* failed runs have no file — no empty flex stub */
            }

            /* Fallback-annotation line (default-backup-directory runs —
               see DatabaseBackupHostedService): a full-width secondary
               line UNDER the row's main content. Engine strings are
               English with embedded LTR paths, so the line renders LTR
               (like the mono file names) while the page stays RTL. */
            .backup-run-note {
                flex-basis: 100%;
                margin-top: 0.15rem;
                font-size: 0.72rem;
                line-height: 1.4;
                color: var(--rz-text-secondary-color);
                direction: ltr;
                unicode-bidi: embed;
                text-align: left;
                overflow-wrap: anywhere; /* long server paths must wrap, not overflow the card */
            }

            .backup-run-section-label {
                font-size: 0.7rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                color: var(--rz-text-secondary-color);
                margin-top: 0.75rem;
                display: block;
            }
    </style>
</HeadContent>

<RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
    @* ── Page header ── *@
    <div>
        <div class="settings-header">
            <RadzenIcon Icon="settings" Style="font-size: 1.75rem; color: var(--rz-primary);" />
            <h1 class="settings-title">@Loc["PageHeading"]</h1>
        </div>
        <p class="settings-subtitle">@Loc["PageSubheading"]</p>
    </div>

    @* ── Loading state ── *@
    @if (_isLoading)
    {
        <RadzenCard>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Medium" />
                <RadzenText Text="@Loc["Loading"]" TextStyle="TextStyle.Body1" />
            </RadzenStack>
        </RadzenCard>
    }

    @* ── Error state ── *@
    else if (_loadError is not null)
    {
        <RadzenAlert Title="@Loc["ErrorTitle"]"
                     Text="@_loadError"
                     AlertStyle="AlertStyle.Danger"
                     Variant="Variant.Filled"
                     ShowIcon="true" />
    }

    @* ── Main content ── *@
    else if (_user is not null)
    {
        <div class="settings-grid">
            @* LEFT — account + appearance cards *@
            <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
                @* ── Account card — read-only identity fields ── *@
                <RadzenCard Variant="Variant.Filled" Style="padding: 1.5rem;">
                    <div class="section-title">
                        <RadzenIcon Icon="person" Style="color: var(--rz-primary);" />
                        <span>@Loc["AccountCardTitle"]</span>
                    </div>

                    <div class="profile-grid">
                        <div class="profile-label">@Loc["ColWorkerId"]</div>
                        <div class="profile-value profile-value-mono">@(CultureFormat.FormatDigits(_user.WorkerId))</div>

                        <div class="profile-label">@Loc["ColFullName"]</div>
                        <div class="profile-value">@_user.FullName</div>

                        <div class="profile-label">@Loc["ColGender"]</div>
                        <div class="profile-value">@GetGenderLabel(_user.Gender)</div>

                        @if (!string.IsNullOrWhiteSpace(_user.Email))
                        {
                            <div class="profile-label">@Loc["ColEmail"]</div>
                            <div class="profile-value profile-value-mono">@_user.Email</div>
                        }

                        <div class="profile-label">@Loc["ColStatus"]</div>
                        <div class="profile-value">
                            @if (_user.IsActive)
                            {
                                <RadzenBadge Text="@Loc["StatusActive"]" BadgeStyle="BadgeStyle.Success" IsPill="true" />
                            }
                            else
                            {
                                <RadzenBadge Text="@Loc["StatusInactive"]" BadgeStyle="BadgeStyle.Light" IsPill="true" />
                            }
                        </div>
                    </div>

                    @* Change password button — links out to /Account/ChangePassword.
                       That page is a STATIC SSR page (not interactive) because it
                       has to re-issue the auth cookie on the same HTTP response.
                       We can't inline its form here. forceLoad:true is REQUIRED —
                       navigating from an interactive circuit to a static SSR page
                       without a full HTTP reload leaves the circuit alive and the
                       static page never renders. *@
                    <div class="action-row">
                        <RadzenButton Text="@Loc["ChangePassword"]"
                                      Icon="lock_reset"
                                      ButtonStyle="ButtonStyle.Primary"
                                      Variant="Variant.Filled"
                                      Click="@(() => Navigation.NavigateTo("/Account/ChangePassword", forceLoad: true))" />
                    </div>
                </RadzenCard>

                @* ── Appearance card — theme selector ──
                   Renders one RadzenCard per available theme, styled exactly
                   like the gender buttons in CreateUser.razor (same .usertype-option
                   class + .is-selected modifier). Only the active theme's card
                   has .is-selected, so only one card shows the primary-tinted
                   background + solid primary border at a time. Clicking a card
                   calls window.takTheme.set(themeName) via JS interop and
                   updates _currentTheme to re-render the list.

                   The themes are grouped into two categories, each rendered
                   under a small all-caps header so the user can tell the
                   custom Tak themes apart from the built-in Radzen ones:
                     1. "Tak themes"        — tak-light, tak-dark
                     2. "Radzen themes"    — default, dark, standard, …
                   Both groups share the SAME .theme-toggle grid + .usertype-option
                   card style — the grouping is purely visual. *@
                <RadzenCard Variant="Variant.Filled" Style="padding: 1.5rem;">
                    <div class="section-title">
                        <RadzenIcon Icon="palette" Style="color: var(--rz-primary);" />
                        <span>@Loc["AppearanceCardTitle"]</span>
                    </div>

                    <RadzenText TextStyle="TextStyle.Body2"
                                Style="color: var(--rz-text-secondary-color); display: block; margin-bottom: 0.75rem;">
                        @Loc["ThemeHint"]
                    </RadzenText>

                    @* Render each category group with its own header. We
                       iterate over _themeCategories so the order + grouping
                       is data-driven (not hard-coded in markup). Adding a
                       new category only requires editing _availableThemes +
                       _themeCategories — the markup stays the same. *@
                    @foreach (var category in _themeCategories)
                    {
                        <p class="theme-category-header">@GetCategoryHeader(category)</p>
                        <div class="theme-toggle">
                            @foreach (var theme in _availableThemes.Where(t => t.Category == category.Id))
                            {
                                var themeId = theme.Id; // closure capture for the lambda
                                var isSelected = _currentTheme == themeId;
                                <RadzenCard Variant="@(isSelected ? Variant.Filled : Variant.Outlined)"
                                            Class="@GetToggleClass(isSelected)"
                                            Style="@GetToggleBorderStyle(isSelected)"
                                            @onclick="@(() => HandleSelectThemeAsync(themeId))">
                                    <div class="theme-card-body">
                                        <RadzenIcon Icon="@theme.Icon"
                                                    Style="@GetToggleIconStyle(isSelected)" />
                                        <RadzenText Text="@GetThemeName(themeId)"
                                                    TextStyle="TextStyle.Subtitle1"
                                                    Style="@GetToggleTextStyle(isSelected)" />
                                        <RadzenText Text="@GetThemeHint(themeId)"
                                                    TextStyle="TextStyle.Caption"
                                                    Style="color: var(--rz-text-secondary-color); margin: 0;" />
                                    </div>
                                </RadzenCard>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(_themeToast))
                    {
                        <RadzenText TextStyle="TextStyle.Caption"
                                    Style="color: var(--rz-success, #16a34a); display: block; margin-top: 0.5rem;">
                            @_themeToast
                        </RadzenText>
                    }
                </RadzenCard>
            </RadzenStack>

            @* RIGHT — notification preferences card (Round 3 feature:
               per-user, per-kind mute flags enforced at notification
               creation time), then help / about cards. *@
            <RadzenStack Orientation="Orientation.Vertical" Gap="1rem">
                <RadzenCard Variant="Variant.Outlined" Style="padding: 1.25rem;">
                    <div class="section-title">
                        <RadzenIcon Icon="notifications" Style="color: var(--rz-primary);" />
                        <span>@Loc["NotifPrefsCardTitle"]</span>
                    </div>
                    @if (_prefsLoadError is not null)
                    {
                        <RadzenAlert Title="@Loc["ErrorTitle"]"
                                     Text="@_prefsLoadError"
                                     AlertStyle="AlertStyle.Danger"
                                     Variant="Variant.Filled"
                                     ShowIcon="true"
                                     Style="margin-top: 0.75rem;" />
                    }
                    else if (_notificationPreferences is null)
                    {
                        <div class="tm-skel-stack" aria-busy="true" aria-live="polite" style="margin-top: 0.75rem;">
                            @for (var i = 0; i < 4; i++)
                            {
                                <div class="tm-skel-row">
                                    <div class="tm-skel tm-skel--thumb"></div>
                                    <div class="tm-skel-stack" style="gap:.4rem; flex:1;">
                                        <div class="tm-skel tm-skel--line"></div>
                                        <div class="tm-skel tm-skel--line tm-skel--w60"></div>
                                    </div>
                                    <div class="tm-skel tm-skel--chip"></div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="notif-prefs-list">
                            @foreach (var pref in _notificationPreferences)
                            {
                                <div class="notif-pref-row">
                                    <div class="notif-pref-icon">
                                        <RadzenIcon Icon="@GetNotifPrefIcon(pref.Kind)" />
                                    </div>
                                    <div class="notif-pref-text">
                                        <div class="notif-pref-name">@GetNotifPrefName(pref.Kind)</div>
                                        <div class="notif-pref-desc">@GetNotifPrefDesc(pref.Kind)</div>
                                    </div>
                                    <RadzenSwitch TValue="bool"
                                                  Value="@(!pref.IsMuted)"
                                                  Disabled="@_isSavingPref"
                                                  Name="@($"pref-switch-{(int)pref.Kind}")"
                                                  Change="@(async enabled => await HandleNotifPrefToggleAsync(pref.Kind, !enabled))" />
                                </div>
                            }
                        </div>
                        <p class="notif-pref-hint">@Loc["NotifPrefsHint"]</p>
                    }
                </RadzenCard>

                <RadzenCard Variant="Variant.Outlined" Style="padding: 1.25rem;">
                    <div class="section-title">
                        <RadzenIcon Icon="help_outline" Style="color: var(--rz-primary);" />
                        <span>@Loc["HelpCardTitle"]</span>
                    </div>
                    <RadzenText TextStyle="TextStyle.Body2"
                                Style="color: var(--rz-text-secondary-color); line-height: 1.6;">
                        @Loc["HelpCardText"]
                    </RadzenText>
                </RadzenCard>

                <RadzenCard Variant="Variant.Outlined" Style="padding: 1.25rem;">
                    <div class="section-title">
                        <RadzenIcon Icon="info" Style="color: var(--rz-primary);" />
                        <span>@Loc["AboutCardTitle"]</span>
                    </div>
                    <div class="profile-grid">
                        <div class="profile-label">@Loc["ColApp"]</div>
                        <div class="profile-value">TakOne</div>
                    </div>
                </RadzenCard>
            </RadzenStack>
        </div>

        @* ── Admin tools section (admin-only) ──
           Four tools, each a self-contained card:
             1. Product CSV import  — the round-trip partner of the
                AdminProducts export (which now carries each product's
                picture directory + file name).
             2. Bulk picture upload — same upload mechanism as the
                CreateProduct page (InputFile → IFileStorage), but with
                MULTI-file selection and ORIGINAL file names preserved, so
                a restore re-lands every picture under the exact name the
                CSV references.
             3. User CSV import     — the round-trip partner of the
                manage-users export; new users get the default password
                "@" + reversed worker id + "Temp" and a forced one-time
                password change.
             4. Database backups    — read-side status of the scheduled
                backup service (last run + outcome, next slot, stored
                files, retention) + a "Back up now" trigger. Runs on the
                server's own background execution — the card follows the
                progress by polling.

           GATED: the cards render only for Admins (role resolved via the
           AuthenticationStateProvider — see _isAdmin). Every command is
           ALSO admin-gated server-side via [RequireRoles]; the UI gate is
           UX, the command gate is security. *@
        @if (_isAdmin)
        {
            <div class="admin-section">
                <h2 class="admin-section-title">
                    <RadzenIcon Icon="admin_panel_settings" Style="color: var(--rz-primary);" />
                    @Loc["AdminSectionTitle"]
                </h2>
                <p class="admin-section-subtitle">@Loc["AdminSectionSubtitle"]</p>

                <div class="admin-tools-grid">

                    @* ── Card 1: product CSV import ── *@
                    <RadzenCard Variant="Variant.Filled" Style="padding: 1.25rem;">
                        <div class="section-title">
                            <span class="admin-step-badge" aria-hidden="true">1</span>
                            <RadzenIcon Icon="upload_file" Style="color: var(--rz-primary);" />
                            <span>@Loc["ProductImportCardTitle"]</span>
                        </div>
                        <RadzenText TextStyle="TextStyle.Body2"
                                    Style="color: var(--rz-text-secondary-color); line-height: 1.5; margin-bottom: 0.75rem;">
                            @Loc["ProductImportCardHint"]
                        </RadzenText>

                        @* Sample file with the EXACT positional format (same
                           headers + column order as the AdminProducts export,
                           including the two picture columns) — one click beats
                           a manual 10-column reconstruction from the hint text. *@
                        <button type="button" class="admin-inline-action"
                                @onclick="DownloadProductCsvTemplateAsync">
                            <RadzenIcon Icon="description" Style="font-size: 1rem;" />
                            <span>@Loc["DownloadTemplateButton"]</span>
                        </button>

                        @if (_isImportingProducts)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                                <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
                                <RadzenText TextStyle="TextStyle.Body2">@Loc["ImportWorking"]</RadzenText>
                            </RadzenStack>
                        }
                        else
                        {
                            <label class="import-dropzone">
                                <InputFile OnChange="@OnProductCsvSelectedAsync"
                                           accept=".csv,text/csv"
                                           class="import-dropzone-input" />
                                <span class="import-dropzone-icon">
                                    <RadzenIcon Icon="cloud_upload" Style="font-size: 1.6rem;" />
                                </span>
                                <span class="import-dropzone-title">@Loc["ProductImportPickTitle"]</span>
                                <span class="import-dropzone-hint">@Loc["ProductImportPickHint"]</span>
                            </label>
                        }

                        @if (!string.IsNullOrEmpty(_productImportError))
                        {
                            <RadzenAlert Title="@Loc["ErrorTitle"]"
                                         Text="@_productImportError"
                                         AlertStyle="AlertStyle.Danger"
                                         Variant="Variant.Outlined"
                                         ShowIcon="true"
                                         Style="margin-top: 0.75rem;" />
                        }

                        @if (_productImportRows is { Count: > 0 })
                        {
                            <div class="import-results">
                                <div class="import-results-summary">
                                    <RadzenBadge Text="@Loc["ImportCreatedCount", _productImportCreated]"
                                                 BadgeStyle="BadgeStyle.Success" IsPill="true" />
                                    <RadzenBadge Text="@Loc["ImportUpdatedCount", _productImportUpdated]"
                                                 BadgeStyle="BadgeStyle.Info" IsPill="true" />
                                    <RadzenBadge Text="@Loc["ImportFailedCount", _productImportFailed]"
                                                 BadgeStyle="BadgeStyle.Danger" IsPill="true" />
                                    @* Audit trail: the same per-row ledger
                                       rendered below, exported as CSV so the
                                       import run can be filed / diffed. *@
                                    <button type="button" class="admin-inline-action"
                                            style="margin-top: 0; margin-inline-start: auto;"
                                            @onclick="DownloadProductImportReportAsync">
                                        <RadzenIcon Icon="sim_card_download" Style="font-size: 1rem;" />
                                        <span>@Loc["DownloadReportButton"]</span>
                                    </button>
                                </div>
                                <div class="import-results-list">
                                    @foreach (var rowResult in _productImportRows)
                                    {
                                        <div class="import-result-row">
                                            <span class="import-result-line">@Loc["ImportRowLabel", rowResult.RowNumber]</span>
                                            <span class="import-result-name">@rowResult.Name</span>
                                            @if (rowResult.Outcome == ProductImportRowOutcome.Created)
                                            {
                                                <RadzenBadge Text="@Loc["ImportOutcomeCreated"]" BadgeStyle="BadgeStyle.Success" IsPill="true" />
                                            }
                                            else if (rowResult.Outcome == ProductImportRowOutcome.Updated)
                                            {
                                                <RadzenBadge Text="@Loc["ImportOutcomeUpdated"]" BadgeStyle="BadgeStyle.Info" IsPill="true" />
                                            }
                                            else
                                            {
                                                <span class="import-result-msg">@rowResult.Message</span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </RadzenCard>

                    @* ── Card 2: bulk picture upload ── *@
                    <RadzenCard Variant="Variant.Filled" Style="padding: 1.25rem;">
                        <div class="section-title">
                            <span class="admin-step-badge" aria-hidden="true">2</span>
                            <RadzenIcon Icon="photo_library" Style="color: var(--rz-primary);" />
                            <span>@Loc["PictureUploadCardTitle"]</span>
                        </div>
                        <RadzenText TextStyle="TextStyle.Body2"
                                    Style="color: var(--rz-text-secondary-color); line-height: 1.5; margin-bottom: 0.75rem;">
                            @Loc["PictureUploadCardHint"]
                        </RadzenText>

                        @if (_isUploadingPictures)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                                <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
                                <RadzenText TextStyle="TextStyle.Body2">@Loc["UploadWorking", _pictureUploadDone, _pendingPictures.Count + _pictureUploadDone]</RadzenText>
                            </RadzenStack>
                        }
                        else
                        {
                            <label class="import-dropzone">
                                <InputFile OnChange="@OnPicturesSelectedAsync"
                                           accept="image/jpeg,image/png,image/webp"
                                           multiple
                                           class="import-dropzone-input" />
                                <span class="import-dropzone-icon">
                                    <RadzenIcon Icon="cloud_upload" Style="font-size: 1.6rem;" />
                                </span>
                                <span class="import-dropzone-title">@Loc["PictureUploadPickTitle"]</span>
                                <span class="import-dropzone-hint">@Loc["PictureUploadPickHint"]</span>
                            </label>
                        }

                        @if (_pendingPictures.Count > 0 && !_isUploadingPictures)
                        {
                            <div class="import-file-list">
                                @foreach (var pending in _pendingPictures)
                                {
                                    <div class="import-file-chip">
                                        <RadzenIcon Icon="image" Style="font-size: 1rem; color: var(--rz-primary);" />
                                        <span class="import-file-name">@pending.FileName</span>
                                        <span class="import-file-size">@FormatFileSize(pending.Bytes.Length)</span>
                                        @* Per-file remove — a wrongly-picked file
                                           can be dropped without losing the rest
                                           of the selection. *@
                                        <button type="button" class="import-file-remove"
                                                title="@Loc["PictureRemoveFile"]"
                                                aria-label="@Loc["PictureRemoveFile", pending.FileName]"
                                                @onclick="() => RemovePendingPicture(pending)">
                                            <RadzenIcon Icon="close" Style="font-size: 0.9rem;" />
                                        </button>
                                    </div>
                                }
                            </div>
                            <div class="action-row">
                                <RadzenButton Text="@Loc["PictureUploadButton", _pendingPictures.Count]"
                                              Icon="cloud_done"
                                              ButtonStyle="ButtonStyle.Primary"
                                              Variant="Variant.Filled"
                                              Click="@UploadPendingPicturesAsync" />
                                <RadzenButton Text="@Loc["PictureUploadClearButton"]"
                                              Icon="close"
                                              ButtonStyle="ButtonStyle.Secondary"
                                              Variant="Variant.Outlined"
                                              Click="@ClearPendingPictures" />
                            </div>
                        }

                        @if (_pictureUploadFailures.Count > 0)
                        {
                            <div class="import-results">
                                <div class="import-results-summary">
                                    <RadzenBadge Text="@Loc["UploadSucceededCount", _picturesUploaded]"
                                                 BadgeStyle="BadgeStyle.Success" IsPill="true" />
                                    <RadzenBadge Text="@Loc["UploadFailedCount", _pictureUploadFailures.Count]"
                                                 BadgeStyle="BadgeStyle.Danger" IsPill="true" />
                                </div>
                                <div class="import-results-list">
                                    @foreach (var failure in _pictureUploadFailures)
                                    {
                                        <div class="import-result-row">
                                            <span class="import-result-name">@failure.FileName</span>
                                            <span class="import-result-msg">@failure.Message</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </RadzenCard>

                    @* ── Card 3: user CSV import ── *@
                    <RadzenCard Variant="Variant.Filled" Style="padding: 1.25rem;">
                        <div class="section-title">
                            <span class="admin-step-badge" aria-hidden="true">3</span>
                            <RadzenIcon Icon="group_add" Style="color: var(--rz-primary);" />
                            <span>@Loc["UserImportCardTitle"]</span>
                        </div>
                        <RadzenText TextStyle="TextStyle.Body2"
                                    Style="color: var(--rz-text-secondary-color); line-height: 1.5; margin-bottom: 0.75rem;">
                            @Loc["UserImportCardHint"]
                        </RadzenText>

                        @* Default-password formula — the admin handing out
                           first-login credentials needs the exact rule; showing
                           it (with a worked example) next to the import beats
                           a support round-trip later. *@
                        <div class="admin-info-callout" role="note">
                            <RadzenIcon Icon="key" Class="admin-info-icon" />
                            <div class="admin-info-body">
                                <span>@Loc["UserImportPasswordHint"]</span>
                                <code class="admin-info-code">@Loc["UserImportPasswordExample"]</code>
                            </div>
                        </div>

                        @* Sample file with the EXACT positional format (same
                           headers + column order as the manage-users export). *@
                        <button type="button" class="admin-inline-action"
                                @onclick="DownloadUserCsvTemplateAsync">
                            <RadzenIcon Icon="description" Style="font-size: 1rem;" />
                            <span>@Loc["DownloadTemplateButton"]</span>
                        </button>

                        @if (_isImportingUsers)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                                <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
                                <RadzenText TextStyle="TextStyle.Body2">@Loc["ImportWorking"]</RadzenText>
                            </RadzenStack>
                        }
                        else
                        {
                            <label class="import-dropzone">
                                <InputFile OnChange="@OnUserCsvSelectedAsync"
                                           accept=".csv,text/csv"
                                           class="import-dropzone-input" />
                                <span class="import-dropzone-icon">
                                    <RadzenIcon Icon="cloud_upload" Style="font-size: 1.6rem;" />
                                </span>
                                <span class="import-dropzone-title">@Loc["UserImportPickTitle"]</span>
                                <span class="import-dropzone-hint">@Loc["UserImportPickHint"]</span>
                            </label>
                        }

                        @if (!string.IsNullOrEmpty(_userImportError))
                        {
                            <RadzenAlert Title="@Loc["ErrorTitle"]"
                                         Text="@_userImportError"
                                         AlertStyle="AlertStyle.Danger"
                                         Variant="Variant.Outlined"
                                         ShowIcon="true"
                                         Style="margin-top: 0.75rem;" />
                        }

                        @if (_userImportRows is { Count: > 0 })
                        {
                            <div class="import-results">
                                <div class="import-results-summary">
                                    <RadzenBadge Text="@Loc["ImportCreatedCount", _userImportCreated]"
                                                 BadgeStyle="BadgeStyle.Success" IsPill="true" />
                                    <RadzenBadge Text="@Loc["UserImportSkippedCount", _userImportSkipped]"
                                                 BadgeStyle="BadgeStyle.Light" IsPill="true" />
                                    <RadzenBadge Text="@Loc["ImportFailedCount", _userImportFailed]"
                                                 BadgeStyle="BadgeStyle.Danger" IsPill="true" />
                                    @* Audit trail: the same per-row ledger
                                       rendered below, exported as CSV. *@
                                    <button type="button" class="admin-inline-action"
                                            style="margin-top: 0; margin-inline-start: auto;"
                                            @onclick="DownloadUserImportReportAsync">
                                        <RadzenIcon Icon="sim_card_download" Style="font-size: 1rem;" />
                                        <span>@Loc["DownloadReportButton"]</span>
                                    </button>
                                </div>
                                <div class="import-results-list">
                                    @foreach (var rowResult in _userImportRows)
                                    {
                                        <div class="import-result-row">
                                            <span class="import-result-line">@Loc["ImportRowLabel", rowResult.RowNumber]</span>
                                            <span class="import-result-name">@rowResult.WorkerId</span>
                                            @if (rowResult.Outcome == UserImportRowOutcome.Created)
                                            {
                                                <RadzenBadge Text="@Loc["ImportOutcomeCreated"]" BadgeStyle="BadgeStyle.Success" IsPill="true" />
                                            }
                                            else if (rowResult.Outcome == UserImportRowOutcome.Skipped)
                                            {
                                                <RadzenBadge Text="@Loc["ImportOutcomeSkipped"]" BadgeStyle="BadgeStyle.Light" IsPill="true" />
                                            }
                                            else
                                            {
                                                <span class="import-result-msg">@rowResult.Message</span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </RadzenCard>
                    @* ── Card 4: database backup status ──
                       NOT numbered like cards 1-3: those form the CSV
                       restore workflow; this is a separate operations
                       card. Shows the scheduled-backup service's health
                       (last run + outcome, next 03:30/14:30-UTC slot,
                       stored files, retention) and offers a manual
                       "Back up now" trigger. The trigger returns as soon
                       as the run is ACCEPTED — the backup executes on the
                       hosted service's own background loop, and the card
                       follows it by polling every few seconds until it
                       finishes. *@
                    <RadzenCard Variant="Variant.Filled" Style="padding: 1.25rem;">
                        <div class="section-title">
                            <RadzenIcon Icon="backup" Style="color: var(--rz-primary);" />
                            <span>@Loc["BackupCardTitle"]</span>
                        </div>
                        <RadzenText TextStyle="TextStyle.Body2"
                                    Style="color: var(--rz-text-secondary-color); line-height: 1.5; margin-bottom: 0.75rem;">
                            @Loc["BackupCardHint"]
                        </RadzenText>

                        @if (_isBackupLoading)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                                <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
                                <RadzenText TextStyle="TextStyle.Body2">@Loc["BackupLoading"]</RadzenText>
                            </RadzenStack>
                        }
                        else if (!string.IsNullOrEmpty(_backupLoadError))
                        {
                            <RadzenAlert Title="@Loc["ErrorTitle"]"
                                         Text="@_backupLoadError"
                                         AlertStyle="AlertStyle.Danger"
                                         Variant="Variant.Outlined"
                                         ShowIcon="true"
                                         Style="margin-top: 0.75rem;" />
                            <div class="action-row">
                                <RadzenButton Text="@Loc["BackupRetryButton"]"
                                              Icon="refresh"
                                              ButtonStyle="ButtonStyle.Secondary"
                                              Variant="Variant.Outlined"
                                              Click="@(() => LoadBackupStatusAsync())" />
                            </div>
                        }
                        else if (_backupStatus is { Enabled: false })
                        {
                            @* Not an error — an externally-managed backup
                               regime (or a dev box without a DB). The
                               notice tells the admin which knob to flip. *@
                            <div class="admin-info-callout" role="note">
                                <RadzenIcon Icon="pause_circle" Class="admin-info-icon" />
                                <div class="admin-info-body">
                                    <span>@Loc["BackupDisabledNotice"]</span>
                                    <code class="admin-info-code">DatabaseBackups:Enabled</code>
                                </div>
                            </div>
                        }
                        else if (_backupStatus is { } backup)
                        {
                            @* ── Health snapshot: last run / next slot /
                                   retention / files. 2×2 stat grid; each
                                   cell = muted label + strong value. *@
                            <div class="backup-stats-grid">
                                <div class="backup-stat">
                                    <span class="backup-stat-label">@Loc["BackupLastRunLabel"]</span>
                                    <span class="backup-stat-value">
                                        @if (backup.IsRunning)
                                        {
                                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.4rem">
                                                <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.ExtraSmall" />
                                                <span>@Loc["BackupRunning"]</span>
                                            </RadzenStack>
                                        }
                                        else if (backup.LastRunFinishedUtc is { } finishedUtc)
                                        {
                                            @CultureFormat.FormatTehranDateTime(finishedUtc)
                                            @if (GetBackupRunDuration(backup) is { } durationSeconds)
                                            {
                                                <span class="backup-stat-sub">@Loc["BackupDurationFormat", durationSeconds]</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="backup-stat-sub">@Loc["BackupNeverRun"]</span>
                                        }
                                    </span>
                                    @if (backup.LastRunSucceeded is false && !backup.IsRunning)
                                    {
                                        <RadzenBadge Text="@Loc["BackupOutcomeFailed"]" BadgeStyle="BadgeStyle.Danger" IsPill="true" Style="align-self: flex-start;" />
                                    }
                                    else if (backup.LastRunSucceeded is true)
                                    {
                                        <RadzenBadge Text="@Loc["BackupOutcomeSuccess"]" BadgeStyle="BadgeStyle.Success" IsPill="true" Style="align-self: flex-start;" />
                                    }
                                </div>

                                <div class="backup-stat">
                                    <span class="backup-stat-label">@Loc["BackupNextRunLabel"]</span>
                                    <span class="backup-stat-value">
                                        @(backup.NextScheduledRunUtc is { } next ? CultureFormat.FormatTehranDateTime(next) : "—")
                                    </span>
                                    <span class="backup-stat-sub">@Loc["BackupScheduleSlots"]</span>
                                </div>

                                <div class="backup-stat">
                                    <span class="backup-stat-label">@Loc["BackupRetentionLabel"]</span>
                                    <span class="backup-stat-value">@Loc["BackupRetentionValue", backup.RetentionDays]</span>
                                </div>

                                <div class="backup-stat">
                                    <span class="backup-stat-label">@Loc["BackupFilesLabel"]</span>
                                    <span class="backup-stat-value">@Loc["BackupFilesSummary", backup.Files.Count, FormatFileSize(backup.TotalSizeBytes)]</span>
                                </div>
                            </div>

                            @* Failure detail from the last run — the same
                               message the service logged (e.g. the Docker
                               volume-wiring hint), surfaced so the admin
                               can act without grepping container logs. *@
                            @if (backup.LastRunSucceeded is false && !backup.IsRunning && !string.IsNullOrEmpty(backup.LastRunError))
                            {
                                <RadzenAlert Title="@Loc["BackupFailedAlertTitle"]"
                                             Text="@backup.LastRunError"
                                             AlertStyle="AlertStyle.Danger"
                                             Variant="Variant.Outlined"
                                             ShowIcon="true"
                                             Style="margin-top: 0.5rem;" />
                            }

                            @* ── Run-history ledger (persisted JSONL) — one row
                               per COMPLETED run, newest first: trigger icon
                               (clock = scheduled slot, touch = manual "Back
                               up now"), Tehran start time + duration, and
                               the outcome badge. The full failure message
                               rides the row's title tooltip (the latest
                               failure also gets the alert above). Only
                               rendered when at least one run is recorded —
                               the "Last run: never" stat already covers the
                               fresh-install case. *@
                            @if (backup.RunHistory is { Count: > 0 })
                            {
                                <span class="backup-run-section-label">@Loc["BackupRunHistoryLabel"]</span>
                                <div class="backup-run-list">
                                    @foreach (var run in backup.RunHistory)
                                    {
                                        var rawSeconds = (decimal)(run.FinishedUtc - run.StartedUtc).TotalSeconds;
                                        var durationSeconds = rawSeconds >= 0 ? decimal.Round(rawSeconds, 1) : 0m;
                                        var rowTitle = run.Succeeded
                                            ? string.Format(CultureInfo.CurrentCulture, Loc["BackupRunTooltip"], run.WasManual ? Loc["BackupRunManual"] : Loc["BackupRunScheduled"])
                                            : $"{Loc["BackupRunFailed"]}: {run.Error}";
                                        <div class="backup-run-row @(run.Succeeded ? string.Empty : "backup-run-failed")"
                                             title="@(string.IsNullOrEmpty(run.Note) ? rowTitle : rowTitle + " — " + run.Note)">
                                            @if (run.WasManual)
                                            {
                                                <RadzenIcon Icon="touch_app"
                                                            Class="backup-run-icon backup-run-icon-manual"
                                                            title="@Loc["BackupRunManual"]" />
                                            }
                                            else
                                            {
                                                <RadzenIcon Icon="schedule"
                                                            Class="backup-run-icon backup-run-icon-scheduled"
                                                            title="@Loc["BackupRunScheduled"]" />
                                            }
                                            <span class="backup-run-time">@CultureFormat.FormatTehranDateTime(run.StartedUtc)</span>
                                            <span class="backup-run-duration">@Loc["BackupDurationFormat", durationSeconds]</span>
                                            <span class="backup-run-name">@run.FileName</span>
                                            @if (run.Succeeded)
                                            {
                                                <RadzenBadge Text="@Loc["BackupOutcomeSuccess"]" BadgeStyle="BadgeStyle.Success" IsPill="true" Style="flex: none;" />
                                            }
                                            else
                                            {
                                                <RadzenBadge Text="@Loc["BackupOutcomeFailed"]" BadgeStyle="BadgeStyle.Danger" IsPill="true" Style="flex: none;" />
                                            }
                                            @if (!string.IsNullOrEmpty(run.Note))
                                            {
                                                @* Fallback annotation (default-backup-directory
                                                   runs): renders as a full-width secondary line
                                                   under the row content — the admin must see
                                                   WHERE the file ended up without hovering. *@
                                                <span class="backup-run-note">@run.Note</span>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            @* Stored files ledger — newest first, mono
                               names (LTR even in fa-IR), size + Tehran
                               time. Scrollable with the thin themed
                               scrollbar. *@
                            @if (backup.Files.Count > 0)
                            {
                                <span class="backup-run-section-label">@Loc["BackupFilesLedgerLabel"]</span>
                                <div class="backup-file-list">
                                    @foreach (var file in backup.Files)
                                    {
                                        <div class="backup-file-row">
                                            <RadzenIcon Icon="save" Style="font-size: 1rem; color: var(--rz-primary); flex: none;" />
                                            <span class="backup-file-name">@file.FileName</span>
                                            <span class="backup-file-size">@FormatFileSize(file.SizeBytes)</span>
                                            <span class="backup-file-date">@CultureFormat.FormatTehranDateTime(file.LastWriteUtc)</span>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <RadzenText TextStyle="TextStyle.Body2"
                                            Style="color: var(--rz-text-secondary-color); margin-top: 0.5rem;">
                                    @Loc["BackupNoFiles"]
                                </RadzenText>
                            }

                            <div class="action-row">
                                <RadzenButton Text="@Loc["BackupTriggerButton"]"
                                              Icon="play_arrow"
                                              ButtonStyle="ButtonStyle.Primary"
                                              Variant="Variant.Filled"
                                              Disabled="@(backup.IsRunning || _isTriggeringBackup)"
                                              IsBusy="@_isTriggeringBackup"
                                              BusyText="@Loc["BackupTriggering"]"
                                              Click="@TriggerBackupNowAsync" />
                                <RadzenButton Text="@Loc["BackupRefreshButton"]"
                                              Icon="refresh"
                                              ButtonStyle="ButtonStyle.Secondary"
                                              Variant="Variant.Outlined"
                                              Disabled="@(_isTriggeringBackup)"
                                              Click="@(() => LoadBackupStatusAsync())" />
                                @* Run-report CSV — the persisted audit ledger
                                   as a file (QA-4 handover item). Disabled when
                                   no run has completed yet; the data is the
                                   ALREADY-LOADED snapshot, so no extra query. *@
                                <RadzenButton Text="@Loc["BackupRunReportButton"]"
                                              Icon="download"
                                              ButtonStyle="ButtonStyle.Secondary"
                                              Variant="Variant.Outlined"
                                              Disabled="@(backup.RunHistory is not { Count: > 0 })"
                                              Click="@DownloadBackupRunReportAsync" />
                            </div>
                        }
                    </RadzenCard>
                </div>
            </div>
        }
    }
</RadzenStack>

@code {
    // ── State ──────────────────────────────────────────────────────────

    private UserDto? _user;
    private string? _loadError;
    private bool _isLoading = true;

    /// <summary>
    /// The user's per-kind notification preferences (Round 3). Null while
    /// loading / on load failure (the card renders its skeleton / error
    /// state respectively). One entry per NotificationKind — the query
    /// guarantees the complete list.
    /// </summary>
    private List<NotificationPreferenceDto>? _notificationPreferences;

    /// <summary>
    /// Non-null when the preferences query failed — the card renders an
    /// inline RadzenAlert instead of the list (the rest of the page still
    /// works; account + theme are loaded independently).
    /// </summary>
    private string? _prefsLoadError;

    /// <summary>
    /// True while a SetNotificationMutedCommand is in flight — disables
    /// ALL the switches (prevents stacking a second toggle on a
    /// first-in-flight one; the upsert's race-loser path would surface a
    /// confusing error toast for a double-click).
    /// </summary>
    private bool _isSavingPref;

    /// <summary>
    /// The currently-applied theme name. Initialized to "tak-light" (the
    /// project default) and then synced with theme.js's saved value in
    /// OnAfterRenderAsync(firstRender:true) — same pattern as MainLayout.razor.
    /// Drives the .is-selected class on the theme cards.
    /// </summary>
    private string _currentTheme = "tak-light";

    /// <summary>
    /// Transient "theme applied" toast — shown briefly after a theme
    /// switch so the user gets feedback that the click was registered.
    /// Cleared on the next switch. Kept as a simple string (not a
    /// ToastService call) so it persists alongside the card.
    /// </summary>
    private string? _themeToast;

    /// <summary>
    /// One entry per available theme. The Id matches the keys in theme.js's
    /// TAK_THEMES registry (for Tak themes) OR a built-in Radzen theme name
    /// (for Radzen themes). Adding a new theme requires updating this list;
    /// for Tak themes you ALSO need to update theme.js's TAK_THEMES.
    ///
    /// The Icon is a Material Symbols name (light_mode for light themes,
    /// dark_mode for dark themes) — rendered via RadzenIcon.
    ///
    /// NameKey + HintKey are resx keys (looked up via Loc[...]) — they
    /// decouple the display strings from the theme Id so the Id can stay
    /// stable (e.g. "tak-light") while the user-visible name can be
    /// localized ("Tak Light" / "پوسته روشن").
    ///
    /// Category groups the theme under a header in the UI ("Tak themes"
    /// vs "Radzen themes") — must match a ThemeCategory.Id in
    /// _themeCategories below.
    /// </summary>
    private readonly List<ThemeOption> _availableThemes = new()
    {
        // ── Tak themes (custom palette on top of a Radzen base) ──
        // These are the project's recommended defaults. The override CSS
        // files (tak-light.css, tak-dark.css) live in wwwroot/css/Themes/.
        new ThemeOption("tak-light",       "light_mode", IsDark: false,
            NameKey: "ThemeName_TakLight",       HintKey: "ThemeHint_TakLight",       Category: "Tak"),
        new ThemeOption("tak-dark",        "dark_mode",  IsDark: true,
            NameKey: "ThemeName_TakDark",        HintKey: "ThemeHint_TakDark",        Category: "Tak"),

        // ── Radzen built-in themes (no Tak override) ──
        // theme.js's applyTheme() handles any unknown theme name by
        // treating it as a Radzen base — so all of these work without
        // any registry changes in theme.js.
        new ThemeOption("standard",        "light_mode", IsDark: false,
            NameKey: "ThemeName_Standard",      HintKey: "ThemeHint_Standard",      Category: "Radzen"),
        new ThemeOption("standard-dark",   "dark_mode",  IsDark: true,
            NameKey: "ThemeName_StandardDark",  HintKey: "ThemeHint_StandardDark",  Category: "Radzen"),
        new ThemeOption("default",         "light_mode", IsDark: false,
            NameKey: "ThemeName_Default",       HintKey: "ThemeHint_Default",       Category: "Radzen"),
        new ThemeOption("dark",            "dark_mode",  IsDark: true,
            NameKey: "ThemeName_Dark",          HintKey: "ThemeHint_Dark",          Category: "Radzen"),
        new ThemeOption("material",        "light_mode", IsDark: false,
            NameKey: "ThemeName_Material",      HintKey: "ThemeHint_Material",      Category: "Radzen"),
        new ThemeOption("material-dark",   "dark_mode",  IsDark: true,
            NameKey: "ThemeName_MaterialDark",  HintKey: "ThemeHint_MaterialDark",  Category: "Radzen"),
        new ThemeOption("software",        "light_mode", IsDark: false,
            NameKey: "ThemeName_Software",      HintKey: "ThemeHint_Software",      Category: "Radzen"),
        new ThemeOption("software-dark",   "dark_mode",  IsDark: true,
            NameKey: "ThemeName_SoftwareDark",  HintKey: "ThemeHint_SoftwareDark",  Category: "Radzen"),
        new ThemeOption("humanistic",      "light_mode", IsDark: false,
            NameKey: "ThemeName_Humanistic",    HintKey: "ThemeHint_Humanistic",    Category: "Radzen"),
        new ThemeOption("humanistic-dark", "dark_mode",  IsDark: true,
            NameKey: "ThemeName_HumanisticDark",HintKey: "ThemeHint_HumanisticDark",Category: "Radzen"),
    };

    /// <summary>
    /// One theme entry in the selector grid. See _availableThemes above
    /// for the field-by-field rationale.
    /// </summary>
    private sealed record ThemeOption(
        string Id,
        string Icon,
        bool IsDark,
        string NameKey,
        string HintKey,
        string Category);

    /// <summary>
    /// Ordered list of theme categories — each renders as a small all-caps
    /// header above its group of theme cards. The order here controls the
    /// order the groups appear in the UI (Tak first, then Radzen).
    ///
    /// Id must match the Category field on ThemeOption entries. Header is
    /// a resx key (looked up via Loc[...]) so the category labels are
    /// localized too.
    /// </summary>
    private readonly List<ThemeCategory> _themeCategories = new()
    {
        new ThemeCategory(Id: "Tak",    HeaderKey: "ThemeCategory_Tak"),
        new ThemeCategory(Id: "Radzen", HeaderKey: "ThemeCategory_Radzen"),
    };

    /// <summary>
    /// One category group in the theme selector. See _themeCategories
    /// above for the field-by-field rationale.
    /// </summary>
    private sealed record ThemeCategory(string Id, string HeaderKey);

    /// <summary>
    /// Resolves the localized header for a category. Used by the markup's
    /// @category.Header binding so the razor file doesn't need to know
    /// about the resx-key indirection.
    /// </summary>
    private string GetCategoryHeader(ThemeCategory category) => Loc[category.HeaderKey];

    // ── Lifecycle ──────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Resolve the current user's Id via AuthStateProvider — NOT
            // ICurrentUserService, which reads from HttpContext (null over
            // the SignalR circuit in interactive Blazor Server mode).
            // Same pattern as UserDetail.razor.
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user?.Identity?.IsAuthenticated != true)
            {
                _loadError = Loc["Error_NotAuthenticated"];
                return;
            }

            // Admin role for the admin-tools section — resolved via the
            // auth state (NOT ICurrentUserService.IsInRole, which reads
            // HttpContext and returns false for everyone over the SignalR
            // circuit). Same pattern as ManageGroups.razor's _isAdmin.
            _isAdmin = user.IsInRole(Roles.Admin);

            // The UserId claim is set by our custom IClaimsPrincipalFactory
            // in Infrastructure — it's the Domain User's Guid Id. Fallback
            // to NameIdentifier for safety.
            var idClaim = user.FindFirst("UserId")?.Value
                          ?? user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

            if (!Guid.TryParse(idClaim, out var userId))
            {
                _loadError = Loc["Error_NotAuthenticated"];
                return;
            }

            var query = new GetUserByIdQuery { UserId = userId };
            var result = await MessageBus.InvokeAsync<Result<UserDto>>(query);

            if (result.IsSuccess)
            {
                _user = result.Value;
            }
            else
            {
                // The handler returns "User '...' was not found." for both
                // genuinely-missing users and not-allowed-to-see — we
                // surface a generic message to avoid leaking which.
                _loadError = Loc["Error_GenericLoad"];
            }

            // ── Notification preferences (Round 3) — loaded independently
            // so a prefs failure never takes the account card down with
            // it. The query resolves the CURRENT user server-side (no
            // client-supplied Id — anti-CSRF). ──
            await LoadNotificationPreferencesAsync();

            // ── Backup status (admin-only card) — loaded independently for
            // the same reason: a failed status load only affects its own
            // card (inline alert + Retry there). ──
            if (_isAdmin)
            {
                await LoadBackupStatusAsync();
            }
        }
        catch
        {
            _loadError = Loc["Error_GenericLoad"];
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>
    /// After the first interactive render, read the actually-applied theme
    /// from theme.js (window.takTheme.get) and update _currentTheme so the
    /// active theme's card shows .is-selected. Same pattern as
    /// MainLayout.razor's OnAfterRenderAsync.
    ///
    /// WHY OnAfterRenderAsync (not OnInitializedAsync):
    ///   - OnInitializedAsync runs TWICE in InteractiveServer + prerender:
    ///     once during static prerender (no circuit yet — JS interop throws),
    ///     and once after hydration (circuit ready — JS interop works).
    ///   - OnAfterRenderAsync(firstRender: true) runs ONLY ONCE, after the
    ///     circuit is established. JS interop definitely works here.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var saved = await JS.InvokeAsync<string>("takTheme.get");
            if (!string.IsNullOrEmpty(saved) && saved != _currentTheme)
            {
                _currentTheme = saved;
                StateHasChanged();
            }
        }
        catch
        {
            // JS interop failed (e.g. theme.js didn't load) — leave
            // _currentTheme at its "tak-light" default. The user can
            // still click theme cards; only the persistence would fail.
        }
    }

    // ── Theme selection ────────────────────────────────────────────────

    /// <summary>
    /// Called when the user clicks a theme card. Calls theme.js's
    /// takTheme.set(themeName) to swap the CSS <link> + persist to
    /// localStorage, then updates _currentTheme so the .is-selected class
    /// moves to the clicked card. No page reload needed — theme.js swaps
    /// the stylesheet in-place and the whole page re-paints.
    /// </summary>
    private async Task HandleSelectThemeAsync(string themeId)
    {
        if (themeId == _currentTheme)
        {
            return; // no-op — clicking the already-active theme
        }

        try
        {
            await JS.InvokeVoidAsync("takTheme.set", themeId);
            _currentTheme = themeId;
            _themeToast = string.Format(CultureInfo.CurrentCulture, Loc["ThemeApplied"], GetThemeName(themeId));
        }
        catch
        {
            // JS interop failed — show an error toast so the user knows.
            _themeToast = Loc["Error_ThemeSwitch"];
        }
    }

