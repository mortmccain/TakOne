    // ── Backup status card state (admin-only) ──────────────────────────

    /// <summary>True while the GetBackupStatusQuery is in flight. Initialized TRUE so the admin card's first frame shows the loading spinner (not an empty body) until the initial load resolves; polls pass showLoadingState:false so refreshes never blink the card.</summary>
    private bool _isBackupLoading = true;

    /// <summary>The latest backup-subsystem snapshot; null until the first load completes.</summary>
    private BackupStatusDto? _backupStatus;

    /// <summary>Non-null when the status query failed — the card shows an inline alert + Retry.</summary>
    private string? _backupLoadError;

    /// <summary>True while the TriggerBackupNowCommand is in flight (the "Back up now" button's busy state).</summary>
    private bool _isTriggeringBackup;

    /// <summary>
    /// Loads (or refreshes) the backup status snapshot. Non-fatal: a
    /// failed load only takes down the backup card (inline alert + Retry),
    /// never the rest of the Settings page.
    /// </summary>
    /// <param name="showLoadingState">
    /// True (default) for user-initiated loads — the card body swaps to a
    /// spinner. False for background POLLS — the last snapshot stays on
    /// screen so a 5-second poll never blinks the card.
    /// </param>
    private async Task LoadBackupStatusAsync(bool showLoadingState = true)
    {
        if (showLoadingState)
        {
            _isBackupLoading = true;
        }

        try
        {
            var result = await MessageBus.InvokeAsync<Result<BackupStatusDto>>(
                new GetBackupStatusQuery());

            if (result.IsSuccess)
            {
                _backupStatus = result.Value;
                _backupLoadError = null;
            }
            else
            {
                _backupLoadError = result.Error;
            }
        }
        catch (Exception)
        {
            _backupLoadError = Loc["BackupLoadError"];
        }
        finally
        {
            if (showLoadingState)
            {
                _isBackupLoading = false;
            }
        }
    }

    /// <summary>
    /// "Back up now": dispatches TriggerBackupNowCommand and — once the
    /// run is accepted — follows its progress by polling the status every
    /// few seconds until the run finishes (bounded at 10 minutes; the
    /// scheduled slots are unaffected by manual runs). The backup itself
    /// executes on the hosted service's own background loop; this handler
    /// only waits for the ACCEPT + polls.
    /// </summary>
    private async Task TriggerBackupNowAsync()
    {
        if (_isTriggeringBackup || _backupStatus is { IsRunning: true })
        {
            return; // a run is already starting/executing — nothing to do
        }

        _isTriggeringBackup = true;
        try
        {
            var result = await MessageBus.InvokeAsync<Result>(new TriggerBackupNowCommand());

            if (result.IsSuccess)
            {
                await Toast.Success(Loc["BackupTriggered"], summary: Loc["PageHeading"]);

                // Immediate refresh (picks up IsRunning=true) + follow the
                // run until it completes.
                await LoadBackupStatusAsync();
                await PollBackupStatusWhileRunningAsync();
            }
            else
            {
                // Rejected server-side: a run already in flight / pending,
                // or the schedule is disabled. Refresh so the card shows
                // which, then surface the rejection.
                await LoadBackupStatusAsync();
                await Toast.Warning(result.Error, summary: Loc["ErrorTitle"]);
            }
        }
        catch (Exception)
        {
            await Toast.Warning(Loc["BackupTriggerError"], summary: Loc["ErrorTitle"]);
        }
        finally
        {
            _isTriggeringBackup = false;
        }
    }

    /// <summary>
    /// Polls the backup status every few seconds while a run is executing,
    /// so the card's "Backup in progress…" turns into the outcome badge
    /// without the admin hammering Refresh. Bounded (10 minutes) and
    /// best-effort — a dropped circuit simply stops the polling.
    /// </summary>
    private async Task PollBackupStatusWhileRunningAsync()
    {
        try
        {
            var deadline = DateTime.UtcNow.AddMinutes(10);
            while (DateTime.UtcNow < deadline)
            {
                await Task.Delay(TimeSpan.FromSeconds(5));
                await LoadBackupStatusAsync(showLoadingState: false);
                StateHasChanged(); // intermediate updates — the handler is long-running

                if (_backupStatus is not { IsRunning: true })
                {
                    break;
                }
            }
        }
        catch (Exception)
        {
            // Polling is cosmetic — swallow and leave the last snapshot.
        }
    }

    /// <summary>
    /// Builds and downloads the backup run-history report as CSV (the
    /// persisted JSONL ledger in file form — a portable audit artifact
    /// for ticketing/ops handovers). Columns are machine-friendly:
    /// UTC ISO-8601 timestamps, raw duration seconds, invariant size
    /// bytes; the outcome + trigger cells reuse the card's localized
    /// labels (same convention as the grid exports' status columns).
    /// Data source is the ALREADY-LOADED status snapshot — the ledger
    /// is append-only and this page is its only reader, so a re-query
    /// would only race a run in progress for zero benefit.
    /// </summary>
    private async Task DownloadBackupRunReportAsync()
    {
        if (_backupStatus?.RunHistory is not { Count: > 0 } runs)
        {
            return; // the button is disabled in this state — belt + braces
        }

        try
        {
            var builder = new CsvBuilder();
            builder.AddHeader(
                Loc["BackupRunReportColStarted"],
                Loc["BackupRunReportColFinished"],
                Loc["BackupRunReportColDuration"],
                Loc["BackupRunReportColOutcome"],
                Loc["BackupRunReportColTrigger"],
                Loc["BackupRunReportColFile"],
                Loc["BackupRunReportColSize"],
                Loc["BackupRunReportColError"],
                Loc["BackupRunReportColNote"]);

            // Runs are stored newest-first; the REPORT reads chronologically
            // (oldest→newest) so the audit trail unfolds in execution order.
            foreach (var run in runs.Reverse())
            {
                var rawSeconds = (decimal)(run.FinishedUtc - run.StartedUtc).TotalSeconds;
                var durationSeconds = rawSeconds >= 0 ? decimal.Round(rawSeconds, 1) : 0m;

                builder.AddRow(
                    run.StartedUtc.ToString("u", CultureInfo.InvariantCulture),
                    run.FinishedUtc.ToString("u", CultureInfo.InvariantCulture),
                    durationSeconds,                     // invariant RAW seconds (CsvBuilder contract)
                    run.Succeeded ? Loc["BackupOutcomeSuccess"] : Loc["BackupOutcomeFailed"],
                    run.WasManual ? Loc["BackupRunManual"] : Loc["BackupRunScheduled"],
                    run.FileName,                        // may be empty on pre-file failures
                    run.SizeBytes,                       // invariant RAW bytes
                    run.Error,                           // empty on success
                    run.Note);                           // empty on normal runs (fallback annotation)
            }

            var fileName = $"takone-backup-runs-{DateTime.UtcNow:yyyyMMdd-HHmmss}.csv";
            await JS.InvokeVoidAsync("takDownload.csv", fileName, builder.ToString());

            await Toast.Success(Loc["BackupRunReportDone", runs.Count], summary: Loc["PageHeading"]);
        }
        catch (Exception)
        {
            // JS interop can fail after a circuit reconnect — same policy
            // as every other download on this page.
            await Toast.Warning(Loc["DownloadError"], summary: Loc["ErrorTitle"]);
        }
    }

    /// <summary>
    /// Duration (seconds, one decimal) of the last COMPLETED backup run,
    /// or null when the run never finished / never happened. Derived from
    /// the status DTO's start+finish timestamps.
    /// </summary>
    private static decimal? GetBackupRunDuration(BackupStatusDto backup)
    {
        if (backup.LastRunStartedUtc is not { } started || backup.LastRunFinishedUtc is not { } finished)
        {
            return null;
        }

        var seconds = (decimal)(finished - started).TotalSeconds;
        return seconds >= 0 ? decimal.Round(seconds, 1) : null;
    }

    /// <summary>
    /// Reads an InputFile's text content as UTF-8 (BOM-tolerant — the
    /// export's download helper prepends one; CsvParser strips it).
    /// Shared by both CSV import pickers.
    /// </summary>
    private static async Task<string> ReadTextFileAsync(IBrowserFile file, int maxBytes)
    {
        await using var stream = file.OpenReadStream(maxAllowedSize: maxBytes);
        using var reader = new System.IO.StreamReader(stream, System.Text.Encoding.UTF8);
        return await reader.ReadToEndAsync();
    }

    /// <summary>
    /// Product-CSV picker: parse + normalize the file, dispatch
    /// ImportProductsCommand, and merge the handler's per-row report
    /// with any local parse failures.
    ///
    /// COLUMN ORDER (positional — must mirror the AdminProducts export):
    /// Name, Category, SubCategory, SubSubCategory, Price, Currency,
    /// Stock, Status, Picture directory, Picture file name. The Status
    /// and Picture-directory columns are read but ignored (stock status
    /// is derived from stock; the URL is rebuilt from the file name).
    /// </summary>
    private async Task OnProductCsvSelectedAsync(InputFileChangeEventArgs e)
    {
        // Reset the previous run's UI state.
        _productImportError = null;
        _productImportRows = null;
        _productImportCreated = _productImportUpdated = _productImportFailed = 0;

        if (e.FileCount == 0)
        {
            return; // picker cancelled — keep the previous state
        }

        var file = e.File;
        var rows = new List<ProductImportRowDto>();
        var localFailures = new List<ProductImportRowResultDto>();

        try
        {
            var csv = await ReadTextFileAsync(file, MaxCsvFileSizeBytes);
            var records = CsvParser.Parse(csv);

            // Row 0 is the header; every record after it is a data row.
            if (records.Count < 2)
            {
                _productImportError = Loc["ImportErrorNoDataRows"];
                return;
            }

            for (var i = 1; i < records.Count; i++)
            {
                var fields = records[i];
                var rowNumber = i; // 1-based DATA-row number (header = 0)

                // Guard the positional contract: the export always writes
                // 10 columns; a short row means a broken/edited file — the
                // row is reported, not silently mis-mapped.
                if (fields.Length < 10)
                {
                    localFailures.Add(new ProductImportRowResultDto
                    {
                        RowNumber = rowNumber,
                        Name = fields.Length > 0 ? fields[0] : string.Empty,
                        Outcome = ProductImportRowOutcome.Failed,
                        Message = Loc["ImportErrorShortRow"]
                    });
                    continue;
                }

                if (!CsvParser.TryParseInvariantDecimal(fields[4], out var price)
                    || !CsvParser.TryParseInvariantInt(fields[6], out var stock))
                {
                    localFailures.Add(new ProductImportRowResultDto
                    {
                        RowNumber = rowNumber,
                        Name = fields[0],
                        Outcome = ProductImportRowOutcome.Failed,
                        Message = Loc["ImportErrorBadNumber"]
                    });
                    continue;
                }

                rows.Add(new ProductImportRowDto
                {
                    Name = fields[0],
                    CategoryName = fields[1],
                    SubCategoryName = fields[2],
                    SubSubCategoryName = fields[3],
                    PriceAmount = price,
                    Currency = fields[5],
                    StockQuantity = stock,
                    PictureFileName = fields[9],
                    RowNumber = rowNumber
                });
            }
        }
        catch (System.IO.IOException ex)
        {
            _productImportError = Loc["ImportErrorReadFailed", ex.Message];
            return;
        }

        // All rows failed local parsing — nothing to dispatch.
        if (rows.Count == 0)
        {
            _productImportRows = localFailures;
            _productImportFailed = localFailures.Count;
            return;
        }

        _isImportingProducts = true;
        try
        {
            var result = await MessageBus.InvokeAsync<Result<ProductImportResultDto>>(new ImportProductsCommand(rows));

            if (result.IsSuccess)
            {
                var report = result.Value;
                _productImportCreated = report.CreatedCount;
                _productImportUpdated = report.UpdatedCount;
                _productImportFailed = report.FailedCount + localFailures.Count;

                // Handler rows first (file order), then local failures —
                // both are already ordered by row number within themselves.
                _productImportRows = report.RowResults.Concat(localFailures).ToList();

                await Toast.Success(Loc["ProductImportDone", report.CreatedCount, report.UpdatedCount, report.FailedCount + localFailures.Count], summary: Loc["PageHeading"]);
            }
            else
            {
                _productImportError = result.Error;
            }
        }
        catch (Exception)
        {
            _productImportError = Loc["ImportErrorGeneric"];
        }
        finally
        {
            _isImportingProducts = false;
        }
    }

    /// <summary>
    /// Bulk-picture picker: buffer every selected image immediately (the
    /// IBrowserFile streams die with the JS registry — same lesson as
    /// CreateProduct.razor), pre-filter content type + size, and hand the
    /// batch to the explicit Upload button.
    /// </summary>
    private async Task OnPicturesSelectedAsync(InputFileChangeEventArgs e)
    {
        _pictureUploadFailures = new List<PictureUploadFailure>();
        _picturesUploaded = 0;
        _pictureUploadDone = 0;

        if (e.FileCount == 0)
        {
            return; // picker cancelled — keep the previous batch
        }

        var accepted = new List<PendingPicture>(e.FileCount);
        var rejected = new List<PictureUploadFailure>();

        foreach (var file in e.GetMultipleFiles(MaxPicturesPerBatch))
        {
            // ── Pre-filter: content type + size (client-side mirror of the
            //    backend's checks — the backend's magic-byte sniff stays
            //    the authority). Rejected files become per-file failure
            //    entries in the results list, not silent drops.
            if (!AllowedPictureContentTypes.Contains(file.ContentType))
            {
                rejected.Add(new PictureUploadFailure(file.Name, Loc["PictureUploadErrorType"]));
                continue;
            }

            if (file.Size > MaxPictureFileSizeBytes)
            {
                rejected.Add(new PictureUploadFailure(file.Name, Loc["PictureUploadErrorSize"]));
                continue;
            }

            try
            {
                await using var stream = file.OpenReadStream(maxAllowedSize: MaxPictureFileSizeBytes);
                using var ms = new System.IO.MemoryStream();
                await stream.CopyToAsync(ms);
                accepted.Add(new PendingPicture(file.Name, file.ContentType, ms.ToArray()));
            }
            catch (System.IO.IOException)
            {
                rejected.Add(new PictureUploadFailure(file.Name, Loc["PictureUploadErrorRead"]));
            }
        }

        _pendingPictures = accepted;

        if (rejected.Count > 0)
        {
            // Surface the pre-filter rejections in the results ledger
            // (same shape as upload failures — file name + reason).
            _pictureUploadFailures = rejected;
            await Toast.Warning(Loc["PictureUploadSomeRejected", rejected.Count], summary: Loc["PageHeading"]);
        }
    }

    /// <summary>
    /// Uploads the buffered batch: one SaveWithOriginalNameAsync per file
    /// (name-preserving — the restore contract), collecting per-file
    /// failures instead of aborting the batch.
    /// </summary>
    private async Task UploadPendingPicturesAsync()
    {
        if (_pendingPictures.Count == 0 || _isUploadingPictures)
        {
            return;
        }

        _isUploadingPictures = true;
        _picturesUploaded = 0;
        _pictureUploadDone = 0;
        var failures = new List<PictureUploadFailure>();

        try
        {
            var batch = _pendingPictures;
            foreach (var picture in batch)
            {
                try
                {
                    using var stream = new System.IO.MemoryStream(picture.Bytes, writable: false);
                    await FileStorage.SaveWithOriginalNameAsync(
                        stream, picture.FileName, picture.ContentType, CancellationToken.None);
                    _picturesUploaded++;
                }
                catch (System.IO.InvalidDataException ex)
                {
                    // Backend rejected the file (bad magic bytes, type
                    // mismatch, oversize, unusable name). The pre-filter
                    // already catches most of these — this is the
                    // server-side backstop.
                    failures.Add(new PictureUploadFailure(picture.FileName, ex.Message));
                }
                catch (Exception)
                {
                    // Storage I/O failure — also per-file, not fatal.
                    failures.Add(new PictureUploadFailure(picture.FileName, Loc["PictureUploadErrorStorage"]));
                }
                finally
                {
                    _pictureUploadDone++;
                    StateHasChanged(); // progress text updates per file
                }
            }

            _pictureUploadFailures = failures;
            _pendingPictures = new List<PendingPicture>();

            if (failures.Count == 0)
            {
                await Toast.Success(Loc["PictureUploadDone", _picturesUploaded], summary: Loc["PageHeading"]);
            }
            else
            {
                await Toast.Warning(Loc["PictureUploadDoneWithFailures", _picturesUploaded, failures.Count], summary: Loc["PageHeading"]);
            }
        }
        finally
        {
            _isUploadingPictures = false;
        }
    }

    /// <summary>
    /// Discards the buffered batch without uploading (the picker's Clear
    /// button).
    /// </summary>
    private void ClearPendingPictures()
    {
        _pendingPictures = new List<PendingPicture>();
        _pictureUploadFailures = new List<PictureUploadFailure>();
        _picturesUploaded = 0;
        _pictureUploadDone = 0;
    }

    /// <summary>
    /// Drops ONE buffered picture from the pending batch (the chip's ✕
    /// button) — a wrongly-picked file can be removed without losing the
    /// rest of the selection.
    /// </summary>
    private void RemovePendingPicture(PendingPicture picture)
    {
        _pendingPictures.Remove(picture);
    }

    // ── CSV template + import-report downloads (admin-only) ────────────
