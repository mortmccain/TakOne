  <data name="GenderHint" xml:space="preserve">
    <value>لطفاً یکی را انتخاب کنید. این مقدار بعداً قابل تغییر نیست.</value>
  </data>

  <data name="FieldGroupName" xml:space="preserve">
    <value>نام گروه</value>
  </data>
