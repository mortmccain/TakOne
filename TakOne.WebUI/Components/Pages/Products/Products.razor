    // ── Language toggle (EN | FA) ───────────────────────────────────────
    // Single-click switch: clicking EN or FA immediately commits the culture
    // cookie and force-reloads the page. No popup, no Save button. The
    // cookie format/name matches what Program.cs's CookieRequestCultureProvider
    // reads. force-reload so App.razor re-evaluates <html lang/dir> from the
    // new CurrentUICulture and the whole page swaps RTL/LTR + localized strings.
    // If the user clicks the already-active language, we no-op (avoids an
    // unnecessary reload).
    private async Task SetCultureAsync(string culture)
    {
        if (string.Equals(culture, _currentCulture, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        var cookieValue = $"c={culture}|uic={culture}";
        await JS.InvokeVoidAsync("eval",
            $"document.cookie = 'takone_culture={cookieValue}; path=/; max-age=31536000; samesite=strict'");
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    // ── Theme toggle (sun/moon) ────────────────────────────────────────
    // Flips between tak-light and tak-dark. If the current theme is neither
    // (e.g. user picked "material-dark" from the sidebar dropdown), we
    // default to flipping TO tak-light — this way the sun/moon button always
    // lands on a known Tak theme and the icon's meaning stays predictable.
    //
    // No force-reload needed — theme.js's takTheme.set() swaps the CSS <link>
    // href in-place and appends/removes the override <link> at runtime. The
    // whole page re-paints with the new theme without a round-trip. We just
    // update _currentTheme + StateHasChanged so the sun/moon icon flips too.
    private async Task ToggleThemeAsync()
    {
        var newTheme = _currentTheme == "tak-dark" ? "tak-light" : "tak-dark";

        try
        {
            await JS.InvokeVoidAsync("takTheme.set", newTheme);
            _currentTheme = newTheme;
        }
        catch (JSException)
        {
            // Swallow — same defensive pattern as MainLayout/ShopLayout's
            // OnThemeChanged. If theme.js didn't load, the toggle silently
            // fails rather than crashing the Blazor circuit.
        }
    }

