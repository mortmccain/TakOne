    // ── User avatar helpers ─────────────────────────────────────────────

    /// <summary>
    /// Returns the first character of the current user's ACTUAL NAME (not
    /// their worker ID / username). Used as the single-letter initial
    /// inside the circle avatar in the shop header — matches the HTML
    /// reference design at /upload/tak-makaron-pc-design.html.
    ///
    /// Falls back to "؟" (Persian question mark) if the name is empty/null
    /// (shouldn't happen — ICurrentUserService.FullName falls back to the
    /// worker ID — but defensive).
    /// </summary>
    private string GetUserInitial()
    {
        var name = CurrentUser.FullName?.Trim();
        return string.IsNullOrEmpty(name) ? "؟" : name.Substring(0, 1);
    }

    /// <summary>
    /// Returns the user's access level as a localized label for the avatar
    /// badge. The mapping (per user spec):
    ///   Admin     → "admin"   (English — the only English label)
    ///   Manager   → "مدیر"     (Director/Manager)
    ///   Employee  → "کارمند"   (Employee)
    ///   Customer  → "کارمند"   (Employee — same label, per spec)
    ///   ReadOnly  → "مدیر"     (Director/Manager — same label, per spec)
    ///
    /// IsInRole checks are used (not a single role string) because a user
    /// can have multiple roles — Admin+Manager is common. We check in
    /// priority order: Admin > Manager > Employee > ReadOnly > Customer.
    /// </summary>
    private string GetRoleLabel()
    {
        if (CurrentUser.IsInRole(Roles.Admin)) return Loc["RoleAdmin"];
        if (CurrentUser.IsInRole(Roles.Manager)) return Loc["RoleManager"];
        if (CurrentUser.IsInRole(Roles.Employee)) return Loc["RoleEmployee"];
        if (CurrentUser.IsInRole(Roles.ReadOnly)) return Loc["RoleReadOnly"];
        if (CurrentUser.IsInRole(Roles.Customer)) return Loc["RoleCustomer"];
        return Loc["RoleEmployee"]; // fallback
    }

    // ── Display helpers ─────────────────────────────────────────────────

    /// <summary>
    /// Formats a MoneyDto for display. IRR is converted to Toman (amount ÷ 10)
    /// and labelled "تومان" — matches the Dashboard convention
    /// (GetDashboardStatsQueryHandler). Other currencies pass through unchanged.
    /// </summary>
    private static string FormatPrice(MoneyDto? price)
    {
        if (price is null || price.Amount == 0) return "—";
        var isIrr = string.Equals(price.Currency, "IRR", StringComparison.OrdinalIgnoreCase);
        var displayAmount = isIrr ? price.Amount / 10m : price.Amount;
        var amount = displayAmount.ToString("N0", CultureInfo.CurrentCulture);
        var unit = isIrr ? "تومان" : price.Currency;
        return $"{amount} {unit}";
    }

    /// <summary>
    /// Converts Latin digits in a number/string to Persian digits (۰۱۲۳۴۵۶۷۸۹).
    /// Persian culture already does this for ToString("N0"), but for integer
    /// counts (like "5 کالا") we render via @ToPersian(5) — which would
    /// otherwise show Latin digits in any culture. This helper keeps the
    /// page's digit system consistent with the rest of the Persian UI.
    /// Returns the original string for null/empty/non-numeric input.
    /// </summary>
    private static string ToPersian(int value)
    {
        // Use the current culture's digit shape — for fa-IR this is Persian,
        // for en-US this is Latin. Respects the language switcher.
        return value.ToString("N0", CultureInfo.CurrentCulture)
                   .Replace(",", ""); // counts don't need thousand separators
    }

    private static string ToPersian(decimal value)
    {
        return value.ToString("N0", CultureInfo.CurrentCulture);
    }

    /// <summary>
    /// Translates a backend <c>Result.Error</c> string into a user-facing,
    /// culture-aware message. Returns null if the error doesn't match a
    /// known pattern (the caller should fall back to a generic localized
    /// "something went wrong" message).
    ///
    /// Currently handles:
    ///   - <c>PurchaseLimitExceeded:{name}|{limit}</c> — produced by
    ///     CreateOrAppendSale / UpdateSaleLineItem / SubmitSale handlers.
    ///     Localized via the PurchaseLimitExceeded resx key, which does
    ///     NOT mention "groups" (the original Persian error leaked the
    ///     internal group concept to customers).
    ///   - <c>CategoryDeactivated:{productName}</c> — produced by
    ///     CreateOrAppendSale / AddItemToSale / SubmitSale handlers when
    ///     the product's category / sub / sub-sub has been deactivated.
    ///     Localized via the CategoryDeactivated resx key. The product's
    ///     StockQuantity is preserved; only visibility + buyability are
    ///     suppressed.
    /// </summary>
    private string? LocalizeError(string? error)
    {
        if (PurchaseLimitErrors.TryParse(error, out var productName, out var limit))
        {
            return string.Format(
                CultureInfo.CurrentCulture,
                Loc["PurchaseLimitExceeded"],
                productName,
                limit);
        }
        if (CategoryDeactivatedErrors.TryParse(error, out var deactivatedProductName))
        {
            return string.Format(
                CultureInfo.CurrentCulture,
                Loc["CategoryDeactivated"],
                deactivatedProductName);
        }
        // Stable error code returned by SubmitSaleCommandHandler when the
        // cart is empty — defense-in-depth guard that should never fire.
        // If it does, show a localized message instead of the raw code.
        if (error == "SubmitEmptyCart")
        {
            return Loc["SubmitEmptyCart"];
        }
        // Step 10d — CartConflict is produced when AddItemToSale /
        // UpdateSaleLineItem / RemoveSaleLineItem / SubmitSale detects
        // that the sale was mutated (or submitted) by a concurrent
        // invocation between the initial load and the cart-lock acquire.
        // The customer just needs to refresh the page.
        if (CartConflictErrors.TryParse(error))
        {
            return Loc["CartConflict"];
        }
        return error;
    }

    /// <summary>
    /// Translates QuickReorderLastSaleCommand's stable error codes
    /// ("QuickReorderNothingToAdd", "QuickReorderNothingNewAdded") into
    /// culture-aware messages. Returns null for any other error so the
    /// caller falls back to a generic message.
    /// </summary>
    private string? LocalizeReorderError(string? error)
    {
        return error switch
        {
            "QuickReorderNothingToAdd" => Loc["ToastReorderNothingToAdd"],
            "QuickReorderNothingNewAdded" => Loc["ToastReorderNothingNewAdded"],
            _ => error
        };
    }
}