@* Products.razor — Tak shop page redesign
   Built to closely mirror the design at /upload/tak-makaron-pc-design.html.

   LAYOUT (top to bottom):
     1. Header: hamburger + language toggle | search bar (Ctrl+F to focus) | user icon (settings) + cart icon
        (Portal brand "تک ماکارون" / "پورتال سفارش کارکنان" + its icon
         used to live here in the top bar; they have been MOVED to the
         top of the ShopLayout sidebar — see ShopLayout.razor.)
     2. Golden shimmer line (animated gradient, like the HTML's announcement bar)
     3. Stats bar (5 cards):
          - سفارش های این ماه (orders this month — count)
          - مجموع خرید های این ماه (total spent this month — amount)
          - مجموع خرید های این سال (total spent this year — amount)
          - تعداد اجناس موجود (count of in-stock products)
          - سفارش سریع (Quick Reorder button — loads last order, clamped to current limits)
     4. Main 3-col grid:
          - RIGHT (col 2/12): categories sidebar
          - CENTER (col 7/12): hero banner + filter bar + product grid + pager
          - LEFT (col 3/12): mini cart (no discount, no add-another-item, no schedule-delivery, only submit)

   HERO BANNER:
     - ویژه کارکنان badge (unchanged)
     - Title: "تنها در اوج،" (white) + "تک ماکارون" (gold) — two-tone
     - No subtitle paragraph (removed per spec)
     - Golden button: "سفارش های من" (navigates to /Sales)
     - Green button: "سبد خرید" (navigates to /Cart)

   PRODUCT CARD:
     - Image (placeholder icon when no PictureUrl)
     - "موجود" stock badge (color varies by stock level)
     - NO heart icon (no favorites feature)
     - NO discount tag (no discount model)
     - NO code (کد: TM-XXXX)
     - NO stars
     - Name (green, bold)
     - Description (gray, under name) — required by spec
     - Price (no strikethrough, no "عمده" wholesale tag)
     - Quantity selector + Add-to-cart button
        - The qty selector's max is the user's remaining limit (MyPurchaseLimit - qty in cart)
        - If no limit (staff), max is product.StockQuantity
        - When remaining = 0, the add button is disabled and shows the
          "you have already selected the maximum available per person" text

   CART INTEGRATION:
     - Loaded in parallel with products + categories on init
     - Reloaded after every add-to-cart / qty change / submit
     - Mini-cart uses CartDto (same as /Cart page) but trimmed to show
       only: header, items (with qty controls), totals (no discount line),
       submit button. No "+add another item", no "schedule delivery".

   STATS NOTE:
     The 4 numeric stats (monthly count, monthly total, yearly total,
     stock count) currently use placeholder values via a small
     GetStubStatsAsync() method. The backend doesn't yet have a
     user-scoped stats query — that's a TODO for a later iteration.
     The Quick Reorder stat is fully functional (calls
     QuickReorderLastSaleCommand which loads the last submitted sale
     and re-adds lines clamped to current stock + current limit). *@

@page "/Products"
@attribute [Authorize]
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Wolverine
@using TakOne.Application.Common.Authorization
@using TakOne.Application.Common.Errors
@using TakOne.Application.Common.Interfaces
@using TakOne.Application.Products.DTOs
@using TakOne.Application.Products.Queries.GetProductsPaginated
@using TakOne.Application.Categories.DTOs
@using TakOne.Application.Categories.Queries.GetActiveCategories
@using TakOne.Application.Sales.DTOs
@using TakOne.Application.Sales.Queries.GetActiveCartForUser
@using TakOne.Application.Sales.Commands.CreateOrAppendSale
@using TakOne.Application.Sales.Commands.UpdateSaleLineItem
@using TakOne.Application.Sales.Commands.SubmitSale
@using TakOne.Application.Sales.Commands.QuickReorderLastSale
@using TakOne.Application.Sales.Queries.GetCustomerShopStats
@using TakOne.SharedKernel.Common
@using TakOne.SharedKernel.DTOs
@using TakOne.WebUI.Components.CartBudgetBar
@using TakOne.WebUI.Services
@inject IMessageBus MessageBus
@inject ICurrentUserService CurrentUser
@inject NavigationManager Navigation
@inject ToastService Toast
@inject IJSRuntime JS
@inject IStringLocalizer<Products> Loc

<PageTitle>@Loc["PageTitle"]</PageTitle>

@* Use ShopLayout (no default top bar — full-screen shop experience).
   The shop header below sticks to the top via CSS position: sticky. *@
@layout TakOne.WebUI.Components.Layout.ShopLayout

@* products.css is loaded globally by App.razor (scoped under .tm-shop-page,
   so it doesn't affect other routes). No per-page <link> needed here. *@

<div class="tm-shop-page">

    @* ── 1. HEADER: hamburger + language toggle | search bar | cart + user avatar ── *@
    @* (Portal brand icon + "تک ماکارون" / "پورتال سفارش کارکنان" used to sit here
       too — they have been MOVED to the top of the ShopLayout sidebar.) *@
    @* The gold shimmer line sits INSIDE <header> so it sticks along with the
       header (position:sticky is on .tm-shop-header). Previously the shimmer
       was a sibling of the header and scrolled away under the sticky header.
       Moving it inside the header element makes both stick together — no
       wrapper div needed, no extra CSS, works on all themes. *@
    <header class="tm-shop-header">
        <div class="tm-shop-header-inner">

            @* Right side (RTL): hamburger + language toggle.
               The portal brand (icon + "تک ماکارون" title +
               "پورتال سفارش کارکنان" subtitle) used to sit here too,
               but has been MOVED to the top of the ShopLayout sidebar
               (see ShopLayout.razor's .tm-sidebar-brand block). The
               hamburger and language toggle remain in the top bar. *@
            <div class="tm-portal-block">
                @* Hamburger — toggles the ShopLayout's sidebar. Cast to
                   the concrete layout type so we can call ToggleSidebar(). *@
                <button type="button"
                        class="tm-hamburger"
                        title="@Loc["MenuTitle"]"
                        aria-label="@Loc["MenuAriaLabel"]"
                        @onclick="ToggleSidebar">
                    @* Inline style on <path> as a DEFENSIVE fallback — the CSS
                       rule `.tm-hamburger svg path { stroke: var(--tm-green) !important; }`
                       is the primary fix, but if Radzen's CSS somehow overrides
                       even !important (e.g. via a runtime-injected style), this
                       inline style has the highest priority and guarantees the
                       hamburger lines are visible. Hardcoded color (not var())
                       because CSS variables don't work in inline SVG attributes
                       outside of style="" — and we want this to work even if
                       the .tm-shop-page variable scope somehow isn't applied. *@
                    <svg fill="none" stroke="#0E4D3C" viewBox="0 0 24 24" stroke-width="2" width="24" height="24" aria-hidden="true" style="display:block;">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" style="stroke:#0E4D3C;fill:none;" />
                    </svg>
                </button>
                @* PORTAL BRAND (icon + title "تک ماکارون" + subtitle
                   "پورتال سفارش کارکنان") has been MOVED to the top of the
                   ShopLayout sidebar. See ShopLayout.razor's .tm-sidebar-brand
                   block. The hamburger and language toggle remain here in the
                   top bar — everything else in the top bar is unchanged. *@

                @* EN | FA language toggle. Plain text — no background, no popup.
                   Clicking either code immediately commits the culture cookie
                   and force-reloads the page so App.razor re-evaluates
                   <html lang/dir> from the new CurrentUICulture (fa-IR → RTL,
                   en-US → LTR). The active language is rendered with the
                   theme accent color so the user can see which one is current. *@
                <div class="tm-lang-toggle" role="group" aria-label="@Loc["LanguageAriaLabel"]">
                    <button type="button"
                            class='tm-lang-btn @(_currentCulture == "en-US" ? "is-active" : "")'
                            aria-pressed='@(_currentCulture == "en-US")'
                            @onclick='(() => SetCultureAsync("en-US"))'>
                        EN
                    </button>
                    <span class="tm-lang-sep" aria-hidden="true">|</span>
                    <button type="button"
                            class='tm-lang-btn @(_currentCulture == "fa-IR" ? "is-active" : "")'
                            aria-pressed='@(_currentCulture == "fa-IR")'
                            @onclick='(() => SetCultureAsync("fa-IR"))'>
                        FA
                    </button>
                </div>
            </div>

            @* Center: search bar with Ctrl+F kbd badge *@
            <div class="tm-search-block">
                <input type="text"
                       id="tm-shop-search-input"
                       class="tm-search-input"
                       placeholder="@Loc["SearchPlaceholder"]"
                       value="@_searchTerm"
                       @oninput="OnSearchInput"
                       @onkeypress="OnSearchKeypress" />
                <svg class="tm-search-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" width="20" height="20" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.2-5.2M17 11a6 6 0 11-12 0 6 6 0 0112 0z" />
                </svg>
                <div class="tm-search-kbd">
                    <kbd>Ctrl</kbd>
                    <kbd>F</kbd>
                </div>
            </div>

            @* Left side (RTL): cart icon + theme toggle (sun/moon) + user avatar *@
            <div class="tm-actions-block">
                @* Cart icon — visible to everyone EXCEPT ReadOnly.
                   ReadOnly users cannot buy (CreateOrAppendSaleCommand is
                   gated to Admin/Manager/Employee/Customer via
                   [RequireRoles]), so showing them a cart icon would be
                   misleading UX. Matches the sidebar Cart nav link in
                   SidebarContent.razor which also excludes ReadOnly. *@
                <AuthorizeView Roles="@(Roles.Admin + "," + Roles.Manager + "," + Roles.Employee + "," + Roles.Customer)">
                    <button type="button"
                            class="tm-icon-button"
                            title="@Loc["CartTitle"]"
                            @onclick="GoToCart">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" width="24" height="24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z" />
                        </svg>
                        @if (_cart is { } c && c.TotalItemCount > 0)
                        {
                            <span class="tm-badge">@ToPersian(c.TotalItemCount)</span>
                        }
                    </button>
                </AuthorizeView>

                @* Theme quick-toggle — switches between tak-light and tak-dark.
                   The ICON itself changes with the theme: when the LIGHT theme
                   is active, a MOON icon is shown (click → switch to dark);
                   when the DARK theme is active, a SUN icon is shown (click →
                   switch to light). This is the standard sun/moon toggle
                   convention — the icon shows what you'll switch TO, not what
                   you're currently on.

                   Only tak-light ↔ tak-dark are toggled. If the user picked a
                   different Radzen theme (e.g. material-dark) from the sidebar
                   dropdown, this button still toggles to the most-recent Tak
                   theme — but for the common case (user uses the sun/moon
                   toggle exclusively), it's a clean light/dark flip.

                   Styling: no background (transparent), inherits currentColor
                   so the icon picks up the theme's text color. Hover gives a
                   subtle accent-color tint via .tm-theme-toggle:hover in CSS. *@
                <button type="button"
                        class="tm-icon-button tm-theme-toggle"
                        title='@(_currentTheme == "tak-dark" ? Loc["ThemeSwitchToLight"] : Loc["ThemeSwitchToDark"])'
                        aria-label='@(_currentTheme == "tak-dark" ? Loc["ThemeSwitchToLight"] : Loc["ThemeSwitchToDark"])'
                        @onclick="ToggleThemeAsync">
                    @if (_currentTheme == "tak-dark")
                    {
                        @* Sun icon — shown when dark is active (click → light) *@
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" width="22" height="22" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
                        </svg>
                    }
                    else
                    {
                        @* Moon icon — shown when light is active (click → dark) *@
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" width="22" height="22" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
                        </svg>
                    }
                </button>

                @* User avatar — circle with first initial of the user's actual
                   name (NOT their worker ID) + their access level. Clicking it
                   goes to /Settings (same as the previous gear icon).
                   Matches the HTML reference design at /upload/tak-makaron-pc-design.html. *@
                <button type="button"
                        class="tm-user-block"
                        title="@Loc["UserMenuTitle"]"
                        @onclick="GoToSettings">
                    <div class="tm-user-text">
                        <p class="tm-user-name">@CurrentUser.FullName</p>
                        <p class="tm-user-role">@GetRoleLabel()</p>
                    </div>
                    @* Inline style on the avatar div as a DEFENSIVE fallback.
                       The CSS rule `.tm-user-avatar { border-radius: 50% !important; }`
                       is the primary fix, but if a Radzen rule somehow overrides
                       even !important, this inline style guarantees the avatar
                       stays circular. Hardcoded gradient (not var()) because
                       CSS variables in inline styles CAN work here (the element
                       is inside .tm-shop-page) but we want maximum robustness. *@
                    <div class="tm-user-avatar"
                         style="border-radius:50%; -webkit-border-radius:50%; -moz-border-radius:50%; background:linear-gradient(135deg, #0E4D3C, #0A3528); width:44px; height:44px; display:flex; align-items:center; justify-content:center; overflow:hidden; flex-shrink:0; position:relative; box-shadow:0 0 0 2px rgba(201,162,39,0.3), 0 2px 8px rgba(14,77,60,0.3);">
                        <span class="tm-user-avatar-initial">@GetUserInitial()</span>
                    </div>
                </button>

                @* LOGOUT BUTTON — sits on the OUTER side of the user avatar
                   in BOTH layouts (left in RTL/Persian, right in LTR/English).
                   Same pattern as MainLayout.razor — see that file's comment
                   block for the full CSRF-safe POST-form rationale. The
                   /Account/SignOut endpoint is POST-only and validated by
                   the UseAntiforgery middleware against the
                   __RequestVerificationToken rendered by <AntiforgeryToken />. *@
                <form method="post" action="/Account/SignOut" class="tm-logout-form">
                    <AntiforgeryToken />
                    <button type="submit"
                            class="tm-icon-button tm-logout-button"
                            title="@Loc["LogoutTitle"]"
                            aria-label="@Loc["LogoutAriaLabel"]">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" width="24" height="24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l3 3m0 0l-3 3m3-3H2.25" />
                        </svg>
                    </button>
                </form>
            </div>
        </div>

        @* ── 2. GOLDEN SHIMMER LINE — inside <header> so it sticks with it ── *@
        <div class="tm-gold-shimmer" aria-hidden="true"></div>
    </header>

    @* ── 3. STATS BAR ── *@
    <div class="tm-stats-bar">
        <div class="tm-stats-inner">

            @* سفارش های این ماه *@
            <div class="tm-stat-item">
                <div class="tm-stat-icon tm-stat-icon-gold">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" width="24" height="24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25z" />
                    </svg>
                </div>
                <div class="tm-stat-body">
                    <p class="tm-stat-label">@Loc["StatOrdersThisMonth"]</p>
                    <p class="tm-stat-value tm-persian-num">@ToPersian(_stats?.OrdersThisMonth ?? 0) @Loc["StatOrdersUnit"]</p>
                </div>
            </div>

            @* مجموع خرید های این ماه *@
            <div class="tm-stat-item">
                <div class="tm-stat-icon tm-stat-icon-green">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" width="24" height="24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z" />
                    </svg>
                </div>
                <div class="tm-stat-body">
                    <p class="tm-stat-label">@Loc["StatMonthlyTotal"]</p>
                    <p class="tm-stat-value tm-persian-num">@FormatPrice(_stats?.MonthlyTotal)</p>
                </div>
            </div>

            @* مجموع خرید های این سال *@
            <div class="tm-stat-item">
                <div class="tm-stat-icon tm-stat-icon-gold">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" width="24" height="24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
                    </svg>
                </div>
                <div class="tm-stat-body">
                    <p class="tm-stat-label">@Loc["StatYearlyTotal"]</p>
                    <p class="tm-stat-value tm-persian-num">@FormatPrice(_stats?.YearlyTotal)</p>
                </div>
            </div>

            @* تعداد اجناس موجود *@
            <div class="tm-stat-item">
                <div class="tm-stat-icon tm-stat-icon-green">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" width="24" height="24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
                    </svg>
                </div>
                <div class="tm-stat-body">
                    <p class="tm-stat-label">@Loc["StatInStockCount"]</p>
                    <p class="tm-stat-value tm-persian-num">@ToPersian(_stats?.InStockProductCount ?? 0) @Loc["StatInStockUnit"]</p>
                </div>
            </div>

            @* سفارش سریع — clickable button *@
            <button type="button"
                    class="tm-stat-item tm-stat-item--button"
                    disabled="@(_isReordering || _isReadOnly)"
                    title="@(_isReadOnly ? Loc["QuickReorderReadOnlyTitle"] : Loc["StatQuickReorderTitle"])"
                    @onclick="QuickReorderAsync">
                <div class="tm-stat-icon tm-stat-icon-gold">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" width="24" height="24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                    </svg>
                </div>
                <div class="tm-stat-body">
                    <p class="tm-stat-label">@Loc["StatQuickReorder"]</p>
                    <p class="tm-stat-value">@Loc["StatQuickReorderValue"]</p>
                </div>
            </button>
        </div>
    </div>

    @* ── 4. MAIN 3-COL GRID ── *@
    <main class="tm-shop-main">

        @* ── 4a. RIGHT (col 2/12): CATEGORIES SIDEBAR ── *@
        <aside>
            <div class="tm-categories-card">
                <h3 class="tm-categories-title">@Loc["CategoriesTitle"]</h3>
                <nav>
                    <ul class="tm-cat-list">
                        <li>
                            <button type="button"
                                    class="tm-cat-item @(_selectedCategoryId is null ? "is-active" : "")"
                                    @onclick="(() => OnCategoryChanged(null))">
                                <span class="tm-cat-icon-bg">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" width="16" height="16" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zm9.75 0A2.25 2.25 0 0115.75 3.75H18A2.25 2.25 0 0120.25 6v2.25a2.25 2.25 0 01-2.25 2.25h-2.25A2.25 2.25 0 0113.5 8.25V6zm-9.75 9.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zm9.75 0a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
                                    </svg>
                                </span>
                                <span>@Loc["AllCategories"]</span>
                                <span class="tm-cat-count tm-persian-num">@ToPersian(_totalCount)</span>
                            </button>
                        </li>
                        @foreach (var cat in _categories)
                        {
                            var catId = cat.Id; // closure capture
                            <li>
                                <button type="button"
                                        class="tm-cat-item @(_selectedCategoryId == catId ? "is-active" : "")"
                                        @onclick="(() => OnCategoryChanged(catId))">
                                    <span class="tm-cat-icon-bg">
                                        <svg fill="currentColor" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                                            <path d="M4 4h16v2H4zm0 4h16v2H4zm0 4h16v2H4zm0 4h16v2H4z" />
                                        </svg>
                                    </span>
                                    <span>@cat.Name</span>
                                </button>
                            </li>
                        }
                    </ul>
                </nav>
                @* No "special offer" card, no "stock availability" panel — both removed per spec. *@
            </div>
        </aside>

        @* ── 4b. CENTER (col 7/12): HERO + PRODUCT GRID ── *@
        <section>

            @* HERO BANNER *@
            <div class="tm-hero">
                @* Image placeholder. User said "different picture (not the weird flower) that I'll set for it".
                   Until they set it, leave the slot empty (no image rendered — the green gradient still shows). *@
                <div class="tm-hero-image" aria-hidden="true">
                    @* <img src="/images/hero-placeholder.png" alt="" /> *@
                </div>
                <div class="tm-hero-content">
                    <span class="tm-hero-badge">
                        <span class="tm-pulse-dot"></span>
                        @Loc["HeroBadge"]
                    </span>
                    <h2 class="tm-hero-title">
                        @Loc["HeroTitleWhite"]
                        <span class="tm-hero-title-gold">@Loc["HeroTitleGold"]</span>
                    </h2>
                    @* No subtitle paragraph — removed per spec *@
                    <div class="tm-hero-buttons">
                        <button type="button" class="tm-hero-btn-gold" @onclick="GoToMyOrders">
                            @Loc["HeroButtonMyOrders"]
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" width="16" height="16" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                            </svg>
                        </button>
                        <button type="button" class="tm-hero-btn-green" @onclick="GoToCart">
                            @Loc["HeroButtonCart"]
                        </button>
                    </div>
                </div>
            </div>

            @* PRODUCTS HEADER (count + active filter chips) *@
            <div class="tm-products-header">
                <div class="tm-products-title-block">
                    <h3 class="tm-products-title">@Loc["ProductsHeading"]</h3>
                    <span class="tm-products-count tm-persian-num">@ToPersian(_totalCount) @Loc["ProductsCountUnit"]</span>

                    @* ACTIVE FILTER CHIPS
                       Render one chip per active filter (search term, category)
                       next to the count. Each chip shows what's currently
                       filtered and offers a one-click X to clear JUST that
                       filter (the other filter, if any, stays active).
                       When both filters are active at once, an additional
                       "Clear all" pill appears at the end so the user can
                       wipe everything in one click. *@
                    @if (HasActiveFilters)
                    {
                        <div class="tm-active-filters" role="group" aria-label="@Loc["ActiveFiltersLabel"]">
                            @if (!string.IsNullOrWhiteSpace(_searchTerm))
                            {
                                <button type="button"
                                        class="tm-filter-chip tm-filter-chip-search"
                                        title="@Loc["ClearSearchTooltip"]"
                                        aria-label="@string.Format(Loc["ClearSearchAria"], _searchTerm)"
                                        @onclick="ClearSearchAsync">
                                    <svg class="tm-filter-chip-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" width="14" height="14" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.2-5.2M17 11a6 6 0 11-12 0 6 6 0 0112 0z" />
                                    </svg>
                                    <span class="tm-filter-chip-label">"@_searchTerm"</span>
                                    <svg class="tm-filter-chip-x" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" width="14" height="14" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                    </svg>
                                </button>
                            }
                            @if (GetSelectedCategoryName() is { } categoryName)
                            {
                                <button type="button"
                                        class="tm-filter-chip tm-filter-chip-category"
                                        title="@Loc["ClearCategoryTooltip"]"
                                        aria-label="@string.Format(Loc["ClearCategoryAria"], categoryName)"
                                        @onclick="(() => OnCategoryChanged(null))">
                                    <svg class="tm-filter-chip-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" width="14" height="14" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9.776c.112-.017.227-.026.344-.026h15.812c.117 0 .232.009.344.026m-16.5 0a2.25 2.25 0 00-1.883 2.542l.857 6a2.25 2.25 0 002.227 1.932H19.05a2.25 2.25 0 002.227-1.932l.857-6a2.25 2.25 0 00-1.883-2.542m-16.5 0V6A2.25 2.25 0 016 3.75h3.879a1.5 1.5 0 011.06.44l2.122 2.12a1.5 1.5 0 001.06.44H18A2.25 2.25 0 0120.25 9v.776" />
                                    </svg>
                                    <span class="tm-filter-chip-label">@categoryName</span>
                                    <svg class="tm-filter-chip-x" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" width="14" height="14" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                    </svg>
                                </button>
                            }
                            @if (HasMultipleActiveFilters)
                            {
                                <button type="button"
                                        class="tm-filter-chip tm-filter-chip-clear-all"
                                        title="@Loc["ClearAllFiltersTooltip"]"
                                        aria-label="@Loc["ClearAllFiltersAria"]"
                                        @onclick="ClearFilters">
                                    <svg class="tm-filter-chip-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" width="14" height="14" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M1 7h22M9 7V4a2 2 0 012-2h2a2 2 0 012 2v3" />
                                    </svg>
                                    <span class="tm-filter-chip-label">@Loc["ClearAllFiltersButton"]</span>
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>

            @* LOADING / ERROR / EMPTY / GRID *@
            @if (_isLoading)
            {
                <div class="tm-loading">
                    <div class="tm-spinner"></div>
                    <p class="tm-loading-text">@Loc["LoadingProducts"]</p>
                </div>
            }
            else if (!string.IsNullOrEmpty(_loadError))
            {
                <div class="tm-empty">
                    <div class="tm-empty-icon">⚠</div>
                    <h4 class="tm-empty-title">@Loc["LoadErrorTitle"]</h4>
                    <p class="tm-empty-text">@(string.IsNullOrEmpty(_loadError) ? Loc["LoadErrorDefault"] : _loadError)</p>
                    <button type="button" class="tm-clear-btn" @onclick="LoadProductsAsync">@Loc["RetryButton"]</button>
                </div>
            }
            else if (_filteredProducts.Count == 0)
            {
                <div class="tm-empty">
                    <div class="tm-empty-icon">🔍</div>
                    <h4 class="tm-empty-title">@Loc["EmptyTitle"]</h4>
                    <p class="tm-empty-text">@Loc["EmptyMessage"]</p>
                    <button type="button" class="tm-clear-btn" @onclick="ClearFilters">@Loc["ClearFiltersButton"]</button>
                </div>
            }
            else
            {
                <div class="tm-product-grid">
                    @foreach (var product in _filteredProducts)
                    {
                        var remaining = GetRemainingForProduct(product);
                        var qty = GetQtyForProduct(product.Id);
                        var limitReached = remaining <= 0;
                        var stockOut = product.StockQuantity <= 0;
                        var disabled = limitReached || stockOut || _isAddingAny;
                        <div class="tm-product-card">
                            <div class="tm-product-image">
                                @if (!string.IsNullOrWhiteSpace(product.PictureUrl))
                                {
                                    <img src="@product.PictureUrl" alt="@product.Name" loading="lazy" />
                                }
                                else
                                {
                                    <span class="tm-product-image-placeholder">
                                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" width="64" height="64">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                                        </svg>
                                    </span>
                                }
                                @if (stockOut)
                                {
                                    <span class="tm-stock-badge">
                                        <span class="tm-stock-dot tm-stock-dot-out"></span>
                                        @Loc["StockOut"]
                                    </span>
                                }
                                else if (product.StockQuantity <= 10)
                                {
                                    <span class="tm-stock-badge">
                                        <span class="tm-stock-dot tm-stock-dot-low"></span>
                                        @Loc["StockLow"]
                                    </span>
                                }
                                else
                                {
                                    <span class="tm-stock-badge">
                                        <span class="tm-stock-dot tm-stock-dot-in"></span>
                                        @Loc["StockIn"]
                                    </span>
                                }
                            </div>

                            <div class="tm-product-body">
                                <h4 class="tm-product-name">@product.Name</h4>
                                <p class="tm-product-desc">@product.Description</p>
                                <p class="tm-product-price tm-persian-num">
                                    @FormatPrice(product.Price)
                                </p>

                                <div class="tm-product-actions">
                                    <div class="tm-qty-selector">
                                        <button type="button"
                                                class="tm-qty-btn"
                                                disabled="@(qty <= 1 || _isReadOnly)"
                                                @onclick="(() => DecrementQty(product.Id))">
                                            −
                                        </button>
                                        <span class="tm-qty-value tm-persian-num">@ToPersian(qty)</span>
                                        <button type="button"
                                                class="tm-qty-btn"
                                                disabled="@(qty >= GetQtyMaxForProduct(product) || _isReadOnly)"
                                                @onclick="(() => IncrementQty(product.Id))">
                                            +
                                        </button>
                                    </div>
                                    @if (_isReadOnly)
                                    {
                                        <button type="button"
                                                class="tm-add-btn"
                                                disabled
                                                title="@Loc["AddButtonReadOnlyTitle"]">
                                            @Loc["AddButtonReadOnly"]
                                        </button>
                                    }
                                    else if (limitReached && !stockOut)
                                    {
                                        <button type="button"
                                                class="tm-add-btn tm-add-btn-text-full"
                                                disabled
                                                title="@Loc["AddButtonLimitReachedTitle"]">
                                            @Loc["AddButtonLimitReached"]
                                        </button>
                                    }
                                    else if (stockOut)
                                    {
                                        <button type="button" class="tm-add-btn" disabled>
                                            @Loc["AddButtonStockOut"]
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="tm-add-btn"
                                                disabled="@(_isAddingAny)"
                                                @onclick="(() => AddToCartAsync(product))">
                                            @if (_isAddingAny)
                                            {
                                                <span>…</span>
                                            }
                                            else
                                            {
                                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" width="16" height="16" aria-hidden="true">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272" />
                                                </svg>
                                                <span>@Loc["AddButtonText"]</span>
                                            }
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @* PAGER (only when there's more than 1 page) *@
                @if (_totalCount > _pageSize)
                {
                    var totalPages = (int)Math.Ceiling((double)_totalCount / _pageSize);
                    var startPage = Math.Max(1, _pageNumber - 2);
                    var endPage = Math.Min(totalPages, startPage + 4);
                    if (endPage - startPage < 4) startPage = Math.Max(1, endPage - 4);

                    <div class="tm-pager">
                        <button type="button"
                                class="tm-pager-btn"
                                disabled="@(_pageNumber <= 1)"
                                @onclick="(() => OnPageChanged(_pageNumber - 1))">
                            ‹
                        </button>

                        @for (var p = startPage; p <= endPage; p++)
                        {
                            var page = p;
                            <button type="button"
                                    class="tm-pager-btn @(page == _pageNumber ? "is-active" : "")"
                                    @onclick="(() => OnPageChanged(page))">
                                <span class="tm-persian-num">@ToPersian(page)</span>
                            </button>
                        }

                        <button type="button"
                                class="tm-pager-btn"
                                disabled="@(_pageNumber >= totalPages)"
                                @onclick="(() => OnPageChanged(_pageNumber + 1))">
                            ›
                        </button>

                        <span class="tm-pager-info tm-persian-num">
                            @string.Format(Loc["PagerInfo"], ToPersian(_pageNumber), ToPersian(totalPages), ToPersian(_totalCount))
                        </span>
                    </div>
                }
            }
        </section>

        @* ── 4c. LEFT (col 3/12): MINI CART ── *@
        <aside class="tm-mini-cart">
            <div class="tm-cart-header">
                <div class="tm-cart-header-left">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" width="20" height="20" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272" />
                    </svg>
                    <h3 class="tm-cart-header-title">@Loc["CartTitle"]</h3>
                </div>
                @if (_cart is { } cart && cart.TotalItemCount > 0)
                {
                    <span class="tm-cart-header-badge tm-persian-num">@ToPersian(cart.TotalItemCount) @Loc["CartUnit"]</span>
                }
            </div>

            @* Step 10e — CartBudgetBar (mini-cart version).
               Shown when _cart.BudgetInfo is populated (i.e. the customer
               has an active salary budget AND LimitMode enforces it). When
               null (staff, or LimitMode = CountOnly), the bar is absent
               and the mini-cart reverts to its pre-Step 10e layout.
               CartTotal is the live cart total from _cart.Total — the
               mini-cart doesn't track pending quantities like the full
               Cart page does, so we use the server snapshot directly. *@
            @if (_cart?.BudgetInfo is not null)
            {
                <CartBudgetBar Budget="_cart.BudgetInfo" CartTotal="_cart?.Total" />
            }

            @if (_cart is null || _cart.LineItems.Count == 0)
            {
                <div class="tm-cart-empty">
                    @Loc["CartEmpty"]
                </div>
            }
            else
            {
                <div class="tm-cart-items">
                    @foreach (var line in _cart.LineItems)
                    {
                        var lineMax = GetCartLineMax(line);
                        <div class="tm-cart-line">
                            <div class="tm-cart-line-img">
                                @* PictureUrl not in CartLineItemDto — show placeholder icon *@
                                <span class="tm-cart-line-img-placeholder">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" width="24" height="24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5z" />
                                    </svg>
                                </span>
                            </div>
                            <div class="tm-cart-line-body">
                                <p class="tm-cart-line-name">@line.ProductName</p>
                                <div class="tm-cart-line-controls">
                                    <div class="tm-cart-line-qty">
                                        <button type="button"
                                                disabled="@(_updatingLineId == line.Id || line.Quantity <= 1 || _isReadOnly)"
                                                @onclick="(() => UpdateCartLineQtyAsync(line.Id, line.Quantity - 1))">
                                            −
                                        </button>
                                        <span class="tm-persian-num">@ToPersian(line.Quantity)</span>
                                        <button type="button"
                                                disabled="@(_updatingLineId == line.Id || line.Quantity >= lineMax || _isReadOnly)"
                                                @onclick="(() => UpdateCartLineQtyAsync(line.Id, line.Quantity + 1))">
                                            +
                                        </button>
                                    </div>
                                    <p class="tm-cart-line-total tm-persian-num">@FormatPrice(line.LineTotal)</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="tm-cart-footer">
                    <div class="tm-cart-totals">
                        <div class="tm-cart-totals-row">
                            <span class="tm-cart-totals-label">@Loc["CartSubtotal"]</span>
                            <span class="tm-cart-totals-value tm-persian-num">@FormatPrice(_cart.Total)</span>
                        </div>
                        <div class="tm-cart-totals-row">
                            <span class="tm-cart-totals-label">@Loc["CartShipping"]</span>
                            <span class="tm-cart-totals-value">@Loc["CartShippingFree"]</span>
                        </div>
                        <div class="tm-cart-totals-row tm-cart-totals-row--grand">
                            <span class="tm-cart-totals-label">@Loc["CartGrandTotal"]</span>
                            <span class="tm-cart-totals-value tm-persian-num">@FormatPrice(_cart.Total)</span>
                        </div>
                    </div>
                    <button type="button"
                            class="tm-submit-btn"
                            disabled="@(_isSubmitting || _isReadOnly)"
                            title="@(_isReadOnly ? Loc["SubmitReadOnlyTitle"] : "")"
                            @onclick="SubmitCartAsync">
                        @if (_isSubmitting)
                        {
                            <span>@Loc["SubmittingOrder"]</span>
                        }
                        else
                        {
                            <span>@Loc["SubmitOrder"]</span>
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" width="16" height="16" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                            </svg>
                        }
                    </button>
                    @* No "+add another item" button, no "schedule delivery" button — both removed per spec *@
                </div>
            }
        </aside>
    </main>
</div>

@code {
    // ── State ────────────────────────────────────────────────────────────

    /// <summary>
    /// Receives the ShopLayout instance via cascade so the shop header's
    /// hamburger button can call ToggleSidebar() on it. The ShopLayout
    /// wraps its @Body in <c>&lt;CascadingValue Value="this" TValue="ShopLayout"&gt;</c>
    /// to publish itself.
    /// </summary>
    [CascadingParameter] public TakOne.WebUI.Components.Layout.ShopLayout? ShopLayoutRef { get; set; }

    private List<ProductListItemDto> _products = new();
    private List<ProductListItemDto> _filteredProducts => _products; // stock filter is server-side now

    private List<CategoryDto> _categories = new();

    private string _searchTerm = string.Empty;
    private Guid? _selectedCategoryId;

    // Currently-active UI culture. Used to highlight the active side of the
    // EN | FA toggle. Initialized from CultureInfo.CurrentUICulture which the
    // localization middleware has already set based on the takone_culture
    // cookie (or the fa-IR default) before this component renders.
    private string _currentCulture = CultureInfo.CurrentUICulture.Name;

    // Currently-active theme. Initialized to "tak-light" (the project default)
    // for the very first render; OnAfterRenderAsync then reads the actual
    // saved theme from localStorage (via window.takTheme.get) and updates
    // this field + StateHasChanged() so the sun/moon icon reflects reality.
    // Used by the sun/moon toggle button: "tak-dark" → show sun (click →
    // light), anything else → show moon (click → dark).
    private string _currentTheme = "tak-light";

    private const int _pageSize = 12;
    private int _pageNumber = 1;
    private int _totalCount;

    private bool _isLoading = true;
    private string _loadError = string.Empty;

    // Cart state — loaded in parallel with products on init, reloaded after
    // any mutation (add, qty update, submit, quick reorder).
    private CartDto? _cart;

    // Per-card "adding" flag (so only the clicked card shows a spinner).
    private Guid? _addingProductId;

    // GLOBAL "any add-to-cart in flight" guard. Prevents concurrent
    // CreateOrAppendSaleCommand invocations from racing on the user's
    // draft Sale (the root cause of the DbUpdateConcurrencyException
    // "expected to affect 1 row(s), but actually affected 0 row(s)" bug
    // on rapid double-clicks of the Add button).
    //
    // WHY A GLOBAL FLAG (not just per-product):
    //   The race happens when two AddToCartAsync invocations run in
    //   parallel against the SAME draft Sale — even for DIFFERENT
    //   products. Both invocations re-load the sale, both compute the
    //   next LineNumber from the in-memory _lineItems collection, and
    //   both INSERT with the same LineNumber → unique-index violation
    //   on (SaleId, LineNumber).
    //
    //   Serializing ALL cart mutations on the client side is the clean
    //   first line of defense. The server-side retry (in
    //   CreateOrAppendSaleCommandHandler via IUnitOfWork.ExecuteWithRetryAsync)
    //   is the second line of defense for the cases the UI can't prevent
    //   (multi-tab users, refresh-during-add, network-retry double-fires).
    private bool _isAddingAny;

    // Mini-cart line "updating" flag (so only the clicked line's buttons disable).
    private Guid? _updatingLineId;

    // Submit + quick-reorder flags (disable their buttons while in-flight).
    private bool _isSubmitting;
    private bool _isReordering;

    // Per-product quantity selector state. Keyed by ProductId.
    // Default value is 1 when the product is first rendered.
    private readonly Dictionary<Guid, int> _qtyByProduct = new();

    // Stats — loaded from the real backend query (GetCustomerShopStatsQuery).
    // Null while loading; the UI shows 0/— until the first load completes.
    private CustomerShopStatsDto? _stats;

    // True when the signed-in user is a PURE read-only viewer — i.e. they
    // have the ReadOnly role AND do NOT also hold any role that the
    // shopping commands accept (Customer / Employee / Manager / Admin).
    //
    // WHY THE "AND NOT" CLAUSE IS NEEDED:
    //   The four cart-mutation commands (CreateOrAppendSale,
    //   UpdateSaleLineItem, SubmitSale, QuickReorderLastSale) carry
    //   [RequireRoles(Customer, Employee, Manager, Admin)] — ReadOnly is
    //   deliberately EXCLUDED. So a pure ReadOnly user can never shop, and
    //   we gray out the add/qty/submit/reorder buttons to match.
    //
    //   But a user can hold MULTIPLE roles. Since Customer was added to
    //   the UserDetail assign-role dropdown, an admin can give a ReadOnly
    //   user the Customer role too (e.g. to "convert" them into a buyer).
    //   That user now satisfies BOTH [RequireRoles] checks for shopping
    //   (they have Customer) — the backend will let them buy. The UI must
    //   match: if we ONLY checked IsInRole(ReadOnly), we'd gray out their
    //   add buttons even though the backend would accept the call. So we
    //   treat them as a shopper (not read-only) whenever they hold any of
    //   the four shopping-allowed roles.
    //
    // Computed once in OnInitializedAsync (cheaper than re-evaluating
    // CurrentUser.IsInRole on every render).
    private bool _isReadOnly;

    // ── Lifecycle ────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        // Resolve the role once, up-front. A user is treated as read-only
        // for shopping ONLY when they have ReadOnly and don't also hold any
        // of the four shopping-allowed roles (Customer / Employee / Manager
        // / Admin). See _isReadOnly's doc-comment for the full rationale.
        var canShop = CurrentUser.IsInRole(Roles.Customer)
                      || CurrentUser.IsInRole(Roles.Employee)
                      || CurrentUser.IsInRole(Roles.Manager)
                      || CurrentUser.IsInRole(Roles.Admin);
        _isReadOnly = CurrentUser.IsInRole(Roles.ReadOnly) && !canShop;

        try
        {
            await Task.WhenAll(
                LoadCategoriesAsync(),
                LoadProductsAsync(),
                LoadCartAsync(),
                LoadStatsAsync());
        }
        finally
        {
            _isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // On the very first render, read the saved theme from localStorage
        // (via window.takTheme.get — same API the layouts use) so the sun/moon
        // icon reflects what theme.js has actually applied. Without this, the
        // icon would always show "moon" (the _currentTheme default "tak-light")
        // even if the user had previously picked tak-dark.
        if (!firstRender) return;

        try
        {
            var saved = await JS.InvokeAsync<string>("takTheme.get");
            if (!string.IsNullOrEmpty(saved) && saved != _currentTheme)
            {
                _currentTheme = saved;
                StateHasChanged();
            }
        }
        catch
        {
            // If JS interop fails (e.g. theme.js didn't load), leave
            // _currentTheme at its "tak-light" default. The toggle button
            // still works — it just may not reflect the actual active theme
            // until the page is reloaded.
        }
    }

    // ── Data loading ────────────────────────────────────────────────────

    private async Task LoadCategoriesAsync()
    {
        try
        {
            var result = await MessageBus.InvokeAsync<Result<List<CategoryDto>>>(
                new GetActiveCategoriesQuery());

            if (result.IsSuccess)
            {
                _categories = result.Value;
            }
        }
        catch
        {
            // Non-fatal: empty categories just means the sidebar shows "All".
        }
    }

    private async Task LoadProductsAsync()
    {
        _isLoading = true;
        _loadError = string.Empty;

        try
        {
            var query = new GetProductsPaginatedQuery
            {
                PageNumber = _pageNumber,
                PageSize = _pageSize,
                SearchTerm = string.IsNullOrWhiteSpace(_searchTerm) ? null : _searchTerm.Trim(),
                CategoryId = _selectedCategoryId
            };

            var result = await MessageBus.InvokeAsync<PaginatedResult<ProductListItemDto>>(query);

            _products = result.Items.ToList();
            _totalCount = result.TotalCount;

            // Initialize qty selectors to 1 for any new product in the page
            // (preserve existing values for products that survived the reload).
            foreach (var p in _products)
            {
                if (!_qtyByProduct.ContainsKey(p.Id))
                {
                    _qtyByProduct[p.Id] = 1;
                }
            }

            // If the page is now empty, bump back to page 1 and retry.
            if (_products.Count == 0 && _pageNumber > 1)
            {
                _pageNumber = 1;
                await LoadProductsAsync();
                return;
            }
        }
        catch (Exception)
        {
            _loadError = Loc["LoadErrorDefault"];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadCartAsync()
    {
        try
        {
            var result = await MessageBus.InvokeAsync<Result<CartDto?>>(
                new GetActiveCartForUserQuery());

            _cart = result.IsSuccess ? result.Value : null;
        }
        catch
        {
            // Non-fatal: an empty mini-cart is shown.
            _cart = null;
        }
    }

    /// <summary>
    /// Loads the 4 numeric shop stats (orders this month, monthly/yearly
    /// totals, in-stock count) from GetCustomerShopStatsQuery. Non-fatal —
    /// on failure the cards just show 0/—.
    /// </summary>
    private async Task LoadStatsAsync()
    {
        try
        {
            var result = await MessageBus.InvokeAsync<Result<CustomerShopStatsDto>>(
                new GetCustomerShopStatsQuery());

            _stats = result.IsSuccess ? result.Value : null;
        }
        catch
        {
            // Non-fatal: stats cards show 0/—.
            _stats = null;
        }
    }

    // ── Filter handlers ─────────────────────────────────────────────────

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchTerm = e.Value?.ToString() ?? string.Empty;
        // Debounce: defer the actual query slightly so we don't hammer the
        // backend on every keystroke. The simpler-than-a-timer approach: just
        // let the user press Enter (handled in OnSearchKeypress) to commit
        // the search. Typing alone doesn't re-query.
    }

    private async Task OnSearchKeypress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _pageNumber = 1;
            await LoadProductsAsync();
        }
    }

    private async Task OnCategoryChanged(Guid? categoryId)
    {
        _selectedCategoryId = categoryId;
        _pageNumber = 1;
        await LoadProductsAsync();
    }

    private async Task OnPageChanged(int newPage)
    {
        _pageNumber = newPage;
        await LoadProductsAsync();
    }

    private async Task ClearFilters()
    {
        _searchTerm = string.Empty;
        _selectedCategoryId = null;
        _pageNumber = 1;
        await LoadProductsAsync();

        // Clear the visible text in the search input — see ClearSearchAsync
        // for the rationale (one-way binding means the input's visible
        // text would otherwise stay stale).
        try
        {
            await JS.InvokeVoidAsync("eval", "document.getElementById('tm-shop-search-input') && (document.getElementById('tm-shop-search-input').value = '')");
        }
        catch
        {
            // Non-fatal — chip row is still cleared, just the input's
            // visible text might be stale until the next interaction.
        }
    }

    /// <summary>
    /// Clears ONLY the search term (keeps the selected category, if any).
    /// Triggered by the search filter chip's X button. Resets to page 1
    /// because the result set changes when the search filter is dropped.
    /// Also clears the visible text in the search input element so the
    /// input doesn't show stale text after the chip is dismissed.
    /// </summary>
    private async Task ClearSearchAsync()
    {
        _searchTerm = string.Empty;
        _pageNumber = 1;
        await LoadProductsAsync();

        // Clear the visible text in the search input. Blazor's @bind is
        // one-way here (we use value="@_searchTerm" + @oninput), so we
        // must push the cleared value to the DOM explicitly. The input
        // has id="tm-shop-search-input" — see the markup above.
        try
        {
            await JS.InvokeVoidAsync("eval", "document.getElementById('tm-shop-search-input') && (document.getElementById('tm-shop-search-input').value = '')");
        }
        catch
        {
            // Non-fatal — if JS interop is unavailable (e.g. during SSR
            // or prerender), the chip is still cleared from the title
            // block; only the input box's visible text is stale. The
            // next keystroke or page reload will sync it.
        }
    }

    /// <summary>
    /// True when EITHER a search term or a category filter is active.
    /// Drives whether the active-filters chip row is rendered at all.
    /// </summary>
    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(_searchTerm) || _selectedCategoryId is not null;

    /// <summary>
    /// True when BOTH a search term AND a category filter are active at
    /// once. In that case we additionally render a "Clear all" pill at
    /// the end of the chip row so the user can wipe everything in one
    /// click instead of clicking X twice.
    /// </summary>
    private bool HasMultipleActiveFilters =>
        !string.IsNullOrWhiteSpace(_searchTerm) && _selectedCategoryId is not null;

    /// <summary>
    /// Resolves the currently-selected category's display name from the
    /// in-memory _categories list. Returns null when no category is
    /// selected OR when the selected id no longer maps to a category in
    /// the list (e.g. the category was just deactivated and the tree was
    /// reloaded without it). In either case the category chip is hidden.
    /// </summary>
    private string? GetSelectedCategoryName()
    {
        if (_selectedCategoryId is not { } catId)
        {
            return null;
        }

        return _categories.FirstOrDefault(c => c.Id == catId)?.Name;
    }

    // ── Quantity selector (per-card) ────────────────────────────────────

    private int GetQtyForProduct(Guid productId)
    {
        return _qtyByProduct.TryGetValue(productId, out var q) ? q : 1;
    }

    private int GetQtyMaxForProduct(ProductListItemDto product)
    {
        // Max = min(stock, remaining limit). For staff (no limit), max = stock.
        // We always allow at least 1 so the user can interact with the selector
        // (the add button is disabled separately when remaining <= 0).
        var remaining = GetRemainingForProduct(product);
        var cap = product.MyPurchaseLimit.HasValue
            ? Math.Min(remaining, product.StockQuantity)
            : product.StockQuantity;
        return Math.Max(1, cap);
    }

    /// <summary>
    /// How many MORE units the current user can add for this product in a
    /// single click = min(remaining stock, remaining limit), where:
    ///   - remaining stock = StockQuantity - already in this user's cart
    ///   - remaining limit = MyPurchaseLimit - already in this user's cart
    ///     (for staff with no limit, this is int.MaxValue — bounded only by stock)
    ///
    /// Returns 0 when either stock or limit is exhausted (the Add button is
    /// then replaced with the "you have already selected the maximum"
    /// disabled state).
    ///
    /// WHY we subtract in-cart from BOTH: stock is shared across all users
    /// (another user could grab it between page load and add-to-cart), but
    /// the per-user cap on stock is "what's left after I've reserved my
    /// share". The backend re-checks both; the frontend clamp is best-effort
    /// for UX, not a security boundary.
    /// </summary>
    private int GetRemainingForProduct(ProductListItemDto product)
    {
        var inCart = _cart?.LineItems
            .Where(li => li.ProductId == product.Id)
            .Sum(li => li.Quantity) ?? 0;

        var remainingStock = Math.Max(0, product.StockQuantity - inCart);

        if (!product.MyPurchaseLimit.HasValue)
        {
            // Staff — no per-product cap. Bounded only by remaining stock.
            return remainingStock;
        }

        var remainingLimit = Math.Max(0, product.MyPurchaseLimit.Value - inCart);
        return Math.Min(remainingStock, remainingLimit);
    }

    private void IncrementQty(Guid productId)
    {
        var current = GetQtyForProduct(productId);
        var product = _products.FirstOrDefault(p => p.Id == productId);
        if (product is null) return;
        var max = GetQtyMaxForProduct(product);
        if (current < max)
        {
            _qtyByProduct[productId] = current + 1;
        }
    }

    private void DecrementQty(Guid productId)
    {
        var current = GetQtyForProduct(productId);
        if (current > 1)
        {
            _qtyByProduct[productId] = current - 1;
        }
    }

    // ── Add to cart ─────────────────────────────────────────────────────

    private async Task AddToCartAsync(ProductListItemDto product)
    {
        // ── Re-entry guard ───────────────────────────────────────────────
        // Blazor Server processes UI events on a single synchronization
        // context per circuit, BUT only between awaits. Two rapid clicks
        // on the Add button will both be dispatched, the second one
        // starting after the first's await yields. Without this guard,
        // both clicks fire CreateOrAppendSaleCommand concurrently, and
        // the server-side retry (which is a defense-in-depth, not the
        // primary fix) has to clean up the race.
        //
        // The check + set is synchronous, so it's atomic with respect
        // to the circuit's event loop — no lock needed.
        if (_isAddingAny)
        {
            return;
        }

        var qty = GetQtyForProduct(product.Id);
        if (qty < 1)
        {
            await Toast.Warning(Loc["ToastQtyMin"]);
            return;
        }

        // Clamp defensively against a stale UI (cart changed server-side
        // since the page was loaded). If the clamp brings qty to 0, the
        // user's limit is exhausted — surface a friendly toast instead of
        // silently returning (the original silent-return was the cause of
        // "add buttons don't actually add anything to cart" reports).
        var remaining = GetRemainingForProduct(product);
        if (remaining <= 0)
        {
            await Toast.Warning(Loc["ToastLimitReached"]);
            return;
        }
        if (qty > remaining)
        {
            qty = remaining;
            await Toast.Info(string.Format(Loc["ToastQtyClamped"], ToPersian(remaining)));
        }

        // Set BOTH flags before any await. _isAddingAny is the global
        // guard (disables ALL Add buttons); _addingProductId drives the
        // per-card spinner icon (still useful for visual feedback even
        // though the disable is now global).
        _isAddingAny = true;
        _addingProductId = product.Id;
        // Force an immediate re-render so the buttons visually disable
        // before the upcoming await yields control back to the circuit.
        // Without this, the user could click a second button in the
        // window between the flag set and the natural re-render that
        // happens after the first await.
        StateHasChanged();

        try
        {
            var result = await MessageBus.InvokeAsync<Result<Guid>>(
                new CreateOrAppendSaleCommand(product.Id, qty));

            if (result.IsSuccess)
            {
                await Toast.Success(Loc["ToastAddedToCart"]);
                // Reload cart so the mini-cart + remaining limits reflect reality.
                await LoadCartAsync();
                // Reset the qty selector to 1 for the next add.
                _qtyByProduct[product.Id] = 1;
            }
            else
            {
                await Toast.Error(LocalizeError(result.Error) ?? Loc["ToastAddFailed"]);
            }
        }
        catch (Exception)
        {
            await Toast.Error(Loc["ToastAddError"]);
        }
        finally
        {
            _isAddingAny = false;
            _addingProductId = null;
        }
    }

    // ── Mini-cart line qty update ───────────────────────────────────────

    /// <summary>
    /// Upper bound for the +/- buttons on a mini-cart line. Same formula
    /// as the cart page's <c>GetLineMax</c>:
    ///   <c>Min(MyPurchaseLimit, Max(CurrentStock, Quantity))</c>.
    ///
    /// Before this fix, the mini-cart used <c>Max(CurrentStock, Quantity)</c>
    /// and IGNORED the per-group purchase limit — so a customer could click
    /// + past their group's limit and only get stopped by a backend
    /// DomainException (surfaced as a generic error toast). Now the + button
    /// greys out at the limit, matching the products-grid qty selector's
    /// behavior.
    /// </summary>
    private static int GetCartLineMax(CartLineItemDto line)
    {
        var byStock = Math.Max(line.CurrentStock, line.Quantity);
        return line.MyPurchaseLimit.HasValue
            ? Math.Min(line.MyPurchaseLimit.Value, byStock)
            : byStock;
    }

    private async Task UpdateCartLineQtyAsync(Guid lineItemId, int newQty)
    {
        if (_cart is null) return;

        _updatingLineId = lineItemId;
        try
        {
            var result = await MessageBus.InvokeAsync<Result>(
                new UpdateSaleLineItemCommand(_cart.SaleId, lineItemId, newQty));

            if (result.IsSuccess)
            {
                await LoadCartAsync();
            }
            else
            {
                await Toast.Error(LocalizeError(result.Error) ?? Loc["ToastUpdateFailed"]);
            }
        }
        catch (Exception)
        {
            await Toast.Error(Loc["ToastUpdateError"]);
        }
        finally
        {
            _updatingLineId = null;
        }
    }

    // ── Submit cart ─────────────────────────────────────────────────────

    private async Task SubmitCartAsync()
    {
        if (_cart is null) return;

        _isSubmitting = true;
        try
        {
            var result = await MessageBus.InvokeAsync<Result>(
                new SubmitSaleCommand(_cart.SaleId));

            if (result.IsSuccess)
            {
                await Toast.Success(Loc["ToastSubmitSuccess"]);
                _cart = null; // cart is now in Pending status — active draft is gone
                Navigation.NavigateTo("/Sales", forceLoad: false);
            }
            else
            {
                await Toast.Error(LocalizeError(result.Error) ?? Loc["ToastSubmitFailed"]);
            }
        }
        catch (Exception)
        {
            await Toast.Error(Loc["ToastSubmitError"]);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    // ── Quick reorder ───────────────────────────────────────────────────

    private async Task QuickReorderAsync()
    {
        _isReordering = true;
        try
        {
            var result = await MessageBus.InvokeAsync<Result<Guid>>(
                new QuickReorderLastSaleCommand());

            if (result.IsSuccess)
            {
                await Toast.Success(Loc["ToastReorderSuccess"]);
                await LoadCartAsync();
                // Also reload products so the "remaining limit" indicators
                // reflect the new state of the cart.
                await LoadProductsAsync();
            }
            else
            {
                await Toast.Warning(LocalizeReorderError(result.Error) ?? Loc["ToastReorderNoOrders"]);
            }
        }
        catch (Exception)
        {
            await Toast.Error(Loc["ToastReorderError"]);
        }
        finally
        {
            _isReordering = false;
        }
    }

