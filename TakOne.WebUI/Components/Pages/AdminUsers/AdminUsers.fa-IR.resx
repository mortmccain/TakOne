  <!-- ActionLockedForManager — راهنمای ابزار روی آیکن قفل که به جای دکمه
       فعال/غیرفعال‌سازی به مدیر (غیر مدیر سیستم) برای ردیف‌هایی نمایش داده
       می‌شود که کاربر آن ردیف در نقش کارمند یا مشتری نیست. به مدیر دلیل در
       دسترس نبودن عملیات را توضیح می‌دهد تا تصور نکند صفحه خراب است. -->
  <data name="ActionLockedForManager" xml:space="preserve">
    <value>به عنوان مدیر، تنها می‌توانید حساب‌های کارمند و مشتری را فعال یا غیرفعال کنید. عمل روی سایر مدیران، مدیران سیستم و کاربران فقط‌خواندنی نیازمند دسترسی مدیر سیستم است.</value>
  </data>

  <data name="ConfirmDeactivate" xml:space="preserve">
    <value>«{0}» ({1}) غیرفعال شود؟ این کاربر دیگر نمی‌تواند وارد سیستم شود. فروش‌ها و تاریخچه او نگه‌داری می‌شود.</value>
  </data>
  <!-- DeactivateDialogTitle — عنوان نمایش‌داده‌شده در بالای مودال DeactivateUserDialog
       (تأیید دومرحله‌ای با شمارش معکوس ۳ ثانیه‌ای). این کلید در این فایل قرار دارد
       (نه در DeactivateUserDialog.fa-IR.resx) تا صفحه‌ای که مودال را باز می‌کند،
       عنوان آن را در اختیار داشته باشد — مطابق الگوی SaleDetail. -->
  <data name="DeactivateDialogTitle" xml:space="preserve">
    <value>تأیید غیرفعال‌سازی</value>
  </data>
  <data name="DeactivateSuccessTitle" xml:space="preserve">
