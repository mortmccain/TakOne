        => gender switch
        {
            Domain.Users.Gender.Male => "background: #2196f3; color: white;",
            Domain.Users.Gender.Female => "background: #e91e63; color: white;",
            _ => ""
        };

    // String overload — maps "Male"/"Female" keys to the same colors.
    private string GetGenderBadgeStyle(string? key)
        => key switch
        {
            "Male" => "background: #2196f3; color: white;",
            "Female" => "background: #e91e63; color: white;",
            _ => ""
        };

    // ── Status helpers ──────────────────────────────────────────────────
    // Used by both the cell Template (bool overload — user.IsActive) and
    // the filter dropdown's ValueTemplate/Template (string overload —
    // "Active"/"Inactive" keys).

    private string GetStatusLabel(bool isActive)
        => isActive ? Loc["StatusActiveBadge"] : Loc["StatusInactiveBadge"];

    // ── CSV export (Round 5 — all filtered rows, capped) ─────────────

    /// <summary>
    /// Hard cap on exported rows: generous enough for any real export,
    /// small enough that a pathological filter can't hang the Blazor
    /// circuit building a giant string (same value as the Sales export).
    /// </summary>
    private const int ExportRowCap = 2000;

    /// <summary>
    /// Builds a CSV of EVERY user matching the active filters (all pages —
    /// a genuine improvement over the pre-Round-5 export, which could only
    /// ship the ≤100 loaded rows), capped at <see cref="ExportRowCap"/>,
    /// and downloads it via the takDownload helper. Column shape mirrors
    /// the grid: worker id, full name, gender, group, roles (semicolon-
    /// joined — commas would break the CSV field), and active/inactive
    /// status. See Sales.razor's ExportSalesCsvAsync for the format
    /// rationale (RFC 4180 + invariant numbers + BOM-at-save).
    /// </summary>
    private async Task ExportUsersCsvAsync()
    {
        if (_totalCount == 0 || _isExporting)
        {
            return; // the button is disabled for empty lists — belt + braces
        }

        _isExporting = true;
        try
        {
            var builder = new CsvBuilder();
            builder.AddHeader(
                Loc["ColWorkerId"],
                Loc["ColFullName"],
                Loc["ColGender"],
                Loc["ColGroup"],
                Loc["ColRoles"],
                Loc["ColStatus"]);

            var exported = 0;
            var pageNumber = 1;
            const int exportPageSize = 100; // the backend's MaxPageSize cap

            while (exported < ExportRowCap)
            {
                var result = await MessageBus.InvokeAsync<PaginatedResult<UserListItemDto>>(
                    BuildQuery(pageNumber, exportPageSize)); // SAME active filters + sort as the grid

                foreach (var user in result.Items)
                {
                    if (exported >= ExportRowCap) break;

                    builder.AddRow(
                        user.WorkerId,
                        user.FullName,
                        GetGenderLabel(user.Gender),
                        user.GroupName,
                        // Semicolon-joined INSIDE one CSV field: role lists
                        // are multi-valued and commas are the record
                        // separator.
                        string.Join("; ", user.Roles),
                        GetStatusLabel(user.IsActive));
                    exported++;
                }

                // Last page reached when the server returns fewer rows
                // than requested.
                if (result.Items.Count < exportPageSize) break;
                pageNumber++;
            }

            var csv = builder.ToString();
            var fileName = $"takone-users-{DateTime.UtcNow:yyyyMMdd-HHmmss}.csv";
            await JS.InvokeVoidAsync("takDownload.csv", fileName, csv);

            await Toast.Success(Loc["ExportCsvDone", exported], summary: Loc["PageHeading"]);
        }
        catch (Exception)
        {
            // JS interop can fail after a circuit reconnect — a visible
            // toast beats a silently dead button.
            await Toast.Warning(Loc["ExportCsvError"], summary: Loc["ErrorTitle"]);
        }
        finally
        {
            _isExporting = false;
        }
    }

    private string GetStatusLabel(string? status)
        => status switch
        {
            "Active" => Loc["StatusActive"],
            "Inactive" => Loc["StatusInactive"],
            _ => Loc["StatusAll"]
        };

    private BadgeStyle GetStatusBadgeStyle(bool isActive)
        => isActive ? BadgeStyle.Success : BadgeStyle.Danger;

    private BadgeStyle GetStatusBadgeStyle(string? status)
        => status switch
        {
            "Active" => BadgeStyle.Success,
            "Inactive" => BadgeStyle.Danger,
            _ => BadgeStyle.Base
        };
