            _isBusyUserId = null;
        }
    }

    // ── Reset password (Admin only) ─────────────────────────────────────

    /// <summary>
    /// Prompts the admin (via the browser's native prompt()) for a new
    /// password, then dispatches ResetUserPasswordCommand. Same UX pattern
    /// as AdminProducts.razor's restock flow — simple, no custom dialog.
    ///
    /// The handler defers password-complexity validation to ASP.NET
    /// Identity's configured rules. Client-side, we just check non-empty
    /// and at least 8 chars to catch obvious typos before the round-trip.
    /// </summary>
    private async Task HandleResetPasswordAsync(UserListItemDto user)
    {
        if (_isBusyUserId.HasValue) return;

        var promptMessage = string.Format(
            CultureInfo.CurrentCulture,
            Loc["ResetPrompt"],
            user.FullName,
            user.WorkerId);

        var newPassword = await JS.InvokeAsync<string?>("prompt", promptMessage, "");

        // User clicked Cancel or pressed Escape.
        if (string.IsNullOrWhiteSpace(newPassword)) return;

        newPassword = newPassword.Trim();

        // Minimal client-side check — Identity's complexity rules are
        // the real authority and will reject anything too weak.
        if (newPassword.Length < 8)
        {
            await Toast.Warning(Loc["ResetInvalidPassword"], summary: Loc["ErrorTitle"]);
            return;
        }

        _isBusyUserId = user.Id;
        try
        {
            var result = await MessageBus.InvokeAsync<Result>(
                new ResetUserPasswordCommand(user.Id, newPassword));

            if (result.IsSuccess)
            {
                await Toast.Success(
                    string.Format(CultureInfo.CurrentCulture, Loc["ResetSuccess"], user.FullName),
                    summary: Loc["ResetSuccessTitle"]);
            }
            else
            {
                // Identity's error descriptions are user-friendly (e.g.
                // "Passwords must have at least one non-alphanumeric character.")
                // — surface verbatim.
                await Toast.Error(
                    result.Error ?? Loc["ResetError"],
                    summary: Loc["ErrorTitle"]);
            }
        }
        catch
        {
            await Toast.Error(Loc["ResetError"], summary: Loc["ErrorTitle"]);
        }
        finally
        {
            _isBusyUserId = null;
        }
    }

    // ── Row render hook ─────────────────────────────────────────────────

    private void OnRowRender(RowRenderEventArgs<UserListItemDto> args)
    {
        // Subtle visual cue for inactive rows: slight opacity. The status
        // badge already conveys the state, but the row-level cue helps
        // scan-by-gesture users notice deactivated accounts at a glance.
        if (args.Data is { } u && !u.IsActive)
        {
            args.Attributes.Add("style", "opacity: 0.65;");
        }
    }

