  </resheader>

  <data name="PageTitle" xml:space="preserve">
    <value>Manage Users — TakOne</value>
  </data>
  <data name="PageHeading" xml:space="preserve">
    <value>Manage Users</value>
  </data>
  <data name="CreateUserButton" xml:space="preserve">
    <value>Create user</value>
  </data>

  <data name="StatusAll" xml:space="preserve">
