  <data name="ResetPasswordModalLabel" xml:space="preserve">
    <value>New password</value>
  </data>
  <data name="ResetPasswordModalPlaceholder" xml:space="preserve">
    <value>At least 8 characters</value>
  </data>
  <data name="ResetPasswordModalHint" xml:space="preserve">
    <value>Identity's password complexity rules apply.</value>
  </data>
  <data name="ResetPasswordModalSubmit" xml:space="preserve">
    <value>Reset password</value>
  </data>
  <data name="PasswordShow" xml:space="preserve">
    <value>Show password</value>
  </data>
  <data name="PasswordHide" xml:space="preserve">
