  <data name="ActionActivate" xml:space="preserve">
    <value>Activate</value>
  </data>
  <data name="ActionDeactivate" xml:space="preserve">
    <value>Deactivate</value>
  </data>
  <data name="ActionResetPassword" xml:space="preserve">
    <value>Reset password</value>
  </data>
  <data name="ActionViewDetail" xml:space="preserve">
    <value>View details</value>
  </data>
  <!-- ActionLockedForManager — tooltip on the lock icon shown in place of
       the activate/deactivate button when a Manager (non-Admin) views a row
       whose user is not in the Employee or Customer role. Tells the manager
       why the action is unavailable, so they don't think the page is broken. -->
  <data name="ActionLockedForManager" xml:space="preserve">
    <value>As a Manager, you can only activate or deactivate Employee and Customer accounts. Other managers, administrators, and read-only users require Administrator access.</value>
  </data>

  <data name="ConfirmDeactivate" xml:space="preserve">
    <value>Deactivate "{0}" ({1})? They will no longer be able to log in. Their sales and history are kept.</value>
  </data>
  <!-- DeactivateDialogTitle — title shown at the top of the DeactivateUserDialog
       modal (the second-step confirmation with the 3-second countdown). Kept
       here (not in DeactivateUserDialog.en-US.resx) so the page that opens
       the dialog owns its title, matching the SaleDetail pattern. -->
  <data name="DeactivateDialogTitle" xml:space="preserve">
    <value>Confirm deactivation</value>
  </data>
  <data name="DeactivateSuccessTitle" xml:space="preserve">
    <value>User deactivated</value>
  </data>
  <data name="DeactivateSuccess" xml:space="preserve">
    <value>"{0}" has been deactivated.</value>
  </data>
  <data name="ActivateSuccessTitle" xml:space="preserve">
    <value>User activated</value>
  </data>
  <data name="ActivateSuccess" xml:space="preserve">
    <value>"{0}" has been activated and can now log in.</value>
  </data>

  <data name="ResetPrompt" xml:space="preserve">
    <value>Enter a new password for "{0}" ({1}). The user will need it to log in:</value>
  </data>
  <data name="ResetInvalidPassword" xml:space="preserve">
    <value>Password must be at least 8 characters. Please try again.</value>
  </data>
  <data name="ResetSuccessTitle" xml:space="preserve">
    <value>Password reset</value>
  </data>
  <data name="ResetSuccess" xml:space="preserve">
    <value>The password for "{0}" has been reset. Communicate it to the user out-of-band.</value>
  </data>
  <data name="ResetError" xml:space="preserve">
    <value>We couldn't reset the password. Please try again.</value>
  </data>

  <data name="ActionError" xml:space="preserve">
    <value>We couldn't complete that action. Please try again.</value>
  </data>

  <!-- Reset Password modal (mirrors UserDetail.razor's modal — same keys,
       same UX: overlay + dialog + password input with show/hide toggle +
       inline validation + Cancel/Submit footer). -->
  <data name="ModalCancel" xml:space="preserve">
    <value>Cancel</value>
  </data>
  <data name="ResetPasswordModalTitle" xml:space="preserve">
    <value>Reset password</value>
  </data>
  <data name="ResetPasswordModalBody" xml:space="preserve">
    <value>Enter a new password for this user. They will need to use it on their next login.</value>
