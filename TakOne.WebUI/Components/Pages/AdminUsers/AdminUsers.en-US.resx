  </data>

  <!-- GenderAll / GroupAll — placeholders shown in the Gender and Group
       filter dropdowns when no filter is selected (AllowClear resets to
       null). Matches the Status dropdown's "All" placeholder pattern. -->
  <data name="GenderAll" xml:space="preserve">
    <value>All genders</value>
  </data>
  <data name="GroupAll" xml:space="preserve">
    <value>All groups</value>
  </data>

  <!-- EmptyText — shown by RadzenDataGrid's EmptyText when the grid has
       no rows (either no users at all, or filters yielded nothing). -->
  <data name="EmptyText" xml:space="preserve">
    <value>No users found.</value>
  </data>

  <data name="LoadingText" xml:space="preserve">
    <value>Loading users…</value>
  </data>
  <data name="ErrorTitle" xml:space="preserve">
