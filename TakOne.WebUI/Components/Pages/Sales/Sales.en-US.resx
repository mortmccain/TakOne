<?xml version="1.0" encoding="utf-8"?>
<!-- Sales.en-US.resx — English strings for Sales.razor.

     The four <resheader> tags below are REQUIRED by the .resx reader —
     without them, the loader rejects the file with "resx input is not valid,
     couldn't find valid resheader tags". -->
<root>
  <xsd:schema id="root" xmlns="" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
    <xsd:import namespace="http://www.w3.org/XML/1998/namespace" />
    <xsd:element name="root" msdata:IsDataSet="true">
      <xsd:complexType>
        <xsd:choice maxOccurs="unbounded">
          <xsd:element name="resheader">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="resmimetype">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="assembly">
            <xsd:complexType>
              <xsd:attribute name="alias" type="xsd:string" />
              <xsd:attribute name="name" type="xsd:string" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="data">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
                <xsd:element name="comment" type="xsd:string" minOccurs="0" msdata:Ordinal="2" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" msdata:Ordinal="1" />
              <xsd:attribute name="type" type="xsd:string" msdata:Ordinal="3" />
              <xsd:attribute name="mimetype" type="xsd:string" msdata:Ordinal="4" />
              <xsd:attribute ref="xml:space" />
            </xsd:complexType>
          </xsd:element>
        </xsd:choice>
      </xsd:complexType>
    </xsd:element>
  </xsd:schema>

  <resheader name="resmimetype">
    <value>text/microsoft-resx</value>
  </resheader>
  <resheader name="version">
    <value>2.0</value>
  </resheader>
  <resheader name="reader">
    <value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>
  <resheader name="writer">
    <value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>

  <!-- Page chrome -->
  <data name="PageTitle" xml:space="preserve">
    <value>My orders — TakOne</value>
  </data>
  <data name="PageHeading" xml:space="preserve">
    <value>My orders</value>
  </data>
  <data name="ContinueShoppingButton" xml:space="preserve">
    <value>Continue shopping</value>
  </data>

  <!-- Filter bar -->
  <data name="SearchLabel" xml:space="preserve">
    <value>Search</value>
  </data>
  <data name="SearchPlaceholder" xml:space="preserve">
    <value>Search by sale number or customer name…</value>
  </data>
  <data name="StatusLabel" xml:space="preserve">
    <value>Status</value>
  </data>
  <data name="StatusAll" xml:space="preserve">
    <value>All statuses</value>
  </data>
  <data name="StatusDraft" xml:space="preserve">
    <value>Draft</value>
  </data>
  <data name="StatusPending" xml:space="preserve">
    <value>Pending</value>
  </data>
  <data name="StatusApproved" xml:space="preserve">
    <value>Approved</value>
  </data>
  <data name="StatusInvoiced" xml:space="preserve">
    <value>Invoiced</value>
  </data>
  <data name="StatusCancelled" xml:space="preserve">
    <value>Cancelled</value>
  </data>

  <!-- States -->
  <data name="Loading" xml:space="preserve">
    <value>Loading your orders…</value>
  </data>
  <data name="ErrorTitle" xml:space="preserve">
    <value>Something went wrong</value>
  </data>
  <data name="Error_GenericLoad" xml:space="preserve">
    <value>We couldn't load your orders. Please try again.</value>
  </data>
  <data name="RetryButton" xml:space="preserve">
    <value>Try again</value>
  </data>

  <!-- Empty states -->
  <data name="EmptyTitle" xml:space="preserve">
    <value>No orders yet</value>
  </data>
  <data name="EmptyMessage" xml:space="preserve">
    <value>Submit a cart to create your first order. Once it's approved and invoiced, you'll see it here.</value>
  </data>
  <data name="EmptyFilteredTitle" xml:space="preserve">
    <value>No orders match your filters</value>
  </data>
  <data name="EmptyFilteredMessage" xml:space="preserve">
    <value>Try a different search term or status filter.</value>
  </data>
  <!-- Date-range filter (Round 3) -->
  <data name="FilterAriaLabel" xml:space="preserve">
    <value>Filter orders by date</value>
  </data>
  <data name="FilterDateFrom" xml:space="preserve">
    <value>From date</value>
  </data>
  <data name="FilterDateTo" xml:space="preserve">
    <value>To date</value>
  </data>
  <data name="ApplyDateFilterButton" xml:space="preserve">
    <value>Apply</value>
  </data>
  <data name="ClearDateFilterButton" xml:space="preserve">
    <value>Clear date filter</value>
  </data>
  <data name="DateFilterInvalidRange" xml:space="preserve">
    <value>The "from" date must not be after the "to" date.</value>
  </data>
  <data name="EmptyTitleFiltered" xml:space="preserve">
    <value>No orders in this date range</value>
  </data>
  <data name="EmptyMessageFiltered" xml:space="preserve">
    <value>No orders were created between the selected dates. Widen the range or clear the filter to see all your orders.</value>
  </data>
  <data name="ExportCsvButton" xml:space="preserve">
    <value>Export CSV</value>
  </data>

  <data name="GoToCartButton" xml:space="preserve">
    <value>Go to cart</value>
  </data>
  <data name="BrowseProductsButton" xml:space="preserve">
    <value>Browse products</value>
  </data>
  <data name="ClearFiltersButton" xml:space="preserve">
    <value>Clear filters</value>
  </data>

  <!-- RadzenDataGrid empty text (shown when the grid has data but the
       per-column filters match zero rows). Distinct from EmptyTitle,
       which is shown when the backend returns zero sales total. -->
  <data name="EmptyText" xml:space="preserve">
    <value>No orders match your filters</value>
  </data>

  <!-- Table columns -->
  <data name="ColSaleNumber" xml:space="preserve">
    <value>Sale #</value>
  </data>
  <!-- Tooltip shown on draft sale numbers (pseudo-ids). Explains that this
       is a temporary identifier for an unsubmitted cart, not a permanent
       sale number. The permanent number is assigned when the cart is
       submitted. -->
  <data name="DraftPseudoIdTooltip" xml:space="preserve">
    <value>Draft cart — no sale number assigned yet</value>
  </data>
  <data name="ColStatus" xml:space="preserve">
    <value>Status</value>
  </data>
  <data name="ColTotal" xml:space="preserve">
    <value>Total</value>
  </data>
  <data name="ColCustomer" xml:space="preserve">
    <value>Customer</value>
  </data>
  <data name="ColCreatedBy" xml:space="preserve">
    <value>Created by</value>
  </data>
  <data name="ColCreated" xml:space="preserve">
    <value>Created</value>
  </data>
  <data name="ColActions" xml:space="preserve">
    <value>Actions</value>
  </data>
  <data name="ViewButton" xml:space="preserve">
    <value>View</value>
  </data>
  <data name="ActionViewDetail" xml:space="preserve">
    <value>View order details</value>
  </data>

  <!-- Pager -->
  <data name="PageInfoFormat" xml:space="preserve">
    <value>Page {0} of {1} • {2} orders</value>
  </data>
  <data name="ColCurrency" xml:space="preserve">
    <value>Currency</value>
  </data>
  <data name="ColCreatedAt" xml:space="preserve">
    <value>Created At (UTC)</value>
  </data>
  <data name="ExportCsvError" xml:space="preserve">
    <value>The CSV export failed. Please try again.</value>
  </data>

  <data name="PagerSummaryFormat" xml:space="preserve">
    <value>Page {0} of {1} ({2} sales)</value>
    <comment>Radzen pager summary format: {0}=current page, {1}=page count, {2}=server-side total sales count (Round 4 server-driven paging).</comment>
  </data>
  <data name="LoadingAriaLabel" xml:space="preserve">
    <value>Loading sales</value>
    <comment>Screen-reader label for the grid loading veil (Round 4).</comment>
  </data>
  <data name="ExportCsvDone" xml:space="preserve">
    <value>{0} sales exported to CSV</value>
    <comment>Success toast after the CSV export completes; {0}=exported row count (Round 4: exports all filtered rows, capped at 2000).</comment>
  </data>
  <data name="PagerPageSizeText" xml:space="preserve">
    <value>rows per page</value>
  </data>

</root>
