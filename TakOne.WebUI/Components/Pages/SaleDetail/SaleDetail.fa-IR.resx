<?xml version="1.0" encoding="utf-8"?>
<!-- SaleDetail.fa-IR.resx — Persian strings for SaleDetail.razor.

     Persian (Farsi) translations for the /Sales/{Id} order detail page.
     Strings flow RTL when the culture is fa-IR. -->
<root>
  <xsd:schema id="root" xmlns="" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
    <xsd:import namespace="http://www.w3.org/XML/1998/namespace" />
    <xsd:element name="root" msdata:IsDataSet="true">
      <xsd:complexType>
        <xsd:choice maxOccurs="unbounded">
          <xsd:element name="resheader">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="resmimetype">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="assembly">
            <xsd:complexType>
              <xsd:attribute name="alias" type="xsd:string" />
              <xsd:attribute name="name" type="xsd:string" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="data">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
                <xsd:element name="comment" type="xsd:string" minOccurs="0" msdata:Ordinal="2" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" msdata:Ordinal="1" />
              <xsd:attribute name="type" type="xsd:string" msdata:Ordinal="3" />
              <xsd:attribute name="mimetype" type="xsd:string" msdata:Ordinal="4" />
              <xsd:attribute ref="xml:space" />
            </xsd:complexType>
          </xsd:element>
        </xsd:choice>
      </xsd:complexType>
    </xsd:element>
  </xsd:schema>

  <resheader name="resmimetype">
    <value>text/microsoft-resx</value>
  </resheader>
  <resheader name="version">
    <value>2.0</value>
  </resheader>
  <resheader name="reader">
    <value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>
  <resheader name="writer">
    <value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>

  <!-- Page chrome -->
  <data name="PageTitle" xml:space="preserve">
    <value>جزئیات سفارش — تک‌وان</value>
  </data>
  <data name="BackToList" xml:space="preserve">
    <value>بازگشت به سفارش‌ها</value>
  </data>
  <data name="BreadcrumbSales" xml:space="preserve">
    <value>سفارش‌های من</value>
  </data>

  <!-- States -->
  <data name="Loading" xml:space="preserve">
    <value>در حال بارگذاری جزئیات سفارش…</value>
  </data>
  <data name="ErrorTitle" xml:space="preserve">
    <value>خطایی رخ داد</value>
  </data>
  <data name="Error_GenericLoad" xml:space="preserve">
    <value>بارگذاری این سفارش ناموفق بود. لطفاً دوباره تلاش کنید.</value>
  </data>
  <data name="Error_GenericAction" xml:space="preserve">
    <value>انجام این عملیات ناموفق بود. لطفاً دوباره تلاش کنید.</value>
  </data>
  <data name="RetryButton" xml:space="preserve">
    <value>تلاش مجدد</value>
  </data>
  <data name="NotFoundTitle" xml:space="preserve">
    <value>سفارش یافت نشد</value>
  </data>
  <data name="NotFoundMessage" xml:space="preserve">
    <value>این سفارش وجود ندارد یا شما اجازه مشاهده آن را ندارید.</value>
  </data>

  <!-- Status labels -->
  <data name="StatusDraft" xml:space="preserve">
    <value>پیش‌نویس</value>
  </data>
  <data name="StatusPending" xml:space="preserve">
    <value>در انتظار</value>
  </data>
  <data name="StatusApproved" xml:space="preserve">
    <value>تأیید شده</value>
  </data>
  <data name="StatusInvoiced" xml:space="preserve">
    <value>فاکتور شده</value>
  </data>
  <data name="StatusCancelled" xml:space="preserve">
    <value>لغو شده</value>
  </data>

  <!-- Audit trail -->
  <data name="AuditCreated" xml:space="preserve">
    <value>ایجاد شده</value>
  </data>
  <data name="AuditSubmitted" xml:space="preserve">
    <value>ارسال شده</value>
  </data>
  <data name="AuditApproved" xml:space="preserve">
    <value>تأیید شده</value>
  </data>
  <data name="AuditInvoiced" xml:space="preserve">
    <value>فاکتور شده</value>
  </data>
  <data name="AuditCancelled" xml:space="preserve">
    <value>لغو شده</value>
  </data>
  <data name="AuditPending" xml:space="preserve">
    <value>در انتظار اقدام</value>
  </data>
  <data name="AuditByFormat" xml:space="preserve">
    <value>توسط {0}</value>
  </data>

  <!-- Cancellation reason panel -->
  <data name="CancellationReasonLabel" xml:space="preserve">
    <value>دلیل لغو</value>
  </data>

  <!-- Line items table columns -->
  <data name="ColLineNumber" xml:space="preserve">
    <value>#</value>
  </data>
  <data name="ColProduct" xml:space="preserve">
    <value>محصول</value>
  </data>
  <data name="ColQuantity" xml:space="preserve">
    <value>تعداد</value>
  </data>
  <data name="ColUnitPrice" xml:space="preserve">
    <value>قیمت واحد</value>
  </data>
  <data name="ColLineTotal" xml:space="preserve">
    <value>مبلغ ردیف</value>
  </data>

  <!-- Totals summary -->
  <data name="TotalLines" xml:space="preserve">
    <value>تعداد محصولات</value>
  </data>
  <data name="TotalUnits" xml:space="preserve">
    <value>مجموع واحدها</value>
  </data>
  <data name="GrandTotal" xml:space="preserve">
    <value>مبلغ کل</value>
  </data>

  <!-- Staff actions -->
  <data name="ActionApprove" xml:space="preserve">
    <value>تأیید سفارش</value>
  </data>
  <data name="ActionMarkInvoiced" xml:space="preserve">
    <value>ثبت به عنوان فاکتور شده</value>
  </data>
  <data name="ActionCancel" xml:space="preserve">
    <value>لغو سفارش</value>
  </data>

  <!-- Cancel UX — inline form + dialog (replaces the old JS prompt flow) -->
  <data name="CancelPromptMessage" xml:space="preserve">
    <value>دلیل لغو را وارد کنید (الزامی، ۳ تا ۵۰۰ کاراکتر):</value>
  </data>
  <data name="CancelReasonLengthError" xml:space="preserve">
    <value>دلیل لغو باید بین ۳ تا ۵۰۰ کاراکتر باشد.</value>
  </data>

  <!-- Cancel dialog title (shown in the Radzen dialog header bar) -->
  <data name="CancelDialogTitle" xml:space="preserve">
    <value>تأیید لغو</value>
  </data>

  <!-- Inline cancel form (Step 1 of the cancel flow) -->
  <data name="CancelFormHeading" xml:space="preserve">
    <value>در حال لغو سفارش</value>
  </data>
  <data name="CancelFormReasonLabel" xml:space="preserve">
    <value>دلیل لغو *</value>
  </data>
  <data name="CancelFormReasonPlaceholder" xml:space="preserve">
    <value>دلیل روشن و مشخص را وارد کنید. برای تمام نقش‌ها الزامی است و به‌صورت دائمی ثبت می‌شود.</value>
  </data>
  <data name="CancelFormConfirm" xml:space="preserve">
    <value>تأیید لغو</value>
  </data>
  <data name="CancelFormCancelling" xml:space="preserve">
    <value>در حال لغو…</value>
  </data>
  <data name="CancelFormDiscard" xml:space="preserve">
    <value>صرف‌نظر</value>
  </data>

  <!-- Cancel-flow guard messages — surfaced as toasts when the user clicks
       "Confirm Cancellation" but a precondition isn't met. Previously these
       paths returned silently and the button appeared dead. -->
  <data name="CancelGuard_NoSale" xml:space="preserve">
    <value>بارگذاری سفارش ناموفق بود. صفحه را تازه‌سازی کنید و دوباره تلاش کنید.</value>
  </data>
  <data name="CancelGuard_Busy" xml:space="preserve">
    <value>عملیات دیگری در حال انجام است. تا پایان آن منتظر بمانید و دوباره تلاش کنید.</value>
  </data>
  <data name="CancelGuard_DialogError" xml:space="preserve">
    <value>باز کردن پنجرهٔ تأیید ممکن نشد. دوباره تلاش کنید؛ اگر مشکل پابرجا بود، صفحه را تازه‌سازی کنید.</value>
  </data>

  <!-- Action feedback -->
  <data name="ActionSuccessTitle" xml:space="preserve">
    <value>انجام شد</value>
  </data>
  <data name="ActionSuccessFormat" xml:space="preserve">
    <value>{0} — سفارش به‌روزرسانی شد.</value>
  </data>

  <!-- پیام‌های خطای محلی‌شده برای کدهای خطای پایدار و مستقل از فرهنگ که
       توسط هندلرهای دستور Approve / MarkAsInvoiced / Cancel بازگردانده می‌شوند.
       به LocalizeError در SaleDetail.razor و کمک‌کننده‌های TakOne.Application.Common.Errors
       (StockErrors، CategoryDeactivatedErrors، PurchaseLimitErrors) مراجعه کنید. -->
  <!-- StockExceeded — {0} = نام محصول، {1} = موجودی فعلی، {2} = تعداد درخواستی -->
  <data name="StockExceeded" xml:space="preserve">
    <value>موجودی برای تأیید این سفارش کافی نیست. محصول «{0}» {1} عدد موجود دارد، اما سفارش به {2} عدد نیاز دارد.</value>
  </data>
  <!-- CategoryDeactivated — {0} = نام محصول (دسته‌بندی محصول غیرفعال شده است) -->
  <data name="CategoryDeactivated" xml:space="preserve">
    <value>کالای «{0}» دیگر قابل خرید نیست. آن را از سفارش حذف کنید یا با مدیر سیستم تماس بگیرید.</value>
  </data>
  <!-- PurchaseLimitExceeded — {0} = نام محصول، {1} = سقف خرید هر مشتری -->
  <data name="PurchaseLimitExceeded" xml:space="preserve">
    <value>سقف خرید برای «{0}» {1} عدد است. این سفارش از سقف مجاز فراتر می‌رود.</value>
  </data>
</root>