@* Dashboard.razor — Phase 2.1
   Staff-only dashboard at route "/". Per roadmap Section 12.8, Customers
   never land here — they're redirected to /Products at login time. The
   page is gated by [Authorize] (any authenticated user) PLUS a runtime
   role check inside OnInitializedAsync that bounces Customers to
   /Account/AccessDenied as defense-in-depth.

   LAYOUT:
     - Welcome header (current user's name + today's date + scope label)
     - 6 KPI cards (total sales, draft, pending, approved, cancelled,
       active customers)
     - Split layout 9/3:
       - Left (9): 5-year revenue pie, year column chart, monthly line
       - Right (3): status donut + quick-actions panel

   DATA LOADING:
     Single Wolverine IMessageBus.InvokeAsync<Result<DashboardStatsDto>>
     call. Loading spinner while in-flight, error alert on failure.

   ROLE-AWARE SCOPE (roadmap Section 12.2):
     - Admin/Manager/ReadOnly → "Company-wide overview" (all sales)
     - Employee → "Your personal performance" (only sales they approved)
     The scope label in the welcome header switches on stats.IsEmployeeScoped.

   LOCALIZATION:
     All user-visible strings go through IStringLocalizer<Dashboard> (Loc).
     Chart axis labels (month abbreviations) are NOT yet localized — see
     the comment on MonthlyRevenueDto.MonthLabel for the deferral note. *@

@page "/"
@attribute [Authorize(Roles = "Admin,Manager,Employee,ReadOnly")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Wolverine
@using TakOne.Application.Common.Authorization
@using TakOne.Application.Common.Interfaces
@using TakOne.Application.Dashboard.DTOs
@using TakOne.Application.Dashboard.Queries.GetDashboardStats
@using TakOne.SharedKernel.Common
@inject IMessageBus MessageBus
@inject ICurrentUserService CurrentUser
@inject NavigationManager Navigation
@inject IStringLocalizer<Dashboard> Loc

<PageTitle>@Loc["PageTitle"]</PageTitle>

<HeadContent>
    <style>
            .action-tile 
            {
                transition: all 0.2s ease;
                cursor: pointer;
                padding: 1rem;
                border-radius: var(--rz-border-radius);
                border: 1px solid transparent;
            }

                .action-tile:hover,
                .action-tile:active 
                {
                    background: var(--rz-panelmenu-item-hover-background-color);
                    border-color: gray;
                    color: gray;
                    transform: translateX(4px);
                }

                    .action-tile:hover .rz-icon,
                    .action-tile:hover RadzenText 
                    {
                        color: var(--rz-primary);
                    }

            .stat-value 
            {
                font-size: 1.75rem;
                font-weight: 700;
                line-height: 1;
            }

            /* NOTE: the .summary-card hover-lift + shadow rules used to live
                           here, but they leaked across ALL themes via the
                           `var(--tm-shadow-lg, ...)` fallback (other Radzen themes don't
                           define --tm-shadow-lg, so they got the green-tinted rgba fallback
                           — a Tak-specific look bleeding into non-Tak themes).
                           The hover effect now lives ONLY in tak-light.css under the
                           .tm-kpi-card.summary-card:hover selector, so non-Tak themes
                           get the default Radzen card behavior with no forced shadow. */

            .status-chart .rz-legend-bottom 
            {
                bottom: -50px !important;
            }
    </style>
</HeadContent>

@* ── Loading ── *@
@if (_isLoading)
{
    <RadzenStack AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center"
                 Style="height: 50vh;" Gap="1rem">
        <RadzenProgressBarCircular ShowValue="false"
                                   Mode="ProgressBarMode.Indeterminate"
                                   Size="ProgressBarCircularSize.Large" />
        <RadzenText TextStyle="TextStyle.Body2" ThemeColor="TextColor.Secondary">
            @Loc["Loading"]
        </RadzenText>
    </RadzenStack>
}
@* ── Error ── *@
else if (!string.IsNullOrEmpty(_loadError))
{
    <RadzenAlert Title="@Loc["ErrorTitle"]"
                 Text="@_loadError"
                 AlertStyle="AlertStyle.Danger"
                 Variant="Variant.Filled"
                 ShowIcon="true"
                 class="mb-3" />
}
@* ── Dashboard ── *@
else if (_stats is not null)
{
    @* ════════════════════════════════════════
       WELCOME HEADER
       ════════════════════════════════════════ *@
    <RadzenStack Orientation="Orientation.Horizontal"
                 JustifyContent="JustifyContent.SpaceBetween"
                 AlignItems="AlignItems.End"
                 Wrap="FlexWrap.Wrap"
                 Gap="0.75rem"
                 class="mb-4">
        <div>
            <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H2" class="mb-0">
                @Loc["WelcomeBack"], @_stats.CurrentUserName
            </RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" ThemeColor="TextColor.Secondary">
                @DateTime.Now.ToString("dddd, MMMM d, yyyy")
                @if (_stats.IsEmployeeScoped)
                {
                    <span> · @Loc["ScopeEmployee"]</span>
                }
                else
                {
                    <span> · @Loc["ScopeCompany"]</span>
                }
            </RadzenText>
        </div>

        @* Total revenue — prominent but not a card *@
        <div Style="text-align: right;">
            <RadzenText TextStyle="TextStyle.Caption" ThemeColor="TextColor.Secondary"
                        Style="display: block; letter-spacing: .06em; text-transform: uppercase;">
                @Loc["TotalRevenue"]
            </RadzenText>
            <span Style="font-size: 1.9rem; font-weight: 800; color: var(--rz-success);">
                @FormatMoney(_stats.TotalRevenue)
            </span>
            <span Style="font-size: 0.85rem; color: var(--rz-text-secondary-color); margin-left: 3px;">
                @_stats.Currency
            </span>
        </div>
    </RadzenStack>

    @* ════════════════════════════════════════
       TOP ROW — 6-Column Summary Cards Grid
       ════════════════════════════════════════ *@
    <RadzenRow Gap="7" Style="margin-bottom: 1rem;">
        @* Total Sales — the .tm-kpi-total class lets the Tak Light theme
           override the top-bar color to purple (per user spec). Other themes
           keep whatever --rz-primary resolves to. *@
        <RadzenColumn Size="12" SizeMD="6" SizeLG="2">
            <RadzenCard class="summary-card tm-kpi-card tm-kpi-total" Style="border-top: 4px solid var(--rz-primary); height: 100%;">
                <RadzenStack Gap="0.4rem">
                    <RadzenIcon Icon="receipt_long"
                                Style="font-size: 1.5rem;" />
                    <span class="stat-value">
                        @_stats.TotalSalesCount
                    </span>
                    <RadzenText TextStyle="TextStyle.Caption" ThemeColor="TextColor.Secondary">
                        @Loc["Kpi_TotalSales"]
                    </RadzenText>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>

        @* Draft *@
        <RadzenColumn Size="12" SizeMD="6" SizeLG="2">
            <RadzenCard class="summary-card tm-kpi-card" Style="border-top: 4px solid var(--rz-info); height: 100%;">
                <RadzenStack Gap="0.4rem">
                    <RadzenIcon Icon="edit_note"
                                Style="font-size: 1.5rem;" />
                    <span class="stat-value">
                        @_stats.DraftSalesCount
                    </span>
                    <RadzenText TextStyle="TextStyle.Caption" ThemeColor="TextColor.Secondary">
                        @Loc["Kpi_Draft"]
                    </RadzenText>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>

        @* Pending *@
        <RadzenColumn Size="12" SizeMD="6" SizeLG="2">
            <RadzenCard class="summary-card tm-kpi-card" Style="border-top: 4px solid var(--rz-warning); height: 100%;">
                <RadzenStack Gap="0.4rem">
                    <RadzenIcon Icon="hourglass_empty"
                                Style="font-size: 1.5rem;" />
                    <span class="stat-value">
                        @_stats.PendingSalesCount
                    </span>
                    <RadzenText TextStyle="TextStyle.Caption" ThemeColor="TextColor.Secondary">
                        @Loc["Kpi_Pending"]
                    </RadzenText>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>

        @* Approved *@
        <RadzenColumn Size="12" SizeMD="6" SizeLG="2">
            <RadzenCard class="summary-card tm-kpi-card" Style="border-top: 4px solid var(--rz-success); height: 100%;">
                <RadzenStack Gap="0.4rem">
                    <RadzenIcon Icon="check_circle"
                                Style="font-size: 1.5rem;" />
                    <span class="stat-value">
                        @_stats.ApprovedSalesCount
                    </span>
                    <RadzenText TextStyle="TextStyle.Caption" ThemeColor="TextColor.Secondary">
                        @Loc["Kpi_Approved"]
                    </RadzenText>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>

        @* Cancelled *@
        <RadzenColumn Size="12" SizeMD="6" SizeLG="2">
            <RadzenCard class="summary-card tm-kpi-card" Style="border-top: 4px solid var(--rz-danger); height: 100%;">
                <RadzenStack Gap="0.4rem">
                    <RadzenIcon Icon="cancel"
                                Style="font-size: 1.5rem;" />
                    <span class="stat-value">
                        @_stats.CancelledSalesCount
                    </span>
                    <RadzenText TextStyle="TextStyle.Caption" ThemeColor="TextColor.Secondary">
                        @Loc["Kpi_Cancelled"]
                    </RadzenText>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>

        @* Invoiced — replaces the previous "Active Customers" card per user
           spec. The Invoiced count is sourced from the donut chart's
           StatusBreakdown (computed by the dashboard handler — one row per
           SaleStatus value present in scope). If no sales are in Invoiced
           status, the count falls back to 0.

           The border-top color #14B8A6 (teal) MATCHES the Invoiced donut
           slice color (see GetStatusColor("Invoiced") below) — so the card
           and the chart slice are visually cross-referenceable, just like
           the other 4 status cards (Draft/Pending/Approved/Cancelled). *@
        <RadzenColumn Size="12" SizeMD="6" SizeLG="2">
            <RadzenCard class="summary-card tm-kpi-card" Style="border-top: 4px solid #14B8A6; height: 100%;">
                <RadzenStack Gap="0.4rem">
                    <RadzenIcon Icon="request_quote" Style="font-size: 1.5rem;" />
                    <span class="stat-value">
                        @InvoicedSalesCount
                    </span>
                    <RadzenText TextStyle="TextStyle.Caption" ThemeColor="TextColor.Secondary">
                        @Loc["Kpi_Invoiced"]
                    </RadzenText>
                </RadzenStack>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>

    @* ════════════════════════════════════════
       MIDDLE SECTION — Split Layout 9/3
       ════════════════════════════════════════ *@
    <RadzenRow Gap="3" class="mb-4">
        @* Left Column (Size 9) — Revenue Charts *@
        <RadzenColumn Size="12" SizeLG="9">
            <RadzenStack Gap="3">
                @* 5-Year Revenue Distribution Pie *@
                <RadzenCard Style="height: 400px;">
                    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H5" class="mb-0">
                        @Loc["Chart_5YearPie"]
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" ThemeColor="TextColor.Secondary"
                                Style="display: block; margin-bottom: 0.5rem;">
                        @(DateTime.Now.Year - 4)–@DateTime.Now.Year
                        · @(_stats.IsEmployeeScoped ? Loc["ChartLegend_Employee"] : Loc["ChartLegend_All"])
                        · @Loc["ChartLegend_ExcludingCancelled"]
                    </RadzenText>

                    @if (_stats.YearlyData.All(y => y.TotalAmount == 0))
                    {
                        <RadzenStack AlignItems="AlignItems.Center"
                                     JustifyContent="JustifyContent.Center"
                                     Style="height: 300px;" Gap="0.5rem">
                            <RadzenIcon Icon="donut_large"
                                        Style="font-size: 13rem; color: var(--rz-text-secondary-color);" />
                            <RadzenText ThemeColor="TextColor.Secondary">@Loc["Empty_Revenue"]</RadzenText>
                        </RadzenStack>
                    }
                    else
                    {
                        <RadzenChart Style="height: 310px;">
                            <RadzenPieSeries Data="@_stats.YearlyData.Where(y => y.TotalAmount > 0).ToList()"
                                             Title="@Loc["ChartLegend_Revenue"]"
                                             CategoryProperty="YearLabel"
                                             ValueProperty="TotalAmount">
                            </RadzenPieSeries>
                            <RadzenLegend Position="LegendPosition.Bottom" />
                        </RadzenChart>
                    }
                </RadzenCard>

                @* Year-over-Year Revenue Column *@
                <RadzenCard Style="height: 400px;">
                    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H5" class="mb-0">
                        @Loc["Chart_YearColumn"]
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" ThemeColor="TextColor.Secondary"
                                Style="display: block; margin-bottom: 0.5rem;">
                        @Loc["Chart_Last5Years"] · @_stats.Currency · @Loc["ChartLegend_ExcludingCancelled"]
                    </RadzenText>
                    <RadzenChart Style="height: 310px;">
                        <RadzenColumnSeries Data="@_stats.YearlyData"
                                            Title="@(_stats.Currency)"
                                            CategoryProperty="YearLabel"
                                            ValueProperty="TotalAmount">
                        </RadzenColumnSeries>
                        <RadzenCategoryAxis Padding="20" />
                        <RadzenValueAxis FormatString="{0:N0}">
                            <RadzenGridLines Visible="true" />
                        </RadzenValueAxis>
                        <RadzenLegend Position="LegendPosition.Top" />
                    </RadzenChart>
                </RadzenCard>

                @* Monthly Revenue Line Chart *@
                <RadzenCard>
                    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H5" class="mb-0">
                        @Loc["Chart_MonthlyLine"] — @DateTime.Now.Year
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" ThemeColor="TextColor.Secondary"
                                Style="display: block; margin-bottom: 0.5rem;">
                        @_stats.Currency · @Loc["ChartLegend_ExcludingCancelled"] ·
                        @(_stats.IsEmployeeScoped ? Loc["ChartLegend_EmployeeSales"] : Loc["ChartLegend_AllSellers"])
                    </RadzenText>
                    <RadzenChart Style="height: 270px;">
                        <RadzenLineSeries Data="@_stats.CurrentYearMonthlyData"
                                          Title="@(_stats.Currency)"
                                          CategoryProperty="MonthLabel"
                                          ValueProperty="TotalAmount">
                            <RadzenSeriesDataLabels Visible="false" />
                            <RadzenMarkers MarkerType="MarkerType.Circle" />
                        </RadzenLineSeries>
                        <RadzenCategoryAxis Padding="20" />
                        <RadzenValueAxis FormatString="{0:N0}">
                            <RadzenGridLines Visible="true" />
                        </RadzenValueAxis>
                        <RadzenLegend Position="LegendPosition.Top" />
                    </RadzenChart>
                </RadzenCard>
            </RadzenStack>
        </RadzenColumn>

        @* Right Column (Size 3) — Stacked Charts Vertically *@
        <RadzenColumn Size="12" SizeLG="3">
            <RadzenStack Gap="3">
                @* Sales by Status Donut (Top) *@
                <RadzenCard Style="height: 400px;">
                    <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H5" class="mb-0">
                        @Loc["Chart_StatusDonut"]
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Caption" ThemeColor="TextColor.Secondary"
                                Style="display: block;">
                        @Loc["Chart_StatusSubtitle"]
                    </RadzenText>
                    @if (!_stats.StatusBreakdown.Any())
                    {
                        <RadzenStack AlignItems="AlignItems.Center"
                                     JustifyContent="JustifyContent.Center"
                                     Style="height: 300px;" Gap="0.5rem">
                            <RadzenIcon Icon="pie_chart"
                                        Style="font-size: 13rem; color: var(--rz-text-secondary-color);" />
                            <RadzenText ThemeColor="TextColor.Secondary">@Loc["Empty_Sales"]</RadzenText>
                        </RadzenStack>
                    }
                    else
                    {
                        <RadzenChart class="status-chart"
                                     Style="height: 260px;">
                            @* Fills — per-slice colors matching the KPI card border-tops:
                               Draft=blue(info), Pending=orange(warning),
                               Approved=green(success), Invoiced=teal,
                               Cancelled=red(danger).
                               This makes the donut slices visually match the
                               card accents so the user can cross-reference at
                               a glance (e.g. red slice = cancelled = red card top). *@
                            <RadzenDonutSeries Data="@_stats.StatusBreakdown"
                                               Title="@Loc["ChartLegend_Count"]"
                                               CategoryProperty="Status"
                                               ValueProperty="Count"
                                               Fills="@(_stats.StatusBreakdown.Select(s => GetStatusColor(s.Status)).ToList())">
                            </RadzenDonutSeries>
                            <RadzenLegend Position="LegendPosition.Bottom" />
                        </RadzenChart>
                    }
                </RadzenCard>

                @* Quick Actions (Bottom) *@
                <RadzenCard>
                    <RadzenText TextStyle="TextStyle.H6" class="mb-3">@Loc["QuickActions"]</RadzenText>
                    <RadzenStack Gap="4">
                        @* Browse Products — available to all staff (everyone except ReadOnly can shop;
                           ReadOnly sees the catalog read-only too — clicking just navigates, no
                           AddToCart since that button is hidden via AuthorizeView in MainLayout). *@
                        <div class="action-tile rz-panelmenu-item"
                             @onclick="@(() => Navigation.NavigateTo("/Products"))">
                            <RadzenStack Gap="0.4rem">
                                <RadzenIcon Icon="inventory_2"
                                            Style="color: var(--rz-primary); font-size: 1.75rem;" />
                                <RadzenText TextStyle="TextStyle.Subtitle2">@Loc["Action_BrowseProducts"]</RadzenText>
                                <RadzenText TextStyle="TextStyle.Caption" ThemeColor="TextColor.Secondary">
                                    @Loc["Action_BrowseProducts_Desc"]
                                </RadzenText>
                            </RadzenStack>
                        </div>

                        @* View My Sales — everyone has order history (customers see their own purchases;
                           staff see all sales they have visibility into). *@
                        <div class="action-tile rz-panelmenu-item"
                             @onclick="@(() => Navigation.NavigateTo("/Sales"))">
                            <RadzenStack Gap="0.4rem">
                                <RadzenIcon Icon="receipt_long"
                                            Style="color: var(--rz-success); font-size: 1.75rem;" />
                                <RadzenText TextStyle="TextStyle.Subtitle2">@Loc["Action_ViewSales"]</RadzenText>
                                <RadzenText TextStyle="TextStyle.Caption" ThemeColor="TextColor.Secondary">
                                    @Loc["Action_ViewSales_Desc"]
                                </RadzenText>
                            </RadzenStack>
                        </div>

                        @* Manage Products — staff only (Admin/Manager/Employee). Hidden from
                           Customer/ReadOnly per roadmap Section 12.7 (hide, don't disable). *@
                        <AuthorizeView Roles="@(Roles.Admin + "," + Roles.Manager + "," + Roles.Employee)">
                            <div class="action-tile rz-panelmenu-item"
                                 @onclick="@(() => Navigation.NavigateTo("/Admin/Products"))">
                                <RadzenStack Gap="0.4rem">
                                    <RadzenIcon Icon="inventory"
                                                Style="color: var(--rz-info); font-size: 1.75rem;" />
                                    <RadzenText TextStyle="TextStyle.Subtitle2">@Loc["Action_ManageProducts"]</RadzenText>
                                    <RadzenText TextStyle="TextStyle.Caption" ThemeColor="TextColor.Secondary">
                                        @Loc["Action_ManageProducts_Desc"]
                                    </RadzenText>
                                </RadzenStack>
                            </div>
                        </AuthorizeView>

                        @* User Management — Admin + Manager only (per roadmap Section 12.6). *@
                        <AuthorizeView Roles="@(Roles.Admin + "," + Roles.Manager)">
                            <div class="action-tile rz-panelmenu-item"
                                 @onclick="@(() => Navigation.NavigateTo("/Admin/Users"))">
                                <RadzenStack Gap="0.4rem">
                                    <RadzenIcon Icon="manage_accounts"
                                                Style="color: var(--rz-info); font-size: 1.75rem;" />
                                    <RadzenText TextStyle="TextStyle.Subtitle2">@Loc["Action_ManageUsers"]</RadzenText>
                                    <RadzenText TextStyle="TextStyle.Caption" ThemeColor="TextColor.Secondary">
                                        @Loc["Action_ManageUsers_Desc"]
                                    </RadzenText>
                                </RadzenStack>
                            </div>
                        </AuthorizeView>
                    </RadzenStack>
                </RadzenCard>
            </RadzenStack>
        </RadzenColumn>
    </RadzenRow>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private DashboardStatsDto? _stats;
    private bool _isLoading = true;
    private string _loadError = string.Empty;

    /// <summary>
    /// Number of sales currently in <c>SaleStatus.Invoiced</c> status, within
    /// the caller's scope. Sourced from <c>_stats.StatusBreakdown</c> (the
    /// same data the donut chart binds to) — the dashboard handler emits one
    /// <c>StatusCountDto</c> per status value present in scope, so we just
    /// look up the "Invoiced" row and fall back to 0 if no sales are in
    /// that status (e.g. an Employee-scoped dashboard with no invoiced sales
    /// they personally approved).
    ///
    /// WHY NOT A DEDICATED DTO FIELD: the handler already produces the
    /// StatusBreakdown list for the donut chart — adding a separate
    /// <c>InvoicedSalesCount</c> property to <c>DashboardStatsDto</c> would
    /// be redundant. The other 4 status cards (Draft, Pending, Approved,
    /// Cancelled) DO have dedicated fields because they pre-date the
    /// StatusBreakdown donut (added in task 7.2). Adding Invoiced directly
    /// to the breakdown lookup keeps this card's data source consistent
    /// with the donut's — they can never drift apart.
    /// </summary>
    private int InvoicedSalesCount =>
        _stats?.StatusBreakdown?.FirstOrDefault(s => s.Status == "Invoiced")?.Count ?? 0;

    protected override async Task OnInitializedAsync()
    {
        // ------------------------------------------------------------------
        // Defense-in-depth role check. The Dashboard route is [Authorize]
        // (any authenticated user can hit it), but per roadmap Section 12.8
        // Customers should NEVER see the dashboard — they redirect to
        // /Products at login time. If a Customer somehow lands here (e.g.
        // types "/" into the URL bar), bounce them to /Account/AccessDenied
        // with forceLoad so the redirect takes effect cleanly.
        // ------------------------------------------------------------------
        var authState = await AuthStateTask;
        var user = authState.User;

        if (user.Identity?.IsAuthenticated != true)
        {
            // Shouldn't happen ([Authorize] would have caught this), but
            // defense-in-depth: redirect to login.
            Navigation.NavigateTo("/Account/Login", forceLoad: true);
            return;
        }

        if (user.IsInRole(Roles.Customer))
        {
            Navigation.NavigateTo("/Account/AccessDenied", forceLoad: true);
            return;
        }

        // ------------------------------------------------------------------
        // Build the role list to pass into the query. The handler uses this
        // to decide between the AllSales spec (Admin/Manager/ReadOnly) and
        // the SaleByApprover spec (Employee).
        // ------------------------------------------------------------------
        var roles = new List<string>();
        if (user.IsInRole(Roles.Admin)) roles.Add(Roles.Admin);
        if (user.IsInRole(Roles.Manager)) roles.Add(Roles.Manager);
        if (user.IsInRole(Roles.Employee)) roles.Add(Roles.Employee);
        if (user.IsInRole(Roles.ReadOnly)) roles.Add(Roles.ReadOnly);
        if (user.IsInRole(Roles.Customer)) roles.Add(Roles.Customer);

        await LoadStatsAsync(roles);
    }

    private async Task LoadStatsAsync(IReadOnlyList<string> roles)
    {
        _isLoading = true;
        _loadError = string.Empty;

        try
        {
            var query = new GetDashboardStatsQuery
            {
                RequestedByUserId = CurrentUser.UserId,
                UserRoles = roles
            };

            var result = await MessageBus.InvokeAsync<Result<DashboardStatsDto>>(query);

            if (result.IsSuccess)
            {
                _stats = result.Value;
            }
            else
            {
                _loadError = result.Error;
                if (string.IsNullOrEmpty(_loadError))
                {
                    _loadError = Loc["Error_FailedToLoad"];
                }
            }
        }
        catch (Exception)
        {
            // Defensive: any unexpected error → generic message. Don't
            // leak exception details to the user (could expose DB schema
            // or other sensitive info).
            _loadError = Loc["Error_Unexpected"];
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>
    /// Formats a money amount for compact display: 1.2K, 3.4M, 5.6B.
    /// Used in the "Total Revenue" header — the KPI cards show raw counts
    /// (no formatting), but revenue is usually a large number that benefits
    /// from abbreviation.
    /// </summary>
    private static string FormatMoney(decimal amount)
    {
        if (amount >= 1_000_000_000m) return $"{amount / 1_000_000_000m:F1}B";
        if (amount >= 1_000_000m) return $"{amount / 1_000_000m:F1}M";
        if (amount >= 1_000m) return $"{amount / 1_000m:F1}K";
        return amount.ToString("N0");
    }

    /// <summary>
    /// Maps a SaleStatus name (stringified by the DTO handler) to the hex
    /// color used for the corresponding KPI card's border-top. This makes
    /// the donut chart slices visually match the card accents — e.g. the
    /// "Cancelled" slice is red, matching the red border-top on the
    /// Cancelled KPI card.
    ///
    /// WHY HARDCODED HEX (not CSS variables): Radzen charts render slices
    /// as SVG &lt;path fill="..."&gt; elements. SVG fill attributes do NOT
    /// resolve CSS custom properties (var(--rz-info)) reliably across
    /// browsers — the fill would be transparent. So we use the literal hex
    /// values that the Radzen variables resolve to (defined in
    /// tak-light.css's :root block).
    ///
    /// Color mapping:
    ///   Draft     → #3B82F6  (blue,    matches --rz-info / card border-top)
    ///   Pending   → #F59E0B  (orange,  matches --rz-warning)
    ///   Approved  → #16A34A  (green,   matches --rz-success)
    ///   Invoiced  → #14B8A6  (teal,    distinct from Approved's green)
    ///   Cancelled → #DC2626  (red,     matches --rz-danger)
    /// </summary>
    private static string GetStatusColor(string status) => status switch
    {
        "Draft" => "#3B82F6",
        "Pending" => "#F59E0B",
        "Approved" => "#16A34A",
        "Invoiced" => "#14B8A6",
        "Cancelled" => "#DC2626",
        _ => "#0E4D3C"  // fallback: tm-green
    };
}