@* Dashboard.razor — Redesigned (Phase 3)
   Staff-only dashboard at route "/". Per roadmap Section 12.8, Customers
   never land here — they're redirected to /Products at login time.

   LAYOUT (top-to-bottom):
     1. Greeting header — user name + date + scope subtitle
     2. KPI row — 4 cards (right-to-left in RTL):
          - سفارشات امروز (Today's Orders)
          - مجموع خرید کارکنان در این ماه (Monthly Employee Purchase)
          - در انتظار تأیید (Pending Approvals)
          - تعداد فروش های این ماه (Approved Sales This Month)
     3. Charts row 1 — Weekly Revenue Trend (line, 2/3) + Status Donut (1/3)
     4. Charts row 2 — Top Products Bar (2/3) + Category Pie (1/3)
     5. Bottom row — Recent Orders table (2/3) + Top Employees card (1/3)
     6. Quick access row — Settings + Users (2 cards; per user spec,
        مدیریت مالی and گزارش فروش quick-access cards are REMOVED)

   REMOVED per user spec:
     - هشدار موجودی (Low Stock Alert) card
     - مدیریت مالی (Financial Management) quick action
     - گزارش فروش (Sales Report) quick action
     - برترین کارکنان → REPLACED with "کارکنان با بالاترین مبلغ خرید در این ماه"

   CHARTS:
     All 4 charts use Chart.js (vendored at /lib/chartjs/chart.umd.min.js).
     The dashboard.js script exposes window.takDashboard.render(data)
     which initializes all 4 charts with the Tak Makaron dark palette +
     Persian digit tooltips. We pass the data + localized labels via
     JS interop after the data loads.

   CURRENCY CONVERSION (IRR → Toman):
     Per user spec, when the sale currency is IRR, all amounts are divided
     by 10 server-side (in the handler) and the DisplayCurrency is set to
     "تومان". The razor page just displays the (already-converted) numbers
     + the label.

   ROUNDED vs SHARP EDGES:
     Per user spec, only tak-light and tak-dark themes get rounded corners
     on all cards. Other themes get sharp corners. This is handled by
     `border-radius: var(--tm-radius, 0)` in Dashboard.css — the
     --tm-radius variable is only defined in tak-light.css / tak-dark.css. *@

@page "/"
@attribute [Authorize(Roles = "Admin,Manager,Employee,ReadOnly")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Globalization
@using Wolverine
@using TakOne.Application.Common.Authorization
@using TakOne.Application.Common.Interfaces
@using TakOne.Application.Dashboard.DTOs
@using TakOne.Application.Dashboard.Queries.GetDashboardStats
@using TakOne.SharedKernel.Common
@inject IMessageBus MessageBus
@inject ICurrentUserService CurrentUser
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IStringLocalizer<Dashboard> Loc

<PageTitle>@Loc["PageTitle"]</PageTitle>

@* ── Loading ── *@
@if (_isLoading)
{
    <div class="tm-dash-loading">
        <RadzenProgressBarCircular ShowValue="false"
                                   Mode="ProgressBarMode.Indeterminate"
                                   Size="ProgressBarCircularSize.Large" />
        <span>@Loc["Loading"]</span>
    </div>
}
@* ── Error ── *@
else if (!string.IsNullOrEmpty(_loadError))
{
    <RadzenAlert Title="@Loc["ErrorTitle"]"
                 Text="@_loadError"
                 AlertStyle="AlertStyle.Danger"
                 Variant="Variant.Filled"
                 ShowIcon="true"
                 class="m-4" />
}
@* ── Dashboard ── *@
else if (_stats is not null)
{
    <div class="tm-dash-page">

        @* ════════════════════════════════════════
           GREETING HEADER
           — Time-of-day greeting ("Good morning/afternoon/evening, Mr./Ms. {FullName}")
             using the user's gender claim + the server's local time.
           ════════════════════════════════════════ *@
        <div class="tm-dash-greeting">
            <div>
                <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.25rem;">
                    <span class="tm-dash-greeting-badge">
                        <span class="tm-dash-greeting-pulse"></span>
                        @Loc["ActivePanel"]
                    </span>
                    <span class="tm-dash-greeting-date">@FormatDate(DateTime.Now)</span>
                </div>
                <h2 class="tm-dash-greeting-title">
                    @GreetingLabel @_stats.CurrentUserName
                </h2>
                <p class="tm-dash-greeting-subtitle">
                    @if (_stats.IsEmployeeScoped)
                    {
                        @Loc["ScopeEmployee"]
                    }
                    else
                    {
                        @Loc["GreetingSubtitle"]
                    }
                </p>
            </div>
        </div>

        @* ════════════════════════════════════════
           KPI ROW — 4 cards (right-to-left in RTL)
           ════════════════════════════════════════ *@
        <div class="tm-dash-kpi-grid">

            @* KPI 1: Today's Orders (green glow, shopping bag icon) *@
            <div class="tm-dash-kpi-card tm-dash-kpi-glow-green">
                <div class="tm-dash-kpi-card-head">
                    <div class="tm-dash-icon-tile tm-dash-icon-green">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                        </svg>
                    </div>
                    <span class="tm-dash-kpi-badge tm-dash-badge-approved">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" style="width:12px;height:12px;">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 13l4-4 4 4 8-8" />
                        </svg>
                        @FormatDigits(_stats.TodayOrdersCount)
                    </span>
                </div>
                <p class="tm-dash-kpi-label">@Loc["Kpi_TodayOrders"]</p>
                <p class="tm-dash-kpi-value">@FormatDigits(_stats.TodayOrdersCount)</p>
                <p class="tm-dash-kpi-footer">@Loc["Kpi_TodayOrdersFooter"]</p>
            </div>

            @* KPI 2: Monthly Employee Purchase Total (gold glow, money icon) *@
            <div class="tm-dash-kpi-card tm-dash-kpi-glow-gold">
                <div class="tm-dash-kpi-card-head">
                    <div class="tm-dash-icon-tile tm-dash-icon-gold">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                </div>
                <p class="tm-dash-kpi-label">@Loc["Kpi_MonthlyEmployeePurchase"]</p>
                <p class="tm-dash-kpi-value">
                    @FormatMoneyShort(_stats.ThisMonthEmployeePurchaseTotal)
                    <span class="tm-dash-kpi-value-suffix">@_stats.DisplayCurrency</span>
                </p>
                <p class="tm-dash-kpi-footer">
                    @Loc["Kpi_MonthlyEmployeePurchaseFooter"]
                    <strong>@FormatDigits(_stats.ThisMonthActiveEmployeeCount)</strong>
                </p>
            </div>

            @* KPI 3: Pending Approvals (warn glow, clock icon) *@
            <div class="tm-dash-kpi-card tm-dash-kpi-glow-warn">
                <div class="tm-dash-kpi-card-head">
                    <div class="tm-dash-icon-tile tm-dash-icon-warn">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                </div>
                <p class="tm-dash-kpi-label">@Loc["Kpi_PendingApprovals"]</p>
                <p class="tm-dash-kpi-value">@FormatDigits(_stats.PendingSalesCount)</p>
                @if (_stats.OldestPendingSaleAgeMinutes is { } ageMinutes && ageMinutes > 0)
                {
                    <p class="tm-dash-kpi-footer">
                        @Loc["Kpi_PendingApprovalsFooter_Prefix"]
                        <strong>@FormatOldestPending(ageMinutes)</strong>
                    </p>
                }
                else
                {
                    <p class="tm-dash-kpi-footer">@Loc["Kpi_PendingApprovalsFooter_None"]</p>
                }
            </div>

            @* KPI 4: Approved Sales This Month (info glow, users icon) *@
            <div class="tm-dash-kpi-card tm-dash-kpi-glow-info">
                <div class="tm-dash-kpi-card-head">
                    <div class="tm-dash-icon-tile tm-dash-icon-info">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                        </svg>
                    </div>
                </div>
                <p class="tm-dash-kpi-label">@Loc["Kpi_MonthlyApprovedSales"]</p>
                <p class="tm-dash-kpi-value">@FormatDigits(_stats.ThisMonthApprovedSalesCount)</p>
                <p class="tm-dash-kpi-footer">@Loc["Kpi_MonthlyApprovedSalesFooter"]</p>
            </div>
        </div>

        @* ════════════════════════════════════════
           CHARTS ROW 1 — Revenue Trend (line, 2/3) + Status Donut (1/3)
           ════════════════════════════════════════ *@
        <div class="tm-dash-chart-row tm-dash-chart-row-2-1">

            @* Revenue Trend (Line) *@
            <div class="tm-dash-card">
                <div class="tm-dash-card-head">
                    <div>
                        <h3 class="tm-dash-card-title">@Loc["Chart_WeeklyRevenue"]</h3>
                        <p class="tm-dash-card-subtitle">@Loc["Chart_WeeklyRevenue_Sub"]</p>
                    </div>
                    <div style="display:flex; align-items:center; gap:0.5rem;">
                        <div style="display:flex; align-items:center; gap:0.375rem; font-size:0.6875rem; color:var(--tm-gray, var(--rz-text-secondary-color, #94A3A0));">
                            <span style="width:10px; height:10px; border-radius:2px; background:#2A9D7E;"></span>
                            @Loc["Chart_WeeklyLegend_This"]
                        </div>
                        <div style="display:flex; align-items:center; gap:0.375rem; font-size:0.6875rem; color:var(--tm-gray, var(--rz-text-secondary-color, #94A3A0));">
                            <span style="width:10px; height:10px; border-radius:2px; background:rgba(212, 175, 55, 0.6);"></span>
                            @Loc["Chart_WeeklyLegend_Last"]
                        </div>
                    </div>
                </div>
                <div class="tm-dash-chart-canvas-wrap tall">
                    <canvas id="tm-dash-revenue-chart"></canvas>
                </div>
                <div class="tm-dash-chart-footer">
                    <div>
                        <p class="tm-dash-chart-footer-label">@Loc["Chart_WeeklyAvg"]</p>
                        <p class="tm-dash-chart-footer-value">@FormatMoneyShort(WeeklyAverage) @_stats.DisplayCurrency</p>
                    </div>
                    <div>
                        <p class="tm-dash-chart-footer-label">@Loc["Chart_WeeklyMax"]</p>
                        <p class="tm-dash-chart-footer-value gold">@FormatMoneyShort(WeeklyMax) @_stats.DisplayCurrency</p>
                    </div>
                    <div>
                        <p class="tm-dash-chart-footer-label">@Loc["Chart_WeeklyGrowth"]</p>
                        <p class="tm-dash-chart-footer-value green">@FormatPercent(WeeklyGrowthPct, 1)</p>
                    </div>
                </div>
            </div>

            @* Status Donut *@
            <div class="tm-dash-card">
                <div class="tm-dash-card-head">
                    <div>
                        <h3 class="tm-dash-card-title">@Loc["Chart_StatusDonut"]</h3>
                        <p class="tm-dash-card-subtitle">@Loc["Chart_StatusDonut_Sub"]</p>
                    </div>
                </div>
                <div class="tm-dash-chart-canvas-wrap short">
                    <canvas id="tm-dash-status-donut"></canvas>
                    <div class="tm-dash-donut-center">
                        <p class="tm-dash-donut-center-value">@FormatDigits(TotalOrdersCount)</p>
                        <p class="tm-dash-donut-center-label">@Loc["Chart_StatusDonut_Total"]</p>
                    </div>
                </div>
                <div class="tm-dash-chart-legend">
                    @foreach (var status in _stats.StatusBreakdown)
                    {
                        <div class="tm-dash-chart-legend-row">
                            <span class="tm-dash-chart-legend-name">
                                <span class="tm-dash-status-dot" style="background:@(StatusColor(status.Status));"></span>
                                @StatusLocalizedName(status.Status)
                            </span>
                            <span class="tm-dash-chart-legend-value">
                                @FormatDigits(status.Count) (@FormatPercent(StatusPercent(status.Count), 0))
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ════════════════════════════════════════
           CHARTS ROW 2 — Top Products Bar (2/3) + Category Pie (1/3)
           ════════════════════════════════════════ *@
        <div class="tm-dash-chart-row tm-dash-chart-row-2-1">

            @* Top Products (Bar) *@
            <div class="tm-dash-card">
                <div class="tm-dash-card-head">
                    <div>
                        <h3 class="tm-dash-card-title">@Loc["Chart_TopProducts"]</h3>
                        <p class="tm-dash-card-subtitle">@Loc["Chart_TopProducts_Sub"]</p>
                    </div>
                    <a href="/Admin/Products" class="tm-dash-card-subtitle" style="color:var(--tm-gold, #D4AF37); text-decoration:none;">
                        @Loc["Chart_ViewAll"]
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" style="width:12px;height:12px;display:inline-block;vertical-align:middle;">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                        </svg>
                    </a>
                </div>
                <div class="tm-dash-chart-canvas-wrap tall" style="height:288px;">
                    <canvas id="tm-dash-top-products-chart"></canvas>
                </div>
            </div>

            @* Category Pie *@
            <div class="tm-dash-card">
                <div class="tm-dash-card-head">
                    <div>
                        <h3 class="tm-dash-card-title">@Loc["Chart_CategoryPie"]</h3>
                        <p class="tm-dash-card-subtitle">@Loc["Chart_CategoryPie_Sub"]</p>
                    </div>
                </div>
                <div class="tm-dash-chart-canvas-wrap short">
                    <canvas id="tm-dash-category-pie"></canvas>
                </div>
                <div class="tm-dash-chart-legend">
                    @for (var i = 0; i < _stats.TopCategories.Count; i++)
                    {
                        var cat = _stats.TopCategories[i];
                        var color = CategoryColor(i);
                        <div class="tm-dash-chart-legend-row">
                            <span class="tm-dash-chart-legend-name">
                                <span class="tm-dash-status-dot" style="background:@color;"></span>
                                @cat.CategoryName
                            </span>
                            <span class="tm-dash-chart-legend-value">
                                @FormatPercent(CategoryPercent(cat.SalesCount), 0)
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ════════════════════════════════════════
           BOTTOM ROW — Recent Orders (2/3) + Top Employees (1/3)
           ════════════════════════════════════════ *@
        <div class="tm-dash-chart-row tm-dash-chart-row-2-1">

            @* Recent Orders table *@
            <div class="tm-dash-card" style="padding:0; overflow:hidden;">
                <div style="padding:1.25rem; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid var(--tm-border, rgba(255,255,255,0.05));">
                    <div>
                        <h3 class="tm-dash-card-title">@Loc["Orders_Recent"]</h3>
                        <p class="tm-dash-card-subtitle">@Loc["Orders_Recent_Sub"]</p>
                    </div>
                    <a href="/Sales" class="tm-dash-card-subtitle" style="color:var(--tm-gold, #D4AF37); text-decoration:none;">
                        @Loc["Chart_ViewAll"]
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" style="width:12px;height:12px;display:inline-block;vertical-align:middle;">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                        </svg>
                    </a>
                </div>
                <div class="tm-dash-table-wrap">
                    @if (_stats.RecentOrders.Count == 0)
                    {
                        <div class="tm-dash-empty" style="padding:2rem;">@Loc["Orders_Empty"]</div>
                    }
                    else
                    {
                        <table class="tm-dash-table">
                            <thead>
                                <tr>
                                    <th>@Loc["Orders_Col_Number"]</th>
                                    <th>@Loc["Orders_Col_Customer"]</th>
                                    <th>@Loc["Orders_Col_Product"]</th>
                                    <th>@Loc["Orders_Col_Amount"]</th>
                                    <th>@Loc["Orders_Col_Time"]</th>
                                    <th>@Loc["Orders_Col_Status"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in _stats.RecentOrders)
                                {
                                    <tr>
                                        <td class="tm-dash-sale-number">#@order.SaleNumber</td>
                                        <td>
                                            <div class="tm-dash-customer-cell">
                                                <div class="tm-dash-avatar-sm"
                                                     style="background:@(AvatarBackground(order.CustomerName));
                                                    color:@(AvatarTextColor(order.CustomerName));">
                                                    @GetInitial(order.CustomerName)
                                                </div>
                                                <span class="tm-dash-customer-name">@order.CustomerName</span>
                                            </div>
                                        </td>
                                        <td class="tm-dash-product-cell">@order.ProductSummary</td>
                                        <td class="tm-dash-amount-cell">
                                            @FormatMoney(order.TotalAmount)
                                        </td>
                                        <td class="tm-dash-time-cell">@FormatRelativeTime(order.SubmittedAtUtc)</td>
                                        <td>
                                            <span class="tm-dash-status-badge @StatusBadgeClass(order.Status)">
                                                <span class="tm-dash-status-dot" style="background:@StatusColor(order.Status);"></span>
                                                @StatusLocalizedName(order.Status)
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>

            @* Top Employees card *@
            <div class="tm-dash-card">
                <div class="tm-dash-card-head" style="margin-bottom:1rem;">
                    <div>
                        <h3 class="tm-dash-card-title" style="font-size:0.875rem;">@Loc["TopEmployees_Title"]</h3>
                        <p class="tm-dash-card-subtitle">@Loc["TopEmployees_Sub"]</p>
                    </div>
                </div>
                @if (_stats.TopEmployees.Count == 0)
                {
                    <div class="tm-dash-empty">@Loc["TopEmployees_Empty"]</div>
                }
                else
                {
                    <div style="display:flex; flex-direction:column; gap:0.75rem;">
                        @foreach (var emp in _stats.TopEmployees)
                        {
                            <div class="tm-dash-employee-row">
                                <div class="tm-dash-employee-avatar-wrap">
                                    <div class="tm-dash-employee-avatar rank-@emp.Rank">
                                        @GetInitial(emp.FullName)
                                    </div>
                                    <span class="tm-dash-employee-rank-badge rank-@emp.Rank">@FormatDigits(emp.Rank)</span>
                                </div>
                                <div class="tm-dash-employee-info">
                                    <p class="tm-dash-employee-name">@emp.FullName</p>
                                    <p class="tm-dash-employee-group">@(string.IsNullOrEmpty(emp.GroupName) ? "—" : emp.GroupName)</p>
                                </div>
                                <div class="tm-dash-employee-amount">
                                    <p class="tm-dash-employee-amount-value rank-@emp.Rank">@FormatMoneyShort(emp.TotalAmount)</p>
                                    <p class="tm-dash-employee-amount-label">@_stats.DisplayCurrency</p>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* ════════════════════════════════════════
           QUICK ACCESS ROW — Settings + Users only
           (مدیریت مالی and گزارش فروش REMOVED per user spec)
           ════════════════════════════════════════ *@
        <div class="tm-dash-quick-grid">
            <a href="/Settings" class="tm-dash-quick-card">
                <div class="tm-dash-icon-tile tm-dash-icon-warn">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                </div>
                <div>
                    <p class="tm-dash-quick-title">@Loc["Quick_Settings"]</p>
                    <p class="tm-dash-quick-desc">@Loc["Quick_Settings_Desc"]</p>
                </div>
            </a>

            <a href="/Admin/Users" class="tm-dash-quick-card">
                <div class="tm-dash-icon-tile tm-dash-icon-info">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                </div>
                <div>
                    <p class="tm-dash-quick-title">@Loc["Quick_Users"]</p>
                    <p class="tm-dash-quick-desc">@Loc["Quick_Users_Desc"]</p>
                </div>
            </a>
        </div>

    </div>
}

@code {
    private DashboardStatsDto? _stats;
    private bool _isLoading = true;
    private string _loadError = string.Empty;

    // ── Tehran timezone ─────────────────────────────────────────────────
    //
    // Tehran abolished DST in 2022, so a fixed UTC+03:30 offset is
    // functionally equivalent to the IANA "Asia/Tehran" zone for all
    // dates from 2022 onward. The FormatRelativeTime fallback below
    // does the offset arithmetic inline instead of using a static
    // TimeZoneInfo field — the field was coming back null on some
    // Windows deployments, and Blazor hot-reload doesn't refresh
    // static field initializers. Inline arithmetic is bulletproof.

    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;

            // Build the role list from the AuthenticationState — ICurrentUserService
            // exposes IsInRole(string) but not the full role list, so we read it
            // from the ClaimsPrincipal directly. The handler uses this list to
            // decide between the AllSales spec (Admin/Manager/ReadOnly) and the
            // SaleByApprover spec (Employee).
            var authState = await AuthStateTask;
            var user = authState.User;

            if (user.Identity?.IsAuthenticated != true)
            {
                // Defense-in-depth — [Authorize] should have caught this.
                Navigation.NavigateTo("/Account/Login", forceLoad: true);
                return;
            }

            var roles = new List<string>();
            if (user.IsInRole(Roles.Admin)) roles.Add(Roles.Admin);
            if (user.IsInRole(Roles.Manager)) roles.Add(Roles.Manager);
            if (user.IsInRole(Roles.Employee)) roles.Add(Roles.Employee);
            if (user.IsInRole(Roles.ReadOnly)) roles.Add(Roles.ReadOnly);
            if (user.IsInRole(Roles.Customer)) roles.Add(Roles.Customer);

            var query = new GetDashboardStatsQuery
            {
                RequestedByUserId = CurrentUser.UserId,
                UserRoles = roles
            };

            var result = await MessageBus.InvokeAsync<Result<DashboardStatsDto>>(query);

            if (result.IsSuccess)
            {
                _stats = result.Value;
            }
            else
            {
                _loadError = result.Error;
                if (string.IsNullOrEmpty(_loadError))
                {
                    _loadError = Loc["Error_FailedToLoad"];
                }
            }
        }
        catch (Exception)
        {
            _loadError = Loc["Error_Unexpected"];
        }
        finally
        {
            _isLoading = false;
        }
    }

    // Tracks whether we've already handed the dashboard data to dashboard.js
    // for chart rendering. We can't use `firstRender` from OnAfterRenderAsync
    // for this, because _stats is always null on the first render (the async
    // DB query in OnInitializedAsync hasn't completed yet — the first render
    // shows the loading spinner). By the time _stats is populated and the
    // page re-renders with real data, firstRender is already false, so a
    // `!firstRender` guard would skip the render call forever — leaving the
    // chart areas permanently blank. This flag fires the JS interop call
    // exactly once, on the first render where _stats is actually available.
    private bool _chartsInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Wait until the stats have loaded AND we haven't already handed them
        // to the chart initializer. The _chartsInitialized guard ensures we
        // only call takDashboard.render once per full page load.
        if (_stats is null || _chartsInitialized) return;
        _chartsInitialized = true;

        // Pass the dashboard data + localized labels to dashboard.js so it
        // can initialize all 4 charts. We pass a plain anonymous object —
        // System.Text.Json serializes it as JSON for the JS side.
        var chartData = new
        {
            isToman = _stats.IsToman,
            displayCurrency = _stats.DisplayCurrency,

            thisWeekRevenue = _stats.ThisWeekRevenue,
            lastWeekRevenue = _stats.LastWeekRevenue,
            statusBreakdown = _stats.StatusBreakdown,
            topProducts = _stats.TopProducts,
            topCategories = _stats.TopCategories,

            // Localized labels for chart legends + tooltips.
            //
            // CRITICAL: use `.Value` on every Loc[...] call. IStringLocalizer
            // returns LocalizedString structs, which have an implicit
            // conversion to string in C# — BUT System.Text.Json does NOT
            // honor implicit conversions during JS-interop serialization.
            // Without `.Value`, each label is serialized as a JSON OBJECT
            // { name, value, resourceNotFound, searchedLocation } instead of
            // a plain string. dashboard.js then concatenates that object
            // with strings inside tooltip callbacks, producing the literal
            // text "[object Object]" in every tooltip that uses a label
            // (donut/line/bar). The pie chart tooltip was the only one that
            // didn't consume any label field, which is why it was the only
            // correct tooltip.
            labelThisWeek = Loc["Chart_WeeklyLegend_This"].Value,
            labelLastWeek = Loc["Chart_WeeklyLegend_Last"].Value,
            labelApproved = Loc["Status_Approved"].Value,
            labelShipped = Loc["Status_Shipped"].Value,
            labelPending = Loc["Status_Pending"].Value,
            labelCancelled = Loc["Status_Cancelled"].Value,
            labelDraft = Loc["Status_Draft"].Value,
            labelOrdersUnit = Loc["Status_OrdersUnit"].Value,
            labelSalesCount = Loc["Chart_TopProducts"].Value,

            // Empty-state label — shown on any chart whose data array is
            // empty (e.g. a fresh install with no sales yet). Without this,
            // dashboard.js falls back to a hard-coded Persian string.
            labelNoData = Loc["Chart_NoData"].Value
        };

        try
        {
            await JS.InvokeVoidAsync("takDashboard.render", chartData);
        }
        catch (Exception ex)
        {
            // Non-fatal — charts just don't render, but the rest of the
            // dashboard still works. Log to the browser console so JS-side
            // failures (missing script, ReferenceError in dashboard.js,
            // canvas not in DOM, etc.) are visible in DevTools instead of
            // silently swallowed. Previously this was an empty catch, which
            // made a one-line bug in dashboard.js (referencing an undefined
            // `toFa` identifier inside the IIFE's public-API object) invisible
            // for an entire session — the dashboard just showed blank charts
            // with no clue why.
            try
            {
                await JS.InvokeVoidAsync("console.error",
                    "[Dashboard] takDashboard.render failed:", ex.Message);
            }
            catch
            {
                // Console itself unavailable — nothing more we can do.
            }
        }
    }

    // ── Helpers for formatting + display ────────────────────────────────

    /// <summary>
    /// Time-of-day greeting label for the dashboard header.
    ///
    /// Picks one of 4 greeting keys based on the SERVER's local hour:
    ///   00:00–04:59 → Greeting_LateNight  ("شب بخیر" / "Good night")
    ///   05:00–11:59 → Greeting_Morning    ("صبح بخیر" / "Good morning")
    ///   12:00–16:59 → Greeting_Afternoon  ("ظهر بخیر" / "Good afternoon")
    ///   17:00–23:59 → Greeting_Evening    ("عصر بخیر" / "Good evening")
    ///
    /// The greeting is prefixed with the user's title ("آقای"/"خانم" in
    /// fa-IR, "Mr."/"Ms." in en-US) based on the Gender claim. Falls back
    /// to a gender-neutral greeting when the gender is missing.
    ///
    /// WHY SERVER TIME: the dashboard is rendered server-side (Blazor SSR),
    /// so DateTime.Now here is the server's local time. For Tak Makaron
    /// (Iran-based, single office), this is fine — all users share the
    /// same office hours. If we ever go multi-timezone, this should switch
    /// to the user's timezone (read from their profile / browser).
    /// </summary>
    private string GreetingLabel
    {
        get
        {
            var hour = DateTime.Now.Hour;
            var isFa = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";

            // Pick the time-of-day key.
            // Persian convention used here:
            //   00:00–04:59  → شب بخیر     (LateNight — small hours)
            //   05:00–11:59  → صبح بخیر    (Morning)
            //   12:00–16:59  → ظهر بخیر    (Afternoon)
            //   17:00–19:59  → عصر بخیر    (Evening — early evening)
            //   20:00–23:59  → شب بخیر     (LateNight — night)
            // The 20:00 cutoff is important: Persian "شب" starts around 8 PM,
            // so 10 PM must be "شب بخیر", not "عصر بخیر".
            var timeKey = hour switch
            {
                < 5 => "Greeting_LateNight",
                < 12 => "Greeting_Morning",
                < 17 => "Greeting_Afternoon",
                < 20 => "Greeting_Evening",
                _ => "Greeting_LateNight"
            };

            // Pick the title key based on gender.
            // Gender claim values are "Male" / "Female" (the enum names
            // written by Login.razor). Null/unknown → neutral (no title).
            var gender = _stats?.UserGender;
            var titleKey = gender switch
            {
                "Male" => isFa ? "Title_Male" : "Title_Male_En",
                "Female" => isFa ? "Title_Female" : "Title_Female_En",
                _ => null
            };

            // Combine: "<TimeGreeting> <Title>" e.g. "صبح بخیر آقای" or
            // "Good morning, Mr." (note the en-US key already includes the
            // trailing period+space so the name follows naturally).
            if (titleKey is null)
            {
                return Loc[timeKey] + " ";
            }
            return Loc[timeKey] + " " + Loc[titleKey] + " ";
        }
    }

    /// <summary>
    /// Formats the "oldest pending sale" age (in minutes) as a localized
    /// relative-time string for the KPI card 3 footer.
    ///
    /// Examples (fa-IR): "۵ دقیقه", "۳ ساعت", "۲ روز".
    /// Examples (en-US): "5 minutes", "3 hours", "2 days".
    ///
    /// Uses the same buckets as FormatRelativeTime (minutes / hours / days),
    /// but WITHOUT the "ago" suffix — the footer already has a prefix like
    /// "قدیمی‌ترین:" / "Oldest:" before this value.
    /// </summary>
    private string FormatOldestPending(int ageMinutes)
    {
        if (ageMinutes < 60)
        {
            return FormatDigits(ageMinutes) + " " + Loc["MinutesUnit"];
        }
        var hours = ageMinutes / 60;
        if (hours < 24)
        {
            return FormatDigits(hours) + " " + Loc["HoursUnit"];
        }
        var days = hours / 24;
        return FormatDigits(days) + " " + Loc["DaysUnit"];
    }

    /// <summary>
    /// Formats a date using the current UI culture's full date format.
    /// In fa-IR mode this produces a Jalali (Persian) calendar date with
    /// Persian digits (e.g. "جمعه, ۱۴۰۵/۰۵/۱۶"); in en-US mode it produces
    /// a Gregorian date with ASCII digits (e.g. "Friday, 2026/08/07").
    /// </summary>
    /// <remarks>
    /// WHY WE EXPLICITLY USE PersianCalendar:
    /// .NET's fa-IR culture's default DateTimeFormat.Calendar is the
    /// Gregorian calendar (a long-standing quirk), so
    /// <c>date.ToString("yyyy/MM/dd", fa-IR)</c> returns the Gregorian year
    /// (e.g. "2026") — not the Jalali year ("۱۴۰۵"). Even when the digits
    /// render as Persian, the year is wrong. We therefore pull the Jalali
    /// components from <see cref="PersianCalendar"/> explicitly, then format
    /// each component with the current culture so the NativeDigits
    /// (۰-۹ for fa-IR, 0-9 for en-US) kick in automatically.
    /// </remarks>
    private string FormatDate(DateTime date)
    {
        var isFa = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
        if (!isFa)
        {
            return date.ToString("dddd, yyyy/MM/dd", CultureInfo.CurrentCulture);
        }

        // fa-IR: build the Jalali date string piece by piece so both the
        // calendar AND the digits are correct.
        var pc = new PersianCalendar();
        var dayName = date.ToString("dddd", CultureInfo.CurrentCulture);
        var year = pc.GetYear(date).ToString("0000", CultureInfo.CurrentCulture);
        var month = pc.GetMonth(date).ToString("00", CultureInfo.CurrentCulture);
        var day = pc.GetDayOfMonth(date).ToString("00", CultureInfo.CurrentCulture);
        return $"{dayName}, {year}/{month}/{day}";
    }

    /// <summary>
    /// Formats an amount with thousands separators using the current UI
    /// culture's number format. In fa-IR mode this produces Persian digits
    /// + Persian thousands separator (e.g. "۱۴٬۰۰۰"); in en-US mode it
    /// produces ASCII digits + comma separator (e.g. "14,000"). Used in the
    /// recent-orders table.
    /// </summary>
    private string FormatMoney(decimal amount)
    {
        var rounded = Math.Round(amount, 0);
        return rounded.ToString("N0", CultureInfo.CurrentCulture);
    }

    /// <summary>
    /// Formats an amount in millions (e.g. "۲٫۴M" in fa-IR, "2.4M" in en-US)
    /// for KPI cards and chart footer summaries where large numbers need to
    /// fit in a small space.
    /// </summary>
    private string FormatMoneyShort(decimal amount)
    {
        if (amount >= 1_000_000m)
        {
            var millions = (amount / 1_000_000m).ToString("0.0", CultureInfo.CurrentCulture);
            return millions + "M";
        }
        if (amount >= 1_000m)
        {
            var thousands = (amount / 1_000m).ToString("0.0", CultureInfo.CurrentCulture);
            return thousands + "K";
        }
        return Math.Round(amount, 0).ToString("N0", CultureInfo.CurrentCulture);
    }

    /// <summary>
    /// Formats a numeric string using the current UI culture's native
    /// digits. In fa-IR mode this produces Persian digits (۰-۹); in en-US
    /// mode it leaves ASCII digits unchanged (0-9). Leaves non-digit
    /// characters untouched.
    ///
    /// WHY: the user asked that ALL numbers in the dashboard follow the
    /// language rule — Persian digits in Persian mode, English digits in
    /// English mode. The previous version was hard-coded to always convert
    /// to Persian digits, which broke the English mode.
    ///
    /// HOW: .NET 10's fa-IR culture has NumberFormat.NativeDigits = ۰..۹.
    /// int.ToString("0", CultureInfo.CurrentCulture) uses those native
    /// digits. For string inputs (e.g. "0.0"), we parse and re-format so
    /// the native digits + culture decimal separator are applied.
    /// </summary>
    private string FormatDigits(string? value)
    {
        if (string.IsNullOrEmpty(value)) return string.Empty;

        // Try to format as a number — this gives us native digits + the
        // culture's decimal separator for free.
        if (decimal.TryParse(value, NumberStyles.Any, CultureInfo.InvariantCulture, out var n))
        {
            // Preserve the original precision (e.g. "0.0" stays one decimal).
            var decimals = value.Contains('.') ? value.Length - value.IndexOf('.') - 1 : 0;
            var fmt = decimals > 0 ? "0." + new string('0', decimals) : "0";
            return n.ToString(fmt, CultureInfo.CurrentCulture);
        }

        // Fallback: leave as-is (shouldn't happen for the inputs we pass).
        return value;
    }

    /// <summary>
    /// Formats an integer using the current UI culture's native digits.
    /// </summary>
    private string FormatDigits(int value) =>
        value.ToString("0", CultureInfo.CurrentCulture);

    /// <summary>
    /// Formats a percentage value (already calculated) using the current UI
    /// culture's digits + decimal separator. Appends the localized percent
    /// symbol (٪ in fa-IR, % in en-US) so the symbol also follows the culture.
    /// </summary>
    private string FormatPercent(decimal pct, int decimals = 1)
    {
        var fmt = decimals > 0 ? "0." + new string('0', decimals) : "0";
        var s = pct.ToString(fmt, CultureInfo.CurrentCulture);
        // In fa-IR, ٪ (U+066A ARABIC PERCENT SIGN) is the conventional
        // percent symbol. In en-US, % is standard.
        var isFa = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
        return s + (isFa ? "٪" : "%");
    }

    // ── Weekly revenue stats (for the line chart footer) ────────────────

    private decimal WeeklyAverage =>
        _stats?.ThisWeekRevenue.Count > 0
            ? _stats.ThisWeekRevenue.Average(d => d.TotalAmount)
            : 0m;

    private decimal WeeklyMax =>
        _stats?.ThisWeekRevenue.Count > 0
            ? _stats.ThisWeekRevenue.Max(d => d.TotalAmount)
            : 0m;

    private decimal WeeklyGrowthPct
    {
        get
        {
            if (_stats is null) return 0m;
            var thisTotal = _stats.ThisWeekRevenue.Sum(d => d.TotalAmount);
            var lastTotal = _stats.LastWeekRevenue.Sum(d => d.TotalAmount);
            if (lastTotal == 0) return 0m;
            return ((thisTotal - lastTotal) / lastTotal) * 100m;
        }
    }

    // ── Donut chart helpers ──────────────────────────────────────────────

    private int TotalOrdersCount => _stats?.StatusBreakdown.Sum(s => s.Count) ?? 0;

    private int StatusPercent(int count)
    {
        var total = TotalOrdersCount;
        return total > 0 ? (int)Math.Round(count * 100.0 / total) : 0;
    }

