    /// <summary>
    /// Sets the product's stock to the value entered in _editStock.
    /// Dispatches SetProductStockCommand, which calls Product.AdjustStockTo
    /// — the domain enforces quantity > 0 (zero and negatives are rejected
    /// with a clear message pointing the user to the Deactivate flow).
    ///
    /// VALIDATION ORDER:
    ///   1. Client-side: if _editStock is null or ≤ 0, show inline error
    ///      and don't dispatch. Same UX pattern as the Restock dialog.
    ///   2. Server-side: SetProductStockCommandValidator rejects ≤ 0.
    ///   3. Domain-side: Product.AdjustStockTo throws DomainException if
    ///      ≤ 0 (defense-in-depth).
    /// </summary>
    private async Task HandleSetStockAsync()
    {
        if (_product is null) return;

        if (_editStock is null || _editStock <= 0)
        {
            _showStockError = true;
            return;
        }
        _showStockError = false;

        _isSavingStock = true;
        try
        {
            var command = new SetProductStockCommand(_product.Id, _editStock.Value);
            var result = await MessageBus.InvokeAsync<Result>(command);

            if (result.IsSuccess)
            {
                // Reflect the new stock locally so the "Current stock" display
                // updates without a full reload. ProductDto is a class (not a
                // record), so we create a new instance copying the existing
                // fields and overwriting StockQuantity.
                _product = new ProductDto
                {
                    Id = _product.Id,
                    Name = _product.Name,
                    Description = _product.Description,
                    PictureUrl = _product.PictureUrl,
                    Price = _product.Price,
                    StockQuantity = _editStock.Value,
                    CategoryId = _product.CategoryId,
                    SubCategoryId = _product.SubCategoryId,
                    SubSubCategoryId = _product.SubSubCategoryId,
                    PurchaseLimits = _product.PurchaseLimits
                };
                await Toast.Success(
                    string.Format(CultureInfo.CurrentCulture, Loc["StockSetSuccess"], _product.Name, CultureFormat.FormatNumber(_editStock.Value)),
                    summary: Loc["StockSetSuccessTitle"]);
            }
            else
            {
                await Toast.Error(
                    ErrorDisplay.Localize(result.Error) ?? Loc["Error_GenericSave"],
                    summary: Loc["ErrorTitle"]);
            }
        }
        catch
        {
            await Toast.UnexpectedError(UnexpectedErrorCodes.ProductDetail_SaveBasicFailure, summary: Loc["ErrorTitle"]);
        }
        finally
        {
            _isSavingStock = false;
        }
    }

