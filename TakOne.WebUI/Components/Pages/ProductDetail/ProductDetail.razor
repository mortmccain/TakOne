    // ── Price textbox helpers ────────────────────────────────────────────

    /// <summary>
    /// Formats a decimal price amount for DISPLAY in the price textbox.
    /// Mirrors EditGroup.razor's FormatSalaryForDisplay: N0 for IRR
    /// (0 decimals, whole Rial), N2 for other currencies (2 decimals).
    /// Then runs through CultureFormat.ToCultureDigits so digits become
    /// Persian (۰-۹) and separator becomes ٬ in fa-IR mode.
    /// </summary>
    private static string FormatPriceForDisplay(decimal amount, string currency)
    {
        var isIrr = string.Equals(currency, "IRR", StringComparison.OrdinalIgnoreCase);
        var fmt = isIrr ? "N0" : "N2";
        return CultureFormat.ToCultureDigits(
            amount.ToString(fmt, CultureInfo.InvariantCulture));
    }

    /// <summary>
    /// Parses a string the user typed into the price textbox into a decimal.
    /// Accepts ASCII digits, Persian digits, comma/٬ thousands separators,
    /// and ./٫ decimal separators. Same logic as EditGroup.TryParseAmount.
    /// </summary>
    private static bool TryParseAmount(string? input, out decimal amount)
    {
        amount = 0m;
        if (string.IsNullOrWhiteSpace(input)) return false;

        var sb = new System.Text.StringBuilder(input.Length);
        foreach (var c in input.Trim())
        {
            if (c == ',' || c == '٬') continue;
            if (c == '٫') sb.Append('.');
            else if (c >= '۰' && c <= '۹')
                sb.Append((char)('0' + (c - '۰')));
            else sb.Append(c);
        }

        return decimal.TryParse(sb.ToString(),
            NumberStyles.Number, CultureInfo.InvariantCulture, out amount);
    }

    /// <summary>
    /// Fired when the price textbox gains focus. Switches the displayed
    /// text to the raw invariant number for easy editing.
    /// </summary>
    private void OnEditPriceFocus()
    {
        if (TryParseAmount(_editPriceText, out var amount))
        {
            _editPriceText = amount.ToString(CultureInfo.InvariantCulture);
        }
    }

    /// <summary>
    /// Fired when the price textbox loses focus. Parses the text,
    /// re-formats it for display.
    /// </summary>
    private void OnEditPriceBlur()
    {
        if (_product is not null && TryParseAmount(_editPriceText, out var amount))
        {
            _editPriceText = FormatPriceForDisplay(amount, _product.Price.Currency);
        }
    }

