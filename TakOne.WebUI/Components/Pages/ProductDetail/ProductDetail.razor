    /// <summary>
    /// Removes a single limit row. Dispatches RemoveProductPurchaseLimitCommand
    /// (which is idempotent — succeeds even if no limit exists for the group).
    /// On success, clears the limit value + sets HasExistingLimit=false so the
    /// Remove button greys out (but the row stays so the user can re-set the
    /// limit if they change their mind).
    ///
    /// SALARY FEATURE (Step 8): the command takes GroupId (Guid) instead of
    /// GroupName (string).
    /// </summary>
    private async Task HandleRemoveLimitAsync(LimitRow row)
    {
        if (_product is null || row.GroupId == Guid.Empty)
        {
            return;
        }

        row.IsSaving = true;
        try
        {
            var command = new RemoveProductPurchaseLimitCommand(
                ProductId: _product.Id,
                GroupId: row.GroupId);

            var result = await MessageBus.InvokeAsync<Result>(command);

            if (result.IsSuccess)
            {
                row.Limit = null;
                row.HasExistingLimit = false;
                await Toast.Success(
                    string.Format(CultureInfo.CurrentCulture, Loc["LimitRemoved"], row.GroupName),
                    summary: Loc["LimitRemovedTitle"]);
            }
            else
            {
                await Toast.Error(ErrorDisplay.Localize(result.Error) ?? Loc["Error_GenericSave"], summary: Loc["ErrorTitle"]);
            }
        }
        catch
        {
            await Toast.UnexpectedError(UnexpectedErrorCodes.ProductDetail_SaveStatusFailure, summary: Loc["ErrorTitle"]);
        }
        finally
        {
            row.IsSaving = false;
        }
    }

    // ── Display helpers ────────────────────────────────────────────────

    /// <summary>
    /// Formats a MoneyDto for display. IRR is converted to Toman (amount ÷ 10)
    /// and labelled "تومان" — matches the Products grid convention so a
    /// customer sees the same unit on the listing and the detail page.
    /// Other currencies pass through unchanged.
    /// Delegates to <see cref="CultureFormat.FormatMoneyToman"/> for
    /// culture-native digits (Persian digits in fa-IR mode, ASCII in en-US).
    /// </summary>
    private static string FormatPrice(MoneyDto price)
        => CultureFormat.FormatMoneyToman(price);
}