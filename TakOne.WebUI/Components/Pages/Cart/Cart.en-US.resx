<?xml version="1.0" encoding="utf-8"?>
<!-- Cart.en-US.resx — English strings for Cart.razor.

     The four <resheader> tags below are REQUIRED by the .resx reader —
     without them, the loader rejects the file with "resx input is not valid,
     couldn't find valid resheader tags". -->
<root>
  <xsd:schema id="root" xmlns="" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
    <xsd:import namespace="http://www.w3.org/XML/1998/namespace" />
    <xsd:element name="root" msdata:IsDataSet="true">
      <xsd:complexType>
        <xsd:choice maxOccurs="unbounded">
          <xsd:element name="resheader">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="resmimetype">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="assembly">
            <xsd:complexType>
              <xsd:attribute name="alias" type="xsd:string" />
              <xsd:attribute name="name" type="xsd:string" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="data">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
                <xsd:element name="comment" type="xsd:string" minOccurs="0" msdata:Ordinal="2" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" msdata:Ordinal="1" />
              <xsd:attribute name="type" type="xsd:string" msdata:Ordinal="3" />
              <xsd:attribute name="mimetype" type="xsd:string" msdata:Ordinal="4" />
              <xsd:attribute ref="xml:space" />
            </xsd:complexType>
          </xsd:element>
        </xsd:choice>
      </xsd:complexType>
    </xsd:element>
  </xsd:schema>

  <resheader name="resmimetype">
    <value>text/microsoft-resx</value>
  </resheader>
  <resheader name="version">
    <value>2.0</value>
  </resheader>
  <resheader name="reader">
    <value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>
  <resheader name="writer">
    <value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value>
  </resheader>

  <!-- Page chrome -->
  <data name="PageTitle" xml:space="preserve">
    <value>Cart — TakOne</value>
  </data>
  <data name="PageHeading" xml:space="preserve">
    <value>Shopping cart</value>
  </data>
  <data name="ItemCount" xml:space="preserve">
    <value>{0} items</value>
  </data>
  <data name="ItemCountSingular" xml:space="preserve">
    <value>{0} item</value>
  </data>

  <!-- States -->
  <data name="Loading" xml:space="preserve">
    <value>Loading your cart…</value>
  </data>
  <data name="ErrorTitle" xml:space="preserve">
    <value>Something went wrong</value>
  </data>
  <data name="RetryButton" xml:space="preserve">
    <value>Try again</value>
  </data>
  <data name="Error_GenericLoad" xml:space="preserve">
    <value>We couldn't load your cart. Please try again.</value>
  </data>
  <data name="Error_GenericUpdate" xml:space="preserve">
    <value>We couldn't update this item. Please try again.</value>
  </data>
  <data name="Error_GenericRemove" xml:space="preserve">
    <value>We couldn't remove this item. Please try again.</value>
  </data>
  <data name="Error_GenericClear" xml:space="preserve">
    <value>We couldn't clear your cart. Please try again.</value>
  </data>
  <data name="Error_GenericSubmit" xml:space="preserve">
    <value>We couldn't submit your cart. Please try again.</value>
  </data>

  <!-- Empty state -->
  <data name="EmptyTitle" xml:space="preserve">
    <value>Your cart is empty</value>
  </data>
  <data name="EmptyMessage" xml:space="preserve">
    <value>Browse the catalog and add items to your cart to get started.</value>
  </data>
  <data name="BrowseProductsButton" xml:space="preserve">
    <value>Browse products</value>
  </data>

  <!-- Line item -->
  <data name="UnitPriceLabel" xml:space="preserve">
    <value>{0} each</value>
  </data>
  <data name="UpdateButton" xml:space="preserve">
    <value>Update</value>
  </data>
  <data name="RemoveButton" xml:space="preserve">
    <value>Remove</value>
  </data>

  <!-- Stock badges -->
  <data name="StockIn" xml:space="preserve">
    <value>In stock ({0})</value>
  </data>
  <data name="StockLow" xml:space="preserve">
    <value>Only {0} in stock — reduce the quantity</value>
  </data>
  <data name="StockOut" xml:space="preserve">
    <value>Out of stock — remove this item</value>
  </data>
  <data name="StockIssueWarning" xml:space="preserve">
    <value>One or more items have stock issues. Please fix them before submitting.</value>
  </data>

  <!-- Summary panel -->
  <data name="SummaryTitle" xml:space="preserve">
    <value>Order summary</value>
  </data>
  <data name="TotalItems" xml:space="preserve">
    <value>Total units</value>
  </data>
  <data name="LineItemsCount" xml:space="preserve">
    <value>Different products</value>
  </data>
  <data name="TotalAmount" xml:space="preserve">
    <value>Total</value>
  </data>

  <!-- Action buttons -->
  <data name="ContinueShoppingButton" xml:space="preserve">
    <value>Continue shopping</value>
  </data>
  <data name="SubmitCartButton" xml:space="preserve">
    <value>Submit cart</value>
  </data>
  <data name="ClearCartButton" xml:space="preserve">
    <value>Clear cart</value>
  </data>

  <!-- Clear confirmation -->
  <data name="ConfirmClearMessage" xml:space="preserve">
    <value>Remove all items from your cart? This can't be undone.</value>
  </data>
  <data name="ConfirmClearYes" xml:space="preserve">
    <value>Yes, clear cart</value>
  </data>
  <data name="ConfirmClearNo" xml:space="preserve">
    <value>Cancel</value>
  </data>

  <!-- Toasts -->
  <data name="UpdatedTitle" xml:space="preserve">
    <value>Cart updated</value>
  </data>
  <data name="Updated" xml:space="preserve">
    <value>Quantity updated.</value>
  </data>
  <data name="RemovedTitle" xml:space="preserve">
    <value>Item removed</value>
  </data>
  <data name="Removed" xml:space="preserve">
    <value>The item was removed from your cart.</value>
  </data>
  <data name="ClearedTitle" xml:space="preserve">
    <value>Cart cleared</value>
  </data>
  <data name="Cleared" xml:space="preserve">
    <value>All items were removed from your cart.</value>
  </data>
  <data name="SubmittedTitle" xml:space="preserve">
    <value>Cart submitted</value>
  </data>
  <data name="Submitted" xml:space="preserve">
    <value>Your order has been submitted and is now pending approval.</value>
  </data>
  <data name="QuantityLabel" xml:space="preserve">
    <value>Quantity</value>
  </data>
  <data name="PurchaseLimitExceeded" xml:space="preserve">
    <value>The purchase limit for &apos;{0}&apos; is {1} units per customer. You cannot add more than this amount.</value>
  </data>
  <data name="LimitIssueWarning" xml:space="preserve">
    <value>One or more items exceed the per-customer purchase limit. Reduce the quantity before submitting.</value>
  </data>
  <data name="CategoryDeactivated" xml:space="preserve">
    <value>&apos;{0}&apos; is currently unavailable for purchase. Please remove it from your cart or try again later.</value>
  </data>
  <!-- SubmitEmptyCart — returned by SubmitSaleCommandHandler when the cart
       has 0 line items. Defense-in-depth guard that should never fire (the
       Submit button is disabled for empty carts), but if it does, show a
       localized message instead of the raw error code. -->
  <data name="SubmitEmptyCart" xml:space="preserve">
    <value>Your cart is empty. Add at least one item before submitting.</value>
  </data>
  <!-- Step 10d — CartConflict is produced when the cart was mutated (or
       submitted) by a concurrent invocation between the initial load and
       the cart-lock acquire. The customer just needs to refresh the page. -->
  <data name="CartConflict" xml:space="preserve">
    <value>Your cart was modified by another session. Refresh the page to continue.</value>
  </data>
  <!-- Step 12-a — shown when a user without a customer group tries to buy.
       The internal "group" concept is intentionally hidden — the customer
       just sees a "contact administrator" message. -->
  <data name="NoCustomerGroup" xml:space="preserve">
    <value>Your account is not configured for purchases. Please contact an administrator.</value>
  </data>

  <!-- Step 7 — SalaryBudgetExceeded is produced when the customer's salary
       budget (LimitMode = SalaryOnly or Both) would be exceeded by adding /
       updating / submitting. The localized message is GENERIC — the
       customer NEVER sees the word "group" (per the feature spec). They
       just see their remaining monthly budget.

       Format args:
         {0} = product name (e.g. "Spaghetti 1.2")
         {1} = remaining budget display (already formatted with currency
               label, e.g. "30,000 ریال" or "1,250 USD") -->
  <data name="SalaryBudgetExceeded" xml:space="preserve">
    <value>Adding &apos;{0}&apos; would exceed your monthly budget. You have {1} remaining this month.</value>
  </data>
  <data name="SalaryBudgetExceededCart" xml:space="preserve">
    <value>Submitting your order would exceed your monthly budget. You have {0} remaining this month.</value>
  </data>

  <!-- Step 7 — CurrencyMismatch is produced when the product's currency
       doesn't match the customer's salary currency. The localized message
       is intentionally GENERIC — the customer doesn't see the word
       "currency" or "group", just "this item is not available for your
       account" with an internal error code (CurrencyMismatch) that support
       staff can use to diagnose the issue. The error code is intentional —
       it's not a leak, it's a diagnostic aid that lets the customer
       self-troubleshoot (e.g. "I tried to buy a USD product but my account
       is IRR"). -->
  <data name="CurrencyMismatch" xml:space="preserve">
    <value>This item is not available for your account (code: CurrencyMismatch).</value>
  </data>
</root>