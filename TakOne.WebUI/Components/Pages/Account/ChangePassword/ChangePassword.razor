@* ── Inline toggle script ──
   WHY INLINE (not a separate .js file):
     - The function is 5 lines of trivial DOM manipulation — too small
       to justify a separate file, an extra HTTP request, a registration
       in App.razor, and a cache-bust version parameter.
     - It's page-local: the function name `takTogglePw` is unique to
       this page, so there's no reuse argument for hoisting it into a
       shared file.
     - It's a global function declaration (no IIFE, no DOM access at
       parse time), so it's safe to inline — the browser registers
       window.takTogglePw when the <script> tag is parsed, and the
       onclick="takTogglePw(this)" attribute fires it on user click,
       well after the DOM is fully built.

   WHY NOT a Blazor @onclick handler:
     - This page is STATIC SSR (see the top-of-file comment). Blazor's
       @onclick requires a circuit to round-trip the click event to the
       server. With no circuit, the handler silently never fires. The
       onclick HTML attribute, by contrast, is the browser's native
       click handler — no circuit needed.

   WHAT IT DOES:
     1. Finds the .password-row wrapper containing the clicked button.
     2. Finds the <input> inside that wrapper (the password field).
     3. Toggles the input's `type` attribute between "password" and "text".
     4. Swaps which of the two SVGs (.pw-icon-eye / .pw-icon-eye-off)
        is visible by toggling their `display` style.
     5. Updates the button's title, aria-label, and aria-pressed to
        reflect the new state. The localized strings are read from the
        button's data-show-label / data-hide-label attributes (which
        were populated by _loc at render time, so they respect the
        current UI culture).
   *@
<script>
    function takTogglePw(btn) {
        var row = btn.closest('.password-row');
        if (!row) return;
        var input = row.querySelector('input');
        if (!input) return;
        var eyeOn = btn.querySelector('.pw-icon-eye');
        var eyeOff = btn.querySelector('.pw-icon-eye-off');
        var showLabel = btn.getAttribute('data-show-label') || 'Show password';
        var hideLabel = btn.getAttribute('data-hide-label') || 'Hide password';
        if (input.type === 'password') {
            input.type = 'text';
            if (eyeOn) eyeOn.style.display = 'none';
            if (eyeOff) eyeOff.style.display = '';
            btn.setAttribute('title', hideLabel);
            btn.setAttribute('aria-label', hideLabel);
            btn.setAttribute('aria-pressed', 'true');
        } else {
            input.type = 'password';
            if (eyeOn) eyeOn.style.display = '';
            if (eyeOff) eyeOff.style.display = 'none';
            btn.setAttribute('title', showLabel);
            btn.setAttribute('aria-label', showLabel);
            btn.setAttribute('aria-pressed', 'false');
        }
    }

    // Dismiss (the X) on a plain-HTML alert. Walks up from the button to
    // the closest .tak-alert ancestor and hides it with display:none.
    //
    // NOTE: hiding the alert client-side does NOT change the server-side
    // _alertKind state — if the user re-submits the form, the alert is
    // re-evaluated and may reappear (e.g. if they submit the same bad
    // password again). That's the correct behavior: the dismiss button
    // is a UI nicety ("I've read this, get it out of my way"), not a
    // dismissal of the underlying condition.
    function takDismissAlert(btn) {
        var alert = btn.closest('.tak-alert');
        if (alert) {
            alert.style.display = 'none';
        }
    }

    // ── Client-side pre-validation ──────────────────────────────────
    // The page is static SSR with Enhance="false" on the form, so every
    // submit is a full-page POST. Without client-side validation, the
    // user has to WAIT for the server round-trip to find out their
    // password was too short or the two passwords didn't match. This
    // function runs the same checks as the server-side manual validation
    // (in HandleChangePasswordAsync) BEFORE the form submits, so the
    // user gets instant feedback. Server-side validation remains the
    // source of truth (defense-in-depth — works even with JS off).
    //
    // The localized error strings are rendered into data-* attributes on
    // the form by the server (so they respect the current UI culture),
    // then read by this function. This avoids a separate XHR to fetch
    // translations.
    function takValidateChangePassword(form) {
        // Clear any previous client-side error styling
        var prevErrors = form.querySelectorAll('.tak-val-error');
        for (var i = 0; i < prevErrors.length; i++) {
            prevErrors[i].remove();
        }
        var prevBadInputs = form.querySelectorAll('.tak-val-invalid');
        for (var j = 0; j < prevBadInputs.length; j++) {
            prevBadInputs[j].classList.remove('tak-val-invalid');
        }

        var current = form.querySelector('[name="FormModel.CurrentPassword"]');
        var newPw = form.querySelector('[name="FormModel.NewPassword"]');
        var confirm = form.querySelector('[name="FormModel.ConfirmPassword"]');

        // Read localized messages from data-* attributes on the form
        var msgCurrentRequired = form.getAttribute('data-msg-current-required') || 'Please enter your current password.';
        var msgNewRequired = form.getAttribute('data-msg-new-required') || 'Please enter a new password.';
        var msgNewLength = form.getAttribute('data-msg-new-length') || 'Password must be at least 8 characters long.';
        var msgConfirmRequired = form.getAttribute('data-msg-confirm-required') || 'Please confirm your new password.';
        var msgPasswordsDoNotMatch = form.getAttribute('data-msg-passwords-do-not-match') || 'The passwords do not match.';
        var msgNewRequiresUpper = form.getAttribute('data-msg-new-requires-upper') || 'Password must contain at least one uppercase letter (A-Z).';
        var msgNewRequiresLower = form.getAttribute('data-msg-new-requires-lower') || 'Password must contain at least one lowercase letter (a-z).';
        var msgNewRequiresDigit = form.getAttribute('data-msg-new-requires-digit') || 'Password must contain at least one digit (0-9).';
        var msgNewRequiresNonAlphanumeric = form.getAttribute('data-msg-new-requires-non-alphanumeric') || 'Password must contain at least one non-alphanumeric character.';

        function showError(input, message) {
            input.classList.add('tak-val-invalid');
            var err = document.createElement('div');
            err.className = 'tak-val-error';
            err.textContent = message;
            err.style.color = 'var(--rz-danger, #dc2626)';
            err.style.fontSize = '0.8rem';
            err.style.marginTop = '0.25rem';
            // Insert the error OUTSIDE .password-row (as a SIBLING, not a
            // child). If we inserted it INSIDE .password-row (after
            // .rz-form-field), .password-row would grow taller, and the
            // absolutely-positioned eye-toggle button (bottom:4px relative
            // to .password-row) would drop below the error text — looking
            // like the eye "fell out" of the textbox.
            //
            // By inserting as a sibling AFTER .password-row, the row stays
            // its natural height and the eye stays anchored to the input's
            // bottom edge.
            var row = input.closest('.password-row');
            if (row && row.parentNode) {
                row.parentNode.insertBefore(err, row.nextSibling);
            } else if (input.parentNode) {
                input.parentNode.appendChild(err);
            }
        }

        var firstInvalid = null;

        if (!current || !current.value || !current.value.trim()) {
            showError(current, msgCurrentRequired);
            if (!firstInvalid) firstInvalid = current;
        }
        if (!newPw || !newPw.value || !newPw.value.trim()) {
            showError(newPw, msgNewRequired);
            if (!firstInvalid) firstInvalid = newPw;
        } else {
            if (newPw.value.length < 8) {
                showError(newPw, msgNewLength);
                if (!firstInvalid) firstInvalid = newPw;
            } else if (!/[A-Z]/.test(newPw.value)) {
                showError(newPw, msgNewRequiresUpper);
                if (!firstInvalid) firstInvalid = newPw;
            } else if (!/[a-z]/.test(newPw.value)) {
                showError(newPw, msgNewRequiresLower);
                if (!firstInvalid) firstInvalid = newPw;
            } else if (!/[0-9]/.test(newPw.value)) {
                showError(newPw, msgNewRequiresDigit);
                if (!firstInvalid) firstInvalid = newPw;
            } else if (!/[^A-Za-z0-9]/.test(newPw.value)) {
                showError(newPw, msgNewRequiresNonAlphanumeric);
                if (!firstInvalid) firstInvalid = newPw;
            }
        }
        if (!confirm || !confirm.value || !confirm.value.trim()) {
            showError(confirm, msgConfirmRequired);
            if (!firstInvalid) firstInvalid = confirm;
        } else if (newPw && newPw.value && newPw.value !== confirm.value) {
            showError(confirm, msgPasswordsDoNotMatch);
            if (!firstInvalid) firstInvalid = confirm;
        }

        if (firstInvalid) {
            firstInvalid.focus();
            return false;   // prevent form submission
        }
        return true;   // allow form submission
    }

    // Wire up the submit listener on DOMContentLoaded. The form is
    // rendered server-side, so by the time this script runs, the form
    // element exists in the DOM.
    document.addEventListener('DOMContentLoaded', function() {
        var form = document.getElementById('changePasswordForm');
        if (!form) return;
        form.addEventListener('submit', function(e) {
            if (!takValidateChangePassword(form)) {
                e.preventDefault();
            }
        });
    });
</script>

@code {
    /// <summary>
    /// Form model for the change password form.
    ///
    /// The validation attributes here produce the FIRST wave of validation
    /// (fires in OnValidSubmit / OnInvalidSubmit). They are intentionally
    /// minimal — just the structural rules (required, length, equality).
    /// The richer, localized, per-complexity-rule messages are produced by
    /// the manual validation in HandleChangePasswordAsync (server-side)
    /// and the inline JS pre-validation (client-side, instant feedback).
    ///
    /// WHY NOT ErrorMessageResourceName + ErrorMessageResourceType:
    ///   That's the standard way to localize Data Annotations, but it
    ///   requires a separate shared resource class. This page uses an
    ///   IStringLocalizer created via LocalizerFactory (to sidestep a
    ///   Razor source-generator quirk on .NET 10 with
    ///   [SupplyParameterFromForm] — see the comment above the _loc
    ///   field). Wiring Data Annotations to that same localizer is more
    ///   friction than just doing the validation manually in the handler.
    /// </summary>
    private sealed class ChangePasswordModel
    {
        [Required]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required]
        public string NewPassword { get; set; } = string.Empty;

        [Required]
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    [SupplyParameterFromForm(FormName = "changePasswordForm")]
    private ChangePasswordModel? FormModel { get; set; }

    // Logger + localizer created via the *Factory abstractions rather than
    // ILogger<ChangePassword>/IStringLocalizer<ChangePassword>. Same reason
    // as ResetPassword.razor --- sidesteps a Razor source-generator quirk
    // on .NET 10 with [SupplyParameterFromForm]. See ResetPassword.razor
    // for the full explanation.
    //
    // CRITICAL — baseName must be the FULL namespace-qualified resource name
    // (not just "ChangePassword"). The Razor SDK embeds resx files using
    // their full path relative to the project root, so the resource stream
    // is named `TakOne.WebUI.Components.Pages.Account.ChangePassword.
    // ChangePassword.fa-IR.resources` (note the folder path + the .resx
    // filename repeated). ResourceManager uses the baseName LITERALLY ---
    // `new ResourceManager("ChangePassword", asm)` looks for a stream named
    // `ChangePassword.fa-IR.resources`, which doesn't exist, so the
    // localizer silently falls back to returning the raw key (and the page
    // shows "CurrentPasswordLabel", "SubmitButton", etc. as literal text).
    // The full path matches the embedded resource name and the localizer
    // finds the translations. `IStringLocalizer<T>` does this automatically
    // via typeof(T).FullName --- we just have to do it manually here.
    private ILogger _logger = default!;
    private IStringLocalizer _loc = default!;

    /// <summary>
    /// Single-source-of-truth for which alert (if any) is visible.
    /// Replaces the previous three-boolean design (which allowed two
    /// alerts to be visible at once when a code path forgot to clear
    /// one before setting another — see markup comment above).
    /// </summary>
    private enum AlertKind
    {
        None,
        MustChange,
        Error,
        Success
    }

    private AlertKind _alertKind = AlertKind.None;
    private string _alertMessage = string.Empty;
    private bool _isSubmitting;

    protected override void OnInitialized()
    {
        _logger = LoggerFactory.CreateLogger("ChangePassword");
        // Full namespace-qualified baseName — see comment above the field
        // declaration for why this can't be just "ChangePassword".
        _loc = LocalizerFactory.Create(
            "TakOne.WebUI.Components.Pages.Account.ChangePassword.ChangePassword",
            "TakOne.WebUI");
        FormModel ??= new ChangePasswordModel();

        var httpContext = HttpContextAccessor.HttpContext;

        // --------------------------------------------------------------
        // If the user is NOT authenticated, they have no business on
        // this page --- redirect to login. (They might have hit /Account/
        // ChangePassword directly in the URL bar without signing in.)
        // --------------------------------------------------------------
        if (httpContext?.User?.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/Account/Login", forceLoad: true);
            return;
        }

        // --------------------------------------------------------------
        // If the user has the `must_change_password` claim, this is a
        // forced-first-login flow --- show the warning banner so they
        // understand why they're here instead of on the dashboard.
        // --------------------------------------------------------------
        if (httpContext!.User.HasClaim("must_change_password", "true"))
        {
            _alertKind = AlertKind.MustChange;
        }
    }

    private async Task HandleChangePasswordAsync()
    {
        var model = FormModel!;
        _isSubmitting = true;
        // Clear any existing alert so a fresh submit doesn't keep a stale
        // banner visible alongside a new error (Issue #08 — duplicate
        // alerts). With the single-enum design this is a single assignment.
        _alertKind = AlertKind.None;
        _alertMessage = string.Empty;

        try
        {
            var httpContext = HttpContextAccessor.HttpContext;
            if (httpContext is null)
            {
                _alertKind = AlertKind.Error;
                _alertMessage = _loc["Error_Unexpected"];
                return;
            }

            // ── Manual validation (localized, server-side, runs without JS) ──
            // Data Annotations only give us the [Required] / [StringLength]
            // checks, and their messages don't localize well with this
            // page's LocalizerFactory-based IStringLocalizer. So we run
            // a quick, fully-localized manual validation here that catches
            // the most common user errors BEFORE we hit Identity.
            //
            // This ALSO catches things Data Annotations can't easily express
            // (e.g. "password must contain a digit" — Identity enforces
            // this server-side, but its error is a generic English-derived
            // string; we can give a friendlier, localized message here).
            //
            // Order: required fields first, then length, then complexity,
            // then match. Each returns the FIRST applicable error — we
            // don't pile them up; one error at a time is enough for the
            // user to act on.
            if (string.IsNullOrWhiteSpace(model.CurrentPassword))
            {
                _alertKind = AlertKind.Error;
                _alertMessage = _loc["Val_CurrentRequired"];
                return;
            }
            if (string.IsNullOrWhiteSpace(model.NewPassword))
            {
                _alertKind = AlertKind.Error;
                _alertMessage = _loc["Val_NewRequired"];
                return;
            }
            if (model.NewPassword.Length < 8)
            {
                _alertKind = AlertKind.Error;
                _alertMessage = _loc["Val_NewLength"];
                return;
            }
            if (string.IsNullOrWhiteSpace(model.ConfirmPassword))
            {
                _alertKind = AlertKind.Error;
                _alertMessage = _loc["Val_ConfirmRequired"];
                return;
            }
            if (!string.Equals(model.NewPassword, model.ConfirmPassword,
                    StringComparison.Ordinal))
            {
                _alertKind = AlertKind.Error;
                _alertMessage = _loc["Val_PasswordsDoNotMatch"];
                return;
            }
            // Complexity rules — match Identity's configured rules
            // (appsettings: RequireUppercase, RequireLowercase, RequireDigit,
            // RequireNonAlphanumeric). Run them here so we get a friendly
            // localized error before Identity returns its own (still
            // correct but Englishier) message.
            if (!ContainsUpper(model.NewPassword))
            {
                _alertKind = AlertKind.Error;
                _alertMessage = _loc["Val_NewRequiresUpper"];
                return;
            }
            if (!ContainsLower(model.NewPassword))
            {
                _alertKind = AlertKind.Error;
                _alertMessage = _loc["Val_NewRequiresLower"];
                return;
            }
            if (!ContainsDigit(model.NewPassword))
            {
                _alertKind = AlertKind.Error;
                _alertMessage = _loc["Val_NewRequiresDigit"];
                return;
            }
            if (!ContainsNonAlphanumeric(model.NewPassword))
            {
                _alertKind = AlertKind.Error;
                _alertMessage = _loc["Val_NewRequiresNonAlphanumeric"];
                return;
            }

            // ------------------------------------------------------------
            // Determine which flow we're in: FORCED (the user was
            // redirected here by the MustChangePassword middleware
            // because their cookie carries the `must_change_password`
            // claim) or VOLUNTARY (the user navigated here directly
            // to change their own password).
            //
            // The two flows have DIFFERENT success behavior:
            //   - FORCED:   sign the user OUT and redirect to /Account/Login.
            //   - VOLUNTARY: re-issue the cookie and redirect to the
            //                role-aware landing page (or returnUrl).
            //
            // We read the claim HERE (not in OnInitialized) because the
            // claim's presence is the canonical signal — and reading it
            // here keeps the decision local to the success path where
            // it's used.
            // ------------------------------------------------------------
            var isForcedChange = httpContext.User.HasClaim("must_change_password", "true");

            // ------------------------------------------------------------
            // Defense-in-depth: reject the new password if it's identical
            // to the current password. Identity's UserManager.ChangePasswordAsync
            // does NOT enforce this by default (it has no password-history
            // feature), so we enforce it here. This is especially
            // important for the forced-first-login flow --- the whole
            // point of forcing a change is to ensure the new password is
            // DIFFERENT from the one the operator configured.
            // ------------------------------------------------------------
            if (string.Equals(model.CurrentPassword, model.NewPassword,
                StringComparison.Ordinal))
            {
                _alertKind = AlertKind.Error;
                _alertMessage = _loc["Error_NewPasswordSameAsCurrent"];
                return;
            }

            // ------------------------------------------------------------
            // Resolve the current user's Id from the auth cookie's
            // NameIdentifier claim. We don't trust UserName here --- the
            // user might have just had their UserName changed by an
            // admin (rare but possible), and the cookie might be stale.
            // The NameIdentifier claim IS the user's immutable Guid Id
            // and is the canonical way to look up the ApplicationUser.
            // ------------------------------------------------------------
            var userIdClaim = httpContext.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (userIdClaim is null || !Guid.TryParse(userIdClaim, out var userId))
            {
                _logger.LogError(
                    "ChangePassword: authenticated user has no parseable " +
                    "NameIdentifier claim. Claim value: '{ClaimValue}'.",
                    userIdClaim ?? "(null)");
                _alertKind = AlertKind.Error;
                _alertMessage = _loc["Error_Unexpected"];
                return;
            }

            // ------------------------------------------------------------
            // Call the Application-layer abstraction. The implementation
            // (UserAccountService) verifies the current password, validates
            // the new password, hashes + stores it, rotates the
            // SecurityStamp, and clears the MustChangePassword flag ---
            // all in one atomic call.
            // ------------------------------------------------------------
            var result = await UserAccountService.ChangePasswordAsync(
                userId,
                model.CurrentPassword,
                model.NewPassword);

            if (!result.IsSuccess)
            {
                // Identity's error message --- already localized by the
                // IdentityErrorDescriber. For wrong current password,
                // it'll say "Incorrect password." For complexity
                // failures, it'll say "Passwords must have at least one
                // digit ('0'-'9')." etc.
                _alertKind = AlertKind.Error;
                _alertMessage = ErrorDisplay.Localize(result.Error) ?? string.Empty;
                _logger.LogWarning(
                    "ChangePassword: ChangePasswordAsync failed for userId {UserId}. Error: {Error}.",
                    userId, _alertMessage);
                return;
            }

            _logger.LogInformation(
                "ChangePassword: password changed for userId {UserId} (forced flow: {IsForced}).",
                userId, isForcedChange);

            // ============================================================
            // FORCED-FIRST-LOGIN FLOW
            // ============================================================
            // The user was redirected here by the MustChangePassword
            // middleware because their cookie carried the
            // `must_change_password` claim. The password has now been
            // changed and the MustChangePassword flag on the user row
            // has been cleared (by UserAccountService.ChangePasswordAsync).
            //
            // SECURITY GUARANTEE:
            //   We deliberately do NOT re-issue the cookie here. Instead,
            //   we SIGN THE USER OUT and redirect to /Account/Login.
            //   Why: the cookie the user is currently holding was minted
            //   from a sign-in with a password that was set by SOMEONE
            //   ELSE (the operator, an admin, or a manager). Even though
            //   the password has been changed on the user row, the
            //   cookie's authentication is still anchored to the OLD
            //   sign-in. The cleanest way to guarantee the cookie is
            //   freshly minted from the user's OWN new password is to
            //   force a fresh sign-in.
            //
            //   This also matches the operational guarantee from
            //   DefaultAdminOptions.ForcePasswordChangeOnFirstLogin:
            //   "the operator cannot log in as the admin after first
            //   login" — and the operator cannot log in with the new
            //   password either, because they don't know it.
            //
            // No success banner is shown: the login page itself is the
            // success indicator. The user will see the familiar login
            // form and understand they need to enter their NEW password.
            // ============================================================
            if (isForcedChange)
            {
                await SignInManager.SignOutAsync();
                _logger.LogInformation(
                    "ChangePassword: forced-change flow complete for userId {UserId}. " +
                    "Signed out. Redirecting to /Account/Login.",
                    userId);
                // NavigateTo in static SSR issues a 302 on the CURRENT
                // HTTP response — this works because we haven't returned
                // from the handler yet. The browser follows the redirect
                // and replaces the entire page with the login page. No
                // success banner is rendered.
                Navigation.NavigateTo("/Account/Login", forceLoad: true);
                return;
            }

            // ============================================================
            // VOLUNTARY FLOW (user navigated here directly)
            // ============================================================
            // Re-issue the auth cookie WITHOUT the `must_change_password`
            // claim. In the voluntary flow the claim shouldn't be present
            // anyway, but we strip it defense-in-depth — if a stale
            // claim somehow lingered on the cookie, the middleware would
            // keep redirecting the user here even though they've already
            // changed their password.
            //
            // We re-use the existing custom claims (FullName, GroupId,
            // Gender) by reading them from the current principal --- that
            // avoids a DB lookup just to re-populate them. (Step 8: the
            // legacy "GroupName" string claim was replaced with the
            // "GroupId" Guid claim when User.GroupName → User.GroupId.)
            // ============================================================
            var appUser = await UserManager.FindByIdAsync(userId.ToString());
            if (appUser is null)
            {
                // Defensive --- we just changed this user's password, so
                // the row definitely exists. If we somehow can't find
                // it, sign the user out and send them to login.
                _logger.LogError(
                    "ChangePassword: ApplicationUser not found after " +
                    "successful password change for userId {UserId}. " +
                    "Signing the user out.",
                    userId);
                await SignInManager.SignOutAsync();
                Navigation.NavigateTo("/Account/Login", forceLoad: true);
                return;
            }

            var refreshedClaims = new List<Claim>();
            // Copy over the existing custom claims (FullName, GroupId,
            // Gender) so the new cookie has the same enrichment.
            foreach (var claimType in new[] { "FullName", "GroupId", "Gender" })
            {
                var existing = httpContext.User.FindFirst(claimType);
                if (existing is not null)
                {
                    refreshedClaims.Add(existing);
                }
            }
            // Deliberately DO NOT add the `must_change_password` claim
            // here --- the whole point of re-issuing the cookie is to
            // ensure that claim is absent.

            await SignInManager.SignInWithClaimsAsync(
                appUser,
                new AuthenticationProperties { IsPersistent = false },
                refreshedClaims);

            // ------------------------------------------------------------
            // Redirect IMMEDIATELY (no success banner, no Task.Delay).
            //
            // PREVIOUS DESIGN: set _showSuccess = true, then fire-and-forget
            //   _ = Task.Delay(1500).ContinueWith(_ => Navigation.NavigateTo(...));
            // That pattern is BROKEN in static SSR — by the time the
            // Task.Delay completes, the HTTP response has already been
            // sent to the browser (with the success banner rendered).
            // Navigation.NavigateTo can't redirect a response that's
            // already been sent, so the redirect never fires and the
            // success banner stays on screen indefinitely — which the
            // user perceives as an "unclosable toast".
            //
            // NEW DESIGN: redirect synchronously inside the handler.
            // Navigation.NavigateTo in static SSR issues a 302 on the
            // CURRENT HTTP response — the browser follows the redirect
            // and replaces the entire page with the role-aware landing
            // page. No success banner is rendered (the new page is the
            // success indicator). The user is never left staring at a
            // stuck toast.
            // ------------------------------------------------------------
            var returnUrl = httpContext.Request.Query["returnUrl"].ToString();
            var target = !string.IsNullOrEmpty(returnUrl) && IsSafeReturnUrl(returnUrl)
                ? returnUrl
                : GetRoleAwareLandingUrl(httpContext.User);

            _logger.LogInformation(
                "ChangePassword: redirecting to '{Target}' after successful voluntary password change.",
                target);

            Navigation.NavigateTo(target, forceLoad: true);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex,
                "ChangePassword: unexpected error changing password.");
            _alertKind = AlertKind.Error;
            _alertMessage = ErrorDisplay.Unexpected(UnexpectedErrorCodes.ChangePassword_UnexpectedFailure);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    /// <summary>
    /// Resolves the role-aware landing URL for the given principal.
    /// Mirrors the same logic in Login.razor --- kept private here so
    /// the two pages don't need a shared helper. (Customer -> /Products;
    /// everyone else -> /.)
    /// </summary>
    private static string GetRoleAwareLandingUrl(ClaimsPrincipal principal)
    {
        if (principal.IsInRole(Roles.Customer))
        {
            return "/Products";
        }
        return "/";
    }

    /// <summary>
    /// Open-redirect defense --- mirrors Login.razor's IsSafeReturnUrl.
    /// Only allows relative URLs that don't start with // (protocol-relative)
    /// and don't point at /Account/Login or /Account/ChangePassword itself
    /// (would loop).
    /// </summary>
    private static bool IsSafeReturnUrl(string returnUrl)
    {
        if (string.IsNullOrWhiteSpace(returnUrl)) return false;
        if (!returnUrl.StartsWith('/')) return false;
        if (returnUrl.StartsWith("//")) return false;
        if (returnUrl.StartsWith("/\\", StringComparison.OrdinalIgnoreCase)) return false;
        if (returnUrl.StartsWith("/Account/Login", StringComparison.OrdinalIgnoreCase)) return false;
        if (returnUrl.StartsWith("/Account/ChangePassword", StringComparison.OrdinalIgnoreCase)) return false;
        return true;
    }

    /// <summary>
    /// Complexity-check helpers. Used by the manual validation in
    /// HandleChangePasswordAsync to produce friendly, localized error
    /// messages BEFORE Identity returns its own (still correct but
    /// less friendly) error. Mirrors the rules configured in
    /// appsettings.json under TakOne:Database:Identity:Password.
    ///
    /// Kept as static methods (no regex) so they're trivially fast and
    /// allocation-free. LINQ's Any() would also work but allocates an
    /// iterator; for a password-length string, the plain loop is fine.
    /// </summary>
    private static bool ContainsUpper(string s)
    {
        foreach (var c in s)
            if (char.IsUpper(c)) return true;
        return false;
    }

    private static bool ContainsLower(string s)
    {
        foreach (var c in s)
            if (char.IsLower(c)) return true;
        return false;
    }

    private static bool ContainsDigit(string s)
    {
        foreach (var c in s)
            if (char.IsDigit(c)) return true;
        return false;
    }

    private static bool ContainsNonAlphanumeric(string s)
    {
        foreach (var c in s)
            if (!char.IsLetterOrDigit(c)) return true;
        return false;
    }
}