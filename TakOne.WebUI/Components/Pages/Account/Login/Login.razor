@* Login.razor — Phase 1.1
   Static-rendered login page (NOT a Blazor circuit). The login flow
   needs the cookie to be set on the HTTP response BEFORE the page
   returns — that's only possible with static SSR, not Blazor Server
   interactive mode (which buffers the response and the cookie wouldn't
   be visible until a full reload).

   FLOW:
     1. User visits /Account/Login?returnUrl=/Sales (or whatever).
     2. Page renders the form statically (no circuit established).
     3. User submits → EditForm's OnValidSubmit fires in the same
        static-rendered request.
     4. We call SignInManager.PasswordSignInAsync — this validates
        credentials AND sets the auth cookie on the HTTP response.
     5. On success, we redirect to the role-aware landing page with
        forceLoad:true so the browser does a fresh HTTP round-trip —
        the new request carries the cookie and Blazor's circuit starts
        with the correct auth state.
     6. On failure, we re-render the form with an error message.

   CUSTOM CLAIMS:
     BlazorCurrentUserService reads "FullName" and "GroupName" claims
     from the principal. We populate these at sign-in time by replacing
     Identity's default ClaimsPrincipal with one that includes our
     custom claims. The technique: call SignInManager.PasswordSignInAsync
     to validate the password + issue the cookie, then if it succeeds,
     re-issue the principal with the extra claims via
     SignInManager.SignInWithClaimsAsync (which atomically replaces
     the cookie).

   ROLE-AWARE REDIRECT (roadmap Section 12.8):
     Admin/Manager/Employee/ReadOnly → /  (Dashboard)
     Customer                          → /Products (Catalog)

   ANTI-FORGERY:
     EditForm automatically emits an antiforgery token. The
     UseAntiforgery middleware in Program.cs validates it on POST.
     No manual [ValidateAntiForgeryToken] needed. *@

@page "/Account/Login"
@layout LoginLayout
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using TakOne.Application.Common.Authorization
@using TakOne.Domain.Users
@using TakOne.Infrastructure.Identity
@using TakOne.Infrastructure.Persistence
@using Microsoft.EntityFrameworkCore
@using TakOne.WebUI.Services.Logging
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Navigation
@inject IStringLocalizer<Login> Loc
@inject LoginAuditLogger AuditLogger

<PageTitle>@Loc["PageTitle"]</PageTitle>

@* ── Page-scoped styles for the password row + eye-toggle button ──
   SAME pattern as ChangePassword.razor / CreateUser.razor. The toggle
   button is a plain <button> (NOT RadzenButton) because this page
   renders STATICALLY (no Blazor circuit) — RadzenButton's Click handler
   needs a circuit to round-trip. A plain <button> with
   onclick="takTogglePw(this)" calls the inline JS function at the
   bottom of this file — pure browser, no server round-trip.

   LAYOUT (revised — eye is INSIDE the textbox, not beside it):
   The .password-row is a positioning context (position:relative, block).
   The RadzenFormField renders the label + input at full width (forced
   via the .password-row .rz-form-field rule below — see comment there).
   The .password-toggle button is position:absolute over the RIGHT edge of
   the input (always the physical right — see `right: 8px` below),
   vertically centered with the input's text. Because absolute
   positioning takes the button OUT of the field's layout flow, the
   input stays at its full width and the eye sits visually INSIDE the
   textbox.

   POSITIONING (eye always on the RIGHT, in both LTR and RTL):
   The <input> inside .password-row is forced to dir="ltr" (see the
   bidi-fix comment above the input element). This means the typed
   text ALWAYS starts from the LEFT edge of the input and extends
   to the RIGHT, regardless of the page's RTL/LTR direction.
   Therefore the eye must ALWAYS sit on the physical RIGHT edge of
   the textbox (where the text ends) — never on the left, where the
   text starts and would collide with the eye.
   We use PHYSICAL `right:8px` + `padding-right:36px` (NOT the CSS
   logical properties `inset-inline-end` / `padding-inline-end`).
   Reason: logical properties flip with the `dir` attribute on <html> —
   in RTL (Persian) they would resolve to `left:8px` / `padding-left:36px`,
   placing the eye on the LEFT — exactly where the (always-LTR) text
   starts, causing the eye to overlap the typed text. Physical `right`
   does NOT flip with `dir`, so the eye stays on the right in both
   English and Persian, matching the English layout the user expects.
   This supersedes the earlier `inset-inline-end` / `padding-inline-end`
   approach, which was correct ONLY when the input itself was RTL
   (i.e. before the dir="ltr" bidi fix was applied to the input). *@
<HeadContent>
    <style>
            .password-row {
                position: relative;
                display: block;
                width: 100%;
            }

            /* Force the RadzenFormField (renders as .rz-form-field with
               display:inline-flex by default) to stretch to 100% width.
               Without this, the field shrinks to its content width when
               placed inside a block-level parent (.password-row), making
               the password textbox visibly narrower than the Worker ID
               field above it (which is a direct flex child of RadzenStack
               and gets stretched via align-items:stretch). Width:100% on
               .rz-form-field forces the wrapper to fill the .password-row,
               and the input inside fills the wrapper — matching the Worker
               ID field's width exactly. */
            .password-row .rz-form-field {
                width: 100%;
            }

            .password-toggle {
                position: absolute;
                /* RadzenFormField renders label-above + input-below.
                   The input sits at the bottom of the form-field wrapper
                   and is ~40px tall, so the input's vertical center is
                   ~20px from the bottom of the wrapper. The button is
                   32px tall (so its center is 16px from its bottom edge);
                   to align the button's center with the input's center,
                   bottom = 20 - 16 = 4px. */
                bottom: 4px;
                /* Physical `right` (not `inset-inline-end`) — the input
                   is forced dir="ltr" so text always starts from the left;
                   the eye therefore always belongs on the physical right
                   edge of the textbox, in both English and Persian modes.
                   See the big comment block above . */
                right: 8px;
                width: 32px;
                height: 32px;
                padding: 0;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                background: transparent;
                color: var(--rz-text-secondary-color, #6b7280);
                border: none;
                border-radius: var(--rz-border-radius, 6px);
                cursor: pointer;
                transition: background-color 0.15s ease, color 0.15s ease;
                /* Ensure the button sits above the input (so the click
                   target is on top, not the input). */
                z-index: 1;
            }

                .password-toggle:hover {
                    background: var(--rz-base-hover-bg, rgba(0, 0, 0, 0.06));
                    color: var(--rz-text-color, #111827);
                }

                .password-toggle:focus-visible {
                    outline: 2px solid var(--rz-primary, #3b82f6);
                    outline-offset: 2px;
                }

                .password-toggle svg {
                    pointer-events: none;
                }

            /* Reserve space INSIDE the input on the RIGHT so the typed
               text doesn't run under the absolutely-positioned eye icon.
               Uses PHYSICAL `padding-right` (NOT the CSS logical property
               `padding-inline-end`) — the input is forced dir="ltr" so
               text always starts from the left and extends to the right,
               and the eye always sits on the physical right. !important
               is needed to beat Radzen's default .rz-textbox padding rule.
               Applies to any <input> inside .password-row (RadzenPassword
               renders as input.rz-textbox, and our native <input> uses
               class="rz-textbox" too). */
            .password-row input {
                padding-right: 36px !important;
            }
    </style>
</HeadContent>

<RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="max-width: 360px; margin: 0 auto;">
    @* Error banner — shown only after a failed login attempt.
       NOTE on `AlertStyle`: this is the CORRECT API for RadzenAlert in
       Radzen.Blazor v11.1.1 (verified via the official docs at
       https://blazor.radzen.com/docs/api/Radzen.AlertStyle and by
       cross-checking the ERP reference project, which uses the exact
       same Radzen.Blazor 11.1.1 version).

       Two earlier drafts got this wrong:
         (a) `AlertShade.Danger` / `AlertShade.Info` — the `AlertShade`
             enum was REMOVED years ago and doesn't exist in v11.1.1.
         (b) `Shade.Danger` / `Shade.Info` — there IS a `Shade` enum in
             Radzen.Blazor, but it doesn't contain Danger/Info (its
             values are Primary/Secondary/Base/Dark/Light — it's a
             theme-shade enum, not a severity enum).

       The actual API is: the `RadzenAlert` parameter is named
       `AlertStyle`, and the enum type is also `AlertStyle` (same name,
       both in namespace `Radzen`). Values: Primary, Secondary, Light,
       Base, Dark, Success, Danger, Warning, Info. Both `AlertStyle` (the
       property) and `AlertStyle` (the enum) are reachable without
       qualification because `Radzen` is imported via _Imports.razor. *@
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <RadzenAlert Title="@Loc["ErrorTitle"]"
                     Text="@_errorMessage"
                     AlertStyle="AlertStyle.Danger"
                     Variant="Variant.Filled"
                     ShowIcon="true" />
    }

    @*
       EditForm with FormName + [SupplyParameterFromForm] is the canonical
       Blazor static-SSR form pattern. On POST, the antiforgery middleware
       validates the token, then Blazor's form binder populates FormModel
       from the posted fields, then OnValidSubmit fires.
    *@
    <EditForm Model="@FormModel"
              OnValidSubmit="@HandleLoginAsync"
              FormName="loginForm"
              Method="post"
              Enhance="false">
        @* ↑ Enhance="false" is the CRITICAL fix. It tells blazor.web.js
         NOT to intercept this form's submit with enhanced navigation.
         The browser does a normal full-page POST, the antiforgery
         token is consumed cleanly, and the cookie set by
         PasswordSignInAsync takes effect on the redirect response. *@

        <DataAnnotationsValidator />

        @* NOTE: Do NOT add <AntiforgeryToken /> here — EditForm auto-injects
       one internally. Adding a second one causes the server to reject
       the POST with 400 "duplicate antiforgery token". *@

        <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">

            <RadzenFormField Text="@Loc["WorkerIdLabel"]">
                @* Native <input type="text" dir="ltr"> instead of RadzenTextBox.
                   WHY: In RTL (fa-IR) mode, RadzenTextBox renders an <input>
                   that inherits dir="rtl" from <html>. The browser's bidi
                   algorithm then treats weak/neutral characters (like "!",
                   "@", "#") as RTL-directional and places them at the
                   START of the LTR run (the right edge in RTL). The user
                   types "miow2323!" but sees "!miow2323" — the "!" jumps
                   to the front. Setting dir="ltr" on the input tells the
                   browser to treat the entire input as LTR, so characters
                   are inserted and displayed in the order the user typed
                   them. This is the same fix used for the price-amount
                   input in CreateProduct.razor and the qty input in
                   ProductDetail.razor. The .rz-textbox class keeps the
                   visual style consistent with other Radzen form fields.
                   The name="FormModel.WorkerId" attribute is REQUIRED for
                   Blazor's [SupplyParameterFromForm] binder to map the
                   posted field back to the model on POST (RadzenTextBox's
                   Name parameter did this implicitly; on a native input
                   we set it explicitly). @bind sets the initial value
                   attribute from the model so the Worker ID is preserved
                   on re-render after a failed login. *@
                <input type="text"
                       class="rz-textbox"
                       dir="ltr"
                       name="FormModel.WorkerId"
                       placeholder="@Loc["WorkerIdPlaceholder"]"
                       autocomplete="username"
                       autofocus
                       @bind="FormModel!.WorkerId"
                       style="width: 100%; text-align: left;" />
            </RadzenFormField>

            @* Password field with the eye-toggle button absolutely
               positioned INSIDE the textbox (right edge). The .password-row
               wrapper is just a positioning context (position:relative) —
               the RadzenFormField fills it at full natural width, and the
               button overlays the input's right edge. See the <style> block
               above for the layout rationale.

               The button is a plain HTML <button> — NOT a RadzenButton —
               because RadzenButton's Click handler needs a Blazor circuit,
               and this page is static-SSR (see the big comment at the top
               of the file). The button's onclick attribute calls
               takTogglePw(this), a tiny inline JS function at the bottom
               of this file.

               Two inline SVGs are stacked inside the button:
                 .pw-icon-eye     → shown when password is MASKED (initial)
                 .pw-icon-eye-off → shown when password is VISIBLE
               JS toggles their display style + the input's type attribute.

               data-show-label / data-hide-label carry the localized
               strings so the JS can swap the title + aria-label without
               a server round-trip. They're read from Loc (the page's
               localizer) on the server at render time, so they respect
               the current culture (fa-IR / en-US).

               Pattern lifted verbatim from ChangePassword.razor so the
               two pages share a consistent eye-toggle UX. *@
            <div class="password-row">
                <RadzenFormField Text="@Loc["PasswordLabel"]">
                    @* Native <input type="password" dir="ltr"> instead of
                       RadzenPassword — same RTL bidi fix as the Worker ID
                       input above. In Persian mode, without dir="ltr",
                       typing "miow2323!" shows "!miow2323" because the
                       bidi algorithm places the neutral "!" at the start
                       of the LTR run. dir="ltr" forces the entire input
                       to be treated as LTR, preserving the typed order.
                       The eye-toggle JS (takTogglePw) still works because
                       it finds the input via row.querySelector('input'),
                       which matches a native <input> the same as
                       RadzenPassword's rendered <input>. The .rz-textbox
                       class keeps the visual style consistent. The
                       name="FormModel.Password" attribute is REQUIRED for
                       Blazor's [SupplyParameterFromForm] binder. *@
                    <input type="password"
                           class="rz-textbox"
                           dir="ltr"
                           name="FormModel.Password"
                           placeholder="@Loc["PasswordPlaceholder"]"
                           autocomplete="current-password"
                           @bind="FormModel!.Password"
                           style="width: 100%; text-align: left;" />
                </RadzenFormField>
                <button type="button"
                        class="password-toggle"
                        title="@Loc["ShowPassword"]"
                        aria-label="@Loc["ShowPassword"]"
                        aria-pressed="false"
                        data-show-label="@Loc["ShowPassword"]"
                        data-hide-label="@Loc["HidePassword"]"
                        onclick="takTogglePw(this)">
                    <svg class="pw-icon-eye" viewBox="0 0 24 24" width="20" height="20"
                         fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    <svg class="pw-icon-eye-off" viewBox="0 0 24 24" width="20" height="20"
                         fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                         style="display: none;">
                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-10-8-10-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 10 8 10 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                        <line x1="1" y1="1" x2="23" y2="23"></line>
                    </svg>
                </button>
            </div>

            <RadzenButton Text="@Loc["SubmitButton"]"
                          ButtonType="ButtonType.Submit"
                          ButtonStyle="ButtonStyle.Primary"
                          Variant="Variant.Filled"
                          Icon="login"
                          Disabled="@_isSubmitting"
                          Style="width: 100%;" />
        </RadzenStack>
    </EditForm>
</RadzenStack>

@* ── Inline toggle script ──
   WHY INLINE (not a separate .js file):
     - The function is 5 lines of trivial DOM manipulation — too small
       to justify a separate file, an extra HTTP request, a registration
       in App.razor, and a cache-bust version parameter.
     - It's page-local: the function name `takTogglePw` is shared with
       ChangePassword.razor / CreateUser.razor, but the implementation
       is identical and safe to redefine (the browser uses the last
       definition parsed, which is fine since they're all the same).
     - It's a global function declaration (no IIFE, no DOM access at
       parse time), so it's safe to inline — the browser registers
       window.takTogglePw when the <script> tag is parsed, and the
       onclick="takTogglePw(this)" attribute fires it on user click,
       well after the DOM is fully built.

   WHY NOT a Blazor @onclick handler:
     - This page is STATIC SSR (see the top-of-file comment). Blazor's
       @onclick requires a circuit to round-trip the click event to the
       server. With no circuit, the handler silently never fires. The
       onclick HTML attribute, by contrast, is the browser's native
       click handler — no circuit needed.

   WHAT IT DOES:
     1. Finds the .password-row wrapper containing the clicked button.
     2. Finds the <input> inside that wrapper (the password field).
     3. Toggles the input's `type` attribute between "password" and "text".
     4. Swaps which of the two SVGs (.pw-icon-eye / .pw-icon-eye-off)
        is visible by toggling their `display` style.
     5. Updates the button's title, aria-label, and aria-pressed to
        reflect the new state. The localized strings are read from the
        button's data-show-label / data-hide-label attributes (which
        were populated by Loc at render time, so they respect the
        current UI culture).

   Identical to the script in ChangePassword.razor — kept duplicated
   rather than hoisted into a shared .js file because both pages are
   static-SSR and may be served independently (a shared file would
   need to be referenced via <script src> in App.razor, which would
   load it on every page even when neither Login nor ChangePassword
   is being viewed). *@
<script>
    function takTogglePw(btn) {
        var row = btn.closest('.password-row');
        if (!row) return;
        var input = row.querySelector('input');
        if (!input) return;
        var eyeOn = btn.querySelector('.pw-icon-eye');
        var eyeOff = btn.querySelector('.pw-icon-eye-off');
        var showLabel = btn.getAttribute('data-show-label') || 'Show password';
        var hideLabel = btn.getAttribute('data-hide-label') || 'Hide password';
        if (input.type === 'password') {
            input.type = 'text';
            if (eyeOn) eyeOn.style.display = 'none';
            if (eyeOff) eyeOff.style.display = '';
            btn.setAttribute('title', hideLabel);
            btn.setAttribute('aria-label', hideLabel);
            btn.setAttribute('aria-pressed', 'true');
        } else {
            input.type = 'password';
            if (eyeOn) eyeOn.style.display = '';
            if (eyeOff) eyeOff.style.display = 'none';
            btn.setAttribute('title', showLabel);
            btn.setAttribute('aria-label', showLabel);
            btn.setAttribute('aria-pressed', 'false');
        }
    }
</script>

@code {
    /// <summary>
    /// The form model. Uses [Required] for basic validation; the actual
    /// credential check happens in SignInManager.PasswordSignInAsync.
    /// </summary>
    private sealed class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Worker ID is required.")]
        public string WorkerId { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Password is required.")]
        public string Password { get; set; } = string.Empty;
    }

    /// <summary>
    /// Bound from the form POST by Blazor's [SupplyParameterFromForm]
    /// mechanism. On the initial GET this is null — OnInitialized creates
    /// a fresh instance. On POST, Blazor populates it from the posted
    /// fields before OnValidSubmit fires.
    /// </summary>
    [SupplyParameterFromForm(FormName = "loginForm")]
    private LoginModel? FormModel { get; set; }

    private string _errorMessage = string.Empty;
    private bool _isSubmitting;

    protected override void OnInitialized()
    {
        // Initialize the form model on the initial GET. On POST, Blazor
        // has already populated FormModel before OnInitialized runs, so
        // this no-ops.
        FormModel ??= new LoginModel();

        // If the user is already authenticated, they have no business on
        // the login page — redirect to their role-aware landing page.
        // (This mirrors the redirect after a successful login, but for
        // the case where the user manually navigates to /Account/Login
        // while already signed in.)
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext?.User?.Identity?.IsAuthenticated == true)
        {
            var target = GetRoleAwareLandingUrl(httpContext.User);
            Navigation.NavigateTo(target, forceLoad: true);
            return;
        }
    }

    private async Task HandleLoginAsync()
    {
        // FormModel is guaranteed non-null here — EditForm only fires
        // OnValidSubmit when the model is populated AND passes validation.
        var model = FormModel!;

        _isSubmitting = true;
        _errorMessage = string.Empty;

        // ISSUE #03 — Audit logging goes through LoginAuditLogger.
        //   - LogFlowStart is GATED to IsDevelopment() inside the logger
        //     itself, so it no-ops in Production regardless of log level.
        //   - It logs ONLY WorkerId (the user-supplied identifier, which is
        //     not a secret — it's the username equivalent). Password,
        //     PasswordLength, EmailConfirmed, LockoutEnd, AccessFailedCount
        //     are NEVER logged — they cannot even be passed to the audit
        //     logger because its only input shape is LoginLogContext, and
        //     none of those fields exist on that record (allow-list by
        //     construction).
        //   - The ForbiddenLoggingAnalyzer (TakOne.Analyzers) is the CI-level
        //     backstop: any attempt to call ILogger.Log* with a banned token
        //     ("DIAG Login", "PasswordLength", "EmailConfirmed", "LockoutEnd",
        //     "AccessFailedCount", "Password=", "Password:") fails the build.
        AuditLogger.LogFlowStart(model.WorkerId);

        try
        {
            var httpContext = HttpContextAccessor.HttpContext;
            if (httpContext is null)
            {
                AuditLogger.Log(new LoginLogContext
                {
                    WorkerId = model.WorkerId,
                    Outcome = LoginLogOutcome.NoHttpContext,
                });
                _errorMessage = Loc["Error_NoHttpContext"];
                return;
            }

            // --------------------------------------------------------------
            // 1a. Pre-check: load the ApplicationUser + Domain User BEFORE
            //     calling PasswordSignInAsync. We need the Domain User for
            //     custom claims (FullName, GroupName, Gender) anyway, so we
            //     fetch it now and also check the user's IsActive flag.
            //
            //     Rationale: appsettings.json sets RequireConfirmedAccount =
            //     false, which means Identity's SignInManager will NOT
            //     consult our custom IsActive flag during sign-in. Without
            //     this pre-check, a deactivated user could log in
            //     successfully. We close that hole here.
            //
            //     We deliberately return the SAME generic error message
            //     for "user not found" and "user deactivated" — leaking
            //     "your account exists but is deactivated" would let an
            //     attacker enumerate valid WorkerIds.
            // --------------------------------------------------------------
            var appUser = await UserManager.FindByNameAsync(model.WorkerId);
            // ISSUE #03 — no DIAG logging of user state. The pre-check
            // result is folded into the InvalidCredentials outcome below;
            // logging "user not found" vs. "user deactivated" separately
            // would let an attacker enumerate valid WorkerIds.
            if (appUser is null || !appUser.IsActive)
            {
                AuditLogger.Log(new LoginLogContext
                {
                    WorkerId = model.WorkerId,
                    Outcome = LoginLogOutcome.InvalidCredentials,
                });
                _errorMessage = Loc["Error_InvalidCredentials"];
                return;
            }

            // Fetch the Domain User (for custom claims) — single row
            // lookup by the shared PK. AsNoTracking because we don't
            // intend to mutate it during the login flow.
            var db = httpContext.RequestServices
                .GetRequiredService<ApplicationDbContext>();
            var domainUser = await db.DomainUsers
                .AsNoTracking()
                .FirstOrDefaultAsync(u => u.Id == appUser.Id);
            // ISSUE #03 — DomainUser lookup result is NOT logged.
            //   - Logging "FOUND" vs "NULL" leaks whether the DomainUser row
            //     exists for a given AspNetUsers.Id — account-state intel.
            //   - Logging FullName leaks PII.
            //   - The data-integrity issue (missing DomainUser row) is still
            //     detected — FullNameClaimsTransformation will log a warning
            //     on the next request when it re-reads from the DB. That
            //     warning is appropriately scoped (transformation layer,
            //     not the credential-checking layer).

            // --------------------------------------------------------------
            // 1b. Validate credentials via SignInManager.
            //
            //     PasswordSignInAsync checks the password against the
            //     hashed value on ApplicationUser, honors lockout policy,
            //     and (if success) issues the auth cookie on the HTTP
            //     response.
            //
            //     Note: this is NOT a Blazor circuit call. The page is
            //     statically rendered, so SignInManager sees the real
            //     HttpContext and can write the cookie to the response.
            // --------------------------------------------------------------
            var result = await SignInManager.PasswordSignInAsync(
                model.WorkerId,
                model.Password,
                isPersistent: false,        // session cookie — closes with browser
                lockoutOnFailure: true);    // honor lockout policy on bad password

            // ISSUE #03 — SignInResult branch is NOT logged.
            //   - The original DIAG call logged Succeeded / IsLockedOut /
            //     IsNotAllowed / Requires2FA — that told an attacker which
            //     accounts are locked, which have unconfirmed emails, which
            //     have 2FA enabled. Credential-stuffing goldmine.
            //   - We collapse everything except LockedOut into the
            //     InvalidCredentials outcome. Lockout stays distinct so
            //     SIEM can correlate brute-force attempts; LockoutEnd is
            //     never logged (tells attacker when to retry).

            if (!result.Succeeded)
            {
                // Map Identity's SignInResult to a user-friendly message.
                // We deliberately DON'T distinguish "wrong password" from
                // "user not found" — both return the same generic message
                // to prevent username enumeration.
                if (result.IsLockedOut)
                {
                    AuditLogger.Log(new LoginLogContext
                    {
                        WorkerId = model.WorkerId,
                        Outcome = LoginLogOutcome.LockedOut,
                    });
                    _errorMessage = Loc["Error_LockedOut"];
                }
                else if (result.IsNotAllowed)
                {
                    // IsNotAllowed fires when RequireConfirmedEmail=true
                    // and the user's EmailConfirmed=false. With
                    // RequireConfirmedAccount=false (our config), this
                    // branch is unlikely to fire — but we handle it
                    // defensively in case someone tightens the config.
                    // Collapsed into InvalidCredentials — never logged
                    // separately (would leak account-state intel).
                    AuditLogger.Log(new LoginLogContext
                    {
                        WorkerId = model.WorkerId,
                        Outcome = LoginLogOutcome.InvalidCredentials,
                    });
                    _errorMessage = Loc["Error_NotAllowed"];
                }
                else if (result.RequiresTwoFactor)
                {
                    // 2FA not implemented in v1 (roadmap Section 11).
                    // Collapsed into InvalidCredentials — never logged
                    // separately (would reveal which accounts have 2FA).
                    AuditLogger.Log(new LoginLogContext
                    {
                        WorkerId = model.WorkerId,
                        Outcome = LoginLogOutcome.InvalidCredentials,
                    });
                    _errorMessage = Loc["Error_TwoFactorNotSupported"];
                }
                else
                {
                    AuditLogger.Log(new LoginLogContext
                    {
                        WorkerId = model.WorkerId,
                        Outcome = LoginLogOutcome.InvalidCredentials,
                    });
                    _errorMessage = Loc["Error_InvalidCredentials"];
                }
                return;
            }

            // ISSUE #03 — success is logged AFTER the cookie enrichment
            // step (below), so the audit event includes MustChangePassword.

            // --------------------------------------------------------------
            // 2. Login succeeded. Now enrich the principal with our
            //    custom claims (FullName, GroupName, Gender) so
            //    BlazorCurrentUserService can read them without a DB
            //    lookup on every request.
            //
            //    Technique: SignInManager.SignInWithClaimsAsync re-creates
            //    the auth cookie with the additional claims baked in. The
            //    existing sign-in (from step 1) is replaced atomically —
            //    no race window where the user is signed in but missing
            //    the custom claims.
            //
            //    ISSUE #02 — Force one-time password change on first login:
            //    If the ApplicationUser.MustChangePassword flag is true
            //    (set by DefaultAdminSeeder on the bootstrap admin, OR by
            //    the AddMustChangePasswordFlag migration on every pre-
            //    existing admin), we ALSO add a `must_change_password`
            //    claim to the cookie. The middleware in Program.cs
            //    inspects this claim on every authenticated request and
            //    redirects the user to /Account/ChangePassword — except
            //    for /Account/ChangePassword, /Account/LogOut, and
            //    /Account/Login themselves. The ChangePassword page
            //    clears the flag on the user row and re-issues the cookie
            //    WITHOUT the claim.
            // --------------------------------------------------------------
            var extraClaims = new List<Claim>
            {
                new("FullName", domainUser?.FullName ?? appUser.UserName ?? string.Empty),
            };
            if (domainUser is not null && !string.IsNullOrEmpty(domainUser.GroupName))
            {
                extraClaims.Add(new Claim("GroupName", domainUser.GroupName));
            }
            // Also stash Gender as a claim — cheap to add, useful for the
            // profile page (avoids a DB lookup just to render "Gender: Male").
            extraClaims.Add(new Claim("Gender", domainUser?.Gender.ToString() ?? Gender.Male.ToString()));

            // ISSUE #02 — force one-time password change on first login.
            // The claim is read by the MustChangePasswordRedirectMiddleware
            // in Program.cs. We use "true" (string) as the claim value
            // because Claim values are always strings — the middleware
            // checks `HasClaim("must_change_password", "true")`.
            if (appUser.MustChangePassword)
            {
                extraClaims.Add(new Claim("must_change_password", "true"));
            }

            // Re-sign-in with the enriched principal. The
            // AuthenticationProperties here match what
            // PasswordSignInAsync already used (non-persistent session
            // cookie). We pass isPersistent:false to keep the cookie
            // session-scoped.
            await SignInManager.SignInWithClaimsAsync(
                appUser,
                new AuthenticationProperties { IsPersistent = false },
                extraClaims);

            // ISSUE #03 — success audit event. Logged AFTER the enriched
            // cookie is issued, so the audit record includes the
            // MustChangePassword flag (useful for tracking Issue #02
            // forced-password-change compliance). UserId is logged here
            // because the user is now authenticated — the SIEM can
            // correlate post-login activity with this audit row.
            // On InvalidCredentials (above), UserId is deliberately
            // absent: an attacker submitting random WorkerIds must not
            // learn which ones resolve to valid Guids.
            AuditLogger.Log(new LoginLogContext
            {
                WorkerId = model.WorkerId,
                Outcome = LoginLogOutcome.Success,
                UserId = appUser.Id,
                MustChangePassword = appUser.MustChangePassword,
            });

            // --------------------------------------------------------------
            // 3. Role-aware redirect.
            //
            //    Per roadmap Section 12.8:
            //      Admin/Manager/Employee/ReadOnly → /  (Dashboard)
            //      Customer                          → /Products
            //
            //    If a returnUrl was supplied (user was redirected from
            //    a protected page), honor it INSTEAD of the role-aware
            //    default — UNLESS the returnUrl is the login page itself
            //    (which would create an infinite redirect loop).
            //
            //    ISSUE #02 OVERRIDE: if MustChangePassword is true, we
            //    redirect to /Account/ChangePassword regardless of role
            //    or returnUrl. The MustChangePassword middleware would
            //    redirect them there on the very next request anyway,
            //    but doing it here avoids an extra round-trip and gives
            //    the user immediate visual feedback.
            //
            //    forceLoad:true is CRITICAL — it forces a full HTTP
            //    round-trip so the new cookie is visible to Blazor's
            //    circuit. Without it, Blazor would try to handle the
            //    navigation client-side via SignalR, the circuit would
            //    still see the pre-login auth state, and the user would
            //    bounce back to /Account/Login.
            // --------------------------------------------------------------
            string target;
            if (appUser.MustChangePassword)
            {
                // Force password change first — role-aware landing page
                // and any returnUrl are deferred until after the change.
                target = "/Account/ChangePassword";
            }
            else
            {
                var returnUrl = httpContext.Request.Query["returnUrl"].ToString();
                var principalForRedirect = await CreateUserPrincipalWithRolesAsync(appUser);
                target = !string.IsNullOrEmpty(returnUrl) && IsSafeReturnUrl(returnUrl)
                    ? returnUrl
                    : GetRoleAwareLandingUrl(principalForRedirect);
            }

            // ISSUE #03 — NavigateTo target is NOT logged.
            //   - Logging the target URL leaks whether the user has the
            //     Customer role (target=/Products) vs. staff role (target=/)
            //     vs. forced-change flow (target=/Account/ChangePassword).
            //     That's role-state intel — useful for an attacker deciding
            //     which compromised accounts are worth pursuing.
            //   - The success audit event above already records everything
            //     the SIEM needs.
            Navigation.NavigateTo(target, forceLoad: true);
        }
        catch (Exception ex)
        {
            // Defensive: any unexpected error → generic message. Don't
            // leak exception details to the user.
            // ISSUE #03 — only the exception TYPE NAME is logged. The
            // message may contain PII or config details; the stack trace
            // leaks internal structure. The full exception is available
            // in the developer's local debugger; production logs get
            // only the classification.
            AuditLogger.Log(new LoginLogContext
            {
                WorkerId = model.WorkerId,
                Outcome = LoginLogOutcome.Exception,
                ExceptionTypeName = ex.GetType().Name,
            });
            _errorMessage = Loc["Error_Unexpected"];
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    /// <summary>
    /// Resolves the role-aware landing URL for the given principal.
    /// </summary>
    private static string GetRoleAwareLandingUrl(ClaimsPrincipal principal)
    {
        // Customer → /Products (no dashboard for customers — they
        // redirect to the catalog after login).
        // Everyone else (Admin/Manager/Employee/ReadOnly) → / (Dashboard).
        if (principal.IsInRole(Roles.Customer))
        {
            return "/Products";
        }
        return "/";
    }

    /// <summary>
    /// Builds a temporary ClaimsPrincipal that includes the user's roles,
    /// for the sole purpose of evaluating the role-aware redirect target.
    ///
    /// We can't use the just-signed-in principal from HttpContext because
    /// at this point in the request, the cookie has been written to the
    /// response but HttpContext.User still reflects the pre-sign-in state.
    /// So we build a fresh principal from UserManager's role list.
    /// </summary>
    private async Task<ClaimsPrincipal> CreateUserPrincipalWithRolesAsync(ApplicationUser appUser)
    {
        var roles = await UserManager.GetRolesAsync(appUser);

        var claims = new List<Claim>
        {
            new(ClaimTypes.NameIdentifier, appUser.Id.ToString()),
            new(ClaimTypes.Name, appUser.UserName ?? string.Empty),
        };
        claims.AddRange(roles.Select(r => new Claim(ClaimTypes.Role, r)));

        var identity = new ClaimsIdentity(claims, "TakOneLogin");
        return new ClaimsPrincipal(identity);
    }

    /// <summary>
    /// Open-redirect defense. Only allow return URLs that are RELATIVE
    /// (start with / but not //). Absolute URLs or protocol-relative
    /// URLs could be used to redirect the user to a phishing site
    /// after a successful login.
    /// </summary>
    private static bool IsSafeReturnUrl(string returnUrl)
    {
        if (string.IsNullOrWhiteSpace(returnUrl)) return false;
        if (!returnUrl.StartsWith('/')) return false;
        if (returnUrl.StartsWith("//")) return false; // protocol-relative
        if (returnUrl.StartsWith("/\\", StringComparison.OrdinalIgnoreCase)) return false;
        // Don't allow redirect back to the login page itself — would loop.
        if (returnUrl.StartsWith("/Account/Login", StringComparison.OrdinalIgnoreCase)) return false;
        return true;
    }
}