@* ResetPassword.razor — Phase 1.5
   Static-rendered "Reset Password" page. Reached via the link in the
   (currently dev-logged) password-reset email:
     /Account/ResetPassword?email=...&token=...

   WHY STATIC SSR (not a Blazor circuit):
     Same reason as Login.razor — the page handles a form POST and
     re-renders the result in the same HTTP response. No interactive
     circuit needed.

   FLOW:
     1. User clicks the reset link in their email. The URL contains
        `email` and `token` query parameters (both URL-encoded by
        QueryHelpers.AddQueryString in ForgotPassword.razor).
     2. We read both via [SupplyParameterFromQuery].
     3. If EITHER is missing or whitespace, the link is invalid —
        show "invalid reset link" error and don't render the form.
     4. Otherwise, render the form (New Password + Confirm Password).
        The email field is shown read-only so the user knows which
        account they're resetting.
     5. On submit, call IUserAccountService.ResetPasswordFromTokenAsync.
        - On success: show success message + redirect to /Account/Login
          after a short delay.
        - On failure: show the Identity error message (typically
          "Invalid token" for expired/used tokens, or a complexity
          message for weak passwords).

   TOKEN LIFESPAN + REUSE:
     Identity's DataProtectorTokenProvider issues tokens with a 24h
     default lifespan (configurable via TokenLifespan in
     IdentityOptions.Tokens). Each token is single-use: once
     UserManager.ResetPasswordAsync succeeds, the SecurityStamp is
     rotated, which invalidates any other outstanding tokens for
     that user.

   ANTI-FORGERY:
     EditForm emits the antiforgery token automatically. The
     UseAntiforgery middleware in Program.cs validates it on POST. *@

@page "/Account/ResetPassword"
@layout LoginLayout
@using System.ComponentModel.DataAnnotations
@using Microsoft.Extensions.Logging
@using Microsoft.Extensions.Localization
@using TakOne.Application.Common.Interfaces
@inject IUserAccountService UserAccountService
@inject ILoggerFactory LoggerFactory
@inject NavigationManager Navigation
@inject IHttpContextAccessor HttpContextAccessor
@inject IStringLocalizerFactory LocalizerFactory

<PageTitle>@_loc["PageTitle"]</PageTitle>

<RadzenStack Orientation="Orientation.Vertical" Gap="1rem" Style="max-width: 360px; margin: 0 auto;">
    @* --- Invalid-link banner (email or token missing on the query string) --- *@
    @if (_showInvalidLinkError)
    {
        <RadzenAlert Title="@_loc["ErrorTitle"]"
                     Text="@_loc["Error_InvalidLink"]"
                     AlertStyle="AlertStyle.Danger"
                     Variant="Variant.Filled"
                     ShowIcon="true" />

        <RadzenStack Orientation="Orientation.Horizontal"
                     JustifyContent="JustifyContent.Center">
            <RadzenLink Text="@_loc["BackToLogin"]"
                        Path="/Account/Login"
                        Icon="arrow_back" />
        </RadzenStack>
    }
    else if (_showSuccess)
    {
        @* --- Success banner (after a successful password reset) --- *@
        <RadzenAlert Title="@_loc["SuccessTitle"]"
                     Text="@_loc["SuccessMessage"]"
                     AlertStyle="AlertStyle.Success"
                     Variant="Variant.Filled"
                     ShowIcon="true" />

        <RadzenStack Orientation="Orientation.Horizontal"
                     JustifyContent="JustifyContent.Center">
            <RadzenButton Text="@_loc["GoToLoginButton"]"
                          ButtonStyle="ButtonStyle.Primary"
                          Variant="Variant.Filled"
                          Icon="login"
                          Click="@GoToLogin" />
        </RadzenStack>
    }
    else
    {
        @* --- Error banner (token invalid/expired OR password complexity failure) --- *@
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <RadzenAlert Title="@_loc["ErrorTitle"]"
                         Text="@_errorMessage"
                         AlertStyle="AlertStyle.Danger"
                         Variant="Variant.Filled"
                         ShowIcon="true" />
        }

        <RadzenText Text="@_loc["IntroText"]"
                    Style="color: var(--rz-text-secondary-color); font-size: 0.9rem;" />

        @* --- Read-only email display ---
           We render the email as static text (NOT a read-only form field)
           so the user can see WHICH account they're resetting, but can't
           try to "fix" it (the email is bound to the token — changing
           it would invalidate the link anyway).

           Using `RadzenText` (not a form input) avoids any ambiguity about
           whether `ReadOnly` is a valid parameter on `RadzenTextBox` in
           Radzen.Blazor v11.1.1 — and is cleaner UX to boot. *@
        <RadzenCard Variant="Variant.Text" Style="padding: 0.5rem 0.75rem; background: var(--rz-base-background-color);">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenIcon Icon="mail_outline" Style="color: var(--rz-text-secondary-color); font-size: 1.1rem;" />
                <RadzenStack Orientation="Orientation.Vertical" Gap="0">
                    <span style="font-size: 0.75rem; color: var(--rz-text-secondary-color);">@_loc["EmailLabel"]</span>
                    <span style="font-weight: 500;">@Email</span>
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>

        <EditForm Model="@FormModel" OnValidSubmit="@HandleResetPasswordAsync" FormName="resetPasswordForm">
            <DataAnnotationsValidator />

            <RadzenStack Orientation="Orientation.Vertical" Gap="0.75rem">
                @* NOTE on `autofocus` + `FormModel!`:
                   Same pattern as Login.razor — see that file for the
                   full explanation. `RadzenTextBox` (and `RadzenPassword`)
                   have NO `AutoFocus` parameter in Radzen.Blazor v11.1.1,
                   so bare `autofocus` HTML attribute is the only way to
                   autofocus on a static-SSR page. `FormModel!` suppresses
                   CS8602 since `FormModel` is `ResetPasswordModel?`. *@
                <RadzenFormField Text="@_loc["NewPasswordLabel"]">
                    <RadzenPassword @bind-Value="FormModel!.NewPassword"
                                    Placeholder="@_loc["NewPasswordPlaceholder"]"
                                    autocomplete="new-password"
                                    autofocus />
                </RadzenFormField>

                <RadzenFormField Text="@_loc["ConfirmPasswordLabel"]">
                    <RadzenPassword @bind-Value="FormModel!.ConfirmPassword"
                                    Placeholder="@_loc["ConfirmPasswordPlaceholder"]"
                                    autocomplete="new-password" />
                </RadzenFormField>

                @* Password complexity hint — helps the user meet the
                   Identity complexity rules configured in appsettings.json
                   (8+ chars, upper + lower + digit + non-alphanumeric).
                   We don't dynamically validate these on the client — the
                   user just sees the rules and Identity enforces them
                   server-side. *@
                <RadzenText Text="@_loc["PasswordRequirements"]"
                            Style="color: var(--rz-text-secondary-color); font-size: 0.8rem; line-height: 1.4;" />

                <RadzenButton Text="@_loc["SubmitButton"]"
                              ButtonType="ButtonType.Submit"
                              ButtonStyle="ButtonStyle.Primary"
                              Variant="Variant.Filled"
                              Icon="lock_reset"
                              Disabled="@_isSubmitting"
                              Style="width: 100%;" />
            </RadzenStack>
        </EditForm>
    }
</RadzenStack>

@code {
    /// <summary>
    /// Form model for the reset password form. NewPassword uses [Required]
    /// + [StringLength] with minimum 8 chars (matches appsettings.json
    /// Identity:Password:RequiredLength=8). ConfirmPassword uses [Compare]
    /// to enforce equality with NewPassword — Blazor's validation
    /// infrastructure surfaces the comparison error automatically.
    /// </summary>
    private sealed class ResetPasswordModel
    {
        [Required(ErrorMessage = "New password is required.")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "Password must be at least 8 characters long.")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please confirm your new password.")]
        [Compare(nameof(NewPassword), ErrorMessage = "The passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    /// <summary>
    /// Populated from the query string by Blazor's
    /// [SupplyParameterFromQuery] mechanism. The ForgotPassword page
    /// builds the URL via QueryHelpers.AddQueryString, which URL-encodes
    /// both values; Blazor auto-decodes them when populating these
    /// properties.
    /// </summary>
    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    [SupplyParameterFromForm]
    private ResetPasswordModel? FormModel { get; set; }

    // Logger + localizer created via the *Factory abstractions rather than
    // ILogger<ResetPassword>/IStringLocalizer<ResetPassword>. Reason: the
    // generic-self-reference pattern (`ILogger<T>` where T is the page's own
    // type) was producing CS0246 "type ResetPassword could not be found"
    // on this specific page — likely a Razor source-generator quirk in the
    // .NET 10 preview when the page also uses [SupplyParameterFromQuery]
    // on public properties. The factory-based approach sidesteps the issue
    // entirely: the @inject lines reference only BCL types, and the page's
    // own type is never used as a generic argument. Functionally identical
    // — the logger gets the same category name, and the localizer loads
    // the same resource file (Looked up by base name + assembly).
    private ILogger _logger = default!;
    private IStringLocalizer _loc = default!;

    private bool _showInvalidLinkError;
    private bool _showSuccess;
    private string _errorMessage = string.Empty;
    private bool _isSubmitting;

    protected override void OnInitialized()
    {
        _logger = LoggerFactory.CreateLogger("ResetPassword");
        _loc = LocalizerFactory.Create("ResetPassword", "TakOne.WebUI");
        FormModel ??= new ResetPasswordModel();

        // --------------------------------------------------------------
        // Validate the query string parameters. The reset link must
        // contain BOTH email AND token. If either is missing/whitespace,
        // the link is invalid (probably the user typed it manually or
        // the email client mangled it). We show a generic "invalid link"
        // message and don't render the form.
        //
        // ENUMERATION DEFENSE: we DON'T check whether the email is
        // registered here — that would let an attacker probe emails by
        // crafting reset links and observing the response. The actual
        // validity check happens in ResetPasswordFromTokenAsync, which
        // returns the same "Invalid reset link" message for "user not
        // found" and "invalid token" cases.
        // --------------------------------------------------------------
        if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Token))
        {
            _showInvalidLinkError = true;
            return;
        }

        // If the user is already authenticated, redirect to home —
        // they don't need to reset their password (they're already in).
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext?.User?.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/", forceLoad: true);
            return;
        }
    }

    private async Task HandleResetPasswordAsync()
    {
        var model = FormModel!;
        _isSubmitting = true;
        _errorMessage = string.Empty;

        try
        {
            // Defensive — should be caught by the form validation above,
            // but the query params could have been tampered with between
            // page load and form submit. Re-check.
            if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Token))
            {
                _showInvalidLinkError = true;
                return;
            }

            var result = await UserAccountService.ResetPasswordFromTokenAsync(
                Email!,
                Token!,
                model.NewPassword);

            if (result.IsSuccess)
            {
                _showSuccess = true;
                // No automatic redirect — let the user click "Go to Login".
                // (Auto-redirect would be jarring if they want to read the
                // success message first. The button is right there.)
                _logger.LogInformation(
                    "ResetPassword: password successfully reset for email '{Email}'.",
                    Email);
            }
            else
            {
                // Identity's error message — already localized by the
                // IdentityErrorDescriber. For token failures, it'll say
                // something like "Invalid token." For password complexity
                // failures, it'll say "Passwords must have at least one
                // digit ('0'-'9')." etc.
                //
                // Result.Error is non-null when IsFailure is true (enforced
                // by Result's constructor), so we can assign directly.
                _errorMessage = result.Error;
                _logger.LogWarning(
                    "ResetPassword: reset failed for email '{Email}'. Error: {Error}.",
                    Email, _errorMessage);
            }
        }
        catch (Exception ex)
        {
            _logger.LogError(ex,
                "ResetPassword: unexpected error resetting password for email '{Email}'.",
                Email);
            _errorMessage = _loc["Error_Unexpected"];
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void GoToLogin()
    {
        // forceLoad:true so the browser does a fresh HTTP request — the
        // user's pre-reset cookie (if any) is gone (SecurityStamp rotated)
        // and they need to re-authenticate.
        Navigation.NavigateTo("/Account/Login", forceLoad: true);
    }
}