@using TakOne.WebUI.Components
@using System.Globalization

@* <html> lang/dir are DYNAMIC: Persian (fa-IR) → RTL, English (en-US) → LTR.
   The previous version hardcoded `lang="fa" dir="rtl"` so English mode
   still rendered right-to-left, which is wrong. Reading from
   CultureInfo.CurrentUICulture means the attributes are correct on the
   very first server render (the localization middleware has already
   set CurrentUICulture based on the cookie/query-string/default before
   App.razor renders).

   - TwoLetterISOLanguageName → "fa" for fa-IR, "en" for en-US
   - TextInfo.IsRightToLeft  → true for fa-IR (Persian is RTL),
                                false for en-US (English is LTR) *@
<!DOCTYPE html>
<html lang="@HtmlLang" dir="@HtmlDir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    <RadzenTheme Theme="standard-dark" />

    <link rel="stylesheet" href="_content/Radzen.Blazor/Radzen.Blazor.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="css/Pages/Products.css?v=5" />
    <link rel="stylesheet" href="TakOne.WebUI.styles.css" />
    <link rel="icon" type="image/png" href="TakLogo.png" />

    @* FOUC-prevention script — extracted to wwwroot/js/theme.js.
       Runs synchronously in <head>. With <RadzenTheme> above, the theme
       <link> is injected by Blazor's HeadOutlet AFTER hydration — so this
       script uses a MutationObserver to detect when the link appears, then
       swaps its href to the saved theme (and layers the tak-light override
       on top if needed). The ?v=11 cache-bust forces the browser to fetch
       the latest theme.js (previous versions had different logic). *@
    <script src="js/theme.js?v=11"></script>

    @* SignalR client + our hub bridge. Loaded in <head> so it's ready
       before any page tries to call notificationHub.start(). *@
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="js/notificationHub.js?v=10"></script>

    @* Shop page (Products) — Ctrl+F focuses the search bar (replaces the
        HTML's Ctrl+K binding). Registered globally; the listener only
        intercepts when the shop search input is present, so other pages
        keep the browser's native find-in-page behavior. *@
    <script src="js/products.js?v=3"></script>

    <HeadOutlet @rendermode="@RenderModeForPage" />
</head>
<body>
    <Routes @rendermode="@RenderModeForPage" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js"></script>
</body>
</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    /// <summary>
    /// Two-letter ISO language code for the current UI culture ("fa" or "en").
    /// Used for the &lt;html lang="..."&gt; attribute. Reading from
    /// CurrentUICulture (not a hardcoded value) means the attribute is
    /// correct on the very first server render after the localization
    /// middleware has set the culture.
    /// </summary>
    private string HtmlLang => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    /// <summary>
    /// "rtl" for right-to-left scripts (Persian, Arabic, Hebrew, etc.),
    /// "ltr" for left-to-right scripts (English, etc.). Uses
    /// CultureInfo.TextInfo.IsRightToLeft which is populated from the
    /// culture's satellite data — no hardcoded culture→direction mapping
    /// needed, so this works automatically if more cultures are added
    /// later (e.g. ar-SA would also get RTL).
    /// </summary>
    private string HtmlDir => CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "rtl" : "ltr";

    /// <summary>
    /// Account pages (login, logout, access-denied) render STATICALLY (no
    /// SignalR circuit) so that the cookie redirect actually takes effect
    /// on the very first response — Blazor's interactive mode would buffer
    /// the response and the cookie wouldn't be visible until a full reload.
    /// Everything else renders interactively (InteractiveServer).
    /// </summary>
    private IComponentRenderMode? RenderModeForPage =>
        HttpContext.Request.Path.StartsWithSegments("/Account")
            ? null
            : InteractiveServer;
}