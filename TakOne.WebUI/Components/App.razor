@using TakOne.WebUI.Components
@using System.Globalization

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentCulture.Name" dir="@(
      CultureInfo.CurrentCulture.TextInfo.IsRightToLeft ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <RadzenTheme theme="standard-dark" />
    <link rel="stylesheet" href="_content/Radzen.Blazor/Radzen.Blazor.css" />
    <link rel="stylesheet" href="css/app.css" />
    <link rel="stylesheet" href="TakOne.WebUI.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />

    @* FOUC-prevention script — extracted to wwwroot/js/theme.js (roadmap Phase 0.5).
       Runs synchronously before the browser paints a single pixel. The
       RadzenTheme component above already injected the standard-dark
       <link> in the DOM, so querySelector finds it instantly and swaps
       the href to the user's saved theme. This avoids the flash of the
       default theme that would otherwise appear for ~50ms. *@
    <script src="js/theme.js"></script>

    @* SignalR client + our hub bridge (roadmap Phase 0.6). Loaded in <head>
       so it's ready before any page tries to call notificationHub.start(). *@
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="js/notificationHub.js"></script>

    <HeadOutlet @rendermode="@RenderModeForPage" />
</head>
<body>
    <Routes @rendermode="@RenderModeForPage" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js"></script>
</body>
</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    /// <summary>
    /// Account pages (login, logout, access-denied) render STATICALLY (no
    /// SignalR circuit) so that the cookie redirect actually takes effect
    /// on the very first response — Blazor's interactive mode would buffer
    /// the response and the cookie wouldn't be visible until a full reload.
    /// Everything else renders interactively (InteractiveServer).
    /// </summary>
    private IComponentRenderMode? RenderModeForPage =>
        HttpContext.Request.Path.StartsWithSegments("/Account")
            ? null
            : InteractiveServer;
}