    @* Chart.js — VENDORED locally (same pattern as SignalR).
       Used by the redesigned Dashboard page (Dashboard.razor) for the
       4 charts (line, donut, bar, pie). dashboard.js (below) wraps the
       Chart.js global and exposes window.takDashboard.render(data).
       Cache-bust via ?v=4.4.0 so future upgrades force a re-fetch. *@
    <script src="lib/chartjs/chart.umd.min.js?v=4.4.0"></script>

    @* Dashboard chart initializer — wraps Chart.js with the Tak Makaron
       dark palette + Persian digit tooltips. Loaded globally; only
       invokes when the dashboard calls window.takDashboard.render().

       v5 cache-bust: added empty-state handling for all 4 charts so a
       fresh install with no sales data shows a friendly "no data yet"
       message instead of blank chart areas. Without this cache-bust the
       browser would keep serving the old v4 JS which silently renders
       empty Chart.js instances on canvases that have no data — looking
       identical to a broken chart.

       v6 cache-bust: fixed "[object Object]" showing in the line, donut
       and bar chart tooltips. Root cause was on the .NET side (Loc[...]
       returns LocalizedString structs that System.Text.Json serializes
       as JSON objects, not strings) — that's now fixed in Dashboard.razor
       via .Value. This JS-side bump adds an asStr() defensive helper
       that unwraps any LocalizedString-shaped object just in case a
       future razor change forgets `.Value` again. Without this cache-bust
       the browser would keep serving the old v5 JS which has no asStr()
       safety net. *@
    <script src="js/dashboard.js?v=6"></script>

    @* Admin Categories page — measures node positions in the horizontal
        category tree and returns SVG bezier path data for the connector
        lines between parent and child nodes. Used by AdminCategories.razor.
        Re-measures on resize and on language/dir change.

        v6 cache-bust: made bindRedraw idempotent — it now disconnects
        all previous observers before creating new ones, preventing
        MutationObserver leaks when the user switches between Tree and
        List views. Without this cache-bust the browser would keep
        serving the old v5 JS which leaks a MutationObserver on
        document.documentElement every time the user switches views. *@
    <script src="js/adminCategoriesTree.js?v=6"></script>

    @* Download helper (Round 3 CSV exports): Blob + object-URL + synthetic
        click persistence for files built in .NET (Blazor Server circuits
        have no HttpResponse to stream through). takDownload.csv prepends
        the UTF-8 BOM so Excel opens Persian text correctly. See
        wwwroot/js/download.js. *@
    <script src="js/download.js?v=1"></script>

    <HeadOutlet @rendermode="@RenderModeForPage" />
</head>
<body>
    <Routes @rendermode="@RenderModeForPage" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js"></script>
</body>
</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    /// <summary>
    /// Two-letter ISO language code for the current UI culture ("fa" or "en").
    /// Used for the &lt;html lang="..."&gt; attribute. Reading from
    /// CurrentUICulture (not a hardcoded value) means the attribute is
    /// correct on the very first server render after the localization
    /// middleware has set the culture.
    /// </summary>
    private string HtmlLang => CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    /// <summary>
    /// "rtl" for right-to-left scripts (Persian, Arabic, Hebrew, etc.),
    /// "ltr" for left-to-right scripts (English, etc.). Uses
    /// CultureInfo.TextInfo.IsRightToLeft which is populated from the
    /// culture's satellite data — no hardcoded culture→direction mapping
    /// needed, so this works automatically if more cultures are added
    /// later (e.g. ar-SA would also get RTL).
    /// </summary>
    private string HtmlDir => CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "rtl" : "ltr";

    /// <summary>
    /// Account pages (login, logout, access-denied) render STATICALLY (no
    /// SignalR circuit) so that the cookie redirect actually takes effect
    /// on the very first response — Blazor's interactive mode would buffer
    /// the response and the cookie wouldn't be visible until a full reload.
    /// Everything else renders interactively (InteractiveServer).
    /// </summary>
    private IComponentRenderMode? RenderModeForPage =>
        HttpContext.Request.Path.StartsWithSegments("/Account")
            ? null
            : InteractiveServer;
}