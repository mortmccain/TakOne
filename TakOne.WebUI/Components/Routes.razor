@using Microsoft.AspNetCore.Components.Authorization
@using TakOne.WebUI.Components

<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                @* Round 18-A / Brutal Review Fix #33: NotAuthorized fires for
                   TWO distinct cases:
                     (a) UNAUTHENTICATED user — bounce to /Account/Login.
                     (b) AUTHENTICATED-but-unauthorized user — must go to
                         /Account/AccessDenied, NOT /Account/Login. An
                         authenticated Customer hitting / (Dashboard) was
                         previously bounced to /Account/Login, which saw
                         they were authenticated and redirected them to
                         /Products — broken UX (looked like a redirect
                         loop). Now: authenticated+unauthorized →
                         RedirectToAccessDenied → /Account/AccessDenied
                         (a proper 403 page). The AuthenticationState
                         is exposed via the Context parameter. *@
                <NotAuthorized Context="authState">
                    @if (authState.User.Identity?.IsAuthenticated == true)
                    {
                        <RedirectToAccessDenied />
                    }
                    else
                    {
                        <RedirectToLogin />
                    }
                </NotAuthorized>
                <Authorizing>
                    <div class="d-flex justify-content-center align-items-center" style="height: 100vh;">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Not Found</PageTitle>
            <LayoutView Layout="typeof(Layout.MainLayout)">
                <div class="alert alert-warning m-4">
                    <h4>Page Not Found</h4>
                    <p>The page you requested does not exist.</p>
                </div>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>