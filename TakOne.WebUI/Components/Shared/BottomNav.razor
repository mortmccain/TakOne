@* BottomNav.razor — role-aware bottom navigation bar for mobile pages.
   Renders different nav items based on:
     1. The user's role (Customer vs Admin/Manager/Employee)
     2. The current page (which "section" they're in)

   CUSTOMER (always 4 items):
     Products | My Orders | Cart | Settings

   ADMIN/MANAGER/EMPLOYEE — items change based on current page:
     In Dashboard:     Dashboard(selected) | Products | Admin Products | Admin Users | Settings
     In Products:      Dashboard | Products(selected) | Orders | Cart | Settings
     In Admin Products: Dashboard | Admin Products(selected) | Admin Categories | Settings
     In Admin Users:   Dashboard | Admin Users(selected) | Customer Groups | Settings

   The "section" is determined by the current URL path.
*@

@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@using System.Security.Claims
@using TakOne.Application.Common.Authorization

<nav class="bottom-nav">
    @foreach (var item in _navItems)
    {
        <a href="@item.Href"
           class="nav-item @(item.IsActive ? "active" : "")"
           @onclick:preventDefault
           @onclick="() => NavigateTo(item.Href)">
            <div class="nav-indicator"></div>
            @if (item.ShowBadge)
            {
                <div class="nav-icon-wrapper">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        @item.SvgPath
                    </svg>
                    <span class="nav-badge">۵</span>
                </div>
            }
            else
            {
                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    @item.SvgPath
                </svg>
            }
            <span class="nav-label">@item.Label</span>
        </a>
    }
</nav>

@code {
    private List<NavItem> _navItems = new();

    private bool _isAdmin;
    private bool _isManager;
    private bool _isEmployee;
    private bool _isCustomer;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            _isAdmin = user.IsInRole(Roles.Admin);
            _isManager = user.IsInRole(Roles.Manager);
            _isEmployee = user.IsInRole(Roles.Employee);
            _isCustomer = user.IsInRole(Roles.Customer) && !_isAdmin && !_isManager && !_isEmployee;
        }
        catch { }

        BuildNavItems();
    }

    private void BuildNavItems()
    {
        _navItems.Clear();

        var currentPath = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0];
        // Normalize: remove leading slash, trailing slash
        currentPath = currentPath.Trim('/').TrimEnd('/');

        if (_isCustomer)
        {
            // Customer always sees the same 4 items regardless of page
            _navItems.Add(new NavItem("Products", "/m/Products", NavIcon.Products, IsActive(currentPath, "m/Products")));
            _navItems.Add(new NavItem("My Orders", "/Sales", NavIcon.Orders, IsActive(currentPath, "Sales")));
            _navItems.Add(new NavItem("Cart", "/Cart", NavIcon.Cart, IsActive(currentPath, "Cart"), ShowBadge: true));
            _navItems.Add(new NavItem("Settings", "/Settings", NavIcon.Profile, IsActive(currentPath, "Settings")));
        }
        else
        {
            // Staff: determine which "section" based on current path
            if (IsActive(currentPath, "m/Dashboard") || currentPath == "" || currentPath == "/")
            {
                // Dashboard section
                _navItems.Add(new NavItem("Dashboard", "/", NavIcon.Dashboard, true));
                _navItems.Add(new NavItem("Products", "/m/Products", NavIcon.Products, false));
                _navItems.Add(new NavItem("Admin Products", "/Admin/Products", NavIcon.AdminProducts, false));
                _navItems.Add(new NavItem("Admin Users", "/Admin/Users", NavIcon.AdminUsers, false));
                _navItems.Add(new NavItem("Settings", "/Settings", NavIcon.Profile, false));
            }
            else if (IsActive(currentPath, "m/Products") || IsActive(currentPath, "Products"))
            {
                // Products section
                _navItems.Add(new NavItem("Dashboard", "/", NavIcon.Dashboard, false));
                _navItems.Add(new NavItem("Products", "/m/Products", NavIcon.Products, true));
                _navItems.Add(new NavItem("Orders", "/Sales", NavIcon.Orders, false));
                _navItems.Add(new NavItem("Cart", "/Cart", NavIcon.Cart, false, ShowBadge: true));
                _navItems.Add(new NavItem("Settings", "/Settings", NavIcon.Profile, false));
            }
            else if (IsActive(currentPath, "Admin/Products"))
            {
                // Admin Products section
                _navItems.Add(new NavItem("Dashboard", "/", NavIcon.Dashboard, false));
                _navItems.Add(new NavItem("Admin Products", "/Admin/Products", NavIcon.AdminProducts, true));
                _navItems.Add(new NavItem("Admin Categories", "/Admin/Categories", NavIcon.AdminCategories, false));
                _navItems.Add(new NavItem("Settings", "/Settings", NavIcon.Profile, false));
            }
            else if (IsActive(currentPath, "Admin/Users"))
            {
                // Admin Users section
                _navItems.Add(new NavItem("Dashboard", "/", NavIcon.Dashboard, false));
                _navItems.Add(new NavItem("Admin Users", "/Admin/Users", NavIcon.AdminUsers, true));
                _navItems.Add(new NavItem("Customer Groups", "/Admin/Groups", NavIcon.CustomerGroups, false));
                _navItems.Add(new NavItem("Settings", "/Settings", NavIcon.Profile, false));
            }
            else
            {
                // Fallback for other pages (Sales, Cart, Settings, etc.)
                _navItems.Add(new NavItem("Dashboard", "/", NavIcon.Dashboard, IsActive(currentPath, "")));
                _navItems.Add(new NavItem("Products", "/m/Products", NavIcon.Products, false));
                _navItems.Add(new NavItem("Orders", "/Sales", NavIcon.Orders, IsActive(currentPath, "Sales")));
                _navItems.Add(new NavItem("Cart", "/Cart", NavIcon.Cart, IsActive(currentPath, "Cart"), ShowBadge: true));
                _navItems.Add(new NavItem("Settings", "/Settings", NavIcon.Profile, IsActive(currentPath, "Settings")));
            }
        }
    }

    private static bool IsActive(string currentPath, string checkPath)
    {
        currentPath = currentPath.Trim('/').TrimEnd('/').ToLowerInvariant();
        checkPath = checkPath.Trim('/').TrimEnd('/').ToLowerInvariant();
        if (string.IsNullOrEmpty(checkPath)) return string.IsNullOrEmpty(currentPath);
        return currentPath == checkPath || currentPath.StartsWith(checkPath + "/", StringComparison.OrdinalIgnoreCase);
    }

    private void NavigateTo(string href)
    {
        Navigation.NavigateTo(href, forceLoad: false);
    }

    // ── Data structures ─────────────────────────────────────────────────

    private sealed record NavItem(
        string Label,
        string Href,
        Microsoft.AspNetCore.Components.MarkupString SvgPath,
        bool IsActive,
        bool ShowBadge = false);

