@* BottomNav.razor — role-aware bottom navigation bar for mobile pages.
   Renders different nav items based on:
     1. The user's role (Customer vs Admin/Manager/Employee)
     2. The current page (which "section" they're in)

   CUSTOMER (always 4 items):
     Products | My Orders | Cart | Settings

   ADMIN/MANAGER/EMPLOYEE — items change based on current page:
     In Dashboard:     Dashboard(selected) | Products | Admin Products | Admin Users | Settings
     In Products:      Dashboard | Products(selected) | Orders | Cart | Settings
     In Admin Products: Dashboard | Admin Products(selected) | Admin Categories | Settings
     In Admin Users:   Dashboard | Admin Users(selected) | Customer Groups | Settings

   The "section" is determined by the current URL path.
*@

@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject Microsoft.Extensions.Localization.IStringLocalizer<BottomNav> Loc
@using TakOne.Application.Common.Authorization
@using TakOne.WebUI.Services

<nav class="bottom-nav">
    @foreach (var item in _navItems)
    {
        <a href="@item.Href"
           class="nav-item @(item.IsActive ? "active" : "")"
           @onclick:preventDefault
           @onclick="() => NavigateTo(item.Href)">
            <div class="nav-indicator"></div>
            @if (item.ShowBadge && CartCount > 0)
            {
                <div class="nav-icon-wrapper">
                    <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        @item.SvgPath
                    </svg>
                    <span class="nav-badge">@CultureFormat.FormatNumber(CartCount)</span>
                </div>
            }
            else
            {
                <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    @item.SvgPath
                </svg>
            }
            <span class="nav-label">@item.Label</span>
        </a>
    }
</nav>

@code {
    [Parameter] public int CartCount { get; set; }

    private List<NavItem> _navItems = new();

    private bool _isAdmin;
    private bool _isManager;
    private bool _isEmployee;
    private bool _isCustomer;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            _isAdmin = user.IsInRole(Roles.Admin);
            _isManager = user.IsInRole(Roles.Manager);
            _isEmployee = user.IsInRole(Roles.Employee);
            _isCustomer = user.IsInRole(Roles.Customer) && !_isAdmin && !_isManager && !_isEmployee;
        }
        catch { }

        BuildNavItems();
    }

    private void BuildNavItems()
    {
        _navItems.Clear();

        var currentPath = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0];
        // Normalize: remove leading slash, trailing slash
        currentPath = currentPath.Trim('/').TrimEnd('/');

        // Normalize the current path so both desktop (e.g. "Sales") and
        // mobile (e.g. "m/Sales") routes resolve to the same section. The
        // nav-bar logic keys off section, not exact URL, so the bar shows the
        // correct set of items + active state whichever route the user is on.
        var section = NormalizeSection(currentPath);

        if (_isCustomer)
        {
            // Customer always sees the same 4 items regardless of page.
            // All hrefs point to mobile routes so a tap keeps the user on a
            // mobile page (no full-page redirect bounce).
            _navItems.Add(new NavItem(Loc["Products"], "/m/Products", NavIcon.Products, section == "products"));
            _navItems.Add(new NavItem(Loc["MyOrders"], "/m/Sales", NavIcon.Orders, section == "sales"));
            _navItems.Add(new NavItem(Loc["Cart"], "/m/Cart", NavIcon.Cart, section == "cart", ShowBadge: true));
            _navItems.Add(new NavItem(Loc["Settings"], "/m/Settings", NavIcon.Profile, section == "settings"));
        }
        else
        {
            // Staff: determine which "section" based on current path.
            // Per the plan, the lower bar's contents change depending on
            // which area the staff member is currently viewing.
            if (section == "dashboard")
            {
                // In Dashboard: Dashboard(sel) | Products | Admin Products | Admin Users | Settings
                _navItems.Add(new NavItem(Loc["Dashboard"], "/", NavIcon.Dashboard, true));
                _navItems.Add(new NavItem(Loc["Products"], "/m/Products", NavIcon.Products, false));
                _navItems.Add(new NavItem(Loc["AdminProducts"], "/m/Admin/Products", NavIcon.AdminProducts, false));
                _navItems.Add(new NavItem(Loc["AdminUsers"], "/m/Admin/Users", NavIcon.AdminUsers, false));
                _navItems.Add(new NavItem(Loc["Settings"], "/m/Settings", NavIcon.Profile, false));
            }
            else if (section == "products")
            {
                // In Products: Dashboard | Products(sel) | Orders | Cart | Settings
                _navItems.Add(new NavItem(Loc["Dashboard"], "/", NavIcon.Dashboard, false));
                _navItems.Add(new NavItem(Loc["Products"], "/m/Products", NavIcon.Products, true));
                _navItems.Add(new NavItem(Loc["Orders"], "/m/Sales", NavIcon.Orders, false));
                _navItems.Add(new NavItem(Loc["Cart"], "/m/Cart", NavIcon.Cart, false, ShowBadge: true));
                _navItems.Add(new NavItem(Loc["Settings"], "/m/Settings", NavIcon.Profile, false));
            }
            else if (section == "admin-products")
            {
                // In Admin Products: Dashboard | Admin Products(sel) | Admin Categories | Settings
                _navItems.Add(new NavItem(Loc["Dashboard"], "/", NavIcon.Dashboard, false));
                _navItems.Add(new NavItem(Loc["AdminProducts"], "/m/Admin/Products", NavIcon.AdminProducts, true));
                _navItems.Add(new NavItem(Loc["AdminCategories"], "/m/Admin/Categories", NavIcon.AdminCategories, false));
                _navItems.Add(new NavItem(Loc["Settings"], "/m/Settings", NavIcon.Profile, false));
            }
            else if (section == "admin-users")
            {
                // In Admin Users: Dashboard | Admin Users(sel) | Customer Groups | Settings
                _navItems.Add(new NavItem(Loc["Dashboard"], "/", NavIcon.Dashboard, false));
                _navItems.Add(new NavItem(Loc["AdminUsers"], "/m/Admin/Users", NavIcon.AdminUsers, true));
                _navItems.Add(new NavItem(Loc["CustomerGroups"], "/m/Admin/Groups", NavIcon.CustomerGroups, false));
                _navItems.Add(new NavItem(Loc["Settings"], "/m/Settings", NavIcon.Profile, false));
            }
            else if (section == "admin-categories")
            {
                // On the Admin Categories page: keep the Admin Products
                // section bar (the one that introduced this destination) but
                // mark Admin Categories as the active destination.
                _navItems.Add(new NavItem(Loc["Dashboard"], "/", NavIcon.Dashboard, false));
                _navItems.Add(new NavItem(Loc["AdminProducts"], "/m/Admin/Products", NavIcon.AdminProducts, false));
                _navItems.Add(new NavItem(Loc["AdminCategories"], "/m/Admin/Categories", NavIcon.AdminCategories, true));
                _navItems.Add(new NavItem(Loc["Settings"], "/m/Settings", NavIcon.Profile, false));
            }
            else if (section == "admin-groups")
            {
                // On the Customer Groups page: keep the Admin Users section
                // bar (the one that introduced this destination) but mark
                // Customer Groups as the active destination.
                _navItems.Add(new NavItem(Loc["Dashboard"], "/", NavIcon.Dashboard, false));
                _navItems.Add(new NavItem(Loc["AdminUsers"], "/m/Admin/Users", NavIcon.AdminUsers, false));
                _navItems.Add(new NavItem(Loc["CustomerGroups"], "/m/Admin/Groups", NavIcon.CustomerGroups, true));
                _navItems.Add(new NavItem(Loc["Settings"], "/m/Settings", NavIcon.Profile, false));
            }
            else
            {
                // Fallback for Sales, Cart, Settings and any other page.
                // Keep the Products-style bar so the user can always get
                // back to the main flow.
                _navItems.Add(new NavItem(Loc["Dashboard"], "/", NavIcon.Dashboard, false));
                _navItems.Add(new NavItem(Loc["Products"], "/m/Products", NavIcon.Products, section == "products"));
                _navItems.Add(new NavItem(Loc["Orders"], "/m/Sales", NavIcon.Orders, section == "sales"));
                _navItems.Add(new NavItem(Loc["Cart"], "/m/Cart", NavIcon.Cart, section == "cart", ShowBadge: true));
                _navItems.Add(new NavItem(Loc["Settings"], "/m/Settings", NavIcon.Profile, section == "settings"));
            }
        }
    }

    /// <summary>
    /// Maps the current URL path to a stable "section" key. Both desktop
    /// ("Sales", "Admin/Products") and mobile ("m/Sales", "m/Admin/Products")
    /// routes resolve to the same section so the lower bar shows the right
    /// set of items + active state on either route.
    /// </summary>
    private static string NormalizeSection(string currentPath)
    {
        var p = currentPath.Trim('/').TrimEnd('/').ToLowerInvariant();
        // Strip the leading "m/" mobile prefix so "m/admin/products" → "admin/products"
        if (p.StartsWith("m/", StringComparison.Ordinal))
            p = p.Substring(2);

        if (string.IsNullOrEmpty(p) || p == "dashboard")
            return "dashboard";
        if (p == "products" || p.StartsWith("products/", StringComparison.Ordinal))
            return "products";
        if (p == "admin/products" || p.StartsWith("admin/products/", StringComparison.Ordinal))
            return "admin-products";
        if (p == "admin/users" || p.StartsWith("admin/users/", StringComparison.Ordinal))
            return "admin-users";
        if (p == "admin/categories" || p.StartsWith("admin/categories/", StringComparison.Ordinal))
            return "admin-categories";
        if (p == "admin/groups" || p.StartsWith("admin/groups/", StringComparison.Ordinal))
            return "admin-groups";
        if (p == "sales" || p.StartsWith("sales/", StringComparison.Ordinal))
            return "sales";
        if (p == "cart" || p.StartsWith("cart/", StringComparison.Ordinal))
            return "cart";
        if (p == "settings" || p.StartsWith("settings/", StringComparison.Ordinal))
            return "settings";
        return "other";
    }

    private void NavigateTo(string href)
    {
        Navigation.NavigateTo(href, forceLoad: false);
    }

    // ── Data structures ─────────────────────────────────────────────────

    private sealed record NavItem(
        string Label,
        string Href,
        Microsoft.AspNetCore.Components.MarkupString SvgPath,
        bool IsActive,
        bool ShowBadge = false);

    // ── SVG icon paths (inline so no external dependency) ────────────────
