@* RedirectToAccessDenied.razor — Phase 1.3
   Renders when AuthorizeRouteView.NotAuthorized fires for an
   AUTHENTICATED user who lacks the role for the requested page.
   Sends them to /Account/AccessDenied with forceLoad so the cookie
   middleware's AccessDeniedPath picks it up.

   Routes.razor's NotAuthorized template picks between this and
   <RedirectToLogin /> based on whether the user is authenticated. *@

@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        Navigation.NavigateTo("/Account/AccessDenied", forceLoad: true);
    }
}