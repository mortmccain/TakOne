@* SidebarContent.razor — shared sidebar content for MainLayout + ShopLayout.
   Both layouts render the SAME sidebar (brand block + nav + support card).
   Previously this markup was duplicated in both layout files; extracting it
   into a shared component ensures the sidebar stays in sync across layouts.

   WHAT THIS COMPONENT RENDERS:
     1. Brand block — Tak Makaron logo (refresh trigger) + "تک ماکارون" /
        "پورتال سفارش کارکنان". Same .tm-sidebar-brand block as before.
     2. Navigation — plain HTML <nav> with <a> elements styled to match the
        reference HTML design (rounded nav-items, section headers, hover/active
        states). Previously this used RadzenPanelMenu; we replaced it with
        plain HTML for exact visual control (matching the HTML reference
        design's .nav-item styling).
     3. Support card — green gradient box at the bottom with "پشتیبانی فنی"
        + "ساعات پاسخگویی: ۸ تا ۱۷" + "55555" (a plain number, not a button,
        per user spec).

   NAV ITEMS (pages stay the same as before, minus Profile which was removed
   per user spec — "we will not have a profile page"):
     - Section "منوی اصلی" (Main Menu):
         Dashboard (Admin/Manager/Employee/ReadOnly)
         Products (everyone)
         My Orders / Sales (everyone)
         Cart (everyone except ReadOnly)
     - Section "بخش مدیریت" (Admin Section — Admin/Manager/Employee only):
         Manage Products
         Manage Categories
         Manage Users
     - Section "سیستم" (System):
         Settings

   ACTIVE STATE: detected by comparing Navigation.Uri against each item's
   path. The .tm-nav-item.active class applies the HTML reference design's
   active styling (green gradient background + gold left-border bar).

   NAVIGATION: uses @onclick with Navigation.NavigateTo for client-side
   Blazor navigation (no full HTTP reload). The href attribute is also set
   for accessibility/SEO — @onclick:preventDefault stops the browser's
   default full-reload navigation.

   ICONS: uses <RadzenIcon Icon="..." /> for each nav item. Radzen's icon
   font provides Material Symbols glyphs that are visually similar to the
   Heroicons-style SVGs in the HTML reference. Using RadzenIcon (instead of
   inline SVGs) keeps the markup concise and lets Radzen handle icon font
   loading. *@

@inject NavigationManager Navigation
@inject IStringLocalizer<MainLayout> Localizer
@inject IStringLocalizer<Products> ProductsLoc
@using TakOne.WebUI.Components.Pages.Products
@using System.Globalization
@implements IDisposable

@* Brand block — same .tm-sidebar-brand as before. The icon is a refresh
   trigger (clicking it force-reloads the current page). *@
<div class="tm-sidebar-brand">
    <button type="button"
            class="tm-portal-icon"
            title="@ProductsLoc["RefreshProductsTitle"]"
            aria-label="@ProductsLoc["RefreshProductsTitle"]"
            @onclick="RefreshCurrentPage">
        <span class="tm-portal-icon-fallback">ت</span>
    </button>
    <div class="tm-portal-text">
        <span class="tm-portal-title">@ProductsLoc["PortalTitle"]</span>
        <span class="tm-portal-subtitle">@ProductsLoc["PortalSubtitle"]</span>
    </div>
</div>

@* ── Navigation — plain HTML <nav> with <a> elements.
   Replaces the previous RadzenPanelMenu. The .tm-nav / .tm-nav-item /
   .tm-nav-section-header classes are styled in sidebar.css to match the
   HTML reference design's sidebar exactly.

   Section headers ("منوی اصلی", "بخش مدیریت", "سیستم") group the nav
   items logically, matching the HTML reference design's section structure.
   The Admin section is role-gated via <AuthorizeView> — only
   Admin/Manager/Employee can see it. *@
<nav class="tm-nav">
    <p class="tm-nav-section-header">@Localizer["NavSection_Main"]</p>

    <AuthorizeView Roles="@(Roles.Admin + "," + Roles.Manager + "," + Roles.Employee + "," + Roles.ReadOnly)">
        <a href="/" class="tm-nav-item @(IsActive("/") ? "active" : "")">
            <RadzenIcon Icon="dashboard" />
            <span>@Localizer["Dashboard"]</span>
        </a>
    </AuthorizeView>

    <AuthorizeView>
        <a href="/Products" class="tm-nav-item @(IsActive("/Products") ? "active" : "")">
            <RadzenIcon Icon="inventory_2" />
            <span>@Localizer["Products"]</span>
        </a>
    </AuthorizeView>

    <AuthorizeView>
        <a href="/Sales" class="tm-nav-item @(IsActive("/Sales") ? "active" : "")">
            <RadzenIcon Icon="receipt_long" />
            <span>@Localizer["MyOrders"]</span>
        </a>
    </AuthorizeView>

    <AuthorizeView Roles="@(Roles.Admin + "," + Roles.Manager + "," + Roles.Employee)">
        <a href="/Cart" class="tm-nav-item @(IsActive("/Cart") ? "active" : "")">
            <RadzenIcon Icon="shopping_cart" />
            <span>@Localizer["Cart"]</span>
        </a>
    </AuthorizeView>
    <AuthorizeView Roles="@Roles.Customer">
        <a href="/Cart" class="tm-nav-item @(IsActive("/Cart") ? "active" : "")">
            <RadzenIcon Icon="shopping_cart" />
            <span>@Localizer["Cart"]</span>
        </a>
    </AuthorizeView>

    @* Admin section — staff only (no customers, no read-only).
       Previously this was a collapsible RadzenPanelMenuItem with children.
       Now it's flat nav items under a section header, matching the HTML
       reference design's structure (which has no collapsible groups). *@
    <AuthorizeView Roles="@(Roles.Admin + "," + Roles.Manager + "," + Roles.Employee)">
        <p class="tm-nav-section-header">@Localizer["NavSection_Admin"]</p>

        <a href="/Admin/Products" class="tm-nav-item @(IsActive("/Admin/Products") ? "active" : "")">
            <RadzenIcon Icon="inventory" />
            <span>@Localizer["ManageProducts"]</span>
        </a>
        <a href="/Admin/Categories" class="tm-nav-item @(IsActive("/Admin/Categories") ? "active" : "")">
            <RadzenIcon Icon="category" />
            <span>@Localizer["ManageCategories"]</span>
        </a>
        <a href="/Admin/Users" class="tm-nav-item @(IsActive("/Admin/Users") ? "active" : "")">
            <RadzenIcon Icon="group" />
            <span>@Localizer["ManageUsers"]</span>
        </a>
        <a href="/Admin/Groups" class="tm-nav-item @(IsActive("/Admin/Groups") ? "active" : "")">
            <RadzenIcon Icon="diversity_3" />
            <span>@Localizer["ManageGroups"]</span>
        </a>
    </AuthorizeView>

    <p class="tm-nav-section-header">@Localizer["NavSection_System"]</p>
    <a href="/Settings" class="tm-nav-item @(IsActive("/Settings") ? "active" : "")">
        <RadzenIcon Icon="settings" />
        <span>@Localizer["Settings"]</span>
    </a>
</nav>

@* ── Support card — bottom of sidebar.
   Per user spec: show "پشتیبانی فنی" + "ساعات پاسخگویی: ۸ تا ۱۷" + the
   number "482" as PLAIN TEXT (not a button — the HTML reference had a
   "تماس با ما" button, but the user asked to replace it with just the
   number 482).

   DIGIT FORMATTING: the number is rendered through FormatLocalDigits()
   so it shows Persian digits (۴۸۲) in fa-IR mode and ASCII digits
   (482) in en-US mode — same rule as all other numbers on the page. *@
<div class="tm-support-card">
    <p class="tm-support-title">@ProductsLoc["SupportTitle"]</p>
    <p class="tm-support-hours">@ProductsLoc["SupportHours"]</p>
    <p class="tm-support-phone">@FormatLocalDigits("482")</p>
</div>

@code {
    protected override void OnInitialized()
    {
        // Subscribe to navigation events so the sidebar's active state
        // stays in sync after Blazor enhanced-navigation clicks.
        //
        // WHY THIS IS NEEDED:
        // With InteractiveServer render mode + enhanced navigation, Blazor
        // patches the DOM with the new server-rendered sidebar HTML after
        // a click — so visually the new item lights up. BUT the live
        // interactive SidebarContent component instance is NOT re-rendered
        // automatically (its OnInitialized/OnParametersSet don't fire again
        // because the layout component is preserved across navigations).
        // Its in-memory state still has the OLD active page.
        //
        // Later, when anything triggers a re-render in the circuit (a hover
        // transition, a sibling StateHasChanged, a Radzen update), the
        // component re-evaluates IsActive(...) with its stale state and
        // OVERWRITES the patched DOM — putting the highlight back on the
        // old page. This is exactly the "sometimes it works, sometimes it
        // doesn't" symptom the user reported.
        //
        // Subscribing to LocationChanged + calling StateHasChanged() forces
        // the component to re-evaluate IsActive(...) with the new URL
        // immediately after every navigation, so its in-memory state matches
        // the patched DOM. No more flicker / revert.
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Trigger a re-render so IsActive(...) re-evaluates against the new URL.
        // StateHasChanged is safe to call from this event handler — Blazor
        // schedules the render on the circuit's sync context.
        StateHasChanged();
    }

    /// <summary>
    /// Force-reloads the current page. Triggered by the brand icon at the
    /// top of the sidebar. Uses Navigation.Uri so the refresh works on ANY
    /// page regardless of which layout renders this sidebar.
    /// </summary>
    private void RefreshCurrentPage()
    {
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    /// <summary>
    /// Formats a numeric string (ASCII digits) using the current UI culture's
    /// native digits. In fa-IR mode this produces Persian digits (۴۸۲); in
    /// en-US mode it leaves ASCII digits unchanged (482). Used for the
    /// sidebar support phone number so it follows the same digit rule as
    /// the rest of the UI.
    ///
    /// WHY (instead of hard-coding ۴۸۲): the user asked that ALL numbers in
    /// the app follow the culture rule — Persian digits in Persian mode,
    /// English digits in English mode. Hard-coding either form would break
    /// one of the two cultures.
    ///
    /// IMPLEMENTATION: delegates to <see cref="CultureFormat.FormatDigits(string)"/>,
    /// which formats with InvariantCulture first and then swaps ASCII digits
    /// for Persian digits in fa-IR mode. We can't just call
    /// <c>n.ToString("0", CultureInfo.CurrentCulture)</c> because .NET's
    /// NumberFormatInfo.NativeDigits is informational-only and not honored
    /// by ToString in modern .NET.
    /// </summary>
    private string FormatLocalDigits(string value)
        => CultureFormat.FormatDigits(value);

    /// <summary>
    /// Returns true if the given nav path matches the current page. Used to
    /// apply the .active class to the current page's nav item.
    ///
    /// MATCHING RULES (more robust than the previous exact-string compare):
    ///   1. Strip query string and fragment from the current URL
    ///      (e.g. "/Sales?tab=active" → "/Sales"). Otherwise a query string
    ///      would silently break the active highlight.
    ///   2. Trim trailing slash (e.g. "/Sales/" → "/Sales"). Browsers and
    ///      Blazor sometimes normalize URLs with trailing slashes.
    ///   3. Case-insensitive compare (paths are case-insensitive on the server).
    ///   4. For non-root paths, ALSO match sub-routes — e.g. being on
    ///      "/Sales/{id}" (sale detail) still highlights the "My Sales"
    ///      nav item. This is done via StartsWith(path + "/").
    ///   5. For the root path "/", EXACT match only — otherwise every URL
    ///      would match (since every URL starts with "/").
    ///
    /// IMPORTANT: "/Admin/Products" does NOT activate the "/Products" nav
    /// item, because StartsWith("/Products/") returns false for
    /// "/Admin/Products". The previous behavior is preserved.
    /// </summary>
    private bool IsActive(string path)
    {
        // Extract the relative path (e.g. "Sales" from "https://x/Sales?y=1#z").
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);

        // Split off query string and fragment — keep only the path portion.
        // Use OrdinalIndexOf to find '?' or '#' (whichever comes first).
        var queryStart = relative.IndexOfAny(new[] { '?', '#' });
        if (queryStart >= 0)
        {
            relative = relative.Substring(0, queryStart);
        }

        // Normalize: ensure leading slash, trim trailing slash (except for root).
        var currentPath = "/" + relative.TrimStart('/');
        if (currentPath.Length > 1 && currentPath.EndsWith('/'))
        {
            currentPath = currentPath.TrimEnd('/');
        }

        // Case-insensitive comparison.
        if (string.Equals(currentPath, path, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        // Sub-route match for non-root paths only.
        // "/Sales/abc-123" should highlight "/Sales".
        // "/Products/abc-123" should highlight "/Products".
        // "/Admin/Users/abc-123" should highlight "/Admin/Users".
        // But "/" must NOT prefix-match (otherwise it matches everything).
        if (path.Length > 1 &&
            currentPath.StartsWith(path + "/", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        return false;
    }

    public void Dispose()
    {
        // Always unsubscribe to prevent memory leaks if the component is
        // disposed (e.g. when navigating to a statically-rendered page like
        // /Account/*, the interactive circuit is torn down).
        Navigation.LocationChanged -= OnLocationChanged;
    }
}