@* MainLayout.razor — Phase 0.10 + 0.20
   Radzen-based main layout with:
     - Sidebar with role-gated navigation (uses Roles static class)
       + BRAND BLOCK at the top of the sidebar (Tak Makaron logo +
         "تک ماکارون" / "پورتال سفارش کارکنان"). Same .tm-sidebar-brand
         block as in ShopLayout.razor — the user asked for the brand to
         appear on the sidebar of EVERY page, not just /Products. The
         icon is a refresh trigger (clicking it force-reloads the
         current page via RefreshCurrentPage).
     - TOP BAR (redesigned to match the Products page top bar, per user
       spec). Same .tm-shop-header / .tm-shop-header-inner / .tm-portal-block /
       .tm-actions-block / .tm-gold-shimmer markup + CSS classes as
       Products.razor — so the two layouts feel visually consistent.
       Differences from the Products page top bar:
         - NO search bar (only /Products has a search bar)
         - NO cart count badge (MainLayout doesn't subscribe to cart
           updates — the icon still navigates to /Cart on click)
       Everything else (hamburger, EN|FA toggle, cart icon, sun/moon
       theme toggle, user avatar, gold shimmer line) is identical to
       the Products page top bar.
     - Session-expiry warning toast at 55 minutes (5 min before 1h expiry)
       [TODO — not yet implemented]
     - Notification hub auto-connect on circuit start

   Role-gated nav:
     - Dashboard: Admin, Manager, Employee, ReadOnly (NOT Customer — they
       redirect to /Products and have no dashboard)
     - Products (catalog): everyone (buyers shop here; admins manage)
     - Sales: everyone (their own order history)
     - Cart: everyone except ReadOnly (ReadOnly can't buy)
     - Profile, Settings: everyone
     - Admin section: Admin, Manager, Employee (NOT Customer/ReadOnly) *@

@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ToastService Toast
@inject ICurrentUserService CurrentUser
@inject IStringLocalizer<Products> ProductsLoc
@inject Wolverine.IMessageBus MessageBus
@inject TakOne.WebUI.Services.NotificationRefreshService NotificationRefresh
@inject IStringLocalizer<TakOne.WebUI.Components.Layout.MainLayout> MainLayoutLoc
@implements IDisposable
@using System.Globalization
@using TakOne.Application.Common.Interfaces
@using TakOne.Application.Notifications.Queries.GetUnreadNotificationCount
@using TakOne.WebUI.Components.Pages.Products
@using TakOne.WebUI.Services

<RadzenLayout>
    @* Sidebar with role-gated navigation *@
    <RadzenSidebar @ref="sidebar" Style="width: 240px;">
        @* Sidebar content (brand block + nav + support card) is now in a
           shared SidebarContent.razor component — same markup for both
           MainLayout and ShopLayout. The sidebar uses plain HTML nav items
           (not RadzenPanelMenu) styled to match the HTML reference design
           exactly. See SidebarContent.razor for the full nav structure. *@
        <SidebarContent />
    </RadzenSidebar>

    <RadzenBody>
        @* ── TOP BAR — redesigned to match the Products page top bar
           (per user spec). The previous MainLayout top bar used Radzen
           dropdowns for theme + culture, a RadzenBadge + RadzenText for
           the user, and a CSRF-safe logout <form> with a RadzenButton.
           The user asked for ALL non-Products pages to use the SAME top
           bar design as the Products page, MINUS the search box (only
           /Products has a search bar).

           So this header now reuses the EXACT same markup pattern + CSS
           classes as Products.razor's <header class="tm-shop-header">:
             - .tm-portal-block (right side in RTL): hamburger + EN|FA toggle
             - .tm-actions-block (left side in RTL): cart icon + theme
               toggle (sun/moon) + user avatar
             - .tm-gold-shimmer: the animated gold gradient bar that sits
               BELOW the top bar (the "shining small bar" the user asked
               for on all pages)

           The .tm-search-block (center search input) is INTENTIONALLY
           OMITTED — only /Products has a search bar. The flex
           justify-content:space-between on .tm-shop-header-inner pushes
           .tm-portal-block and .tm-actions-block to opposite ends, which
           looks clean without a center element.

           WHY NOT <RadzenHeader>: the previous version wrapped the toolbar
           in <RadzenHeader>. We drop that wrapper and use a plain
           <header class="tm-shop-header"> instead — same pattern as
           ShopLayout.razor (which also has no RadzenHeader). The
           .tm-shop-header CSS provides its own background/border/shadow
           + position:sticky, so RadzenHeader's styling is not needed.
           RadzenLayout works fine without a RadzenHeader child (ShopLayout
           proves this).

           CSS SOURCE: all the .tm-shop-header / .tm-shop-header-inner /
           .tm-portal-block / .tm-hamburger / .tm-lang-* / .tm-icon-button /
           .tm-theme-toggle / .tm-user-* / .tm-gold-shimmer rules live in
           wwwroot/css/Pages/Products.css. They are NOT scoped under
           .tm-shop-page (despite the file's intro comment claiming
           otherwise — the actual selectors are top-level), so they apply
           here in MainLayout too. Products.css is loaded globally via
           App.razor's <link> tag (cache-bust query string ?v=11).

           LOCALIZATION: the localization keys (MenuTitle, MenuAriaLabel,
           LanguageAriaLabel, CartTitle, UserMenuTitle, ThemeSwitchToLight,
           ThemeSwitchToDark, RoleAdmin/Manager/Employee/ReadOnly/Customer)
           all live in the Products resource files (Products.en-US.resx,
           Products.fa-IR.resx). We read them via the ProductsLoc
           IStringLocalizer<Products> injected at the top of this file —
           same keys the Products page itself uses, so translations are
           shared and consistent across both layouts.

           LOGOUT: the previous top bar had a CSRF-safe logout <form>
           POSTing to /Account/SignOut. The Products page top bar does
           NOT have a logout button (the user avatar clicks go to
           /Settings, where logout lives). To match the Products page
           design exactly (per the user's "look like the one on products
           page" instruction), the logout <form> is REMOVED from this top
           bar. Logout is still accessible by clicking the user avatar →
           /Settings. If a future sidebar-based logout is desired, it can
           be added to the sidebar nav below without touching this header. *@
        <header class="tm-shop-header">
            <div class="tm-shop-header-inner">

                @* Right side (RTL): hamburger + EN|FA language toggle.
                   Same .tm-portal-block as Products.razor. The hamburger
                   toggles THIS layout's sidebar (ToggleSidebar method
                   below). The EN|FA toggle commits the culture cookie
                   and force-reloads so App.razor re-evaluates
                   <html lang/dir> from the new CurrentUICulture. *@
                <div class="tm-portal-block">
                    <button type="button"
                            class="tm-hamburger"
                            title="@ProductsLoc["MenuTitle"]"
                            aria-label="@ProductsLoc["MenuAriaLabel"]"
                            @onclick="ToggleSidebar">
                        @* Inline style on <path> as a DEFENSIVE fallback —
                           same pattern as Products.razor. The CSS rule
                           `.tm-hamburger svg path { stroke: ... !important; }`
                           is the primary fix; this inline style is the
                           highest-priority backup. Hardcoded color (not
                           var()) because CSS variables don't work in inline
                           SVG attributes outside of style="". *@
                        <svg fill="none" stroke="#0E4D3C" viewBox="0 0 24 24" stroke-width="2" width="24" height="24" aria-hidden="true" style="display:block;">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" style="stroke:#0E4D3C;fill:none;" />
                        </svg>
                    </button>

                    @* EN | FA language toggle — plain text, no popup.
                       Clicking either code immediately commits the culture
                       cookie and force-reloads the page. Same component as
                       on the Products page top bar (identical markup +
                       behavior). The active language is rendered with the
                       theme accent color via the .is-active class. *@
                    <div class="tm-lang-toggle" role="group" aria-label="@ProductsLoc["LanguageAriaLabel"]">
                        <button type="button"
                                class='tm-lang-btn @(_currentCulture == "en-US" ? "is-active" : "")'
                                aria-pressed='@(_currentCulture == "en-US")'
                                @onclick='(() => SetCultureAsync("en-US"))'>
                            EN
                        </button>
                        <span class="tm-lang-sep" aria-hidden="true">|</span>
                        <button type="button"
                                class='tm-lang-btn @(_currentCulture == "fa-IR" ? "is-active" : "")'
                                aria-pressed='@(_currentCulture == "fa-IR")'
                                @onclick='(() => SetCultureAsync("fa-IR"))'>
                            FA
                        </button>
                    </div>
                </div>

                @* Center: EMPTY — the search bar lives ONLY on /Products
                   (per user spec). The flex justify-content:space-between
                   on .tm-shop-header-inner pushes the two side blocks to
                   opposite edges, which looks clean without a center
                   element. Adding an empty <div> here would just create
                   an unnecessary flex child. *@

                @* Left side (RTL): cart icon + theme toggle (sun/moon) +
                   user avatar. Identical to Products.razor's
                   .tm-actions-block. The cart icon navigates to /Cart
                   (no badge here — the cart count is only tracked on the
                   /Products page; MainLayout doesn't subscribe to cart
                   updates, so we show the icon without a count badge).
                   The theme toggle flips between tak-light and tak-dark.
                   The user avatar shows the user's initial + role label
                   and navigates to /Settings on click. *@
                <div class="tm-actions-block">
                    @* NOTIFICATIONS BELL — desktop top-bar bell icon with
                       unread-count badge. Pings the NotificationRefreshService
                       on every ReceiveRefresh (so the badge updates live when
                       a new notification lands). Visible to ALL
                       authenticated users (customers see their own-sale
                       notifications; staff see their-action notifications).
                       The bell is positioned FIRST in the actions block so
                       it sits next to the user avatar (in RTL, that's the
                       leftmost position in the actions row). *@
                    <AuthorizeView>
                        <button type="button"
                                class="tm-icon-button tm-notification-bell"
                                title="@MainLayoutLoc["NotificationsTitle"]"
                                aria-label="@MainLayoutLoc["NotificationsTitle"]"
                                @onclick="GoToNotifications">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" width="24" height="24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
                            </svg>
                            @if (_unreadCount > 0)
                            {
                                <span class="tm-notification-badge">@(_unreadCount > 99 ? "99+" : _unreadCount.ToString())</span>
                            }
                        </button>
                    </AuthorizeView>

                    @* Cart icon — visible to everyone EXCEPT ReadOnly.
                       ReadOnly users cannot buy (CreateOrAppendSaleCommand
                       is gated to Admin/Manager/Employee/Customer via
                       [RequireRoles]), so showing them a cart icon would
                       be misleading UX. Matches the sidebar Cart nav link
                       in SidebarContent.razor which also excludes ReadOnly. *@
                    <AuthorizeView Roles="@(Roles.Admin + "," + Roles.Manager + "," + Roles.Employee + "," + Roles.Customer)">
                        <button type="button"
                                class="tm-icon-button"
                                title="@ProductsLoc["CartTitle"]"
                                @onclick="GoToCart">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" width="24" height="24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z" />
                            </svg>
                        </button>
                    </AuthorizeView>

                    @* Theme quick-toggle — switches between tak-light and
                       tak-dark. The ICON itself changes with the theme:
                       when LIGHT is active, a MOON icon is shown (click →
                       switch to dark); when DARK is active, a SUN icon is
                       shown (click → switch to light). Same convention as
                       the Products page toggle. *@
                    <button type="button"
                            class="tm-icon-button tm-theme-toggle"
                            title='@(_currentTheme == "tak-dark" ? ProductsLoc["ThemeSwitchToLight"] : ProductsLoc["ThemeSwitchToDark"])'
                            aria-label='@(_currentTheme == "tak-dark" ? ProductsLoc["ThemeSwitchToLight"] : ProductsLoc["ThemeSwitchToDark"])'
                            @onclick="ToggleThemeAsync">
                        @if (_currentTheme == "tak-dark")
                        {
                            @* Sun icon — shown when dark is active (click → light) *@
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" width="22" height="22" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
                            </svg>
                        }
                        else
                        {
                            @* Moon icon — shown when light is active (click → dark) *@
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" width="22" height="22" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
                            </svg>
                        }
                    </button>

                    @* User avatar — circle with first initial of the
                       user's actual name + their access level. Clicking
                       it goes to /Settings (same as the Products page
                       avatar). Markup is identical to Products.razor's
                       .tm-user-block so the two layouts look the same. *@
                    <button type="button"
                            class="tm-user-block"
                            title="@ProductsLoc["UserMenuTitle"]"
                            @onclick="GoToSettings">
                        <div class="tm-user-text">
                            <p class="tm-user-name">@CurrentUser.FullName</p>
                            <p class="tm-user-role">@GetRoleLabel()</p>
                        </div>
                        @* Inline style on the avatar div as a DEFENSIVE
                           fallback — same pattern as Products.razor.
                           Hardcoded gradient (not var()) for maximum
                           robustness across themes. *@
                        <div class="tm-user-avatar"
                             style="border-radius:50%; -webkit-border-radius:50%; -moz-border-radius:50%; background:linear-gradient(135deg, #0E4D3C, #0A3528); width:44px; height:44px; display:flex; align-items:center; justify-content:center; overflow:hidden; flex-shrink:0; position:relative; box-shadow:0 0 0 2px rgba(201,162,39,0.3), 0 2px 8px rgba(14,77,60,0.3);">
                            <span class="tm-user-avatar-initial">@GetUserInitial()</span>
                        </div>
                    </button>

                    @* LOGOUT BUTTON — sits on the OUTER side of the user
                       avatar in BOTH layouts (left in RTL/Persian, right in
                       LTR/English). The .tm-actions-block is a flex container
                       with the user-block as the previous child; because the
                       flex direction follows the document's `direction`
                       (rtl/ltr), placing this last in HTML order means it
                       always renders on the side away from the brand/logo.

                       WHY A POST FORM (not a button+handler):
                       This is the same CSRF-safe logout pattern established
                       in AccessDenied.razor and documented in the
                       "LOGOUT ENDPOINT" section of Program.cs. A GET-based
                       logout is a CSRF vulnerability (an attacker could
                       embed `<img src=".../Account/SignOut">` on a
                       third-party page to log any user out). The
                       /Account/SignOut endpoint is POST-only and the
                       UseAntiforgery middleware validates the
                       __RequestVerificationToken field rendered by
                       <AntiforgeryToken />.

                       WHY A <button type="submit"> AND NOT <RadzenButton>:
                       RadzenButton emits a <button> inside a <span> wrapper,
                       which would break the form's submit-on-click behavior
                       in some browsers. A native <button type="submit"> is
                       the simplest, most reliable way to submit a form. The
                       .tm-icon-button class gives it the same look as the
                       other icon buttons (cart, theme) in the actions block. *@
                    <form method="post" action="/Account/SignOut" class="tm-logout-form">
                        <AntiforgeryToken />
                        <button type="submit"
                                class="tm-icon-button tm-logout-button"
                                title="@ProductsLoc["LogoutTitle"]"
                                aria-label="@ProductsLoc["LogoutAriaLabel"]">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" width="24" height="24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l3 3m0 0l-3 3m3-3H2.25" />
                            </svg>
                        </button>
                    </form>
                </div>
            </div>

            @* ── GOLDEN SHIMMER LINE — inside <header> so it sticks with it.
               Same .tm-gold-shimmer element as Products.razor — an
               animated gold gradient bar that sits just below the top bar.
               The user explicitly asked that "those new top bars design
               for all pages should have that shining small bar under it",
               so this is included on every MainLayout page. Placing it
               INSIDE <header> (rather than as a sibling) means it sticks
               along with the header (position:sticky is on
               .tm-shop-header) — same pattern as Products.razor. *@
            <div class="tm-gold-shimmer" aria-hidden="true"></div>
        </header>

        <RadzenContent Style="padding: 24px;">
            @* Round 18-A / Brutal Review Fix #34: wrap @Body in <ErrorBoundary>
               so an unhandled render exception in a child page (e.g. a
               null-reference in OnInitializedAsync of a Dashboard tile) is
               caught at the BODY boundary instead of bubbling up + killing
               the whole circuit. The sidebar + top bar stay rendered so the
               user can navigate away or hit Retry. The boundary is INSIDE
               RadzenContent (the body region) so the sidebar/top bar are
               outside the boundary — by design. Recover() re-renders
               ChildContent; if the same exception re-throws, the boundary
               re-displays ErrorContent (no infinite loop — the boundary
               captures render exceptions only, not post-render ones). *@
            <ErrorBoundary @ref="_bodyErrorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="ex">
                    <div class="error-boundary-content" style="padding:2rem;text-align:center;">
                        <h3>خطایی رخ داد / An error occurred</h3>
                        <p style="color: var(--rz-text-secondary-color); margin: 0.5rem 0 1rem;">@ex.Message</p>
                        <button class="tm-icon-button"
                                style="border:1px solid var(--rz-border-base-color); padding:0.5rem 1.25rem; border-radius:6px; background: var(--rz-base-background-color); cursor:pointer;"
                                @onclick="RetryBodyError">
                            تلاش مجدد / Retry
                        </button>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </RadzenContent>
    </RadzenBody>
</RadzenLayout>

@* ── RADZEN HOST COMPONENTS ────────────────────────────────────────────
   These three are REQUIRED for the corresponding Radzen services to
   actually render anything on screen. They are stateless "render sinks"
   that subscribe to their respective services (DialogService,
   NotificationService) and project the current open dialogs / pending
   notifications into the DOM.

   WITHOUT THEM (the bug we fixed here):
     - DialogService.OpenAsync<T>(...) is callable (the service is
       registered by AddRadzenComponents() in Program.cs) but the
       TaskCompletionSource it returns is NEVER resolved, because no
       RadzenDialog is listening for the OnOpen event to render the
       dialog UI. The await hangs forever — the calling button appears
       dead with no exception, no log, no toast. This was the root cause
       of "the confirm cancellation button does absolutely nothing and
       no errors on why it did nothing" on the SaleDetail page.
     - NotificationService.Notify(...) (wrapped by our ToastService)
       silently drops every toast. The user never sees success/warning/
       error feedback from any action handler's `await Toast.Error(...)`
       call. This is why the cancel-confirmation guards' toasts also
       failed to appear.
     - TooltipService.OpenTooltip(...) silently does nothing — every
       Tooltip="..." parameter on Radzen components is a no-op. (We
       don't currently use Tooltip= anywhere, but registering the host
       is one line and means future Radzen Tooltip parameters work
       without a second debugging session.)

   They are SIBLINGS of <RadzenLayout> (not children) because they
   render fixed-position overlays on top of the entire viewport — they
   must not be clipped by the layout's overflow or stacking context.
   The Radzen docs prescribe this exact placement.

   We add them to BOTH MainLayout and ShopLayout (the two top-level
   layouts) so dialogs and toasts work regardless of which layout the
   current page uses. LoginLayout is a special full-screen chrome with
   no Radzen components and no need for dialogs/toasts, so it's left
   untouched.
*@
<RadzenDialog />
<RadzenNotification />
<RadzenTooltip />

<ReconnectModal />

@code {
    private RadzenSidebar? sidebar;

    // Round 18-A / Brutal Review Fix #34: ErrorBoundary ref for the body
    // wrapper. Recover() re-renders the ChildContent (the @Body). If the
    // child re-throws the same exception on re-render, the boundary will
    // re-display the ErrorContent — no infinite loop (the boundary catches
    // render-time exceptions only).
    private ErrorBoundary? _bodyErrorBoundary;

    private void RetryBodyError()
    {
        _bodyErrorBoundary?.Recover();
    }

    // Theme + culture backing fields for the new top bar (matching the
    // Products.razor pattern). The previous MainLayout used _selectedTheme /
    // _selectedCulture + RadzenDropDown dropdowns; the new top bar uses a
    // sun/moon toggle button (tak-light <-> tak-dark) and an EN|FA text
    // toggle, so the field names mirror Products.razor's _currentTheme /
    // _currentCulture for consistency across the two layouts.
    private string _currentTheme = "tak-light";

    // Initialize from the current UI culture so the EN|FA toggle highlights
    // the ACTUAL active language on first render (was previously hardcoded
    // to "fa-IR" which would highlight FA even when the server had fallen
    // back to en-US via the Accept-Language header).
    private string _currentCulture = CultureInfo.CurrentUICulture.Name;

    [Inject] private IStringLocalizer<MainLayout> Localizer { get; set; } = default!;

    /// <summary>
    /// Live unread-notification count shown as a badge on the bell icon.
    /// Loaded on init + refreshed via the NotificationRefreshService
    /// whenever a SignalR ReceiveRefresh event lands.
    /// </summary>
    private int _unreadCount;

    protected override async Task OnInitializedAsync()
    {
        // The previous MainLayout read the user's display name + role badge
        // here via AuthStateProvider for the RadzenBadge + RadzenText in the
        // old top bar. The new top bar uses ICurrentUserService directly
        // (CurrentUser.FullName, CurrentUser.IsInRole(...)) — same pattern as
        // Products.razor — so there's no auth-state reading to do here anymore.
        //
        // We keep OnInitializedAsync for the SignalR connection start below
        // AND for the unread-notification-count load + the live-refresh
        // subscription.

        // Load the initial unread count for the bell badge. Best-effort —
        // failures just leave the badge at 0 (the user can still navigate
        // to /Notifications to see the full list).
        await LoadUnreadCountAsync();

        // Subscribe to live-refresh events so the badge updates when a
        // new notification lands. The NotificationRefreshService raises
        // this event when the SignalR ReceiveRefresh event arrives (the
        // JS bridge invokes OnReceiveRefresh on the service).
        NotificationRefresh.RefreshReceived += OnNotificationRefreshReceived;
    }

    // Sync the sun/moon toggle icon with the actually-applied theme after
    // the first interactive render.
    //
    // WHY THIS IS NEEDED:
    //   - _currentTheme is initialized to "tak-light" (the project default)
    //     so the toggle shows a MOON icon on the very first paint (indicating
    //     "click to switch to dark").
    //   - But theme.js's IIFE reads localStorage and applies whatever is
    //     actually saved — which might be "tak-dark", "standard", "dark",
    //     etc. if the user previously picked a different theme.
    //   - Without this sync, the icon would show MOON (light is active)
    //     while the page actually rendered as tak-dark — confusing mismatch.
    //
    // WHY OnAfterRenderAsync (not OnInitializedAsync):
    //   - OnInitializedAsync runs TWICE in InteractiveServer + prerender:
    //     once during static prerender (no circuit yet — JS interop throws),
    //     and once after hydration (circuit ready — JS interop works).
    //   - Calling JS interop during the prerender pass throws and is noisy.
    //   - OnAfterRenderAsync(firstRender: true) runs ONLY ONCE, after the
    //     circuit is established. JS interop definitely works here.
    //
    // BRIEF FLASH TRADE-OFF:
    //   - The icon paints as MOON on first render, then updates to SUN after
    //     this method runs IF the saved theme is tak-dark. If the saved theme
    //     IS "tak-light" (the common case for new users), there's no flash.
    //     For users with a different saved theme, the brief flash is
    //     acceptable — the alternative (cookie-based theme sync) adds
    //     complexity for marginal gain.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var saved = await JS.InvokeAsync<string>("takTheme.get");
            // Only update + re-render if the saved theme differs from what
            // the toggle currently assumes. Avoids a needless StateHasChanged
            // call in the common case where saved == "tak-light".
            if (!string.IsNullOrEmpty(saved) && saved != _currentTheme)
            {
                _currentTheme = saved;
                StateHasChanged();
            }
        }
        catch
        {
            // If JS interop fails (e.g. theme.js didn't load due to a network
            // error), leave _currentTheme at its "tak-light" default. The
            // toggle still works for showing the user's intended theme; only
            // the runtime switch (takTheme.set) would also fail, and that's
            // a separate problem to surface via the error UI.
        }

        // Wire up the SignalR connection + register the .NET callback so
        // NotificationRefreshService can raise RefreshReceived when a
        // ReceiveRefresh event arrives. Moved here (from OnInitializedAsync)
        // because JS interop requires the circuit to be live — same reason
        // the theme-sync above lives here.
        try
        {
            await NotificationRefresh.StartAsync();
        }
        catch
        {
            // Non-fatal — UI still works without real-time, just no push
            // refresh. The persisted notification row is the source of
            // truth; the user will see new notifications on next page load.
        }
    }

    /// <summary>
    /// Live-refresh callback — invoked by NotificationRefreshService when
    /// a SignalR ReceiveRefresh event arrives. Re-queries the unread count
    /// and triggers a re-render so the bell badge updates immediately.
    /// </summary>
    /// <remarks>
    /// <b>async void</b>: the one legitimate use of async void is for
    /// event handlers — the event raiser (NotificationRefreshService)
    /// can't await subscribers. The inner try/catch ensures no exception
    /// escapes as an unobserved-exception (which would crash the process
    /// if <c>ThrowUnobservedTaskExceptions</c> is ever flipped on).
    /// </remarks>
    private async void OnNotificationRefreshReceived()
    {
        try
        {
            await LoadUnreadCountAsync();
        }
        catch
        {
            // Silent — the badge is best-effort.
        }
    }

    /// <summary>
    /// Queries the current unread-notification count for the bell badge.
    /// Best-effort — failures leave the badge at its previous value.
    /// </summary>
    private async Task LoadUnreadCountAsync()
    {
        try
        {
            if (!CurrentUser.IsAuthenticated) return;

            var count = await MessageBus.InvokeAsync<int>(
                new GetUnreadNotificationCountQuery());

            if (count != _unreadCount)
            {
                _unreadCount = count;
                StateHasChanged();
            }
        }
        catch
        {
            // Silent — the badge is a UX nicety, not a correctness
            // requirement. The /Notifications page re-queries on load.
        }
    }

    /// <summary>
    /// Navigates to the desktop Notifications page (/Notifications) when
    /// the bell icon is clicked.
    /// </summary>
    private void GoToNotifications()
    {
        Navigation.NavigateTo("/Notifications", forceLoad: false);
    }

    /// <summary>
    /// Unsubscribes from the live-refresh event when the layout is
    /// disposed (circuit shutdown, navigation to a non-MainLayout route).
    /// </summary>
    public void Dispose()
    {
        NotificationRefresh.RefreshReceived -= OnNotificationRefreshReceived;
    }

    private void ToggleSidebar()
    {
        // NOTE on the two earlier compile errors this resolves:
        //
        // 1) "Cannot await 'void'" — RadzenSidebar.Toggle() returns `void`
        //    (not Task) in Radzen.Blazor 11.1.1. The previous draft did
        //    `await sidebar.Toggle();` which failed. We drop the `await`
        //    and just call the method — Toggle() is synchronous, calls
        //    StateHasChanged() internally, and Blazor's `Click` EventCallback
        //    happily binds to a void-returning method.
        //
        // 2) BL0006 "Component parameter 'Expanded' should not be set
        //    outside of its component" — the intermediate workaround mutated
        //    `sidebar.Expanded = !sidebar.Expanded;` directly. `Expanded` is
        //    a [Parameter] on RadzenSidebar, and the Blazor analyzer flags
        //    external writes to [Parameter]s. Calling Toggle() instead
        //    avoids the warning because it's a public method invocation,
        //    not a parameter assignment.
        sidebar?.Toggle();
    }

    // ── Navigation helpers (cart + settings) ───────────────────────────
    // These mirror Products.razor's GoToCart / GoToSettings so the top
    // bar's cart icon and user avatar behave identically across both
    // layouts. forceLoad:false is fine here (no need for a full HTTP
    // reload — these are normal Blazor navigations to in-app routes).

    private void GoToCart()
    {
        Navigation.NavigateTo("/Cart", forceLoad: false);
    }

    private void GoToSettings()
    {
        // Settings page route — may not exist yet. Navigation will land on
        // the not-found page if so, which is acceptable until /Settings is
        // built. Same defensive comment as in Products.razor's GoToSettings.
        Navigation.NavigateTo("/Settings", forceLoad: false);
    }

    // ── Language toggle (EN | FA) ───────────────────────────────────────
    // Single-click switch: clicking EN or FA immediately commits the culture
    // cookie and force-reloads the page. Same behavior as Products.razor's
    // SetCultureAsync. The cookie format/name matches what Program.cs's
    // CookieRequestCultureProvider reads. force-reload so App.razor
    // re-evaluates <html lang/dir> from the new CurrentUICulture and the
    // whole page swaps RTL/LTR + localized strings.
    //
    // If the user clicks the already-active language, we no-op (avoids an
    // unnecessary reload).
    private async Task SetCultureAsync(string culture)
    {
        if (string.Equals(culture, _currentCulture, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        // CRITICAL: CookieRequestCultureProvider expects the cookie VALUE
        // to be in the format `c=<culture>|uic=<ui-culture>` — NOT a bare
        // culture name like `fa-IR`. The `c=` part sets
        // CultureInfo.CurrentCulture (number/date formatting) and `uic=`
        // sets CultureInfo.CurrentUICulture (which .resx file
        // IStringLocalizer picks). We always set both to the same value.
        //
        // Cookie name MUST match `CookieRequestCultureProvider.CookieName`
        // configured in Program.cs (currently `takone_culture`).
        //
        // Brutal Code Review v3 finding #24, part 1: the previous
        // implementation called `JS.InvokeVoidAsync("eval",
        // "document.cookie='takone_culture=...;path=/;max-age=31536000;
        // samesite=strict')` — that's the `eval()` XSS/perf anti-pattern.
        // Replaced by the named JS function `takone.setCultureCookie(culture)`
        // defined in wwwroot/js/culture.js (registered in App.razor's
        // <head>). The JS function builds the cookie value internally so
        // this call site passes ONLY the culture name (a short validated
        // primitive string) — never a full cookie string. Cookie name,
        // value format, and attributes (path=/, max-age=31536000,
        // samesite=strict) are preserved EXACTLY — see culture.js's header
        // comment for the verification.
        await JS.InvokeVoidAsync("takone.setCultureCookie", culture);
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    // ── Theme toggle (sun/moon) ────────────────────────────────────────
    // Flips between tak-light and tak-dark. If the current theme is neither
    // (e.g. user picked "material-dark" via the previous dropdown — now
    // removed, but the saved localStorage value might still be non-Tak),
    // we default to flipping TO tak-light — this way the sun/moon button
    // always lands on a known Tak theme and the icon's meaning stays
    // predictable. Same logic as Products.razor's ToggleThemeAsync.
    //
    // No force-reload needed — theme.js's takTheme.set() swaps the CSS
    // <link> href in-place and appends/removes the override <link> at
    // runtime. The whole page re-paints with the new theme without a
    // round-trip. We just update _currentTheme + StateHasChanged so the
    // sun/moon icon flips too.
    private async Task ToggleThemeAsync()
    {
        var newTheme = _currentTheme == "tak-dark" ? "tak-light" : "tak-dark";

        try
        {
            await JS.InvokeVoidAsync("takTheme.set", newTheme);
            _currentTheme = newTheme;
        }
        catch (JSException)
        {
            // Swallow — same defensive pattern as Products.razor. If
            // theme.js didn't load, the toggle silently fails rather than
            // crashing the Blazor circuit.
        }
    }

    // ── User avatar helpers ─────────────────────────────────────────────
    // Same helpers as Products.razor — they read from ICurrentUserService
    // (injected at the top of this file) so the avatar shows the user's
    // ACTUAL name (not their worker ID) and a localized role label.

    /// <summary>
    /// Returns the first character of the current user's ACTUAL NAME (not
    /// their worker ID / username). Used as the single-letter initial
    /// inside the circle avatar in the top bar — matches the Products
    /// page avatar and the HTML reference design.
    ///
    /// Falls back to "؟" (Persian question mark) if the name is empty/null
    /// (shouldn't happen — ICurrentUserService.FullName falls back to the
    /// worker ID — but defensive).
    /// </summary>
    private string GetUserInitial()
    {
        var name = CurrentUser.FullName?.Trim();
        return string.IsNullOrEmpty(name) ? "؟" : name.Substring(0, 1);
    }

    /// <summary>
    /// Returns the user's access level as a localized label for the avatar
    /// badge. Same priority order + same localization keys as
    /// Products.razor's GetRoleLabel — Admin > Manager > Employee >
    /// ReadOnly > Customer. The labels themselves come from the Products
    /// resource files (read via ProductsLoc) so the two layouts show the
    /// SAME label for the SAME role.
    /// </summary>
    private string GetRoleLabel()
    {
        if (CurrentUser.IsInRole(Roles.Admin)) return ProductsLoc["RoleAdmin"];
        if (CurrentUser.IsInRole(Roles.Manager)) return ProductsLoc["RoleManager"];
        if (CurrentUser.IsInRole(Roles.Employee)) return ProductsLoc["RoleEmployee"];
        if (CurrentUser.IsInRole(Roles.ReadOnly)) return ProductsLoc["RoleReadOnly"];
        if (CurrentUser.IsInRole(Roles.Customer)) return ProductsLoc["RoleCustomer"];
        return ProductsLoc["RoleEmployee"]; // fallback
    }

}