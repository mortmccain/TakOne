@* MainLayout.razor — Phase 0.10 + 0.20
   Radzen-based main layout with:
     - Sidebar with role-gated navigation (uses Roles static class)
     - Header bar with: hamburger toggle, page title, theme switcher,
       language switcher, role badge, display name, logout button
     - Session-expiry warning toast at 55 minutes (5 min before 1h expiry)
     - Notification hub auto-connect on circuit start

   Role-gated nav:
     - Dashboard: Admin, Manager, Employee, ReadOnly (NOT Customer — they
       redirect to /Products and have no dashboard)
     - Products (catalog): everyone (buyers shop here; admins manage)
     - Sales: everyone (their own order history)
     - Cart: everyone except ReadOnly (ReadOnly can't buy)
     - Profile, Settings: everyone
     - Admin section: Admin, Manager, Employee (NOT Customer/ReadOnly) *@

@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ToastService Toast
@inject AuthenticationStateProvider AuthStateProvider
@using System.Globalization

<RadzenLayout>
    @* Sidebar with role-gated navigation *@
    <RadzenSidebar @ref="sidebar" Style="width: 240px;">
        @*
           Component-name fix: the previous draft used `RadzenSidebarMenu` /
           `RadzenSidebarMenuItem`, which DON'T exist in Radzen.Blazor 11.1.1.
           The correct names are `RadzenPanelMenu` / `RadzenPanelMenuItem`.
           (`RadzenSidebar` itself stays — that's the container.)
        *@
        <RadzenPanelMenu>
            <AuthorizeView Roles="@(Roles.Admin + "," + Roles.Manager + "," + Roles.Employee + "," + Roles.ReadOnly)">
                <RadzenPanelMenuItem Text="@Localizer["Dashboard"]" Icon="dashboard" Path="/" />
            </AuthorizeView>

            <AuthorizeView>
                <RadzenPanelMenuItem Text="@Localizer["Products"]" Icon="inventory_2" Path="/Products" />
            </AuthorizeView>

            <AuthorizeView>
                <RadzenPanelMenuItem Text="@Localizer["MyOrders"]" Icon="receipt_long" Path="/Sales" />
            </AuthorizeView>

            <AuthorizeView Roles="@(Roles.Admin + "," + Roles.Manager + "," + Roles.Employee)">
                <RadzenPanelMenuItem Text="@Localizer["Cart"]" Icon="shopping_cart" Path="/Cart" />
            </AuthorizeView>
            <AuthorizeView Roles="@Roles.Customer">
                <RadzenPanelMenuItem Text="@Localizer["Cart"]" Icon="shopping_cart" Path="/Cart" />
            </AuthorizeView>

            @* Admin section — staff only (no customers, no read-only).
               The outer <AuthorizeView> gates the WHOLE group (header +
               children). Its `Context` is renamed to `adminSectionCtx`
               so it doesn't collide with the implicit `context` parameter
               name on the inner <AuthorizeView> elements (Blazor errors
               on nested AuthorizeViews that both use the default name).
               The inner AuthorizeViews each get their own `Context` name
               for the same reason — every nested AuthorizeView in the
               tree must have a unique context name. *@
            <AuthorizeView Context="adminSectionCtx"
                           Roles="@(Roles.Admin + "," + Roles.Manager + "," + Roles.Employee)">
                @* Parent menu item — uses `Text` (not `Title`), and acts as
                   a collapsible group because it has child items. *@
                <RadzenPanelMenuItem Text="@Localizer["AdminSection"]" Icon="admin_panel_settings">
                    <AuthorizeView Context="adminProductsCtx"
                                   Roles="@(Roles.Admin + "," + Roles.Manager + "," + Roles.Employee)">
                        <RadzenPanelMenuItem Text="@Localizer["ManageProducts"]" Icon="inventory" Path="/Admin/Products" />
                    </AuthorizeView>
                    <AuthorizeView Context="adminCategoriesCtx"
                                   Roles="@(Roles.Admin + "," + Roles.Manager + "," + Roles.Employee)">
                        <RadzenPanelMenuItem Text="@Localizer["ManageCategories"]" Icon="category" Path="/Admin/Categories" />
                    </AuthorizeView>
                    <AuthorizeView Context="adminUsersCtx"
                                   Roles="@(Roles.Admin + "," + Roles.Manager)">
                        <RadzenPanelMenuItem Text="@Localizer["ManageUsers"]" Icon="group" Path="/Admin/Users" />
                    </AuthorizeView>
                </RadzenPanelMenuItem>
            </AuthorizeView>

            <AuthorizeView>
                <RadzenPanelMenuItem Text="@Localizer["Profile"]" Icon="account_circle" Path="/Profile" />
            </AuthorizeView>
            <AuthorizeView>
                <RadzenPanelMenuItem Text="@Localizer["Settings"]" Icon="settings" Path="/Settings" />
            </AuthorizeView>
        </RadzenPanelMenu>
    </RadzenSidebar>

    <RadzenBody>
        @* Top header bar.
           NOTE on component choices: a previous version used <RadzenToolBar>,
           <RadzenIconButton>, and <RadzenSpacer>. None of these exist in
           Radzen.Blazor 11.1.1 — the compiler flagged them as "unexpected
           markup element". The replacements are:
             - <RadzenToolBar>  →  plain <div class="takone-toolbar"> with
               flexbox layout (Radzen's CSS already styles children correctly
               because the rz- classes are still on the inner components).
             - <RadzenIconButton Icon="X">  →  <RadzenButton Icon="X"
               Variant="Variant.Text" />  (RadzenButton with Icon= and a Text
               variant behaves as an icon-only button).
             - <RadzenSpacer />  →  <div class="takone-spacer" /> with
               `flex: 1 1 auto` (standard flexbox spacer pattern). *@
        <RadzenHeader>
            <div class="takone-toolbar" style="display: flex; align-items: center; gap: 8px; padding: 8px 16px; min-height: 56px;">
                <RadzenButton Icon="menu" Click="@ToggleSidebar" Variant="Variant.Text" />
                <RadzenText Text="TakOne" Style="font-weight: 600; margin-left: 12px;" />

                <div class="takone-spacer" style="flex: 1 1 auto;"></div>

                @* Theme switcher — Tak custom themes (tak-light) + 10 free Radzen themes.
                   Persisted to localStorage via window.takTheme.set().

                   NOTE on callback choice: an earlier draft used `@bind-Value`
                   + `Change`. RadzenDropDown<T>.Change is EventCallback<object?>
                   (NOT EventCallback<string>), so a lambda `args => Handler(args)`
                   fails with CS1503 "cannot convert from 'object' to 'string'"
                   when Handler takes string. A method group fails too (Blazor
                   can't convert Func<string,Task> to EventCallback<object?>).

                   The fix is to use Radzen's standard ValueChanged callback
                   instead — ValueChanged IS EventCallback<T>, so with
                   TValue="string" it's EventCallback<string>, and the handler
                   `OnThemeChanged(string theme)` matches directly. We drop
                   @bind-Value (since ValueChanged replaces its auto-generated
                   setter) and bind Value + ValueChanged manually. The handler
                   already assigns _selectedTheme, so two-way binding is
                   preserved.

                   DISPLAY NAMES: previously _themes was List<string> and the
                   dropdown showed the raw key ("tak-light", "standard-dark").
                   Now it's List<ThemeOption> so the dropdown shows friendly
                   names ("Tak Light", "Standard Dark") while binding to the
                   underlying key ("tak-light", "standard-dark") via
                   TextProperty="Display" ValueProperty="Key". Same pattern as
                   the currency dropdown on CreateProduct.razor. *@
                <RadzenDropDown Value="_selectedTheme"
                                Data="_themes"
                                TextProperty="Display"
                                ValueProperty="Key"
                                Style="width: 180px;"
                                ValueChanged="@OnThemeChanged"
                                TValue="string" />

                @* Language switcher — Persian (fa-IR, RTL) or English (en-US, LTR) *@
                <RadzenDropDown Value="_selectedCulture"
                                Data="_cultures"
                                Style="width: 120px; margin-left: 8px;"
                                ValueChanged="@OnCultureChanged"
                                TValue="string" />

                @* Role badge + display name + logout (only when authenticated) *@
                <AuthorizeView>
                    <Authorized>
                        <RadzenBadge Text="@_roleBadge" IsPill="true" Style="margin-left: 12px;" />
                        <RadzenText Text="@_displayName" Style="margin-left: 8px;" />
                        <RadzenButton Icon="logout" Click="@DoLogout" Variant="Variant.Text" Style="margin-left: 8px;" />
                    </Authorized>
                </AuthorizeView>
            </div>
        </RadzenHeader>

        <RadzenContent Style="padding: 24px;">
            @Body
        </RadzenContent>
    </RadzenBody>
</RadzenLayout>

<ReconnectModal />

@code {
    private RadzenSidebar? sidebar;
    private string _selectedTheme = "tak-light";

    // Initialize from the current UI culture so the dropdown shows the
    // ACTUAL active culture on first render (was previously hardcoded to
    // "fa-IR" which would show fa-IR even when the server had fallen back
    // to en-US via the Accept-Language header).
    private string _selectedCulture = CultureInfo.CurrentUICulture.Name;

    private string _displayName = string.Empty;
    private string _roleBadge = string.Empty;

    // Theme list — Tak custom themes (tak-light, future tak-dark) appear
    // first as "recommended" options; the 10 free Radzen themes follow as
    // fallbacks. The Display string is what the user sees in the dropdown;
    // the Key is what we persist to localStorage and pass to takTheme.set.
    //
    // To add a new Tak theme:
    //   1. Add the CSS file at wwwroot/css/themes/{key}.css
    //   2. Register the (key, base, override) tuple in TAK_THEMES in
    //      wwwroot/js/theme.js
    //   3. Add a new ThemeOption entry to _themes below
    private readonly List<ThemeOption> _themes = new()
    {
        new(Key: "tak-light",       Display: "Tak Light"),
        new(Key: "standard-dark",   Display: "Standard Dark"),
        new(Key: "standard",        Display: "Standard"),
        new(Key: "material-dark",   Display: "Material Dark"),
        new(Key: "material",        Display: "Material"),
        new(Key: "software-dark",   Display: "Software Dark"),
        new(Key: "software",        Display: "Software"),
        new(Key: "humanistic-dark", Display: "Humanistic Dark"),
        new(Key: "humanistic",      Display: "Humanistic"),
        new(Key: "dark",            Display: "Dark"),
        new(Key: "default",         Display: "Default")
    };

    /// <summary>
    /// Simple (Key, Display) record for binding the theme dropdown. The
    /// RadzenDropDown uses TextProperty="Display" ValueProperty="Key" to
    /// show the friendly name while persisting the underlying theme key.
    /// </summary>
    private sealed record ThemeOption(string Key, string Display);

    private readonly List<string> _cultures = new() { "fa-IR", "en-US" };

    [Inject] private IStringLocalizer<MainLayout> Localizer { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        // Read the current user's name + role for the header badge.
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            _displayName = user.FindFirst("FullName")?.Value
                            ?? user.Identity?.Name
                            ?? "User";
            _roleBadge = string.Join(", ", user.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value));
        }

        // Start the SignalR connection to NotificationHub.
        try
        {
            await JS.InvokeVoidAsync("notificationHub.start");
        }
        catch
        {
            // Non-fatal — UI still works without real-time, just no push refresh.
        }
    }

    // Sync the theme dropdown with the actually-applied theme after the
    // first interactive render.
    //
    // WHY THIS IS NEEDED:
    //   - _selectedTheme is initialized to "tak-light" (the project default)
    //     so the dropdown shows SOMETHING on the very first paint.
    //   - But theme.js's IIFE reads localStorage and applies whatever is
    //     actually saved — which might be "standard", "dark", etc. if the
    //     user previously picked a different theme.
    //   - Without this sync, the dropdown would show "Tak Light" while the
    //     page actually rendered as (say) "Standard" — a confusing mismatch.
    //
    // WHY OnAfterRenderAsync (not OnInitializedAsync):
    //   - OnInitializedAsync runs TWICE in InteractiveServer + prerender:
    //     once during static prerender (no circuit yet — JS interop throws),
    //     and once after hydration (circuit ready — JS interop works).
    //   - Calling JS interop during the prerender pass throws and is noisy.
    //   - OnAfterRenderAsync(firstRender: true) runs ONLY ONCE, after the
    //     circuit is established. JS interop definitely works here.
    //
    // BRIEF FLASH TRADE-OFF:
    //   - The dropdown paints with "Tak Light" on first render, then updates
    //     to the saved theme after this method runs. If the saved theme IS
    //     "tak-light" (the common case for new users), there's no flash.
    //     For users with a different saved theme, the brief flash is
    //     acceptable — the alternative (cookie-based theme sync) adds
    //     complexity for marginal gain.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var saved = await JS.InvokeAsync<string>("takTheme.get");
            // Only update + re-render if the saved theme differs from what
            // the dropdown currently shows. Avoids a needless StateHasChanged
            // call in the common case where saved == "tak-light".
            if (!string.IsNullOrEmpty(saved) && saved != _selectedTheme)
            {
                _selectedTheme = saved;
                StateHasChanged();
            }
        }
        catch
        {
            // If JS interop fails (e.g. theme.js didn't load due to a network
            // error), leave _selectedTheme at its "tak-light" default. The
            // dropdown still works for showing the user's intended theme;
            // only the runtime switch (takTheme.set) would also fail, and
            // that's a separate problem to surface via the error UI.
        }
    }

    private void ToggleSidebar()
    {
        // NOTE on the two earlier compile errors this resolves:
        //
        // 1) "Cannot await 'void'" — RadzenSidebar.Toggle() returns `void`
        //    (not Task) in Radzen.Blazor 11.1.1. The previous draft did
        //    `await sidebar.Toggle();` which failed. We drop the `await`
        //    and just call the method — Toggle() is synchronous, calls
        //    StateHasChanged() internally, and Blazor's `Click` EventCallback
        //    happily binds to a void-returning method.
        //
        // 2) BL0006 "Component parameter 'Expanded' should not be set
        //    outside of its component" — the intermediate workaround mutated
        //    `sidebar.Expanded = !sidebar.Expanded;` directly. `Expanded` is
        //    a [Parameter] on RadzenSidebar, and the Blazor analyzer flags
        //    external writes to [Parameter]s. Calling Toggle() instead
        //    avoids the warning because it's a public method invocation,
        //    not a parameter assignment.
        sidebar?.Toggle();
    }

    private async Task OnThemeChanged(string theme)
    {
        // RadzenDropDown<string>.ValueChanged is EventCallback<string> — not
        // EventCallback<object> — so the parameter type must be `string`.
        // (The previous `object` parameter failed to convert at the call
        // site when @bind-Value was strongly typed to string.)
        _selectedTheme = theme;

        // Delegate ALL theme-swapping logic to wwwroot/js/theme.js. It handles:
        //   - Built-in Radzen themes (single CSS file swap)
        //   - Custom Tak themes (Radzen base + override CSS layer)
        //   - localStorage persistence
        // Keeping the JS as the single source of truth means the FOUC-safe
        // initial-load path and the runtime-switch path use the exact same
        // code — no risk of drift between them.
        //
        // DEFENSIVE TRY/CATCH: if theme.js failed to load for any reason
        // (network error, browser extension blocking it, stale cached OLD
        // version that didn't yet define window.takTheme, etc.), the JS
        // interop call throws JSException. WITHOUT this catch, that exception
        // escapes the EventCallback and crashes the Blazor circuit — the user
        // sees a "Reconnect" modal and loses their current page state. WITH
        // this catch, the dropdown still updates (we set _selectedTheme above)
        // but the actual theme swap silently fails. The user can retry by
        // reloading the page, which re-runs theme.js's IIFE.
        try
        {
            await JS.InvokeVoidAsync("takTheme.set", theme);
        }
        catch (JSException)
        {
            // Swallow — see comment above. StateHasChanged is implicit
            // because EventCallback methods trigger a re-render after
            // they return (even partially).
        }
    }

    private async Task OnCultureChanged(string culture)
    {
        _selectedCulture = culture;

        // CRITICAL: CookieRequestCultureProvider expects the cookie VALUE
        // to be in the format `c=<culture>|uic=<ui-culture>` — NOT a bare
        // culture name like `fa-IR`. The previous implementation wrote
        // `takone_culture=fa-IR` which the provider couldn't parse, so
        // it returned null and the default culture kicked in (always
        // fa-IR regardless of what the user picked). The language
        // switcher appeared to do nothing.
        //
        // The `c=` part sets CultureInfo.CurrentCulture (number/date
        // formatting) and `uic=` sets CultureInfo.CurrentUICulture
        // (which .resx file IStringLocalizer picks). We always set both
        // to the same value.
        //
        // Cookie name MUST match `CookieRequestCultureProvider.CookieName`
        // configured in Program.cs (currently `takone_culture`).
        var cookieValue = $"c={culture}|uic={culture}";
        await JS.InvokeVoidAsync("eval",
            $"document.cookie = 'takone_culture={cookieValue}; path=/; max-age=31536000; samesite=strict'");

        // forceLoad:true triggers a full HTTP request so the new cookie
        // is sent back to the server and the localization middleware
        // can re-evaluate the culture. Without forceLoad, Blazor's
        // interactive navigation wouldn't trigger a fresh HTTP request
        // and the culture wouldn't change.
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    private void DoLogout()
    {
        Navigation.NavigateTo("/Account/Logout", forceLoad: true);
    }
}