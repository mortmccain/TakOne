@* ShopLayout.razor — full-screen shop layout (no default top bar)
   Used by /Products (and potentially /Cart in the future) to get a
   full-screen shop experience without the MainLayout top bar.

   DIFFERENCES FROM MainLayout:
     - NO top bar (the shop page provides its own header inside @Body
       via the .tm-shop-header element in Products.razor)
     - The sidebar is the SAME shared SidebarContent component as MainLayout
       (brand block + nav + support card)
     - The sidebar toggle (hamburger) is controlled by the shop page itself
       via the public ToggleSidebar() method on this layout.

   WHY A SEPARATE LAYOUT (instead of a "hide header" flag on MainLayout):
     Blazor layouts don't easily let a child page set parameters on its
     host layout. The canonical Blazor pattern for "this page has a
     different chrome" is a separate layout (same as LoginLayout.razor).
     This keeps MainLayout stable for all other pages. *@

@inherits LayoutComponentBase
@inject IJSRuntime JS

<RadzenLayout>
    @* Sidebar — same shared SidebarContent as MainLayout. The sidebar
       uses plain HTML nav items (not RadzenPanelMenu) styled to match
       the HTML reference design. See SidebarContent.razor. *@
    <RadzenSidebar @ref="sidebar" Style="width: 240px;">
        <SidebarContent />
    </RadzenSidebar>

    <RadzenBody>
        @* NO top bar here — the shop page provides its own header
           inside @Body (the .tm-shop-header element in Products.razor).
           The shop header is sticky (position: sticky; top: 0) so it
           behaves like a top bar without needing RadzenHeader. *@
        <RadzenContent Style="padding: 0;">
            @* Wrap @Body in a CascadingValue so child pages (Products.razor)
               can receive this layout instance via [CascadingParameter] and
               call ToggleSidebar() on it. This is the standard Blazor pattern
               for a page-to-layout method call. *@
            <CascadingValue Value="this" TValue="ShopLayout">
                @Body
            </CascadingValue>
        </RadzenContent>
    </RadzenBody>
</RadzenLayout>

@* ── RADZEN HOST COMPONENTS ────────────────────────────────────────────
   Same set as MainLayout.razor — required for DialogService /
   NotificationService / TooltipService to actually render their UI.
   See the long comment in MainLayout.razor for the full rationale
   (the cancel-confirmation-button-was-dead bug these fixed). Adding
   them here too so toasts/dialogs work on /Products (ShopLayout) as
   well as on /Sales/{id} and every other MainLayout page.
*@
<RadzenDialog />
<RadzenNotification />
<RadzenTooltip />

<ReconnectModal />

@code {
    private RadzenSidebar? sidebar;

    protected override async Task OnInitializedAsync()
    {
        // Start the SignalR connection to NotificationHub (same as MainLayout).
        try
        {
            await JS.InvokeVoidAsync("notificationHub.start");
        }
        catch
        {
            // Non-fatal — UI still works without real-time, just no push refresh.
        }
    }

    /// <summary>
    /// Toggles the sidebar's collapsed/expanded state. Called by the
    /// shop page's hamburger button via a public method on this layout.
    /// </summary>
    public void ToggleSidebar()
    {
        sidebar?.Toggle();
    }
}