@* ShopLayout.razor — full-screen shop layout (no default top bar)
   Used by /Products (and potentially /Cart in the future) to get a
   full-screen shop experience without the MainLayout top bar.

   DIFFERENCES FROM MainLayout:
     - NO top bar (the shop page provides its own header inside @Body
       via the .tm-shop-header element in Products.razor)
     - The sidebar is the SAME shared SidebarContent component as MainLayout
       (brand block + nav + support card)
     - The sidebar toggle (hamburger) is controlled by the shop page itself
       via the public ToggleSidebar() method on this layout.

   WHY A SEPARATE LAYOUT (instead of a "hide header" flag on MainLayout):
     Blazor layouts don't easily let a child page set parameters on its
     host layout. The canonical Blazor pattern for "this page has a
     different chrome" is a separate layout (same as LoginLayout.razor).
     This keeps MainLayout stable for all other pages. *@

@inherits LayoutComponentBase
@inject IJSRuntime JS

<RadzenLayout>
    @* Sidebar — same shared SidebarContent as MainLayout. The sidebar
       uses plain HTML nav items (not RadzenPanelMenu) styled to match
       the HTML reference design. See SidebarContent.razor. *@
    <RadzenSidebar @ref="sidebar" Style="width: 240px;">
        <SidebarContent />
    </RadzenSidebar>

    <RadzenBody>
        @* NO top bar here — the shop page provides its own header
           inside @Body (the .tm-shop-header element in Products.razor).
           The shop header is sticky (position: sticky; top: 0) so it
           behaves like a top bar without needing RadzenHeader. *@
        <RadzenContent Style="padding: 0;">
            @* Wrap @Body in a CascadingValue so child pages (Products.razor)
               can receive this layout instance via [CascadingParameter] and
               call ToggleSidebar() on it. This is the standard Blazor pattern
               for a page-to-layout method call.

               Round 18-A / Brutal Review Fix #34: wrap @Body in <ErrorBoundary>
               so an unhandled render exception in a ShopLayout child page
               (e.g. Products.razor throwing on a null product DTO) is caught
               at the BODY boundary instead of bubbling up + killing the
               circuit. The sidebar stays rendered so the user can navigate
               away or hit Retry. The boundary is INSIDE RadzenContent (the
               body region) so the sidebar is OUTSIDE the boundary — by design.
               Recover() re-renders ChildContent; if the same exception re-
               throws, the boundary re-displays ErrorContent (no infinite
               loop — the boundary captures render exceptions only). *@
            <CascadingValue Value="this" TValue="ShopLayout">
                <ErrorBoundary @ref="_bodyErrorBoundary">
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <ErrorContent Context="ex">
                        <div class="error-boundary-content" style="padding:2rem;text-align:center;">
                            <h3>خطایی رخ داد / An error occurred</h3>
                            <p style="color: var(--rz-text-secondary-color); margin: 0.5rem 0 1rem;">@ex.Message</p>
                            <button class="tm-icon-button"
                                    style="border:1px solid var(--rz-border-base-color); padding:0.5rem 1.25rem; border-radius:6px; background: var(--rz-base-background-color); cursor:pointer;"
                                    @onclick="RetryBodyError">
                                تلاش مجدد / Retry
                            </button>
                        </div>
                    </ErrorContent>
                </ErrorBoundary>
            </CascadingValue>
        </RadzenContent>
    </RadzenBody>
</RadzenLayout>

@* ── RADZEN HOST COMPONENTS ────────────────────────────────────────────
   Same set as MainLayout.razor — required for DialogService /
   NotificationService / TooltipService to actually render their UI.
   See the long comment in MainLayout.razor for the full rationale
   (the cancel-confirmation-button-was-dead bug these fixed). Adding
   them here too so toasts/dialogs work on /Products (ShopLayout) as
   well as on /Sales/{id} and every other MainLayout page.
*@
<RadzenDialog />
<RadzenNotification />
<RadzenTooltip />

<ReconnectModal />

@code {
    private RadzenSidebar? sidebar;

    // Round 18-A / Brutal Review Fix #34: ErrorBoundary ref for the body
    // wrapper. Recover() re-renders the ChildContent (the @Body). If the
    // child re-throws the same exception on re-render, the boundary will
    // re-display the ErrorContent — no infinite loop (the boundary catches
    // render-time exceptions only).
    private ErrorBoundary? _bodyErrorBoundary;

    private void RetryBodyError()
    {
        _bodyErrorBoundary?.Recover();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Start the SignalR connection to NotificationHub (same as
        // MainLayout). MUST run in OnAfterRenderAsync(firstRender) — NOT
        // OnInitializedAsync: during static SSR prerendering there is no
        // JS runtime, so JS interop in OnInitializedAsync throws
        // InvalidOperationException on EVERY prerender of every ShopLayout
        // page (silently swallowed by the catch below, but each one is a
        // wasted exception + log entry). After the circuit is established
        // the interop succeeds. See the identical pattern in MainLayout's
        // OnAfterRenderAsync for the full rationale.
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("notificationHub.start");
            }
            catch
            {
                // Non-fatal — UI still works without real-time, just no push refresh.
            }
        }
    }

    /// <summary>
    /// Toggles the sidebar's collapsed/expanded state. Called by the
    /// shop page's hamburger button via a public method on this layout.
    /// </summary>
    public void ToggleSidebar()
    {
        sidebar?.Toggle();
    }
}