    /// <summary>
    /// Localized kind label — same titles as the Notifications feed and
    /// the desktop Settings card, so a kind means the same thing
    /// everywhere it appears.
    /// </summary>
    private string GetNotifPrefName(NotificationKind kind) => kind switch
    {
        NotificationKind.SaleSubmitted => Loc["NotifPrefName_Submitted"],
        NotificationKind.SaleApproved => Loc["NotifPrefName_Approved"],
        NotificationKind.SaleInvoiced => Loc["NotifPrefName_Invoiced"],
        NotificationKind.SaleCancelled => Loc["NotifPrefName_Cancelled"],
        NotificationKind.Broadcast => Loc["NotifPrefName_Broadcast"],
        NotificationKind.AppUpdate => Loc["NotifPrefName_AppUpdate"],
        NotificationKind.GroupChanged => Loc["NotifPrefName_GroupChanged"],
        _ => kind.ToString()
    };

