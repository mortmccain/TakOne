@* MobileProducts.razor — mobile version of the Products (shop) page.
   Route: /m/Products
   Layout: MobileLayout

   PORTS ALL PC Products page features:
     - Per-product qty selector (− value +)
     - Grayed-out Add button (stock out, limit reached, salary reached, read-only)
     - Salary budget cap on qty max + Add button
     - Purchase limit cap on qty max + Add button
     - Read-only user check (ReadOnly role without shopping roles)
     - Quick reorder button
     - Cart reload after add (so remaining limits reflect reality)
*@

@page "/m/Products"
@attribute [Authorize]
@layout TakOne.WebUI.Components.Layout.MobileLayout.MobileLayout
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Wolverine
@using TakOne.Application.Common.Authorization
@using TakOne.Application.Common.Interfaces
@using TakOne.Application.Products.DTOs
@using TakOne.Application.Products.Queries.GetProductsPaginated
@using TakOne.Application.Categories.DTOs
@using TakOne.Application.Categories.Queries.GetActiveCategories
@using TakOne.Application.Sales.DTOs
@using TakOne.Application.Sales.Queries.GetActiveCartForUser
@using TakOne.Application.Sales.Commands.CreateOrAppendSale
@using TakOne.Application.Sales.Commands.QuickReorderLastSale
@using TakOne.SharedKernel.Common
@using TakOne.SharedKernel.DTOs
@using TakOne.WebUI.Services
@inject IMessageBus MessageBus
@inject ICurrentUserService CurrentUser
@inject NavigationManager Navigation
@inject IStringLocalizer<MobileProducts> Loc
@inject ToastService Toast
@inject ErrorDisplayService ErrorDisplay
@inject IJSRuntime JS

<PageTitle>@Loc["PageTitle"]</PageTitle>

@if (_isLoading)
{
    @* Skeleton shaped like the real layout: budget card + category chips
       + hero + 4 product cards. Perceived-load is faster than a single
       spinner because the user sees the page's structure take shape. *@
    <div class="m-skeleton-card" aria-busy="true" aria-live="polite">
        <div class="m-skeleton m-skeleton-line short"></div>
        <div class="m-skeleton m-skeleton-line long"></div>
        <div class="m-skeleton m-skeleton-block" style="height: 0.5rem; margin-top: 0.5rem;"></div>
    </div>
    <div class="m-cat-scroll" style="margin-bottom: 1rem;">
        @for (var i = 0; i < 4; i++)
        {
            <div class="m-skeleton" style="width: 4.5rem; height: 4.5rem; border-radius: 1rem; flex-shrink: 0;"></div>
        }
    </div>
    <div class="m-hero" style="background: var(--tm-surface-muted, var(--tm-cream));">
        <div class="m-hero-content">
            <div class="m-skeleton m-skeleton-line short" style="margin-bottom: 0.5rem;"></div>
            <div class="m-skeleton m-skeleton-line medium"></div>
        </div>
    </div>
    <div class="m-products">
        @for (var i = 0; i < 4; i++)
        {
            <div class="m-product-card">
                <div class="m-product-image">
                    <div class="m-skeleton" style="width: 100%; height: 100%; border-radius: 0.75rem;"></div>
                </div>
                <div class="m-product-body">
                    <div class="m-skeleton m-skeleton-line long"></div>
                    <div class="m-skeleton m-skeleton-line short" style="margin-top: 0.5rem;"></div>
                    <div class="m-product-actions">
                        <div class="m-skeleton" style="width: 4.5rem; height: 2rem; border-radius: 0.5rem;"></div>
                        <div class="m-skeleton" style="width: 3rem; height: 2rem; border-radius: 0.5rem;"></div>
                    </div>
                </div>
            </div>
        }
    </div>
    <span class="sr-only">@Loc["Loading"]</span>
}
else
{
    @* ── 1. Budget / salary card ── *@
    <div class="m-budget-card">
        <div class="m-budget-content">
            <div class="m-budget-info">
                <p class="m-budget-label">@Loc["BudgetRemaining"]</p>
                <p class="m-budget-amount">@FormatBudgetAmount()</p>
                @if (_budgetConsumedPercent > 0)
                {
                    <div class="m-budget-bar-container">
                        <div class="m-budget-bar-info">
                            <span>@Loc["BudgetUsed"]</span>
                            <span>@CultureFormat.FormatPercent(_budgetConsumedPercent, 0)</span>
                        </div>
                        <div class="m-budget-bar-track">
                            <div class="m-budget-bar-fill" style="width: @($"{_budgetConsumedPercent:P0}")"></div>
                        </div>
                    </div>
                }
            </div>
            <div class="m-budget-icon">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" style="width: 1.75rem; height: 1.75rem;">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m3.75 0h7.5M3 5.25h18a.75.75 0 01.75.75v12a.75.75 0 01-.75.75H3a.75.75 0 01-.75-.75V6a.75.75 0 01.75-.75z" />
                </svg>
            </div>
        </div>
    </div>

    @* ── Search filter chip (shows when search is active, with X to clear) ── *@
    @if (!string.IsNullOrWhiteSpace(_searchTerm))
    {
        <div class="m-search-chip">
            <span>@Loc["SearchResultsFor"]</span>
            <strong>"@_searchTerm"</strong>
            <button class="m-search-chip-clear" @onclick="ClearSearch">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" style="width: 14px; height: 14px;">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
    }

    @* ── 2. Category chips ── *@
    <div class="m-section">
        <div class="m-section-header">
            <h2 class="m-section-title">@Loc["Categories"]</h2>
        </div>
        <div class="m-cat-scroll">
            <button class="m-cat-chip @(_selectedCategoryId is null ? "active" : "")"
                    @onclick="() => SelectCategory(null)">
                <div class="m-cat-icon">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" style="width: 1.5rem; height: 1.5rem;">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
                    </svg>
                </div>
                <span class="m-cat-label">@Loc["AllCategories"]</span>
            </button>
            @foreach (var cat in _categories)
            {
                <button class="m-cat-chip @(_selectedCategoryId == cat.Id ? "active" : "")"
                        @onclick="() => SelectCategory(cat.Id)">
                    <div class="m-cat-icon">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" style="width: 1.5rem; height: 1.5rem;">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
                        </svg>
                    </div>
                    <span class="m-cat-label">@cat.Name</span>
                </button>
            }
        </div>
    </div>

    @* ── 2b. Shop toolbar (Round 4 sort + QA-11 parity) ──
       Wraps the Round-4 sort control with the two QA-10 desktop-parity
       affordances: the staff "include out of stock" chip (Admin/Manager)
       and the catalog CSV export button. flex-wrap keeps the row sane on
       360px screens (chip wraps to its own line before the sort group
       does). The sort select keeps its Round-4 semantics: SERVER-side
       ordering, so the whole loaded list re-orders (not just the rendered
       cards) and the order survives category + search filters. *@
    <div class="m-shop-toolbar">
        @* STAFF VIEW MODE (QA-11 — desktop-parity port): Admin/Manager
           only. Same contract as the desktop chip: the flag rides the
           SAME GetProductsPaginatedQuery the list AND the CSV export
           issue, and the handler CLAMPS IncludeInactive to false for
           every other role SERVER-side — this gate is convenience, not
           authorization. Persists as oos=1 in the URL (only ever written
           for staff) so it survives the add-to-cart forceLoad reload.
           aria-pressed is a LITERAL STRING — Blazor omits boolean-false
           attributes, and aria-pressed="false" is meaningful ARIA (the
           same workaround the desktop chip uses). *@
        @if (_canSeeInactive)
        {
            <button type="button"
                    class="m-oos-chip @(_includeInactive ? "m-oos-chip--active" : "")"
                    title="@Loc["ShowStockOutTooltip"]"
                    aria-pressed="@(_includeInactive ? "true" : "false")"
                    disabled="@_isLoading"
                    @onclick="ToggleIncludeInactiveAsync">
                @if (_includeInactive)
                {
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" width="15" height="15" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                }
                else
                {
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" width="15" height="15" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
                    </svg>
                }
                <span>@Loc["ShowStockOutChip"]</span>
            </button>
        }
        <div class="m-sort-group">
            <label class="m-sort-label" for="m-products-sort">@Loc["SortLabel"]</label>
            <select id="m-products-sort"
                    class="m-sort-select"
                    value="@_sortBy.ToString()"
                    @onchange="OnSortChanged"
                    disabled="@_isLoading">
                <option value="@nameof(ProductSortBy.Name)">@Loc["SortByName"]</option>
                <option value="@nameof(ProductSortBy.PriceLowToHigh)">@Loc["SortPriceLowToHigh"]</option>
                <option value="@nameof(ProductSortBy.PriceHighToLow)">@Loc["SortPriceHighToLow"]</option>
            </select>
        </div>
        @* CATALOG CSV EXPORT (QA-11 — desktop-parity port): the SAME
           customer-safe 7-column download the desktop shop ships (name,
           category path, price, currency, availability label — no stock
           quantities, no picture columns). Exports parity with the list:
           current search/category/sort AND the staff out-of-stock view
           mode. Disabled while any load runs or the list is empty. *@
        <button type="button"
                class="m-export-btn"
                title="@Loc["ExportCsvTooltip"]"
                aria-label="@Loc["ExportCsvTooltip"]"
                disabled="@(_isLoading || _isExporting || _totalCount == 0)"
                @onclick="ExportProductsCsvAsync">
            @if (_isExporting)
            {
                <span class="m-export-spin" aria-hidden="true"></span>
            }
            else
            {
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" width="15" height="15" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5 5-5M12 15V3" />
                </svg>
            }
            <span>@(_isExporting ? Loc["ExportCsvWorking"] : Loc["ExportCsvButton"])</span>
        </button>
    </div>

    @* ── 3. Hero banner ── *@
    <div class="m-hero">
        <div class="m-hero-content">
            <span class="m-hero-badge">
                <span class="m-pulse-dot"></span>
                @Loc["HeroBadge"]
            </span>
            <h3 class="m-hero-title">@Loc["HeroTitle"]</h3>
            <button class="m-hero-btn" @onclick="GoToMyOrders">
                @Loc["HeroButton"]
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" style="width: 12px; height: 12px;">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg>
            </button>
        </div>
    </div>

    @* ── 4. Product list (1 column, with qty selector + grayed-out logic) ── *@
    <div class="m-products">
        @if (_products.Count == 0)
        {
            <p class="m-empty">@Loc["NoProducts"]</p>
        }
        else
        {
            @foreach (var product in _products)
            {
                var remaining = GetRemainingForProduct(product);
                var qty = GetQtyForProduct(product.Id);
                var limitReached = remaining <= 0;
                var stockOut = product.StockQuantity <= 0;
                var budget = _cart?.BudgetInfo;
                var unitPrice = product.Price?.Amount ?? 0m;
                var salaryReached = budget is not null
                    && (qty * unitPrice) > budget.Remaining;
                var disabled = limitReached || stockOut || salaryReached || _isAddingAny;

                <div class="m-product-card @(stockOut ? "m-product-card--out" : "")">
                    <div class="m-product-image" @onclick="() => GoToProduct(product.Id)">
                        @if (!string.IsNullOrWhiteSpace(product.PictureUrl))
                        {
                            <img src="@product.PictureUrl" alt="@product.Name" loading="lazy" />
                        }
                        else
                        {
                            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" style="color: var(--tm-gray);">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5z" />
                            </svg>
                        }
                        @if (stockOut)
                        {
                            <span class="m-stock-badge m-stock-out">@Loc["StockOut"]</span>
                        }
                        else if (product.StockQuantity <= 10)
                        {
                            <span class="m-stock-badge m-stock-low">@Loc["StockLow"]</span>
                        }
                        else
                        {
                            <span class="m-stock-badge m-stock-in">@Loc["StockIn"]</span>
                        }
                    </div>
                    <div class="m-product-body">
                        <h4 class="m-product-name" @onclick="() => GoToProduct(product.Id)">@product.Name</h4>
                        <p class="m-product-price">@FormatPrice(product.Price)</p>

                        <div class="m-product-actions">
                            <div class="m-qty-selector">
                                <button type="button" class="m-qty-btn"
                                        disabled="@(qty <= 1 || _isReadOnly)"
                                        @onclick="(() => DecrementQty(product.Id))">
                                    −
                                </button>
                                <span class="m-qty-value">@CultureFormat.FormatDigits(qty)</span>
                                <button type="button" class="m-qty-btn"
                                        disabled="@(qty >= GetQtyMaxForProduct(product) || _isReadOnly)"
                                        @onclick="(() => IncrementQty(product.Id))">
                                    +
                                </button>
                            </div>

                            @if (_isReadOnly)
                            {
                                <button type="button" class="m-add-btn m-add-btn-full" disabled
                                        title="@Loc["AddButtonReadOnlyTitle"]">
                                    @Loc["AddButtonReadOnly"]
                                </button>
                            }
                            else if (limitReached && !stockOut)
                            {
                                <button type="button" class="m-add-btn m-add-btn-full" disabled
                                        title="@Loc["AddButtonLimitReachedTitle"]">
                                    @Loc["AddButtonLimitReached"]
                                </button>
                            }
                            else if (salaryReached && !stockOut)
                            {
                                <button type="button" class="m-add-btn m-add-btn-full" disabled
                                        title="@Loc["AddButtonSalaryReachedTitle"]">
                                    @Loc["AddButtonSalaryReached"]
                                </button>
                            }
                            else if (stockOut)
                            {
                                <button type="button" class="m-add-btn m-add-btn-full" disabled>
                                    @Loc["AddButtonStockOut"]
                                </button>
                            }
                            else
                            {
                                <button type="button" class="m-add-btn"
                                        disabled="@_isAddingAny"
                                        @onclick="() => AddToCartAsync(product)">
                                    @if (_isAddingAny)
                                    {
                                        <span>…</span>
                                    }
                                    else
                                    {
                                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" style="width: 16px; height: 16px;">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                                        </svg>
                                        <span>@Loc["AddButtonText"]</span>
                                    }
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    @* ── 4b. Count + Load more (QA-11) ──
       The old mobile page requested one silent 50-row page and never
       hinted that more existed. Now: a count line ("Showing 1–24 of 87",
       tabular digits so the number doesn't jitter between reloads) and
       a full-width "Load more" button WHILE more pages remain — the
       append-style mobile pagination the broadcasts page already uses.
       Both hide on a single-page catalog (no noise for small shops). *@
    @if (_totalCount > 0 && _products.Count > 0)
    {
        <div class="m-products-meta">
            <span class="m-products-count">
                @Loc["ShowingCount",
                    CultureFormat.FormatDigits(1),
                    CultureFormat.FormatDigits(Math.Min(_products.Count, _totalCount)),
                    CultureFormat.FormatDigits(_totalCount)]
            </span>
        </div>
        @if (_products.Count < _totalCount)
        {
            <div class="m-load-more">
                <button type="button"
                        class="m-load-more-btn"
                        disabled="@(_isLoadingMore || _isExporting)"
                        @onclick="LoadMoreAsync">
                    @if (_isLoadingMore)
                    {
                        <span class="m-export-spin" aria-hidden="true"></span>
                        <span>@Loc["LoadingMore"]</span>
                    }
                    else
                    {
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" width="16" height="16" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m0 0l6.75-6.75M12 19.5l-6.75-6.75" />
                        </svg>
                        <span>@Loc["LoadMore"]</span>
                    }
                </button>
            </div>
        }
    }

    @* ── 5. Quick reorder button ── *@
    <div class="m-reorder-section">
        <button class="m-reorder-btn" disabled="@(_isReordering || _isReadOnly)" @onclick="QuickReorderAsync">
            @if (_isReordering)
            {
                <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" />
            }
            else
            {
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" style="width: 18px; height: 18px;">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                </svg>
            }
            @Loc["QuickReorder"]
        </button>
    </div>

    @* ── 6. Support card ──
       The "Call" button (tel:0211234 link) was REMOVED per the launch
       directive — the support card now shows only the support title +
       hours, with no call-to-action phone number rendered. The
       .m-support-call-btn CSS class is kept in mobile.css for backward-
       compatibility. *@
    <div class="m-support-card">
        <div class="m-support-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" style="width: 20px; height: 20px;">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
        </div>
        <div class="m-support-text">
            <p class="m-support-title">@Loc["SupportTitle"]</p>
            <p class="m-support-hours">@Loc["SupportHours"]</p>
        </div>
    </div>
}

@code {
    // ── State ──
    private List<ProductListItemDto> _products = new();
    private List<CategoryDto> _categories = new();
    private Guid? _selectedCategoryId;
    private string _searchTerm = string.Empty;

    // ── Pagination (QA-11 — append-style "load more") ──
    // The old mobile page fetched ONE silent 50-row page and never
    // hinted that more existed. 24 rows per page (≈ 3 screens of cards)
    // keeps payloads light; LoadMoreAsync appends the next page.
    private const int MobilePageSize = 24;
    private int _pageNumber = 1;
    private int _totalCount;
    private bool _isLoadingMore;

    // ── Staff view mode (QA-11 — desktop-parity port) ──
    // Admin/Manager only; the handler CLAMPS IncludeInactive to false
    // for every other role SERVER-side, so these are UX gates, not
    // authorization. oos=1 in the URL restores the mode (staff only).
    private bool _canSeeInactive;
    private bool _includeInactive;

    // ── CSV export (QA-11 — desktop-parity port) ──
    private bool _isExporting;

    /// <summary> Row cap for the CSV export loop (same as the desktop shop). </summary>
    private const int ExportRowCap = 2000;

    /// <summary>
    /// The active catalog sort (Round 4) — same orders as the desktop
    /// shop; server-side, so the whole loaded page re-orders.
    /// </summary>
    private ProductSortBy _sortBy = ProductSortBy.Name;

    private bool _isLoading = true;
    private bool _isReadOnly;

    // Cart + budget state (loaded from GetActiveCartForUserQuery)
    private CartDto? _cart;

    // Per-product quantity selector state. Keyed by ProductId.
    private readonly Dictionary<Guid, int> _qtyByProduct = new();

    // GLOBAL add-to-cart guard (prevents concurrent CreateOrAppendSaleCommand)
    private bool _isAddingAny;
    private bool _isReordering;

    // Budget info for the salary card display
    private decimal _budgetSalary;
    private decimal _budgetConsumed;
    private string _budgetCurrency = "IRR";
    private decimal _budgetConsumedPercent => _budgetSalary > 0 ? Math.Min(1m, _budgetConsumed / _budgetSalary) : 0m;

    // ── Lifecycle ──

    private bool _isInitialized;

    protected override async Task OnParametersSetAsync()
    {
        // Don't process parameters until OnInitializedAsync has run
        // (it loads the initial data). After init, this catches URL
        // changes (e.g. user typed in the header search bar).
        if (!_isInitialized) return;

        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var newSearch = string.Empty;
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("search", out var searchValue))
        {
            newSearch = searchValue.ToString();
        }

        if (newSearch != _searchTerm)
        {
            _searchTerm = newSearch;
            _isLoading = true;
            StateHasChanged();
            // Search change = new result set: restart from page 1 with a
            // FRESH list (not append — the old rows belong to the old
            // search term).
            _pageNumber = 1;
            await LoadProductsAsync();
            _isLoading = false;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Read search term from query string
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("search", out var searchValue))
        {
            _searchTerm = searchValue.ToString();
        }

        // STAFF VIEW MODE (QA-11): resolve the role gate BEFORE the URL
        // restore parses ?oos=1 — a customer opening a staff-shared link
        // keeps the in-stock view locally (mirroring the handler's
        // server-side clamp; the ignored flag is harmless).
        _canSeeInactive = CurrentUser.IsInRole(Roles.Admin)
                       || CurrentUser.IsInRole(Roles.Manager);
        if (_canSeeInactive
            && Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("oos", out var oosValue)
            && oosValue.ToString() == "1")
        {
            _includeInactive = true;
        }

        // Determine if user is read-only (same logic as PC Products page)
        var canShop = CurrentUser.IsInRole(Roles.Customer)
                      || CurrentUser.IsInRole(Roles.Employee)
                      || CurrentUser.IsInRole(Roles.Manager)
                      || CurrentUser.IsInRole(Roles.Admin);
        _isReadOnly = CurrentUser.IsInRole(Roles.ReadOnly) && !canShop;

        try
        {
            await Task.WhenAll(LoadProductsAsync(), LoadCategoriesAsync(), LoadCartAsync());
        }
        finally
        {
            _isLoading = false;
            _isInitialized = true;
        }
    }

    // ── Data loading ──

    /// <summary>
    /// The sort control's change handler: parse the picked key and
    /// reload (the sort rides in SQL with the category/search filters).
    /// A sort change re-orders the WHOLE result set, so paging restarts
    /// at page 1 with a fresh list (never an append).
    /// </summary>
    private async Task OnSortChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<ProductSortBy>(e.Value?.ToString(), ignoreCase: false, out var sortBy))
        {
            _sortBy = sortBy;
            _pageNumber = 1;
            await LoadProductsAsync();
        }
    }

    /// <summary>
    /// Loads one page of the catalog at <see cref="_pageNumber"/>.
    /// <paramref name="append"/> (load-more) ADDS rows to the existing
    /// list; every filter/sort/view-mode change calls it with
    /// <paramref name="append"/> = false (a fresh result set replaces
    /// the old rows). Always passes <see cref="_includeInactive"/> — the
    /// handler clamps it for non-staff roles server-side.
    /// </summary>
    private async Task LoadProductsAsync(bool append = false)
    {
        try
        {
            var query = new GetProductsPaginatedQuery
            {
                PageNumber = _pageNumber,
                PageSize = MobilePageSize,
                SortBy = _sortBy,
                SearchTerm = string.IsNullOrWhiteSpace(_searchTerm) ? null : _searchTerm.Trim(),
                CategoryId = _selectedCategoryId,
                // Staff view mode (QA-11): include zero-stock products
                // for Admin/Manager. Safe to pass unconditionally — the
                // handler clamps this to false for every other role.
                IncludeInactive = _includeInactive
            };
            var result = await MessageBus.InvokeAsync<PaginatedResult<ProductListItemDto>>(query);
            _totalCount = result.TotalCount;
            if (append)
            {
                _products.AddRange(result.Items);
            }
            else
            {
                _products = result.Items.ToList();
            }

            // Initialize qty selectors to 1 for new products
            foreach (var p in _products)
            {
                if (!_qtyByProduct.ContainsKey(p.Id))
                    _qtyByProduct[p.Id] = 1;
            }
        }
        catch { }
    }

    /// <summary>
    /// "Load more" (QA-11): appends the NEXT page to the list — the
    /// append-style mobile pagination the broadcasts page uses. Guarded
    /// against double-taps; a no-op when the last page is already loaded.
    /// </summary>
    private async Task LoadMoreAsync()
    {
        if (_isLoadingMore || _isExporting) return;
        if (_products.Count >= _totalCount) return;

        _isLoadingMore = true;
        try
        {
            _pageNumber++;
            await LoadProductsAsync(append: true);
        }
        finally
        {
            _isLoadingMore = false;
        }
    }

    /// <summary>
    /// Toggles the staff "include out of stock" view mode (QA-11 —
    /// desktop-parity port) and reloads from page 1: the result set
    /// changes wholesale when zero-stock cards join the list, so page 3
    /// of the in-stock list means something different after the flip.
    ///
    /// Export parity is automatic: the list load AND the CSV loop pass
    /// <c>IncludeInactive</c> to the SAME query.
    ///
    /// The flag persists as <see cref="UpdateOosUrl"/> (replace, not
    /// push — no history spam) so it survives the add-to-cart full-page
    /// reload and a manual refresh. Deliberately NOT reset by search /
    /// category changes — it is a role-gated VIEW MODE whose own chip is
    /// the single, always-visible way back.
    /// </summary>
    private async Task ToggleIncludeInactiveAsync()
    {
        _includeInactive = !_includeInactive;
        _pageNumber = 1;
        UpdateOosUrl();
        await LoadProductsAsync();
    }

    /// <summary>
    /// Mirrors the staff view mode into the URL as oos=1 (or removes it)
    /// WITHOUT touching any other query parameter (the header search
    /// bar's ?search= survives). Replace-not-push: toggling is not
    /// navigation. Only ever CALLED from the chip's event handler, so it
    /// can never run during the static prerender pass (NavigateTo
    /// throws there) — the same reason the desktop shop's URL mirror
    /// needs an interactive guard but this one does not.
    /// </summary>
    private void UpdateOosUrl()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        string? oosValue = _includeInactive ? "1" : null;
        string? existing = query.TryGetValue("oos", out var v) ? v.ToString() : null;
        if (string.Equals(existing, oosValue, StringComparison.Ordinal))
        {
            return; // unchanged — skip the navigation entirely
        }

        // Rebuild the query WITHOUT oos, then re-add it only when on —
        // preserves every other parameter (search, future contracts).
        var parameters = new Dictionary<string, string?>();
        foreach (var (key, value) in query)
        {
            if (!string.Equals(key, "oos", StringComparison.OrdinalIgnoreCase))
            {
                parameters[key] = value.ToString();
            }
        }
        if (_includeInactive)
        {
            parameters["oos"] = "1";
        }

        // GetLeftPart(Path) = the URI without query/fragment — the clean
        // base AddQueryString re-attaches the surviving parameters to.
        var basePath = uri.GetLeftPart(UriPartial.Path);
        var relative = parameters.Count == 0
            ? basePath
            : Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(basePath, parameters);
        Navigation.NavigateTo(relative, forceLoad: false, replace: true);
    }

    private async Task LoadCategoriesAsync()
    {
        try
        {
            var result = await MessageBus.InvokeAsync<Result<List<CategoryDto>>>(new GetActiveCategoriesQuery());
            if (result.IsSuccess) _categories = result.Value;
        }
        catch { }
    }

    private async Task LoadCartAsync()
    {
        try
        {
            var result = await MessageBus.InvokeAsync<Result<CartDto?>>(new GetActiveCartForUserQuery());
            if (result.IsSuccess && result.Value is not null)
            {
                _cart = result.Value;
                // Budget info comes from BudgetInfo (populated by ISalaryBudgetService),
                // NOT from Cart.Total. Consumed = all purchases this month (including
                // submitted sales, not just the draft cart).
                if (_cart.BudgetInfo is not null)
                {
                    _budgetSalary = _cart.BudgetInfo.Salary.Amount;
                    _budgetConsumed = _cart.BudgetInfo.Consumed;
                    _budgetCurrency = _cart.BudgetInfo.Salary.Currency;
                }
                else
                {
                    _budgetConsumed = _cart.Total?.Amount ?? 0m;
                    _budgetCurrency = _cart.Total?.Currency ?? "IRR";
                }
            }
            else
            {
                _cart = null;
            }
        }
        catch
        {
            _cart = null;
        }
    }

    // ── Category selection ──

    private async Task SelectCategory(Guid? categoryId)
    {
        _selectedCategoryId = categoryId;
        _pageNumber = 1; // new filter = new result set: fresh page 1
        _isLoading = true;
        StateHasChanged();
        await LoadProductsAsync();
        _isLoading = false;
        StateHasChanged();
    }

    private void ClearSearch()
    {
        // Do NOT pre-clear _searchTerm here: OnParametersSetAsync's
        // change detection (newSearch != _searchTerm) must SEE the
        // transition foo→"" to trigger the reload. Pre-clearing made the
        // comparison always equal — the list kept the STALE search
        // results while the chip vanished (pre-existing bug, found and
        // fixed in the QA-11 round; pinned by a bUnit test).
        // The staff view mode IS preserved across the clear: the page
        // state keeps _includeInactive (a view mode, not a search
        // filter), so the URL keeps mirroring it.
        var target = _includeInactive ? "/m/Products?oos=1" : "/m/Products";
        Navigation.NavigateTo(target, forceLoad: false);
    }

    // ── Qty selector helpers (ported from PC Products page) ──

    private int GetQtyForProduct(Guid productId)
        => _qtyByProduct.TryGetValue(productId, out var q) ? q : 1;

    private int GetQtyMaxForProduct(ProductListItemDto product)
    {
        var remaining = GetRemainingForProduct(product);
        var cap = product.MyPurchaseLimit.HasValue
            ? Math.Min(remaining, product.StockQuantity)
            : product.StockQuantity;
        var max = Math.Max(1, cap);

        if (_cart?.BudgetInfo is { } budget && product.Price is { } price)
        {
            var unitPrice = price.Amount;
            if (unitPrice > 0m)
            {
                var salaryMax = (int)Math.Floor(budget.Remaining / unitPrice);
                max = Math.Min(max, Math.Max(1, salaryMax));
            }
        }

        return max;
    }

    private int GetRemainingForProduct(ProductListItemDto product)
    {
        var inCart = _cart?.LineItems
            .Where(li => li.ProductId == product.Id)
            .Sum(li => li.Quantity) ?? 0;

        var remainingStock = Math.Max(0, product.StockQuantity - inCart);

        if (!product.MyPurchaseLimit.HasValue)
            return remainingStock;

        var remainingLimit = Math.Max(0, product.MyPurchaseLimit.Value - inCart);
        return Math.Min(remainingStock, remainingLimit);
    }

    private void IncrementQty(Guid productId)
    {
        var current = GetQtyForProduct(productId);
        var product = _products.FirstOrDefault(p => p.Id == productId);
        if (product is null) return;
        var max = GetQtyMaxForProduct(product);
        if (current < max)
            _qtyByProduct[productId] = current + 1;
    }

    private void DecrementQty(Guid productId)
    {
        var current = GetQtyForProduct(productId);
        if (current > 1)
            _qtyByProduct[productId] = current - 1;
    }

    // ── Add to cart (ported from PC Products page) ──

    private async Task AddToCartAsync(ProductListItemDto product)
    {
        if (_isAddingAny) return;

        var qty = GetQtyForProduct(product.Id);
        if (qty < 1)
        {
            await Toast.Warning(Loc["ToastQtyMin"]);
            return;
        }

        var remaining = GetRemainingForProduct(product);
        if (remaining <= 0)
        {
            await Toast.Warning(Loc["ToastLimitReached"]);
            return;
        }
        if (qty > remaining)
        {
            qty = remaining;
            await Toast.Info(string.Format(CultureInfo.CurrentCulture, Loc["ToastQtyClamped"], CultureFormat.FormatDigits(remaining)));
        }

        var budget = _cart?.BudgetInfo;
        if (budget is not null)
        {
            var unitPrice = product.Price?.Amount ?? 0m;
            var lineTotal = unitPrice * qty;
            if (lineTotal > budget.Remaining)
            {
                await Toast.Warning(Loc["ToastSalaryReached"]);
                return;
            }
        }

        _isAddingAny = true;
        StateHasChanged();

        try
        {
            var result = await MessageBus.InvokeAsync<Result<Guid>>(
                new CreateOrAppendSaleCommand(product.Id, qty));

            if (result.IsSuccess)
            {
                await Toast.Success(Loc["ToastAddedToCart"]);
                await LoadCartAsync();
                _qtyByProduct[product.Id] = 1;
                // Reload the page so MobileLayout's cart bar + BottomNav
                // badge update with the new cart state. forceLoad:true
                // triggers a full page refresh.
                Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
            }
            else
            {
                await Toast.Error(ErrorDisplay.Localize(result.Error) ?? Loc["ToastAddFailed"]);
            }
        }
        catch
        {
            await Toast.UnexpectedError(UnexpectedErrorCodes.MobileProducts_AddToCartFailure);
        }
        finally
        {
            _isAddingAny = false;
        }
    }

    // ── Quick reorder ──

    private async Task QuickReorderAsync()
    {
        if (_isReordering || _isReadOnly) return;
        _isReordering = true;
        try
        {
            var result = await MessageBus.InvokeAsync<Result>(new QuickReorderLastSaleCommand());
            if (result.IsSuccess)
            {
                await Toast.Success(Loc["ReorderSuccess"], summary: Loc["ReorderSuccessTitle"]);
                await LoadCartAsync();
                // Reload so MobileLayout's cart bar + BottomNav badge update.
                Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
            }
            else
            {
                await Toast.Error(ErrorDisplay.Localize(result.Error) ?? Loc["ReorderError"], summary: Loc["ErrorTitle"]);
            }
        }
        catch
        {
            await Toast.UnexpectedError(UnexpectedErrorCodes.MobileProducts_ReorderFailure, summary: Loc["ErrorTitle"]);
        }
        finally
        {
            _isReordering = false;
        }
    }

    // ── Navigation ──

    private void GoToProduct(Guid productId)
        => Navigation.NavigateTo($"/Products/{productId}", forceLoad: false);

    private void GoToMyOrders()
        => Navigation.NavigateTo("/Sales", forceLoad: false);

    // ── CSV export (QA-11 — desktop-parity port) ──

    /// <summary>
    /// Exports the CURRENT filtered catalog as a CSV download — the
    /// mobile twin of the desktop shop's export (identical file: the
    /// SAME customer-safe columns, the SAME filters + sort + staff
    /// out-of-stock view mode, because both pages issue the SAME
    /// GetProductsPaginatedQuery whose handler enforces per-role
    /// visibility server-side). 100 rows per page until the 2,000-row
    /// cap; CsvBuilder (RFC 4180 + invariant numbers) + takDownload.csv
    /// (UTF-8 + BOM) — the shared export machinery every other page
    /// uses, so the file opens cleanly in Excel under either culture.
    /// </summary>
    private async Task ExportProductsCsvAsync()
    {
        if (_isExporting || _totalCount == 0)
        {
            return; // the button is disabled for empty lists — belt + braces
        }

        _isExporting = true;
        try
        {
            var builder = new CsvBuilder();
            builder.AddHeader(
                Loc["ColName"],
                Loc["ColCategory"],
                Loc["ColSubCategory"],
                Loc["ColSubSubCategory"],
                Loc["ColPrice"],
                Loc["ColCurrency"],
                Loc["ColAvailability"]);

            var exported = 0;
            var pageNumber = 1;
            const int exportPageSize = 100; // the backend's MaxPageSize cap

            while (exported < ExportRowCap)
            {
                var query = new GetProductsPaginatedQuery
                {
                    PageNumber = pageNumber,
                    PageSize = exportPageSize,
                    SearchTerm = string.IsNullOrWhiteSpace(_searchTerm) ? null : _searchTerm.Trim(),
                    CategoryId = _selectedCategoryId,
                    SortBy = _sortBy,
                    // Export parity with the list: the download always
                    // ships exactly what the list shows (the chip's view
                    // mode included). The handler clamps this for
                    // non-staff roles server-side, exactly as for loads.
                    IncludeInactive = _includeInactive
                };

                var result = await MessageBus.InvokeAsync<PaginatedResult<ProductListItemDto>>(query);

                foreach (var product in result.Items)
                {
                    if (exported >= ExportRowCap) break;

                    builder.AddRow(
                        product.Name,
                        product.CategoryName,
                        product.SubCategoryName,
                        product.SubSubCategoryName,
                        product.Price?.Amount,
                        product.Price?.Currency,
                        product.StockQuantity > 0 ? Loc["StockIn"] : Loc["StockOut"]);
                    exported++;
                }

                // Last page reached when the server returns fewer rows
                // than requested.
                if (result.Items.Count < exportPageSize) break;
                pageNumber++;
            }

            var fileName = $"takone-catalog-{DateTime.UtcNow:yyyyMMdd-HHmmss}.csv";
            await JS.InvokeVoidAsync("takDownload.csv", fileName, builder.ToString());

            await Toast.Success(Loc["ExportCsvDone", exported], summary: Loc["PageTitle"]);
        }
        catch (Exception)
        {
            // JS interop can fail after a circuit reconnect — a visible
            // toast beats a silently dead button (same policy as every
            // other export button in the app).
            await Toast.Error(Loc["ExportCsvError"], summary: Loc["ErrorTitle"]);
        }
        finally
        {
            _isExporting = false;
        }
    }

    // ── Formatting ──

    private string FormatPrice(MoneyDto? price)
    {
        if (price is null) return "—";
        var isIrr = string.Equals(price.Currency, "IRR", StringComparison.OrdinalIgnoreCase);
        var displayAmount = isIrr ? price.Amount / 10m : price.Amount;
        var amount = CultureFormat.ToCultureDigits(displayAmount.ToString("N0", CultureInfo.InvariantCulture));
        var unit = isIrr ? Loc["TomanUnit"] : price.Currency;
        return $"{amount} {unit}";
    }

    private string FormatBudgetAmount()
    {
        if (_budgetSalary <= 0) return Loc["NoBudget"];
        var isIrr = string.Equals(_budgetCurrency, "IRR", StringComparison.OrdinalIgnoreCase);
        var remaining = isIrr ? (_budgetSalary - _budgetConsumed) / 10m : (_budgetSalary - _budgetConsumed);
        var amount = CultureFormat.ToCultureDigits(Math.Max(0, remaining).ToString("N0", CultureInfo.InvariantCulture));
        var unit = isIrr ? Loc["TomanUnit"] : _budgetCurrency;
        return $"{amount} {unit}";
    }
}