    /// <summary>
    /// Formats a MoneyDto for display as Toman: IRR is divided by 10 and
    /// labelled with the localized "Toman" unit; other currencies pass
    /// through unchanged with their own currency code. Returns "—" for
    /// null or zero-with-empty-currency amounts (cleaner than "0 تومان"
    /// on an empty price tag).
    ///
    /// Mirrors MobileSales.razor's FormatMoney helper exactly so the
    /// detail page's grand total reads the SAME as the list page's row
    /// total — consistent UX between the two pages that link to each
    /// other.
    /// </summary>
    private string FormatMoney(MoneyDto? money)
    {
        if (money is null || (money.Amount == 0 && string.IsNullOrEmpty(money.Currency)))
            return "—";

        var isIrr = string.Equals(money.Currency, "IRR", StringComparison.OrdinalIgnoreCase);
        var display = isIrr ? money.Amount / 10m : money.Amount;
        var amount = CultureFormat.ToCultureDigits(display.ToString("N0", CultureInfo.InvariantCulture));
        var unit = isIrr ? Loc["TomanUnit"] : money.Currency;
        return $"{amount} {unit}";
    }

    /// <summary>
    /// Formats a UTC DateTimeOffset for display in Tehran time, culture-
    /// aware. Delegates to CultureFormat.FormatTehranDateTime (Tehran =
    /// UTC + 3:30, no DST since 2022; Jalali calendar + Persian digits
    /// in fa-IR mode, Gregorian + ASCII in en-US).
    /// </summary>
    private static string FormatTimestamp(DateTimeOffset utc)
        => CultureFormat.FormatTehranDateTime(utc);

    /// <summary>
    /// Maps a sale status string (the SaleStatus enum's ToString() output)
    /// to a mobile badge color class (the small inline badge next to the
    /// sale number in the page header). Same color mapping as MobileSales.
    /// razor's GetStatusBadgeClass so the badge reads the same on the list
    /// and the detail page.
    /// </summary>
    private static string GetStatusBadgeClass(string? status) => status switch
    {
        "Draft" => "m-badge-neutral",
        "Pending" => "m-badge-warning",
        "Approved" => "m-badge-info",
        "Invoiced" => "m-badge-success",
        "Cancelled" => "m-badge-danger",
        _ => "m-badge-neutral"
    };

    /// <summary>
    /// Returns the CSS class for the large status banner. Uses the
    /// status-bg-* color tokens defined in the desktop SaleDetail.razor's
    /// HeadContent <style> block — the orchestrator will add these as
    /// mobile.css classes in a later pass (page-scoped <HeadContent> styles
    /// don't leak across pages, so the mobile page needs its own equivalent
    /// classes; until the orchestrator adds them, the banner renders
    /// unstyled-but-readable).
    /// </summary>
    private static string GetStatusBannerClass(string status) => status switch
    {
        "Draft" => "status-bg-draft",
        "Pending" => "status-bg-pending",
        "Approved" => "status-bg-approved",
        "Invoiced" => "status-bg-invoiced",
        "Cancelled" => "status-bg-cancelled",
        _ => "status-bg-draft"
    };

    /// <summary>
    /// Returns a Material icon name for the large status banner. The icon
    /// is rendered inside a span with the Material Symbols font family
    /// (defined globally by Radzen's theme; the class .m-status-banner-icon
    /// just sets the size + color). Mirrors the desktop GetStatusIcon
    /// helper verbatim.
    /// </summary>
    private static string GetStatusIcon(string status) => status switch
    {
        "Draft" => "edit_note",
        "Pending" => "hourglass_top",
        "Approved" => "check_circle",
        "Invoiced" => "receipt_long",
        "Cancelled" => "cancel",
        _ => "help_outline"
    };

    /// <summary>
    /// Returns a localized label for the sale status. Falls back to the raw
    /// status string if no localization key matches. Same pattern as the
    /// desktop SaleDetail.razor GetStatusLabel helper.
    /// </summary>
    private string GetStatusLabel(string status)
    {
        var key = $"Status{status}";
        var localized = Loc[key];
        return localized == key ? status : localized;
    }

