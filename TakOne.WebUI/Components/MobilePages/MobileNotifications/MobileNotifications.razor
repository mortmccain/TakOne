@* MobileNotifications.razor — mobile notification center (REAL store).
   Route: /m/Notifications
   Layout: MobileLayout

   PURPOSE: a mobile-friendly notification center. Lists the user's
   notifications from the real Notification aggregate (persisted in the
   Notifications table). Supports:
     - Paginated list, newest-first (PageSize=20).
     - "All" vs "Unread" segmented filter.
     - "Mark all read" action (calls MarkAllNotificationsAsReadCommand).
     - Tap to mark-as-read + navigate to the sale detail page.
     - Live refresh via SignalR ReceiveRefresh (re-queries on push).

   BACKEND CONTRACT:
     - Load: GetNotificationsForUserQuery { PageNumber, PageSize, UnreadOnly }
       → Task<PaginatedResult<NotificationDto>> via
       MessageBus.InvokeAsync<PaginatedResult<NotificationDto>>(query).
       Handler returns bare PaginatedResult<T> (NOT Result<>), same as
       GetSalesPaginatedQuery.
     - Mark one read: MarkNotificationAsReadCommand(NotificationId) → Result.
     - Mark all read: MarkAllNotificationsAsReadCommand → Result<int>
       (the int = number of rows affected, used for the toast).

   LOCALIZATION:
     The DTO exposes the Kind enum + structured fields (SaleDisplayNumber,
     ActorName, Reason) — NO pre-localized text. This page localizes at
     render time using the resx file's templates, formatted with the
     structured params. This means a user who switches language instantly
     sees their old notifications in the new language (no persisted text
     to be stale).
*@

@page "/m/Notifications"
@attribute [Authorize]
@layout TakOne.WebUI.Components.Layout.MobileLayout.MobileLayout
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Wolverine
@using TakOne.Application.Common.Authorization
@using TakOne.Application.Common.Interfaces
@using TakOne.Application.Notifications.DTOs
@using TakOne.Application.Notifications.Queries.GetNotificationsForUser
@using TakOne.Application.Notifications.Queries.GetUnreadNotificationCount
@using TakOne.Application.Notifications.Commands.MarkNotificationAsRead
@using TakOne.Application.Notifications.Commands.MarkAllNotificationsAsRead
@using TakOne.Application.Notifications.Commands.DeleteNotification
@using TakOne.Domain.Notifications.Enums
@using TakOne.SharedKernel.Common
@using TakOne.WebUI.Services
@using TakOne.WebUI.Components.Shared
@implements IDisposable
@inject IMessageBus MessageBus
@inject NavigationManager Navigation
@inject IStringLocalizer<MobileNotifications> Loc
@inject ToastService Toast
@inject TakOne.WebUI.Services.NotificationRefreshService NotificationRefresh

<PageTitle>@Loc["PageTitle"]</PageTitle>

@if (_isLoading)
{
    @* Skeleton — back-header + a few notification cards. *@
    <div class="m-page-header-back">
        <div class="m-skeleton" style="width: 2.5rem; height: 2.5rem; border-radius: 0.5rem;"></div>
        <div class="m-page-header-text" style="flex: 1;">
            <div class="m-skeleton m-skeleton-line medium"></div>
            <div class="m-skeleton m-skeleton-line short" style="margin-top: 0.5rem;"></div>
        </div>
    </div>
    <div class="m-notif-list">
        @for (var i = 0; i < 5; i++)
        {
            <div class="m-notif-card m-notif-skeleton">
                <div class="m-skeleton" style="width: 2.5rem; height: 2.5rem; border-radius: 50%;"></div>
                <div style="flex: 1;">
                    <div class="m-skeleton m-skeleton-line medium" style="margin-bottom: 0.5rem;"></div>
                    <div class="m-skeleton m-skeleton-line short"></div>
                </div>
            </div>
        }
    </div>
    <span class="sr-only">@Loc["Loading"]</span>
}
else if (!string.IsNullOrEmpty(_loadError))
{
    <div class="m-error-box">
        <p>@_loadError</p>
        <button class="m-btn m-btn-secondary" @onclick="LoadAsync">@Loc["RetryButton"]</button>
    </div>
}
else if (_notifications.Count == 0)
{
    @* Empty state — no notifications yet. *@
    <div class="m-page-header-back">
        <button type="button" class="m-back-btn" aria-label="@Loc["Back"]" @onclick="GoBack">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" style="width: 1.25rem; height: 1.25rem;">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
        </button>
        <div class="m-page-header-text">
            <h1 class="m-page-title">@Loc["PageTitle"]</h1>
        </div>
    </div>
    <div class="m-notif-empty">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" style="width: 4rem; height: 4rem; opacity: 0.4;">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0" />
        </svg>
        <p class="m-notif-empty-title">@Loc["EmptyTitle"]</p>
        <p class="m-notif-empty-hint">@Loc["EmptyHint"]</p>
    </div>
}
else
{
    @* ── 1. Page header with segmented filter + mark-all-read. ── *@
    <div class="m-page-header-back">
        <button type="button" class="m-back-btn" aria-label="@Loc["Back"]" @onclick="GoBack">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" style="width: 1.25rem; height: 1.25rem;">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
            </svg>
        </button>
        <div class="m-page-header-text">
            <h1 class="m-page-title">@Loc["PageTitle"]</h1>
            <p class="m-page-subtitle">@Loc["PageSubtitle"]</p>
        </div>
    </div>

    @* ── 2. Segmented filter (All | Unread) + mark-all-read button. ── *@
    <div class="m-notif-toolbar">
        <div class="m-segmented">
            <button type="button"
                    class="m-segment @(_filterUnreadOnly ? "" : "active")"
                    @onclick="() => SetFilterAsync(false)">
                @Loc["FilterAll"]
            </button>
            <button type="button"
                    class="m-segment @(_filterUnreadOnly ? "active" : "")"
                    @onclick="() => SetFilterAsync(true)">
                @Loc["FilterUnread"]
                @if (_unreadCount > 0)
                {
                    <span class="m-segment-badge">@(_unreadCount > 99 ? "99+" : _unreadCount.ToString())</span>
                }
            </button>
        </div>
        @if (_unreadCount > 0)
        {
            <button type="button"
                    class="m-btn m-btn-ghost m-btn-sm"
                    disabled="@_isMarkingAllRead"
                    @onclick="MarkAllReadAsync">
                @if (_isMarkingAllRead)
                {
                    <span class="m-spinner" aria-hidden="true"></span>
                }
                @Loc["MarkAllRead"]
            </button>
        }
    </div>

    @* ── 2b. Per-kind filter chips (Round 4). Horizontally scrollable —
           all 8 chips never wrap-crowd the toolbar. Same labels as the
           feed rows (Title_*), so a kind means the same thing in the
           filter and in the list. Server-side: the kind rides in SQL,
           so TotalPages stays honest. Tap = toggle (the active chip
           deactivates back to "all kinds"). *@
    <div class="m-notif-kind-row" role="tablist" aria-label="@Loc["FilterKindLabel"]">
        <button type="button"
                class="m-notif-kind-chip @(_filterKind is null ? "active" : "")"
                @onclick="() => SetKindFilterAsync(null)">
            @Loc["FilterAllKinds"]
        </button>
        @foreach (var kind in Enum.GetValues<NotificationKind>())
        {
            var k = kind; // capture for the closure
            <button type="button"
                    class="m-notif-kind-chip @(_filterKind == k ? "active" : "")"
                    @onclick="() => SetKindFilterAsync(k)">
                @GetTitle(new NotificationDto { Kind = k })
            </button>
        }

        @* Round 5 — one-click hop to the per-kind mute settings (the
           trailing chip in the scroll row, visually set apart from the
           kind chips by the settings glyph + quiet tint). MobileSettings
           hosts the same per-kind switches the desktop Settings page has. *@
        <a href="/m/Settings" class="m-notif-kind-chip m-notif-manage-prefs">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true" style="width: 0.9rem; height: 0.9rem;">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>@Loc["ManagePrefsLink"]</span>
        </a>
    </div>

    @* ── 3. Notification list. ── *@
    <div class="m-notif-list">
        @foreach (var n in _notifications)
        {
            <button type="button"
                    class="m-notif-card @(n.IsUnread ? "m-notif-unread" : "")"
                    @onclick="() => HandleTapAsync(n)">
                <div class="m-notif-icon @GetIconClass(n.Kind)">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" style="width: 1.25rem; height: 1.25rem;">
                        @GetIconSvg(n.Kind)
                    </svg>
                </div>
                <div class="m-notif-body">
                    <div class="m-notif-title">@GetTitle(n)</div>
                    <div class="m-notif-message">@GetMessage(n)</div>
                    @if (!string.IsNullOrEmpty(n.Reason))
                    {
                        <div class="m-notif-reason">@n.Reason</div>
                    }
                    <div class="m-notif-meta">
                        @if (!string.IsNullOrEmpty(n.SaleDisplayNumber))
                        {
                            <span class="m-notif-sale">@n.SaleDisplayNumber</span>
                            <span class="m-notif-sep" aria-hidden="true">·</span>
                        }
                        <span class="m-notif-time">@FormatRelativeTime(n.CreatedAtUtc)</span>
                    </div>
                </div>
                @if (n.IsUnread)
                {
                    <div class="m-notif-unread-dot" aria-label="@Loc["UnreadAriaLabel"]"></div>
                }

                @* Round 4 — per-notification dismiss. The row is a
                   <button>, so the dismiss is a span[role=button]
                   (nested buttons are invalid HTML) with stopPropagation
                   + Enter/Space keydown support. *@
                <span class="m-notif-dismiss @(n.Id == _dismissingId ? "m-notif-dismiss--busy" : "")"
                      role="button"
                      tabindex="0"
                      title="@Loc["DismissTooltip"]"
                      aria-label="@Loc["DismissTooltip"]"
                      @onclick="() => DismissAsync(n)"
                      @onclick:stopPropagation="true"
                      @onkeydown="@(e => OnDismissKeyDown(e, n))">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.2" style="width: 14px; height: 14px;" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </span>
            </button>
        }
    </div>

    @* ── 4. Pagination. ── *@
    @if (_totalPages > 1)
    {
        <div class="m-pagination">
            <button type="button"
                    class="m-btn m-btn-ghost m-btn-sm"
                    disabled="@(_pageNumber <= 1 || _isLoadingPage)"
                    @onclick="() => LoadPageAsync(_pageNumber - 1)">
                @Loc["PrevPage"]
            </button>
            <span class="m-pagination-info">
                @string.Format(Loc["PageFormat"], _pageNumber, _totalPages)
            </span>
            <button type="button"
                    class="m-btn m-btn-ghost m-btn-sm"
                    disabled="@(_pageNumber >= _totalPages || _isLoadingPage)"
                    @onclick="() => LoadPageAsync(_pageNumber + 1)">
                @Loc["NextPage"]
            </button>
        </div>
    }

    <div class="m-footer">
        @Loc["FooterHint"]
    </div>
}

@code {
    // ── State ────────────────────────────────────────────────────────────
    private List<NotificationDto> _notifications = new();
    private int _pageNumber = 1;
    private int _totalCount;
    private int _totalPages;
    private int _unreadCount;
    private bool _filterUnreadOnly;

    /// <summary>
    /// The active per-kind filter (Round 4). Null = all kinds.
    /// </summary>
    private NotificationKind? _filterKind;

    /// <summary>
    /// The id of the notification whose dismiss round trip is in flight
    /// (drives the row's busy style; single-flight).
    /// </summary>
    private Guid? _dismissingId;
    private bool _isLoading = true;
    private bool _isLoadingPage;
    private bool _isMarkingAllRead;
    private string? _loadError;

    // ── Lifecycle ────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        // Subscribe to live-refresh events FIRST — before any await. If the
        // user navigates away while LoadAsync is in flight, Blazor runs
        // Dispose() (unsubscribing — a no-op at that point), and the awaited
        // task completing after that would attach the handler to an already
        // DISPOSED component, rooting it for the life of the circuit.
        // Subscribing synchronously before the first await guarantees the
        // Dispose()-unsubscribe always matches the subscribe (same pattern
        // as MainLayout / MobileLayout).
        NotificationRefresh.RefreshReceived += OnNotificationRefreshReceived;

        try
        {
            await LoadAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>
    /// Live-refresh callback. Re-queries the list + unread count.
    /// </summary>
    /// <remarks>
    /// async void is the legitimate pattern for event handlers — the
    /// raiser (NotificationRefreshService) can't await subscribers.
    /// </remarks>
    private async void OnNotificationRefreshReceived()
    {
        try
        {
            await LoadAsync();
        }
        catch
        {
            // Silent — the list refresh is best-effort.
        }
    }

    /// <summary>
    /// Loads the current page of notifications + the unread count.
    /// </summary>
    private async Task LoadAsync()
    {
        _loadError = null;
        try
        {
            var query = new GetNotificationsForUserQuery
            {
                PageNumber = _pageNumber,
                PageSize = 20,
                UnreadOnly = _filterUnreadOnly,
                Kind = _filterKind
            };

            var page = await MessageBus.InvokeAsync<PaginatedResult<NotificationDto>>(query);

            _notifications = page.Items.ToList();
            _totalCount = page.TotalCount;
            _totalPages = page.TotalPages;

            // Refresh the unread count separately (always asks for the
            // count regardless of the unread-only filter).
            _unreadCount = await MessageBus.InvokeAsync<int>(
                new GetUnreadNotificationCountQuery());

            StateHasChanged();
        }
        catch
        {
            _loadError = Loc["Err_Load"];
        }
    }

    /// <summary>
    /// Loads a specific page (pagination nav).
    /// </summary>
    private async Task LoadPageAsync(int page)
    {
        if (page < 1 || page > _totalPages) return;

        _pageNumber = page;
        _isLoadingPage = true;
        try
        {
            await LoadAsync();
        }
        finally
        {
            _isLoadingPage = false;
        }
    }

    /// <summary>
    /// Switches the All/Unread filter and reloads page 1.
    /// </summary>
    /// <summary>
    /// The per-kind filter chips' handler: toggle the kind (null again =
    /// all kinds), restart at page 1, reload.
    /// </summary>
    private async Task SetKindFilterAsync(NotificationKind? kind)
    {
        if (_filterKind == kind) return;
        _filterKind = kind;
        _pageNumber = 1;
        await LoadAsync();
    }

    /// <summary>
    /// Keyboard support for the dismiss span (role=button): Enter or
    /// Space dismisses; anything else moves on.
    /// </summary>
    private async Task OnDismissKeyDown(KeyboardEventArgs e, NotificationDto n)
    {
        if (e.Key is "Enter" or " ")
        {
            await DismissAsync(n);
        }
    }

    /// <summary>
    /// Dismisses (hard-deletes) one notification: OPTIMISTIC removal from
    /// the rendered list + the DeleteNotificationCommand round trip; on
    /// failure the list reloads from the server (persisted truth) and a
    /// toast explains. Refreshes the unread count too — deleting an
    /// UNREAD row must decrement the badge immediately.
    /// </summary>
    private async Task DismissAsync(NotificationDto n)
    {
        if (_dismissingId is not null) return;

        _dismissingId = n.Id;
        _notifications.RemoveAll(x => x.Id == n.Id);
        if (n.IsUnread && _unreadCount > 0)
        {
            _unreadCount--;
        }
        try
        {
            var result = await MessageBus.InvokeAsync<Result>(
                new DeleteNotificationCommand(n.Id));

            if (!result.IsSuccess)
            {
                await Toast.Warning(Loc["Err_Dismiss"], summary: Loc["PageTitle"]);
            }
        }
        catch
        {
            await Toast.Warning(Loc["Err_Dismiss"], summary: Loc["PageTitle"]);
        }
        finally
        {
            _dismissingId = null;
        }

        // Reload: restores truth after a failure and fixes TotalPages.
        // Stepping back a page first when the last row of a non-first
        // page was dismissed keeps the reload off an empty page.
        if (_notifications.Count == 0 && _pageNumber > 1)
        {
            _pageNumber--;
        }
        await LoadAsync();
    }

    private async Task SetFilterAsync(bool unreadOnly)
    {
        if (_filterUnreadOnly == unreadOnly) return;
        _filterUnreadOnly = unreadOnly;
        _pageNumber = 1;
        await LoadAsync();
    }

    /// <summary>
    /// Marks all unread notifications as read in a single UPDATE.
    /// Shows a toast with the count affected.
    /// </summary>
    private async Task MarkAllReadAsync()
    {
        _isMarkingAllRead = true;
        try
        {
            var result = await MessageBus.InvokeAsync<Result<int>>(
                new MarkAllNotificationsAsReadCommand());

            if (result.IsSuccess)
            {
                var count = result.Value;
                await Toast.Success(
                    count == 0
                        ? Loc["Toast_NoUnread"]
                        : string.Format(Loc["Toast_MarkedAllRead"], count));
                await LoadAsync();
            }
            else
            {
                await Toast.Error(result.Error ?? Loc["Err_MarkRead"]);
            }
        }
        finally
        {
            _isMarkingAllRead = false;
        }
    }

    /// <summary>
    /// Tap handler — marks the notification as read (idempotent) and
    /// navigates to the sale detail page if the notification is linked
    /// to a sale.
    /// </summary>
    private async Task HandleTapAsync(NotificationDto n)
    {
        // Mark as read in the background — fire-and-forget so the
        // navigation doesn't block on the round-trip.
        if (n.IsUnread)
        {
            _ = Task.Run(async () =>
            {
                try
                {
                    await MessageBus.InvokeAsync<Result>(
                        new MarkNotificationAsReadCommand(n.Id));
                    // Best-effort refresh of the unread count + the list
                    // (so the unread dot disappears + the badge updates).
                    await InvokeAsync(LoadAsync);
                }
                catch
                {
                    // Silent — the read-state is best-effort.
                }
            });
        }

        // Navigate to the sale detail page (mobile route).
        if (n.SaleId.HasValue)
        {
            Navigation.NavigateTo($"/m/Sales/{n.SaleId.Value}", forceLoad: false);
        }
        else if (n.Kind == NotificationKind.AppUpdate)
        {
            // For the auto-emitted "app updated" notification, the user
            // should reload the page to pick up the new code (the running
            // Blazor circuit is still on the OLD container's assets). A
            // full page reload (forceLoad: true) re-fetches everything.
            // The user explicitly taps the notification — opt-in, not
            // forced on them.
            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
        }
        // For Broadcast (admin-authored): no navigation — the title +
        // message are already displayed in the card. The tap just
        // dismisses (marks as read).
    }

    /// <summary>
    /// Returns the localized title for the notification kind.
    /// </summary>
    private string GetTitle(NotificationDto n) => n.Kind switch
    {
        NotificationKind.SaleSubmitted => Loc["Title_Submitted"],
        NotificationKind.SaleApproved => Loc["Title_Approved"],
        NotificationKind.SaleInvoiced => Loc["Title_Invoiced"],
        NotificationKind.SaleCancelled => Loc["Title_Cancelled"],
        // For Broadcast + AppUpdate, the admin-authored Title is the
        // notification's title (stored on the row at fanout time). Fall
        // back to a localized kind-label if the admin somehow sent an
        // empty title (shouldn't happen — the validator rejects it).
        NotificationKind.Broadcast => n.Title ?? Loc["Title_Broadcast"],
        NotificationKind.AppUpdate => n.Title ?? Loc["Title_AppUpdate"],
        NotificationKind.GroupChanged => Loc["Title_GroupChanged"],
        _ => Loc["Title_Unknown"]
    };

    /// <summary>
    /// Returns the localized message body, formatted with the structured
    /// params from the notification (SaleDisplayNumber, ActorName, Reason).
    /// </summary>
    private string GetMessage(NotificationDto n)
    {
        var sale = n.SaleDisplayNumber ?? Loc["UnknownSale"];
        return n.Kind switch
        {
            NotificationKind.SaleSubmitted =>
                string.Format(Loc["Message_Submitted_Customer"], sale),
            NotificationKind.SaleApproved =>
                string.Format(Loc["Message_Approved_Customer"], sale, n.ActorName ?? Loc["UnknownActor"]),
            NotificationKind.SaleInvoiced =>
                string.Format(Loc["Message_Invoiced_Customer"], sale, n.ActorName ?? Loc["UnknownActor"]),
            NotificationKind.SaleCancelled =>
                string.Format(Loc["Message_Cancelled_Customer"], sale, n.ActorName ?? Loc["UnknownActor"]),
            // For Broadcast + AppUpdate, the admin-authored Message is
            // the notification's body (stored on the row at fanout time).
            NotificationKind.Broadcast => n.Message ?? Loc["Message_Unknown"],
            NotificationKind.AppUpdate => n.Message ?? Loc["Message_Unknown"],
            // Group-changed message is generic (the new group name is in
            // Reason, rendered as the context sub-line below the message).
            NotificationKind.GroupChanged => Loc["Message_GroupChanged"],
            _ => Loc["Message_Unknown"]
        };
    }

    /// <summary>
    /// Returns the CSS class for the notification's icon container.
    /// </summary>
    private static string GetIconClass(NotificationKind kind) => kind switch
    {
        NotificationKind.SaleSubmitted => "m-notif-icon-submit",
        NotificationKind.SaleApproved => "m-notif-icon-approve",
        NotificationKind.SaleInvoiced => "m-notif-icon-invoice",
        NotificationKind.SaleCancelled => "m-notif-icon-cancel",
        NotificationKind.Broadcast => "m-notif-icon-broadcast",
        NotificationKind.AppUpdate => "m-notif-icon-appupdate",
        NotificationKind.GroupChanged => "m-notif-icon-groupchange",
        _ => "m-notif-icon-default"
    };

    /// <summary>
    /// Returns the inline SVG path for the notification's icon.
    /// </summary>
    private static Microsoft.AspNetCore.Components.MarkupString GetIconSvg(NotificationKind kind)
    {
        var path = kind switch
        {
