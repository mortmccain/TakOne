    /// <summary>
    /// Formats the notification's CreatedAtUtc as a culture-relative time
    /// ("just now", "X minutes ago", "X hours ago", or absolute date
    /// for older items).
    /// </summary>
    private string FormatRelativeTime(DateTimeOffset createdAtUtc)
    {
        var now = DateTimeOffset.UtcNow;
        var delta = now - createdAtUtc;

        if (delta.TotalMinutes < 1)
            return Loc["Time_JustNow"];
        if (delta.TotalMinutes < 60)
            return string.Format(Loc["Time_MinutesAgo"], (int)delta.TotalMinutes);
        if (delta.TotalHours < 24)
            return string.Format(Loc["Time_HoursAgo"], (int)delta.TotalHours);
        if (delta.TotalDays < 7)
            return string.Format(Loc["Time_DaysAgo"], (int)delta.TotalDays);

        // Older than a week — show the absolute date in Tehran time.
        var tehranTime = createdAtUtc.AddHours(3.5);
        var formatted = tehranTime.ToString("yyyy/MM/dd HH:mm", CultureInfo.InvariantCulture);
        return CultureFormat.ToCultureDigits(formatted);
    }

    private void GoBack()
    {
        // Navigate back to the previous page. If there's no history
        // (deep-linked directly), fall back to the mobile dashboard.
        Navigation.NavigateTo("/m/Dashboard", forceLoad: false);
    }

    public void Dispose()
    {
        NotificationRefresh.RefreshReceived -= OnNotificationRefreshReceived;
    }
