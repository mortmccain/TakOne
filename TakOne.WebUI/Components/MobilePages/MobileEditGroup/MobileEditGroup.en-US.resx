<?xml version="1.0" encoding="utf-8"?>
<!-- MobileEditGroup.en-US.resx — English strings for MobileEditGroup.razor.

     Keys mirror the desktop EditGroup.en-US.resx for shared strings
     (Loading, ErrorTitle, Error_Generic, NotFoundTitle, NotFoundBody,
     SummaryCardTitle, ColName, ColSalary, ColStatus, ColActiveUsers,
     ColCreatedAt, ColUpdatedAt, NoActiveUsers, StatusActive,
     StatusInactive, FieldName, FieldNamePlaceholder, FieldSalary,
     FieldAmount, FieldCurrency, CurrencyLockedTitle, SalaryHint,
     CancelButton, SaveButton, ActivateButton, DeactivateButton,
     ValidationError_NameRequired, ValidationError_AmountRequired,
     NoChanges, NoChangesTitle, SuccessTitle, SuccessSummary,
     ConfirmDeactivate, DeactivateSuccessTitle, DeactivateSuccess,
     ActivateSuccessTitle, ActivateSuccess, BulkDefaultsCardTitle,
     BulkDefaultsDescription, BulkApplyDefaultsButton,
     ConfirmBulkApplyDefaults, BulkApplyDefaultsTitle,
     BulkApplyDefaultsSuccess, BulkApplyDefaultsNoUpdates).

     Mobile-specific keys (PageTitle, PageSubtitle, RetryButton,
     BackToGroups, Error_FailedToLoad, Error_Unexpected, Version,
     EditFormCardTitle, ActionsCardTitle, FieldAmountPlaceholder) are
     new but use the same conventions as the desktop's EditGroup +
     sibling mobile pages (MobileSettings, MobileUserDetail,
     MobileManageGroups). -->
<root>
  <xsd:schema id="root" xmlns="" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
    <xsd:import namespace="http://www.w3.org/XML/1998/namespace" />
    <xsd:element name="root" msdata:IsDataSet="true">
      <xsd:complexType>
        <xsd:choice maxOccurs="unbounded">
          <xsd:element name="data">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" />
              <xsd:attribute ref="xml:space" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="resheader">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" />
            </xsd:complexType>
          </xsd:element>
        </xsd:choice>
      </xsd:complexType>
    </xsd:element>
  </xsd:schema>
  <resheader name="resmimetype"><value>text/microsoft-resx</value></resheader>
  <resheader name="version"><value>2.0</value></resheader>
  <resheader name="reader"><value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value></resheader>
  <resheader name="writer"><value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value></resheader>

  <!-- Page chrome -->
  <data name="PageTitle" xml:space="preserve"><value>Edit customer group — TakOne</value></data>
  <data name="PageSubtitle" xml:space="preserve"><value>Edit group details</value></data>
  <data name="BackToGroups" xml:space="preserve"><value>Back to groups</value></data>

  <!-- States -->
  <data name="Loading" xml:space="preserve"><value>Loading group…</value></data>
  <data name="RetryButton" xml:space="preserve"><value>Try again</value></data>

  <!-- Not-found state — the {GroupId} doesn't exist in the DB or the viewer
       isn't allowed to see it (defense-in-depth — the handler returns a
       generic "not found" for both cases so it never leaks existence). -->
  <data name="NotFoundTitle" xml:space="preserve"><value>Customer group not found</value></data>
  <data name="NotFoundBody" xml:space="preserve"><value>The group you're looking for doesn't exist or you don't have permission to view it.</value></data>

  <!-- Errors -->
  <data name="ErrorTitle" xml:space="preserve"><value>Something went wrong</value></data>
  <data name="Error_FailedToLoad" xml:space="preserve"><value>We couldn't load this group. Please try again.</value></data>
  <data name="Error_Unexpected" xml:space="preserve"><value>An unexpected error occurred. Please try again.</value></data>
  <data name="Error_Generic" xml:space="preserve"><value>We couldn't complete this action. Please try again.</value></data>

  <!-- Summary card -->
  <data name="SummaryCardTitle" xml:space="preserve"><value>Group summary</value></data>
  <data name="ColName" xml:space="preserve"><value>Name</value></data>
  <data name="ColSalary" xml:space="preserve"><value>Monthly budget</value></data>
  <data name="ColStatus" xml:space="preserve"><value>Status</value></data>
  <data name="ColActiveUsers" xml:space="preserve"><value>Active customers</value></data>
  <data name="ColCreatedAt" xml:space="preserve"><value>Created</value></data>
  <data name="ColUpdatedAt" xml:space="preserve"><value>Last updated</value></data>
  <data name="NoActiveUsers" xml:space="preserve"><value>No active customers in this group</value></data>

  <!-- Status badges -->
  <data name="StatusActive" xml:space="preserve"><value>Active</value></data>
  <data name="StatusInactive" xml:space="preserve"><value>Inactive</value></data>

  <!-- Edit form card -->
  <data name="EditFormCardTitle" xml:space="preserve"><value>Edit group</value></data>
  <data name="FieldName" xml:space="preserve"><value>Group name</value></data>
  <data name="FieldNamePlaceholder" xml:space="preserve"><value>e.g. Management, Staff, Contractors</value></data>
  <data name="FieldSalary" xml:space="preserve"><value>Monthly salary budget</value></data>
  <data name="FieldAmount" xml:space="preserve"><value>Amount</value></data>
  <data name="FieldAmountPlaceholder" xml:space="preserve"><value>0</value></data>
  <data name="FieldCurrency" xml:space="preserve"><value>Currency</value></data>
  <data name="CurrencyLockedTitle" xml:space="preserve"><value>Currency is locked. To change currency, deactivate this group and create a new one.</value></data>
  <data name="SalaryHint" xml:space="preserve"><value>Changes take effect immediately for new purchases. The current month's consumed amount is not retroactively recalculated.</value></data>

  <!-- Form actions -->
  <data name="SaveButton" xml:space="preserve"><value>Save changes</value></data>
  <data name="CancelButton" xml:space="preserve"><value>Cancel</value></data>
  <data name="ActivateButton" xml:space="preserve"><value>Activate</value></data>
  <data name="DeactivateButton" xml:space="preserve"><value>Deactivate</value></data>

  <!-- Inline confirm panel (mirrors MobileUserDetail's _confirmingDeactivate pattern) -->
  <data name="ConfirmDeactivate" xml:space="preserve"><value>Deactivate the group "{0}"? Customers in this group cannot make new purchases until it is reactivated. Their submitted sales are kept.</value>
    <comment>{0} = group name</comment>
  </data>

  <!-- Actions card (Activate/Deactivate) -->
  <data name="ActionsCardTitle" xml:space="preserve"><value>Actions</value></data>

  <!-- Validation -->
  <data name="ValidationError_NameRequired" xml:space="preserve"><value>Group name is required.</value></data>
  <data name="ValidationError_NameLength" xml:space="preserve"><value>Group name must be 1–100 characters.</value></data>
  <data name="ValidationError_AmountRequired" xml:space="preserve"><value>Salary amount is required.</value></data>
  <data name="ValidationError_AmountRange" xml:space="preserve"><value>Salary amount cannot be negative.</value></data>

  <!-- Toasts -->
  <data name="NoChanges" xml:space="preserve"><value>No changes to save.</value></data>
  <data name="NoChangesTitle" xml:space="preserve"><value>Nothing changed</value></data>
  <data name="SuccessTitle" xml:space="preserve"><value>Group updated</value></data>
  <data name="SuccessSummary" xml:space="preserve"><value>The customer group has been updated.</value></data>
  <data name="DeactivateSuccessTitle" xml:space="preserve"><value>Group deactivated</value></data>
  <data name="DeactivateSuccess" xml:space="preserve"><value>"{0}" has been deactivated.</value>
    <comment>{0} = group name</comment>
  </data>
  <data name="ActivateSuccessTitle" xml:space="preserve"><value>Group activated</value></data>
  <data name="ActivateSuccess" xml:space="preserve"><value>"{0}" has been activated and its customers can now shop.</value>
    <comment>{0} = group name</comment>
  </data>

  <!-- Bulk Apply Defaults card — closes the "reactivation gap" documented
       since Step 5: when a group is deactivated and new products are added
       during the inactive period, those products have no limit row for the
       group. This card lets the admin bulk-fill missing limits with the
       default value (1) in one shot. Existing limits are always preserved. -->
  <data name="BulkDefaultsCardTitle" xml:space="preserve"><value>Bulk apply default limits</value></data>
  <data name="BulkDefaultsDescription" xml:space="preserve"><value>Apply the default purchase limit (1) to every product that doesn't already have a limit for this group. Products with existing limits are preserved. Use this after reactivating a group to fill gaps for products created while it was inactive.</value></data>
  <data name="BulkApplyDefaultsButton" xml:space="preserve"><value>Apply default limits</value></data>
  <data name="ConfirmBulkApplyDefaults" xml:space="preserve"><value>Apply the default purchase limit (1) to every product missing a limit for the group "{0}"? Products that already have a limit will not be changed. This may take a few seconds for large catalogs.</value>
    <comment>{0} = group name</comment>
  </data>
  <data name="BulkApplyDefaultsTitle" xml:space="preserve"><value>Bulk apply complete</value></data>
  <data name="BulkApplyDefaultsSuccess" xml:space="preserve"><value>Applied default limit {3} to {0} of {1} product(s). {2} product(s) already had limits and were skipped.</value>
    <comment>{0} = ProductsUpdated, {1} = TotalProductsScanned, {2} = ProductsSkipped, {3} = AppliedLimit</comment>
  </data>
  <data name="BulkApplyDefaultsNoUpdates" xml:space="preserve"><value>All {0} product(s) already have a limit for this group. No changes were made.</value>
    <comment>{0} = TotalProductsScanned</comment>
  </data>

  <!-- Footer -->
  <data name="Version" xml:space="preserve"><value>TakOne version 1.0</value></data>
</root>
