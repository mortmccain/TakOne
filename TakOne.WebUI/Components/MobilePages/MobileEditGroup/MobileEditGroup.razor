    /// <summary>
    /// Form field: salary amount as a STRING (NOT decimal). Bound to the
    /// Salary Amount input via @oninput + @onfocus + @onblur. The @onfocus/
    /// @onblur swap shows the raw invariant number while editing (easy
    /// typing) and the formatted (thousand-separated + Persian-digit)
    /// value when not editing. Mirrors the desktop's _salaryAmountText
    /// field verbatim — the only reliable way to get Persian digits out
    /// of .NET is the manual swap in CultureFormat.ToCultureDigits
    /// (NativeDigits is informational-only — see CultureFormat.cs header).
    /// </summary>
    private string _formSalaryAmount = string.Empty;

    /// <summary>
    /// Form field: salary currency (READ-ONLY — the desktop's
    /// UpdateCustomerGroupSalaryCommand only accepts the amount; currency
    /// is preserved on the existing aggregate). Shown as a locked pill
    /// next to the amount input. Pre-filled from _group.Salary.Currency
    /// in LoadAsync.
    /// </summary>
    private string _formSalaryCurrency = string.Empty;

    /// <summary>
    /// Save-form in-flight guard (mirrors MobileProductDetail's _isBusy
    /// + the desktop's _isSubmitting). Disabled the Save button while
    /// the rename + salary-update dispatches are in flight so the user
    /// can't double-submit.
    /// </summary>
    private bool _isBusy;

    // ── Activate / Deactivate state (mirrors MobileUserDetail.razor) ──

    /// <summary>
    /// Per-action in-flight guard (mirrors MobileAdminCategories's
    /// _busyKey + MobileUserDetail's _busyAction pattern). Set to
    /// "action:activate" or "action:deactivate" while an action is in
    /// flight; null when idle. The finally block only clears the flag
    /// when it still matches this action's key — prevents a stale reset
    /// if a concurrent action somehow interleaves (defense-in-depth
    /// against the rare race where the user double-taps before the
    /// first handler's await completes).
    /// </summary>
    private string? _busyAction;

    /// <summary>
    /// True when the inline Deactivate confirmation panel is open.
    /// Toggled by the Deactivate button (open) + Cancel button / a
    /// successful dispatch (close). Mirrors MobileCart's _confirmingClear
    /// + MobileUserDetail's _confirmingDeactivate pattern — a mobile-
    /// friendly alternative to the desktop's 3-second-countdown
    /// DeactivateGroupDialog (which is too heavy for a single-tap UX).
    /// </summary>
    private bool _confirmingDeactivate;

    // ── Bulk Apply Defaults state ────────────────────────────────────

    /// <summary>
    /// True when the inline Bulk Apply Defaults confirmation panel is
    /// open. Mirrors _confirmingDeactivate — single inline panel with
    /// the confirm prompt + Confirm/Cancel buttons, replaces the
    /// desktop's JS.confirm() popup (which is jarring on a mobile
    /// viewport, and the task spec says "no JS interop beyond basic
    /// form interactions").
    /// </summary>
    private bool _confirmingBulkApply;

    /// <summary>
    /// True while a BulkApplyDefaultsForGroupCommand dispatch is in
    /// flight. Separate from _busyAction because bulk-apply disables
    /// EVERY button on the page (Save + Activate/Deactivate + bulk-apply
    /// itself) — a single bool is enough, no need for the per-action
    /// string state machine (no concurrent-action race possible since
    /// every other button is disabled). Mirrors the desktop's
    /// _isBulkApplyingDefaults field.
    /// </summary>
    private bool _isBulkApplyingDefaults;

    // ── Current-user role flags (mirrors desktop EditGroup.razor +
    // MobileManageGroups.razor) ──────────────────────────────────────

    /// <summary>
    /// True if the current user is in the Admin role. Computed via
    /// AuthenticationStateProvider in OnInitializedAsync — NOT via
    /// ICurrentUserService.IsInRole (which returns false for everyone
    /// in interactive Blazor Server mode because HttpContext is null
    /// over the SignalR circuit). Gates the edit-form + activate/
    /// deactivate + bulk-apply UI via the @if (_isAdmin || _isManagerOnly)
    /// rule. The Wolverine handlers ALSO enforce [RequireRoles(Manager,
    /// Admin)] server-side as defense-in-depth.
    /// </summary>
    private bool _isAdmin;

    /// <summary>
    /// True if the current user is in the Manager role (and NOT also
    /// in the Admin role). Used to gate the edit-form + activate/
    /// deactivate + bulk-apply UI (Manager + Admin can act). Admins
    /// who are also in the Manager role bypass this check (treated as
    /// Admins). Same logic as desktop EditGroup.razor's _isManagerOnly.
    /// </summary>
    private bool _isManagerOnly;

    // ── Lifecycle ──────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        // Compute _isAdmin + _isManagerOnly synchronously via
        // AuthStateProvider so the edit-form's @if doesn't flicker on
        // first render. Same pattern as desktop EditGroup.razor +
        // MobileManageGroups.razor.
        try
        {
            await ResolveRolesAsync();
        }
        catch
        {
            // Non-fatal — _isAdmin stays false (edit form hidden —
            // safer fallback if role resolution fails). The handler
            // still enforces [RequireRoles] server-side.
        }

        try
        {
            await LoadAsync();
        }
        catch (Exception)
        {
            // Defense-in-depth — LoadAsync swallows its own exceptions
            // and surfaces a friendly _loadError, but if something
            // unexpected happens (e.g. AuthStateProvider throws during
            // role resolution), show the generic error instead of
            // crashing the circuit.
            _loadError = Loc["Error_Unexpected"];
        }
        finally
        {
            _isLoading = false;
        }
    }

    // ── Auth / role resolution ─────────────────────────────────────────

    /// <summary>
    /// Resolves the current user's Admin/Manager roles via the Blazor
    /// auth state (NOT ICurrentUserService — see field doc on _isAdmin).
    /// Same pattern as the desktop EditGroup.razor + MobileManageGroups.
    /// </summary>
    private async Task ResolveRolesAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user?.Identity?.IsAuthenticated != true) return;

        _isAdmin = user.IsInRole(Roles.Admin);
        // Manager-only = Manager AND not also Admin. Admins who are
        // also in the Manager role bypass this check (treated as Admins).
        _isManagerOnly = !_isAdmin && user.IsInRole(Roles.Manager);
    }

    // ── Data loading ────────────────────────────────────────────────────

    /// <summary>
    /// Loads the CustomerGroupDto via GetCustomerGroupByIdQuery. On
    /// success, sets _group + pre-fills the form fields (Name, Salary
    /// Amount formatted for display, Salary Currency for the locked
    /// pill). On failure (handler returned Result.Failure OR the
    /// dispatch threw), sets _loadError (for the error-box branch)
    /// OR clears _group + leaves _loadError empty (for the not-found
    /// branch — the handler returns a generic "not found" for both
    /// genuinely-missing AND not-allowed-to-see, so we surface the
    /// friendly NotFoundTitle/NotFoundBody message instead of leaking
    /// the existence check).
    ///
    /// Also called by the Retry button in the error branch.
    /// </summary>
    private async Task LoadAsync()
    {
        _loadError = string.Empty;
        try
        {
            var query = new GetCustomerGroupByIdQuery { GroupId = GroupId };
            var result = await MessageBus.InvokeAsync<Result<CustomerGroupDto>>(query);

            if (result.IsSuccess)
            {
                _group = result.Value;
                // Pre-fill the form fields so the inputs render with the
                // current values (not empty textboxes — the user sees
                // what they're about to edit).
                _formName = _group.Name;
                _formSalaryCurrency = _group.Salary.Currency;
                _formSalaryAmount = FormatSalaryForDisplay(_group.Salary.Amount);
            }
            else
            {
                // result.Error contains the handler's user-friendly
                // message (e.g. "Customer group '...' was not found.").
                // For the not-found case, the markup's _group-is-null
                // branch shows the friendly NotFoundTitle/NotFoundBody
                // message — we don't surface the raw handler error
                // because it could leak which (missing vs not-allowed)
                // case occurred.
                _group = null;
                _loadError = string.Empty;
            }
        }
        catch (Exception)
        {
            _group = null;
            _loadError = Loc["Error_FailedToLoad"];
        }
    }

    /// <summary>
    /// Silent-reload variant used after a successful Save / Activate /
    /// Deactivate / Bulk Apply. Skips toggling _isLoading so the page
    /// doesn't flash the full-page loading spinner between the success
    /// toast and the refreshed content. Mirrors desktop EditGroup.razor's
    /// LoadGroupAsync post-action + MobileUserDetail.razor's
    /// ReloadUserSilentlyAsync pattern. Failures are non-fatal — the
    /// action already succeeded and we already toasted success; the
    /// next user interaction (or manual refresh) will surface any
    /// persistent load failure via the regular LoadAsync path.
    /// </summary>
    private async Task ReloadGroupSilentlyAsync()
    {
        try
        {
            var query = new GetCustomerGroupByIdQuery { GroupId = GroupId };
            var result = await MessageBus.InvokeAsync<Result<CustomerGroupDto>>(query);
            if (result.IsSuccess)
            {
                _group = result.Value;
                // Refresh the form fields too so the inputs reflect the
                // freshly-saved state (e.g. the salary textbox shows the
                // new amount formatted; the name input shows the new
                // name). The currency doesn't change (it's locked) but
                // we re-set it for safety.
                _formName = _group.Name;
                _formSalaryCurrency = _group.Salary.Currency;
                _formSalaryAmount = FormatSalaryForDisplay(_group.Salary.Amount);
            }
            // else: silent — keep the stale _group (the action did succeed).
        }
        catch (Exception)
        {
            // Silent — see remark above.
        }
    }

    // ── Save handler (mirrors desktop EditGroup.razor's HandleSubmitAsync)

    /// <summary>
    /// Save handler — dispatches BOTH RenameCustomerGroupCommand (if
    /// the name changed) AND UpdateCustomerGroupSalaryCommand (if the
    /// amount changed). Both run in their own Wolverine transaction —
    /// if either fails, the other is NOT rolled back (they're
    /// independent mutations on the same aggregate; the user can fix
    /// the failing one and retry). On success: Toast.Success +
    /// ReloadGroupSilentlyAsync so the summary card's Name/Salary/
    /// UpdatedAt rows refresh without a full-page reload.
    ///
    /// NO-CHANGES SHORT-CIRCUIT: if neither field changed, toast an
    /// Info "no changes" message + return (mirrors the desktop's
    /// behavior — saves the user from a confusing "saved successfully"
    /// toast when nothing actually changed).
    ///
    /// VALIDATION: simple inline checks (no EditForm + DataAnnotations
    /// on mobile — mirrors MobileAdminCategories's inline-form pattern).
    /// Empty name → toast ValidationError_NameRequired. Salary-amount
    /// parse-fail → toast ValidationError_AmountRequired. The Wolverine
    /// command validators provide the SECOND wave server-side via
    /// Wolverine's pipeline.
    /// </summary>
    private async Task HandleSaveAsync()
    {
        if (_isBusy || _group is null) return;

        var name = _formName.Trim();

        if (string.IsNullOrEmpty(name))
        {
            await Toast.Error(Loc["ValidationError_NameRequired"], summary: Loc["ErrorTitle"]);
            return;
        }

        // Defensive re-parse of the salary textbox. Normally @onblur
        // fires before the Save button's @onclick handler does, but a
        // JS-initiated submit or Enter-key submit could race. Parsing
        // here too guarantees _formSalaryAmount reflects whatever the
        // user typed, even if @onblur hasn't run yet.
        if (!TryParseAmount(_formSalaryAmount, out var salaryAmount))
        {
            await Toast.Error(Loc["ValidationError_AmountRequired"], summary: Loc["ErrorTitle"]);
            return;
        }

        _isBusy = true;
        try
        {
            var nameChanged = !string.Equals(name, _group.Name, StringComparison.Ordinal);
            var amountChanged = salaryAmount != _group.Salary.Amount;

            if (!nameChanged && !amountChanged)
            {
                // No-op — nothing to save. Show an info toast (NOT
                // success — the user should know nothing changed).
                await Toast.Info(Loc["NoChanges"], summary: Loc["NoChangesTitle"]);
                return;
            }

            // 1. Rename if changed.
            if (nameChanged)
            {
                var renameResult = await MessageBus.InvokeAsync<Result>(
                    new RenameCustomerGroupCommand(_group.Id, name));

                if (!renameResult.IsSuccess)
                {
                    await Toast.Error(renameResult.Error ?? Loc["Error_Generic"], summary: Loc["ErrorTitle"]);
                    return;
                }
            }

            // 2. Update salary amount if changed.
            if (amountChanged)
            {
                var salaryResult = await MessageBus.InvokeAsync<Result>(
                    new UpdateCustomerGroupSalaryCommand(_group.Id, salaryAmount));

                if (!salaryResult.IsSuccess)
                {
                    await Toast.Error(salaryResult.Error ?? Loc["Error_Generic"], summary: Loc["ErrorTitle"]);
                    return;
                }
            }

            await Toast.Success(Loc["SuccessSummary"], summary: Loc["SuccessTitle"]);
            await ReloadGroupSilentlyAsync();
        }
        catch (Exception)
        {
            await Toast.Error(Loc["Error_Generic"], summary: Loc["ErrorTitle"]);
        }
        finally
        {
            _isBusy = false;
        }
    }

    // ── Activate / Deactivate handlers (mirror MobileUserDetail.razor) ──

    /// <summary>
    /// Opens the inline Deactivate confirmation panel. No dispatch yet
    /// — the actual DeactivateCustomerGroupCommand is dispatched by
    /// HandleDeactivateAsync after the user taps Confirm. Mirrors
    /// MobileCart's _confirmingClear + MobileUserDetail's
    /// _confirmingDeactivate pattern: a single inline panel with the
    /// confirm prompt + Confirm/Cancel buttons (mobile-friendly
    /// alternative to the desktop's 3-second-countdown
    /// DeactivateGroupDialog).
    /// </summary>
    private void StartDeactivateConfirm()
    {
        if (_busyAction is not null) return;
        if (_group is null || !_group.IsActive) return;
        _confirmingDeactivate = true;
    }

    /// <summary>
    /// Closes the inline Deactivate confirmation panel without
    /// dispatching. Called by the Cancel button. Silent — no toast
    /// (the user explicitly chose to abort).
    /// </summary>
    private void CancelDeactivate()
    {
        // Don't allow cancel mid-dispatch — the dispatch is already in
        // flight, blocking cancel prevents a confused state where the
        // panel is closed but the toast still pops up.
        if (_busyAction == "action:deactivate") return;
        _confirmingDeactivate = false;
    }

    /// <summary>
    /// Dispatches DeactivateCustomerGroupCommand. Called by the
    /// Confirm button in the inline confirmation panel. Sets _busyAction
    /// = "action:deactivate" (mirrors MobileAdminCategories's _busyKey +
    /// MobileUserDetail's _busyAction pattern — the finally block only
    /// clears the flag when it still matches this action's key, which
    /// prevents stale resets from a concurrent action). On success:
    /// toast + close the confirm panel + ReloadGroupSilentlyAsync so
    /// the status badge flips to "Inactive" without a full-page reload.
    /// On failure: toast the handler's error (or the generic
    /// Error_Generic fallback).
    /// </summary>
    private async Task HandleDeactivateAsync()
    {
        if (_busyAction is not null) return;
        if (_group is null || !_group.IsActive) return;

        var actionKey = "action:deactivate";
        _busyAction = actionKey;

        try
        {
            var result = await MessageBus.InvokeAsync<Result>(
                new DeactivateCustomerGroupCommand(_group.Id));

            if (result.IsSuccess)
            {
                _confirmingDeactivate = false;
                await Toast.Success(
                    string.Format(CultureInfo.CurrentCulture, Loc["DeactivateSuccess"], _group.Name),
                    summary: Loc["DeactivateSuccessTitle"]);
                await ReloadGroupSilentlyAsync();
            }
            else
            {
                await Toast.Error(result.Error ?? Loc["Error_Generic"], summary: Loc["ErrorTitle"]);
            }
        }
        catch (Exception)
        {
            await Toast.Error(Loc["Error_Generic"], summary: Loc["ErrorTitle"]);
        }
        finally
        {
            // Only clear the flag when it still matches this action —
            // prevents a stale reset if a concurrent action somehow
            // interleaved (defense-in-depth against the rare race).
            if (_busyAction == actionKey) _busyAction = null;
        }
    }

    /// <summary>
    /// Dispatches ActivateCustomerGroupCommand. Called by the Activate
    /// button directly (no confirmation — activation is a non-destructive
    /// restore, mirrors the desktop's HandleActivateAsync). Sets _busyAction
    /// = "action:activate" (same state-machine pattern as Deactivate).
    /// On success: toast + ReloadGroupSilentlyAsync so the status badge
    /// flips to "Active" without a full-page reload. On failure: toast
    /// the handler's error.
    /// </summary>
    private async Task HandleActivateAsync()
    {
        if (_busyAction is not null) return;
        if (_group is null || _group.IsActive) return;

        var actionKey = "action:activate";
        _busyAction = actionKey;

        try
        {
            var result = await MessageBus.InvokeAsync<Result>(
                new ActivateCustomerGroupCommand(_group.Id));

            if (result.IsSuccess)
            {
                await Toast.Success(
                    string.Format(CultureInfo.CurrentCulture, Loc["ActivateSuccess"], _group.Name),
                    summary: Loc["ActivateSuccessTitle"]);
                await ReloadGroupSilentlyAsync();
            }
            else
            {
                await Toast.Error(result.Error ?? Loc["Error_Generic"], summary: Loc["ErrorTitle"]);
            }
        }
        catch (Exception)
        {
            await Toast.Error(Loc["Error_Generic"], summary: Loc["ErrorTitle"]);
        }
        finally
        {
            if (_busyAction == actionKey) _busyAction = null;
        }
    }

    // ── Bulk Apply Defaults handlers ───────────────────────────────────

    /// <summary>
    /// Opens the inline Bulk Apply Defaults confirmation panel. No
    /// dispatch yet — the actual BulkApplyDefaultsForGroupCommand is
    /// dispatched by HandleBulkApplyDefaultsAsync after the user taps
    /// Confirm. Mirrors _confirmingDeactivate's pattern — single inline
    /// panel replaces the desktop's JS.confirm() popup (per the task
    /// spec's "no JS interop beyond basic form interactions" rule).
    /// </summary>
    private void StartBulkApplyConfirm()
    {
        if (_isBulkApplyingDefaults || _busyAction is not null) return;
        if (_group is null || !_group.IsActive) return;
        _confirmingBulkApply = true;
    }

    /// <summary>
    /// Closes the inline Bulk Apply Defaults confirmation panel without
    /// dispatching. Called by the Cancel button. Silent — no toast.
    /// </summary>
    private void CancelBulkApply()
    {
        if (_isBulkApplyingDefaults) return;
        _confirmingBulkApply = false;
    }

    /// <summary>
    /// Dispatches BulkApplyDefaultsForGroupCommand. Called by the
    /// Confirm button in the inline confirmation panel. Sets
    /// _isBulkApplyingDefaults (which disables every other button on
    /// the page — Save, Activate/Deactivate, and the bulk-apply button
    /// itself — to prevent concurrent mutations while the bulk scan is
    /// in flight). On success: toast the breakdown (ProductsUpdated /
    /// TotalProductsScanned / ProductsSkipped / AppliedLimit) — or an
    /// Info toast when every product already had a limit (no updates
    /// needed — idempotent no-op). On failure: toast the handler's
    /// error. Mirrors the desktop's HandleBulkApplyDefaultsAsync but
    /// replaces the JS.confirm() confirmation with an inline panel
    /// (per the task spec's "no JS interop" rule).
    /// </summary>
    private async Task HandleBulkApplyDefaultsAsync()
    {
        if (_isBulkApplyingDefaults || _busyAction is not null) return;
        if (_group is null || !_group.IsActive) return;

        _isBulkApplyingDefaults = true;
        try
        {
            var result = await MessageBus.InvokeAsync<Result<BulkApplyDefaultsResult>>(
                new BulkApplyDefaultsForGroupCommand(_group.Id));

            if (result.IsSuccess)
            {
                var r = result.Value;

                if (r.ProductsUpdated == 0)
                {
                    // Idempotent no-op — every product already had a
                    // limit. Use Info tone (NOT Success) to communicate
                    // "nothing changed" (mirrors the desktop's behavior).
                    await Toast.Info(
                        string.Format(CultureInfo.CurrentCulture,
                            Loc["BulkApplyDefaultsNoUpdates"], r.TotalProductsScanned),
                        summary: Loc["BulkApplyDefaultsTitle"]);
                }
                else
                {
                    await Toast.Success(
                        string.Format(CultureInfo.CurrentCulture,
                            Loc["BulkApplyDefaultsSuccess"],
                            r.ProductsUpdated, r.TotalProductsScanned,
                            r.ProductsSkipped, r.AppliedLimit),
                        summary: Loc["BulkApplyDefaultsTitle"]);
                }

                _confirmingBulkApply = false;
            }
            else
            {
                await Toast.Error(result.Error ?? Loc["Error_Generic"], summary: Loc["ErrorTitle"]);
            }
        }
        catch (Exception)
        {
            await Toast.Error(Loc["Error_Generic"], summary: Loc["ErrorTitle"]);
        }
        finally
        {
            _isBulkApplyingDefaults = false;
        }
    }

    // ── Navigation ──────────────────────────────────────────────────────

    /// <summary>
    /// Navigates back to the mobile Admin Groups list. forceLoad:false —
    /// in-circuit navigation preserves the MobileLayout shell + BottomNav
    /// state (matches MobileUserDetail's GoToUsers + MobileProductDetail's
    /// GoToProducts pattern).
    /// </summary>
    private void GoToGroups()
        => Navigation.NavigateTo("/m/Admin/Groups", forceLoad: false);

    // ── Display helpers ─────────────────────────────────────────────────

    /// <summary>
    /// Formats a decimal salary amount for the summary card's "Salary"
    /// row (read-only display). Mirrors the desktop's FormatSalaryAmount
    /// verbatim — delegates to CultureFormat.FormatNumber (which produces
    /// Persian digits + ٬ separator in fa-IR mode and ASCII digits + comma
    /// separator in en-US mode, with 0 decimal places).
    /// </summary>
    private string FormatSalaryAmount(decimal amount)
        => CultureFormat.FormatNumber(amount);

    /// <summary>
    /// Formats a decimal salary amount for DISPLAY in the editable
    /// textbox (i.e. when the input is NOT focused). Returns a string
    /// with:
    ///   - Persian digits (۰-۹) when the UI culture is fa-IR, ASCII (0-9)
    ///     otherwise — via CultureFormat.ToCultureDigits.
    ///   - Thousands separators ("," in en-US, "٬" in fa-IR — also handled
    ///     by ToCultureDigits since the .NET N0 format produces commas
    ///     and ToCultureDigits swaps them).
    ///   - 0 decimal places when the currency is IRR (whole-Rial — Iran's
    ///     currency has no fractional unit in practice for salary values).
    ///     2 decimal places for other currencies (USD, EUR, etc.).
    /// Mirrors the desktop's FormatSalaryForDisplay verbatim.
    /// </summary>
    private string FormatSalaryForDisplay(decimal amount)
    {
        var isIrr = string.Equals(_formSalaryCurrency, "IRR",
            StringComparison.OrdinalIgnoreCase);
        // N0 = no decimals, with thousands separators.
        // N2 = 2 decimal places, with thousands separators.
        // InvariantCulture produces ASCII digits + comma separators; we
        // then run ToCultureDigits to swap them for Persian digits + ٬
        // separator when the UI culture is fa-IR.
        var fmt = isIrr ? "N0" : "N2";
        return CultureFormat.ToCultureDigits(
            amount.ToString(fmt, CultureInfo.InvariantCulture));
    }

    /// <summary>
    /// Formats an integer count (e.g. ActiveUserCount) with Persian
    /// digits in fa-IR mode. Mirrors the desktop's FormatInt verbatim.
    /// </summary>
    private string FormatInt(int value)
        => CultureFormat.FormatDigits(value);

    /// <summary>
    /// Formats a UTC DateTime as a localized date-time string in Tehran
    /// time, culture-aware. Mirrors the desktop's FormatDate verbatim —
    /// delegates to CultureFormat.FormatTehranDateTime, which produces
    /// Persian digits + Jalali date in fa-IR mode and ASCII digits +
    /// Gregorian date in en-US mode.
    /// </summary>
    private string FormatDate(DateTime utc)
        => CultureFormat.FormatTehranDateTime(utc);

    // ── Salary amount textbox helpers (mirror desktop verbatim) ───────

    /// <summary>
    /// Parses a string the user typed into the salary amount textbox
    /// into a decimal. Accepts:
    ///   - ASCII digits "0"-"9"
    ///   - Persian digits "۰"-"۹" (converted to ASCII before parsing)
    ///   - Thousands separators "," and "٬" (ignored)
    ///   - Decimal separator "." (ASCII) or "٫" (Persian) — both
    ///     converted to "." for the InvariantCulture parser
    ///   - Leading/trailing whitespace (trimmed)
    /// Returns false on any parse failure (caller decides what to do —
    /// usually toasts a validation error). Mirrors the desktop's
    /// TryParseAmount verbatim.
    /// </summary>
    private static bool TryParseAmount(string? input, out decimal amount)
    {
        amount = 0m;
        if (string.IsNullOrWhiteSpace(input)) return false;

        // Normalize: strip separators, convert Persian digits/decimal-
        // point to ASCII equivalents, then parse with InvariantCulture.
        var sb = new StringBuilder(input.Length);
        foreach (var c in input.Trim())
        {
            if (c == ',' || c == '٬') continue;       // thousands separator
            if (c == '٫') sb.Append('.');              // Persian decimal point
            else if (c >= '۰' && c <= '۹')
                sb.Append((char)('0' + (c - '۰')));    // Persian digit → ASCII
            else sb.Append(c);
        }

        return decimal.TryParse(sb.ToString(),
            NumberStyles.Number, CultureInfo.InvariantCulture, out amount);
    }

    /// <summary>
    /// Fired when the salary amount textbox gains focus. Switches the
    /// displayed text from the formatted (thousand-separated, Persian-
    /// digit) form to the raw invariant number so the user can edit
    /// easily without fighting separators. If the current text doesn't
    /// parse (e.g. user typed garbage that we couldn't format on a
    /// previous blur), we leave the text alone so the user can see what
    /// they typed. Mirrors the desktop's OnSalaryAmountFocus verbatim.
    /// </summary>
    private void OnSalaryAmountFocus()
    {
        if (TryParseAmount(_formSalaryAmount, out var amount))
        {
            // InvariantCulture produces ASCII digits + "." decimal
            // separator — the safest form for free-text editing. No
            // thousands separators (they'd just get in the way while
            // typing).
            _formSalaryAmount = amount.ToString(CultureInfo.InvariantCulture);
        }
        // else: leave the text alone so the user can fix whatever they typed.
    }

    /// <summary>
    /// Fired when the salary amount textbox loses focus. Parses the
    /// current text to a decimal and re-formats the displayed text with
    /// thousand separators + Persian digits (in fa-IR) + 0 decimals (in
    /// IRR). If parsing fails, we leave the text alone — HandleSaveAsync
    /// will surface a validation error via Toast when the user tries to
    /// submit. Mirrors the desktop's OnSalaryAmountBlur verbatim.
    /// </summary>
    private void OnSalaryAmountBlur()
    {
        if (TryParseAmount(_formSalaryAmount, out var amount))
        {
            _formSalaryAmount = FormatSalaryForDisplay(amount);
        }
        // else: leave text alone — HandleSaveAsync will toast a validation error.
    }
}
