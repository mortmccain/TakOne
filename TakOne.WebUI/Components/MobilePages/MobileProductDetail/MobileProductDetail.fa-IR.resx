<?xml version="1.0" encoding="utf-8"?>
<!-- MobileProductDetail.fa-IR.resx — Persian (Farsi) strings for MobileProductDetail.razor.

     Persian text is RTL; the layout direction is handled at the <html dir>
     level by MobileLayout based on the current culture. Individual strings
     here don't need RTL markers.

     Mirrors the desktop ProductDetail.fa-IR.resx for the shared keys
     (PageTitle, Loading, ErrorTitle, BreadcrumbProducts, AddToCart,
     AddedToCartTitle, AddedToCart, MyPurchaseLimitHint, NotFoundMessage
     [aliased as ProductNotFound], Error_GenericLoad [aliased as
     Error_FailedToLoad], Error_GenericAdd [aliased as
     Error_AddToCartFailed]), plus the MobileProducts-shared budget/add-
     button/stock/toman/toast keys (BudgetRemaining, BudgetUsed, NoBudget,
     TomanUnit, OutOfStock[=StockOut], LowStock[=StockLow],
     InStock[=StockIn], AddButtonReadOnly[Title], AddButtonLimitReached
     [Title], AddButtonSalaryReached[Title], AddButtonStockOut[Title],
     ToastQtyMin, ToastLimitReached, ToastQtyClamped, ToastSalaryReached),
     plus mobile-only keys (BackToProducts, NoCategory, RetryButton,
     AddedToCartTitle, Error_Unexpected, Version).

     Version uses Persian digits ("تک‌وان نسخه ۱.۰") matching the
     convention in MobileSales / MobileSettings / MobileSaleDetail.

     The four <resheader> tags below are REQUIRED by the .resx reader —
     without them, the loader rejects the file with "resx input is not
     valid, couldn't find valid resheader tags". -->
<root>
  <xsd:schema id="root" xmlns="" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
    <xsd:import namespace="http://www.w3.org/XML/1998/namespace" />
    <xsd:element name="root" msdata:IsDataSet="true">
      <xsd:complexType>
        <xsd:choice maxOccurs="unbounded">
          <xsd:element name="data">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" />
              <xsd:attribute ref="xml:space" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="resheader">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" />
            </xsd:complexType>
          </xsd:element>
        </xsd:choice>
      </xsd:complexType>
    </xsd:element>
  </xsd:schema>
  <resheader name="resmimetype"><value>text/microsoft-resx</value></resheader>
  <resheader name="version"><value>2.0</value></resheader>
  <resheader name="reader"><value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value></resheader>
  <resheader name="writer"><value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value></resheader>
