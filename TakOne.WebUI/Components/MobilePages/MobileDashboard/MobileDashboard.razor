@* MobileDashboard.razor — mobile version of the Dashboard (staff landing) page.
   Route: /m/Dashboard
   Layout: MobileLayout

   PORTS a mobile-friendly subset of the desktop Dashboard.razor:
     - Greeting header (time-of-day + gender title + scope subtitle + date)
     - 4 KPI cards in a 2-column grid (Today's Orders, Monthly Employee
       Purchase Total, Pending Approvals, Monthly Approved Sales Count)
     - Weekly Revenue sparkline (pure HTML/CSS bar row, NO Chart.js)
     - Recent Orders list (mobile-friendly rows, NOT the desktop <table>)
     - Top Employees card (rank + avatar + name + group + amount)
     - Quick Access cards (Settings → /m/Settings, Users → /m/Admin/Users)

   SKIPPED on mobile:
     - The 4 Chart.js charts (Weekly Revenue line + Status Donut + Top
       Products bar + Category Pie) — too heavy for mobile viewport + JS
       interop. Replaced by the lightweight weekly-revenue sparkline bar
       row above.
     - Status Donut legend (covered implicitly by recent-orders list)
     - Top Products bar chart + Category Pie chart (no mobile equivalent)

   BACKEND CONTRACT (same as desktop Dashboard.razor):
     - Load: GetDashboardStatsQuery (no caller-supplied fields)
       → Result<DashboardStatsDto>. The handler scopes by role
       server-side using ICurrentUserService.IsInRole (server-verified
       claims): Admin/Manager/ReadOnly see all sales, Employee sees
       only the sales they personally approved.
     - The query no longer carries UserRoles/RequestedByUserId —
       that was a role-spoofing hole closed in Brutal Code Review v3
       finding #03.

   STATE MACHINE (matches MobileProducts.razor gold-standard pattern):
     _isLoading → _loadError → _stats is not null → content.

   FORMATTING:
     - All digit formatting goes through CultureFormat.ToCultureDigits /
       FormatDigits / FormatPercent directly (gold-standard mobile
       pattern) — NO local wrappers, matching MobileProducts.razor.
     - Money: IRR is already divided by 10 server-side in the handler
       (DisplayCurrency = "تومان" when original is IRR); the razor page
       just formats the (already-converted) number.

   NO TOASTS, NO JS INTEROP: read-only page. No ToastService / IJSRuntime
   injections needed.
*@

@page "/m/Dashboard"
@attribute [Authorize(Roles = "Admin,Manager,Employee,ReadOnly")]
@layout TakOne.WebUI.Components.Layout.MobileLayout.MobileLayout
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using Wolverine
@using TakOne.Application.Common.Authorization
@using TakOne.Application.Common.Interfaces
@using TakOne.Application.Dashboard.DTOs
@using TakOne.Application.Dashboard.Queries.GetDashboardStats
@using TakOne.SharedKernel.Common
@using TakOne.WebUI.Services
@inject IMessageBus MessageBus
@inject ICurrentUserService CurrentUser
@inject NavigationManager Navigation
@inject IStringLocalizer<MobileDashboard> Loc
@inject ErrorDisplayService ErrorDisplay

<PageTitle>@Loc["PageTitle"]</PageTitle>

@if (_isLoading)
{
    @* Skeleton: greeting block + 4 KPI cards in 2-col grid + sparkline
       + 3 recent order rows + 3 top-employee rows + 2-col quick grid.
       Mimics the real Dashboard layout so the perceived load is fast. *@
    <div class="m-dash-page" aria-busy="true" aria-live="polite">
        <div class="tm-dash-greeting">
            <div>
                <div class="m-skeleton m-skeleton-line short" style="width: 6rem; margin-bottom: 0.5rem;"></div>
                <div class="m-skeleton m-skeleton-line long"></div>
                <div class="m-skeleton m-skeleton-line medium" style="margin-top: 0.5rem;"></div>
            </div>
            <div class="m-skeleton" style="width: 4rem; height: 1.5rem; border-radius: 0.5rem;"></div>
        </div>
        <div class="m-dash-kpi-grid">
            @for (var i = 0; i < 4; i++)
            {
                <div class="tm-dash-kpi-card">
                    <div class="tm-dash-kpi-card-head">
                        <div class="m-skeleton" style="width: 2.5rem; height: 2.5rem; border-radius: 0.5rem;"></div>
                    </div>
                    <div class="m-skeleton m-skeleton-line short" style="margin-top: 0.5rem;"></div>
                    <div class="m-skeleton m-skeleton-line medium" style="height: 1.25rem; margin-top: 0.5rem;"></div>
                    <div class="m-skeleton m-skeleton-line short" style="margin-top: 0.5rem;"></div>
                </div>
            }
        </div>
        <div class="m-skeleton-card">
            <div class="m-skeleton m-skeleton-line short" style="width: 8rem; margin-bottom: 0.5rem;"></div>
            <div class="m-dash-spark-row">
                @for (var i = 0; i < 7; i++)
                {
                    <div class="m-dash-spark-col">
                        <div class="m-dash-spark-bar-track">
                            <div class="m-skeleton" style="width: 100%; height: @(20 + i * 8)px; border-radius: 0.25rem;"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="m-skeleton-card">
            <div class="m-skeleton m-skeleton-line medium" style="width: 8rem; margin-bottom: 0.75rem;"></div>
            @for (var i = 0; i < 3; i++)
            {
                <div class="m-dash-order-row">
                    <div class="m-skeleton-circle"></div>
                    <div class="m-dash-order-body" style="flex: 1;">
                        <div class="m-skeleton m-skeleton-line medium"></div>
                        <div class="m-skeleton m-skeleton-line short" style="margin-top: 0.5rem;"></div>
                    </div>
                </div>
            }
        </div>
        <div class="m-skeleton-card">
            <div class="m-skeleton m-skeleton-line medium" style="width: 10rem; margin-bottom: 0.75rem;"></div>
            @for (var i = 0; i < 3; i++)
            {
                <div class="m-dash-employee-row">
                    <div class="m-skeleton" style="width: 1.75rem; height: 1.75rem; border-radius: 50%;"></div>
                    <div class="m-skeleton m-skeleton-line medium" style="flex: 1; margin: 0 0.75rem;"></div>
                    <div class="m-skeleton" style="width: 4rem; height: 1rem; border-radius: 0.25rem;"></div>
                </div>
            }
        </div>
    </div>
    <span class="sr-only">@Loc["Loading"]</span>
}
else if (!string.IsNullOrEmpty(_loadError))
{
    <div class="m-error-box">
        <p>@_loadError</p>
    </div>
}
else if (_stats is not null)
{
    <div class="m-dash-page">

        @* ════════════════════════════════════════
           GREETING HEADER — time-of-day + gender title + scope subtitle + date
           Mirrors desktop Dashboard.razor lines 95–125 (the tm-dash-greeting
           family is loaded globally via Dashboard.css?v=4 in App.razor).
           ════════════════════════════════════════ *@
        <div class="tm-dash-greeting">
            <div>
                <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.25rem;">
                    <span class="tm-dash-greeting-badge">
                        <span class="tm-dash-greeting-pulse"></span>
                        @Loc["ActivePanel"]
                    </span>
                </div>
                <h2 class="tm-dash-greeting-title">
                    @GreetingLabel @_stats.CurrentUserName
                </h2>
                <p class="tm-dash-greeting-subtitle">
                    @if (_stats.IsEmployeeScoped)
                    {
                        @Loc["ScopeEmployee"]
                    }
                    else
                    {
                        @Loc["GreetingSubtitle"]
                    }
                </p>
            </div>
            <span class="tm-dash-greeting-date">@FormatDate(DateTime.Now)</span>
        </div>

        @* ════════════════════════════════════════
           KPI ROW — 4 cards in a 2-column grid (mobile-friendly)
           Interior uses the existing .tm-dash-kpi-* classes from
           Dashboard.css; the wrapper .m-dash-kpi-grid is mobile-only
           (the orchestrator adds the 2-col grid rule to mobile.css).
           ════════════════════════════════════════ *@
        <div class="m-dash-kpi-grid">

            @* KPI 1: Today's Orders (green glow, shopping-bag icon) *@
            <div class="tm-dash-kpi-card tm-dash-kpi-glow-green">
                <div class="tm-dash-kpi-card-head">
                    <div class="tm-dash-icon-tile tm-dash-icon-green">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                        </svg>
                    </div>
                    <span class="tm-dash-kpi-badge tm-dash-badge-approved">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" style="width:12px;height:12px;">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 13l4-4 4 4 8-8" />
                        </svg>
                        @CultureFormat.FormatDigits(_stats.TodayOrdersCount)
                    </span>
                </div>
                <p class="tm-dash-kpi-label">@Loc["Kpi_TodayOrders"]</p>
                <p class="tm-dash-kpi-value">@CultureFormat.FormatDigits(_stats.TodayOrdersCount)</p>
                <p class="tm-dash-kpi-footer">@Loc["Kpi_TodayOrdersFooter"]</p>
            </div>

            @* KPI 2: Monthly Employee Purchase Total (gold glow, money icon) *@
            <div class="tm-dash-kpi-card tm-dash-kpi-glow-gold">
                <div class="tm-dash-kpi-card-head">
                    <div class="tm-dash-icon-tile tm-dash-icon-gold">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                </div>
                <p class="tm-dash-kpi-label">@Loc["Kpi_MonthlyEmployeePurchase"]</p>
                <p class="tm-dash-kpi-value">
                    @FormatMoneyShort(_stats.ThisMonthEmployeePurchaseTotal)
                    <span class="tm-dash-kpi-value-suffix">@_stats.DisplayCurrency</span>
                </p>
                <p class="tm-dash-kpi-footer">
                    @Loc["Kpi_MonthlyEmployeePurchaseFooter"]
                    <strong>@CultureFormat.FormatDigits(_stats.ThisMonthActiveEmployeeCount)</strong>
                </p>
            </div>

            @* KPI 3: Pending Approvals (warn glow, clock icon) — footer shows
               oldest-pending age when OldestPendingSaleAgeMinutes > 0,
               else "None" footer (matches desktop KPI 3 logic verbatim). *@
            <div class="tm-dash-kpi-card tm-dash-kpi-glow-warn">
                <div class="tm-dash-kpi-card-head">
                    <div class="tm-dash-icon-tile tm-dash-icon-warn">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                </div>
                <p class="tm-dash-kpi-label">@Loc["Kpi_PendingApprovals"]</p>
                <p class="tm-dash-kpi-value">@CultureFormat.FormatDigits(_stats.PendingSalesCount)</p>
                @if (_stats.OldestPendingSaleAgeMinutes is { } ageMinutes && ageMinutes > 0)
                {
                    <p class="tm-dash-kpi-footer">
                        @Loc["Kpi_PendingApprovalsFooter_Prefix"]
                        <strong>@FormatOldestPending(ageMinutes)</strong>
                    </p>
                }
                else
                {
                    <p class="tm-dash-kpi-footer">@Loc["Kpi_PendingApprovalsFooter_None"]</p>
                }
            </div>

            @* KPI 4: Approved Sales This Month (info glow, check-badge icon) —
               value = ApprovedCount + InvoicedCount (matches desktop KPI 4
               logic verbatim per user spec: "approved + invoiced"). *@
            <div class="tm-dash-kpi-card tm-dash-kpi-glow-info">
                <div class="tm-dash-kpi-card-head">
                    <div class="tm-dash-icon-tile tm-dash-icon-info">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                        </svg>
                    </div>
                </div>
                <p class="tm-dash-kpi-label">@Loc["Kpi_MonthlyApprovedSales"]</p>
                <p class="tm-dash-kpi-value">@CultureFormat.FormatDigits(_stats.ThisMonthApprovedSalesCount + _stats.ThisMonthInvoicedSalesCount)</p>
                <p class="tm-dash-kpi-footer">@Loc["Kpi_MonthlyApprovedSalesFooter"]</p>
            </div>
        </div>

        @* ════════════════════════════════════════
           WEEKLY REVENUE SPARKLINE — mobile replacement for the 4 Chart.js
           charts on the desktop dashboard. Pure HTML/CSS bar row with 7 day
           columns (one per WeeklyRevenueDto in _stats.ThisWeekRevenue).
           Bar height = (day.TotalAmount / WeeklyMax) * 100, capped to 0
           when WeeklyMax is 0 to avoid div-by-zero.
           The card shell + footer use the existing .tm-dash-card + .tm-dash-
           chart-footer classes from Dashboard.css; the spark bar itself uses
           the mobile-only .m-dash-spark-* classes.
           ════════════════════════════════════════ *@
        <div class="tm-dash-card">
            <div class="tm-dash-card-head">
                <div>
                    <h3 class="tm-dash-card-title">@Loc["Chart_WeeklyRevenue"]</h3>
                    <p class="tm-dash-card-subtitle">@Loc["Chart_WeeklyRevenue_Sub"]</p>
                </div>
                <div style="display:flex; align-items:center; gap:0.5rem;">
                    <div style="display:flex; align-items:center; gap:0.375rem; font-size:0.6875rem; color:var(--tm-gray, var(--rz-text-secondary-color, #94A3A0));">
                        <span style="width:10px; height:10px; border-radius:2px; background:#2A9D7E;"></span>
                        @Loc["Chart_WeeklyLegend_This"]
                    </div>
                    <div style="display:flex; align-items:center; gap:0.375rem; font-size:0.6875rem; color:var(--tm-gray, var(--rz-text-secondary-color, #94A3A0));">
                        <span style="width:10px; height:10px; border-radius:2px; background:rgba(212, 175, 55, 0.6);"></span>
                        @Loc["Chart_WeeklyLegend_Last"]
                    </div>
                </div>
            </div>
            @if (WeeklyMax > 0)
            {
                <div class="m-dash-spark-row">
                    @foreach (var day in _stats.ThisWeekRevenue)
                    {
                        var pct = WeeklyMax > 0 ? (day.TotalAmount / WeeklyMax) * 100 : 0;
                        <div class="m-dash-spark-col">
                            <span class="m-dash-spark-amount">@FormatMoneyShort(day.TotalAmount)</span>
                            <div class="m-dash-spark-bar-wrap">
                                <div class="m-dash-spark-bar" style="height: @(pct.ToString("0", CultureInfo.InvariantCulture))%"></div>
                            </div>
                            <span class="m-dash-spark-label">@day.DayLabel</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="m-empty">@Loc["Chart_NoData"]</p>
            }
            <div class="tm-dash-chart-footer">
                <div>
                    <p class="tm-dash-chart-footer-label">@Loc["Chart_WeeklyAvg"]</p>
                    <p class="tm-dash-chart-footer-value">@FormatMoneyShort(WeeklyAverage) @_stats.DisplayCurrency</p>
                </div>
                <div>
                    <p class="tm-dash-chart-footer-label">@Loc["Chart_WeeklyMax"]</p>
                    <p class="tm-dash-chart-footer-value gold">@FormatMoneyShort(WeeklyMax) @_stats.DisplayCurrency</p>
                </div>
                <div>
                    <p class="tm-dash-chart-footer-label">@Loc["Chart_WeeklyGrowth"]</p>
                    <p class="tm-dash-chart-footer-value green">@CultureFormat.FormatPercent(WeeklyGrowthPct, 1)</p>
                </div>
            </div>
        </div>

        @* ════════════════════════════════════════
           RECENT ORDERS — mobile-friendly vertical list of .m-dash-order-row
           cards (NOT the desktop <table>, which doesn't fit a narrow mobile
           viewport). Each row shows: avatar circle (initial + deterministic
           background/text color from the customer name), sale # number,
           relative time, customer name, product summary, amount (FormatMoney),
           status badge (status-dot + localized name).
           "View All" link in the card header → /m/Sales (mobile route).
           Empty state shows Loc["Orders_Empty"].
           ════════════════════════════════════════ *@
        <div class="tm-dash-card" style="padding:0; overflow:hidden;">
            <div style="padding:1rem; display:flex; align-items:center; justify-content:space-between; gap:0.5rem; border-bottom:1px solid var(--tm-border, rgba(255,255,255,0.05));">
                <div>
                    <h3 class="tm-dash-card-title">@Loc["Orders_Recent"]</h3>
                    <p class="tm-dash-card-subtitle">@Loc["Orders_Recent_Sub"]</p>
                </div>
                <a href="/m/Sales" class="tm-dash-card-subtitle" style="color:var(--tm-gold, #D4AF37); text-decoration:none; white-space:nowrap;">
                    @Loc["Chart_ViewAll"]
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" style="width:12px;height:12px;display:inline-block;vertical-align:middle;">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                    </svg>
                </a>
            </div>
            @if (_stats.RecentOrders.Count == 0)
            {
                <p class="m-empty" style="padding:1.5rem;">@Loc["Orders_Empty"]</p>
            }
            else
            {
                <div class="m-dash-orders-list">
                    @foreach (var order in _stats.RecentOrders)
                    {
                        <div class="m-dash-order-row">
                            <div class="m-dash-order-avatar"
                                 style="background:@(AvatarBackground(order.CustomerName));
                                        color:@(AvatarTextColor(order.CustomerName));">
                                @GetInitial(order.CustomerName)
                            </div>
                            <div class="m-dash-order-body">
                                <div class="m-dash-order-top">
                                    <span class="m-dash-sale-number">#@CultureFormat.FormatDigits(order.SaleNumber)</span>
                                    <span class="m-dash-order-time">@FormatRelativeTime(order.SubmittedAtUtc)</span>
                                </div>
                                <p class="m-dash-order-customer">@order.CustomerName</p>
                                <p class="m-dash-order-product">@order.ProductSummary</p>
                                <div class="m-dash-order-bottom">
                                    <span class="m-dash-amount">@FormatMoney(order.TotalAmount)</span>
                                    <span class="tm-dash-status-badge @StatusBadgeClass(order.Status)">
                                        <span class="tm-dash-status-dot" style="background:@StatusColor(order.Status);"></span>
                                        @StatusLocalizedName(order.Status)
                                    </span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* ════════════════════════════════════════
           TOP EMPLOYEES — ported verbatim from desktop Dashboard.razor
           lines 414–452 (the rank + avatar + name + group + amount
           layout). Wrapped in the .tm-dash-card shell; rows use the
           mobile-only .m-dash-employee-row class (per spec).
           Empty state shows Loc["TopEmployees_Empty"].
           ════════════════════════════════════════ *@
        <div class="tm-dash-card">
            <div class="tm-dash-card-head" style="margin-bottom:1rem;">
                <div>
                    <h3 class="tm-dash-card-title" style="font-size:0.875rem;">@Loc["TopEmployees_Title"]</h3>
                    <p class="tm-dash-card-subtitle">@Loc["TopEmployees_Sub"]</p>
                </div>
            </div>
            @if (_stats.TopEmployees.Count == 0)
            {
                <p class="m-empty">@Loc["TopEmployees_Empty"]</p>
            }
            else
            {
                <div style="display:flex; flex-direction:column; gap:0.75rem;">
                    @foreach (var emp in _stats.TopEmployees)
                    {
                        <div class="m-dash-employee-row">
                            <div class="m-dash-employee-avatar-wrap">
                                <div class="m-dash-employee-avatar rank-@emp.Rank">
                                    @GetInitial(emp.FullName)
                                </div>
                                <span class="m-dash-employee-rank-badge rank-@emp.Rank">@CultureFormat.FormatDigits(emp.Rank)</span>
                            </div>
                            <div class="m-dash-employee-info">
                                <p class="m-dash-employee-name">@emp.FullName</p>
                                @if (!string.IsNullOrEmpty(emp.GroupName))
                                {
                                    <p class="m-dash-employee-group">@emp.GroupName</p>
                                }
                            </div>
                            <div class="m-dash-employee-amount">
                                <p class="m-dash-employee-amount-value rank-@emp.Rank">@FormatMoneyShort(emp.TotalAmount)</p>
                                <p class="m-dash-employee-amount-label">@_stats.DisplayCurrency</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* ════════════════════════════════════════
           QUICK ACCESS ROW — Settings + Users only (per user spec,
           مدیریت مالی and گزارش فروش quick-access cards are REMOVED).
           Ported verbatim from desktop Dashboard.razor lines 459–484;
           hrefs point at the mobile routes (/m/Settings + /m/Admin/Users)
           instead of the desktop routes. The .tm-dash-icon-tile +
           .tm-dash-icon-warn/info classes are loaded globally via
           Dashboard.css?v=4 in App.razor.
           ════════════════════════════════════════ *@
        <div class="tm-dash-quick-grid">
            <a href="/m/Settings" class="tm-dash-quick-card">
                <div class="tm-dash-icon-tile tm-dash-icon-warn">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                </div>
                <div>
                    <p class="tm-dash-quick-title">@Loc["Quick_Settings"]</p>
                    <p class="tm-dash-quick-desc">@Loc["Quick_Settings_Desc"]</p>
                </div>
            </a>

            <a href="/m/Admin/Users" class="tm-dash-quick-card">
                <div class="tm-dash-icon-tile tm-dash-icon-info">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                    </svg>
                </div>
                <div>
                    <p class="tm-dash-quick-title">@Loc["Quick_Users"]</p>
                    <p class="tm-dash-quick-desc">@Loc["Quick_Users_Desc"]</p>
                </div>
            </a>
        </div>

        @* ── Footer (matches the rest of the mobile pages) ── *@
        <div class="m-footer">@Loc["Version"]</div>
    </div>
}

@code {
    // ── State ───────────────────────────────────────────────────────────
    private DashboardStatsDto? _stats;
    private bool _isLoading = true;
    private string _loadError = string.Empty;

    // ── Auth (cascading parameter — same pattern as desktop Dashboard.razor;
    //    available globally because Routes.razor wraps <AuthorizeRouteView> in
    //    <CascadingAuthenticationState>). Used to build the UserRoles list
    //    that GetDashboardStatsQuery requires — ICurrentUserService exposes
    //    IsInRole(string) but not the full role list, so we read it from the
    //    ClaimsPrincipal directly. Same reasoning as desktop lines 528–533. ──
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    // ── Lifecycle ───────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;

            // Verify the caller is authenticated (defense-in-depth — the
            // [Authorize] attribute on the page should have caught this).
            // The handler resolves roles from ICurrentUserService
            // (server-verified claims), so we no longer build a role list
            // here. See Brutal Code Review v3 finding #03.
            var authState = await AuthStateTask;
            var user = authState.User;

            if (user.Identity?.IsAuthenticated != true)
            {
                // Defense-in-depth — [Authorize] should have caught this.
                _loadError = Loc["Error_Unexpected"];
                return;
            }

            // The query no longer carries UserRoles/RequestedByUserId —
            // the handler resolves roles from ICurrentUserService
            // (server-verified claims) to close the role-spoofing hole.
            // See Brutal Code Review v3 finding #03.
            var query = new GetDashboardStatsQuery();

            var result = await MessageBus.InvokeAsync<Result<DashboardStatsDto>>(query);

            if (result.IsSuccess)
            {
                _stats = result.Value;
            }
            else
            {
                _loadError = ErrorDisplay.Localize(result.Error) ?? string.Empty;
                if (string.IsNullOrEmpty(_loadError))
                {
                    _loadError = Loc["Error_FailedToLoad"];
                }
            }
        }
        catch (Exception)
        {
            _loadError = ErrorDisplay.Unexpected(UnexpectedErrorCodes.MobileDashboard_LoadFailure);
        }
        finally
        {
            _isLoading = false;
        }
    }

    // ── Greeting label (ported verbatim from desktop Dashboard.razor) ────

    /// <summary>
    /// Time-of-day greeting label for the dashboard header.
    ///
    /// Picks one of 4 greeting keys based on the SERVER's local hour:
    ///   00:00–04:59 → Greeting_LateNight  ("شب بخیر" / "Good night")
    ///   05:00–11:59 → Greeting_Morning    ("صبح بخیر" / "Good morning")
    ///   12:00–16:59 → Greeting_Afternoon  ("ظهر بخیر" / "Good afternoon")
    ///   17:00–19:59 → Greeting_Evening    ("عصر بخیر" / "Good evening")
    ///   20:00–23:59 → Greeting_LateNight  ("شب بخیر" — Persian "شب"
    ///                                      starts around 8 PM, so 10 PM
    ///                                      must be "شب بخیر", not "عصر بخیر")
    ///
    /// The greeting is prefixed with the user's title ("آقای"/"خانم" in
    /// fa-IR, "Mr."/"Ms." in en-US) based on the Gender claim. Falls back
    /// to a gender-neutral greeting when the gender is missing.
    ///
    /// WHY SERVER TIME: the dashboard is rendered server-side (Blazor SSR),
    /// so DateTime.Now here is the server's local time. For Tak Makaron
    /// (Iran-based, single office), this is fine — all users share the
    /// same office hours.
    /// </summary>
    private string GreetingLabel
    {
        get
        {
            var hour = DateTime.Now.Hour;
            var isFa = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";

            // Pick the time-of-day key. The 20:00 cutoff is important:
            // Persian "شب" starts around 8 PM, so 10 PM must be "شب بخیر",
            // not "عصر بخیر".
            var timeKey = hour switch
            {
                < 5 => "Greeting_LateNight",
                < 12 => "Greeting_Morning",
                < 17 => "Greeting_Afternoon",
                < 20 => "Greeting_Evening",
                _ => "Greeting_LateNight"
            };

            // Pick the title key based on gender.
            // Gender claim values are "Male" / "Female" (the enum names
            // written by Login.razor). Null/unknown → neutral (no title).
            var gender = _stats?.UserGender;
            var titleKey = gender switch
            {
                "Male" => isFa ? "Title_Male" : "Title_Male_En",
                "Female" => isFa ? "Title_Female" : "Title_Female_En",
                _ => null
            };

            // Combine: "<TimeGreeting> <Title>" e.g. "صبح بخیر آقای" or
            // "Good morning, Mr." (note the en-US key already includes the
            // trailing period+space so the name follows naturally).
            if (titleKey is null)
            {
                return Loc[timeKey] + " ";
            }
            return Loc[timeKey] + " " + Loc[titleKey] + " ";
        }
    }

    // ── Date + money + percent formatting helpers
    //    (call CultureFormat.* directly per the gold-standard mobile pattern
    //    in MobileProducts.razor — NO local ToCultureDigits/FormatDigits/
    //    FormatPercent wrappers, matching the rest of the mobile pages.) ──

    /// <summary>
    /// Formats a date using the current UI culture's full date format.
    /// In fa-IR mode this produces a Jalali (Persian) calendar date with
    /// Persian digits; in en-US mode it produces a Gregorian date with
    /// ASCII digits. The day-name and the date are separated by " | "
    /// (not a comma) so the date reads as a distinct visual chunk.
    /// </summary>
    private string FormatDate(DateTime date)
    {
        var isFa = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fa";
        if (!isFa)
        {
            return date.ToString("dddd | yyyy/MM/dd", CultureInfo.CurrentCulture);
        }

        // fa-IR: build the Jalali date string piece by piece using invariant
        // (ASCII) digits first, then run ToCultureDigits to swap them for
        // Persian digits. This is the only reliable way to get Persian
        // digits out of .NET — NumberFormatInfo.NativeDigits is
        // informational-only and not honored by ToString.
        var pc = new PersianCalendar();
        var dayName = date.ToString("dddd", CultureInfo.CurrentCulture);
        var year = pc.GetYear(date).ToString("0000", CultureInfo.InvariantCulture);
        var month = pc.GetMonth(date).ToString("00", CultureInfo.InvariantCulture);
        var day = pc.GetDayOfMonth(date).ToString("00", CultureInfo.InvariantCulture);
        return CultureFormat.ToCultureDigits($"{dayName} | {year}/{month}/{day}");
    }

    /// <summary>
    /// Formats an amount with thousands separators using the current UI
    /// culture's number format. In fa-IR mode this produces Persian digits
    /// + Persian thousands separator; in en-US mode it produces ASCII
    /// digits + comma separator. Used in the recent-orders list.
    /// </summary>
    private string FormatMoney(decimal amount)
    {
        var rounded = Math.Round(amount, 0);
        var s = rounded.ToString("N0", CultureInfo.InvariantCulture);
        return CultureFormat.ToCultureDigits(s);
    }

    /// <summary>
    /// Formats an amount in millions/thousands (e.g. "۲٫۴M" in fa-IR,
    /// "2.4M" in en-US) for KPI cards + sparkline + chart footer where
    /// large numbers need to fit in a small space.
    /// </summary>
    private string FormatMoneyShort(decimal amount)
    {
        if (amount >= 1_000_000m)
        {
            var millions = (amount / 1_000_000m).ToString("0.0", CultureInfo.InvariantCulture);
            return CultureFormat.ToCultureDigits(millions) + "M";
        }
        if (amount >= 1_000m)
        {
            var thousands = (amount / 1_000m).ToString("0.0", CultureInfo.InvariantCulture);
            return CultureFormat.ToCultureDigits(thousands) + "K";
        }
        return CultureFormat.ToCultureDigits(Math.Round(amount, 0).ToString("N0", CultureInfo.InvariantCulture));
    }

    // ── Weekly revenue stats (for the sparkline footer) ──────────────────

    private decimal WeeklyAverage =>
        _stats?.ThisWeekRevenue.Count > 0
            ? _stats.ThisWeekRevenue.Average(d => d.TotalAmount)
            : 0m;

    private decimal WeeklyMax =>
        _stats?.ThisWeekRevenue.Count > 0
            ? _stats.ThisWeekRevenue.Max(d => d.TotalAmount)
            : 0m;

    private decimal WeeklyGrowthPct
    {
        get
        {
            if (_stats is null) return 0m;
            var thisTotal = _stats.ThisWeekRevenue.Sum(d => d.TotalAmount);
            var lastTotal = _stats.LastWeekRevenue.Sum(d => d.TotalAmount);
            if (lastTotal == 0) return 0m;
            return ((thisTotal - lastTotal) / lastTotal) * 100m;
        }
    }

    // ── Oldest-pending formatter (KPI 3 footer) ──────────────────────────

    /// <summary>
    /// Formats the "oldest pending sale" age (in minutes) as a localized
    /// relative-time string for the KPI card 3 footer.
    /// Examples (fa-IR): "۵ دقیقه", "۳ ساعت", "۲ روز".
    /// Examples (en-US): "5 minutes", "3 hours", "2 days".
    /// Uses the same buckets as FormatRelativeTime (minutes / hours / days),
    /// but WITHOUT the "ago" suffix — the footer already has a prefix like
    /// "قدیمی‌ترین:" / "Oldest:" before this value.
    /// </summary>
    private string FormatOldestPending(int ageMinutes)
    {
        if (ageMinutes < 60)
        {
            return CultureFormat.FormatDigits(ageMinutes) + " " + Loc["MinutesUnit"];
        }
        var hours = ageMinutes / 60;
        if (hours < 24)
        {
            return CultureFormat.FormatDigits(hours) + " " + Loc["HoursUnit"];
        }
        var days = hours / 24;
        return CultureFormat.FormatDigits(days) + " " + Loc["DaysUnit"];
    }

    // ── Relative time (for the recent-orders list) ───────────────────────

    /// <summary>
    /// Formats a UTC timestamp as a relative "X minutes ago" / "X hours ago"
    /// / "X days ago" string, with culture-native digits. Falls back to
    /// absolute date if older than 7 days.
    /// </summary>
    private string FormatRelativeTime(DateTime? submittedAtUtc)
    {
        if (submittedAtUtc is null) return "—";

        var now = DateTime.UtcNow;
        var diff = now - submittedAtUtc.Value;

        if (diff.TotalMinutes < 1) return Loc["JustNow"];
        if (diff.TotalMinutes < 60)
            return CultureFormat.FormatDigits((int)diff.TotalMinutes) + " " + Loc["MinutesAgo"];
        if (diff.TotalHours < 24)
            return CultureFormat.FormatDigits((int)diff.TotalHours) + " " + Loc["HoursAgo"];
        if (diff.TotalDays < 7)
            return CultureFormat.FormatDigits((int)diff.TotalDays) + " " + Loc["DaysAgo"];

        // Fallback for items older than a week: show the absolute Jalali
        // (fa-IR) or Gregorian (en-US) date, with culture-native digits.
        // Convert from UTC to Tehran time (UTC + 3:30, no DST since 2022)
        // by adding the offset inline. (submittedAtUtc is a DateTime here,
        // so AddHours returns DateTime.)
        return FormatDate(submittedAtUtc.Value.AddHours(3.5));
    }

    // ── Donut / category helpers (kept for parity with desktop — the donut
    //    + pie charts aren't rendered on mobile, but these computed
    //    properties + helpers are listed in the spec's "port verbatim"
    //    set. Unused on mobile; harmless to keep.) ──────────────────────

    private int TotalOrdersCount => _stats?.StatusBreakdown.Sum(s => s.Count) ?? 0;

    private int StatusPercent(int count)
    {
        var total = TotalOrdersCount;
        return total > 0 ? (int)Math.Round(count * 100.0 / total) : 0;
    }

    private int CategoryPercent(int count)
    {
        var total = _stats?.TopCategories.Sum(c => c.SalesCount) ?? 0;
        return total > 0 ? (int)Math.Round(count * 100.0 / total) : 0;
    }

    /// <summary>
    /// Returns the color for the i-th category slice in the pie chart.
    /// 6 distinct colors — no two are close to each other. (Unused on
    /// mobile since the pie chart isn't rendered, but ported per spec.)
    /// </summary>
    private string CategoryColor(int index)
    {
        var colors = new[]
        {
            "#2A9D7E",  // green
            "#D4AF37",  // gold
            "#5BA8E8",  // blue
            "#E8A14A",  // orange
            "#9B59B6",  // purple
            "#EF6B6B"   // red (Others)
        };
        return colors[index % colors.Length];
    }

    // ── Status badge helpers (used in the recent-orders list) ────────────

    /// <summary>
    /// Returns the hex color for a given sale status, matching the HTML
    /// reference donut chart palette.
    /// </summary>
    private string StatusColor(string status) => status switch
    {
        "Approved" => "#2A9D7E",
        "Invoiced" => "#5BA8E8",
        "Pending" => "#E8A14A",
        "Cancelled" => "#EF6B6B",
        "Draft" => "#94A3A0",
        _ => "#94A3A0"
    };

    /// <summary>
    /// Returns the CSS class for a status badge in the recent orders list.
    /// Reuses the desktop .tm-dash-badge-* classes (loaded globally via
    /// Dashboard.css?v=4 in App.razor).
    /// </summary>
    private string StatusBadgeClass(string status) => status switch
    {
        "Approved" => "tm-dash-badge-approved",
        "Invoiced" => "tm-dash-badge-info",
        "Pending" => "tm-dash-badge-pending",
        "Cancelled" => "tm-dash-badge-cancel",
        "Draft" => "tm-dash-badge-info",
        _ => "tm-dash-badge-info"
    };

    /// <summary>
    /// Returns the localized name for a sale status. Note: Invoiced is
    /// rendered as Loc["Status_Delivered"] (Invoiced = delivered/handed
    /// over), matching the desktop convention.
    /// </summary>
    private string StatusLocalizedName(string status) => status switch
    {
        "Approved" => Loc["Status_Approved"],
        "Invoiced" => Loc["Status_Delivered"],
        "Pending" => Loc["Status_Pending"],
        "Cancelled" => Loc["Status_Cancelled"],
        "Draft" => Loc["Status_Draft"],
        _ => status
    };

    // ── Avatar helpers (used in the recent-orders list + top-employees) ──

    /// <summary>
    /// Returns the first character of a name for use as an avatar initial.
    /// Falls back to "؟" when the name is null/empty/whitespace.
    /// </summary>
    private string GetInitial(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "؟";
        return name.Trim().Substring(0, 1);
    }

    /// <summary>
    /// Returns a deterministic background color for a customer-name avatar
    /// (in the recent-orders list). Picks from a small palette based on
    /// the first character's hash so the same name always gets the same
    /// color.
    /// </summary>
    private string AvatarBackground(string? name)
    {
        if (string.IsNullOrEmpty(name)) return "rgba(255,255,255,0.10)";
        var palettes = new[]
        {
            "rgba(42, 157, 126, 0.20)",
            "rgba(212, 175, 55, 0.20)",
            "rgba(91, 168, 232, 0.20)",
            "rgba(232, 161, 74, 0.20)",
            "rgba(155, 89, 182, 0.20)",
            "rgba(239, 107, 107, 0.20)"
        };
        var idx = name[0] % palettes.Length;
        return palettes[idx];
    }

    private string AvatarTextColor(string? name)
    {
        if (string.IsNullOrEmpty(name)) return "#94A3A0";
        var palettes = new[]
        {
            "#3DBE96",  // green
            "#E8C547",  // gold
            "#5BA8E8",  // blue
            "#E8A14A",  // orange
            "#9B59B6",  // purple
            "#EF6B6B"   // red
        };
        var idx = name[0] % palettes.Length;
        return palettes[idx];
    }
}
