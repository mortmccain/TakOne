<?xml version="1.0" encoding="utf-8"?>
<root>
  <xsd:schema id="root" xmlns="" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
    <xsd:import namespace="http://www.w3.org/XML/1998/namespace" />
    <xsd:element name="root" msdata:IsDataSet="true">
      <xsd:complexType>
        <xsd:choice maxOccurs="unbounded">
          <xsd:element name="data">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" />
              <xsd:attribute ref="xml:space" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="resheader">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" />
            </xsd:complexType>
          </xsd:element>
        </xsd:choice>
      </xsd:complexType>
    </xsd:element>
  </xsd:schema>
  <resheader name="resmimetype"><value>text/microsoft-resx</value></resheader>
  <resheader name="version"><value>2.0</value></resheader>
  <resheader name="reader"><value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value></resheader>
  <resheader name="writer"><value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value></resheader>

  <!-- Page chrome -->
  <data name="PageTitle" xml:space="preserve"><value>Order tracking — TakOne</value></data>
  <data name="BackToOrderDetails" xml:space="preserve"><value>Back to order details</value></data>
  <data name="BackToOrders" xml:space="preserve"><value>Back to my orders</value></data>
  <data name="ViewFullDetails" xml:space="preserve"><value>View full details</value></data>
  <data name="Version" xml:space="preserve"><value>TakOne v1.0</value></data>
  <data name="TomanUnit" xml:space="preserve"><value>Toman</value></data>

  <!-- States -->
  <data name="Loading" xml:space="preserve"><value>Loading order status…</value></data>
  <data name="Error_GenericLoad" xml:space="preserve"><value>We couldn't load this order's status. Please try again.</value></data>
  <data name="RetryButton" xml:space="preserve"><value>Try again</value></data>
  <data name="NotFoundMessage" xml:space="preserve"><value>This order doesn't exist, or you don't have permission to view it.</value></data>

  <!-- Status labels (badge chip; shared with the Sales list + SaleDetail
       pages, mirrored here so the tracker is self-contained). -->
  <data name="StatusDraft" xml:space="preserve"><value>Draft</value></data>
  <data name="StatusPending" xml:space="preserve"><value>Pending</value></data>
  <data name="StatusApproved" xml:space="preserve"><value>Approved</value></data>
  <data name="StatusInvoiced" xml:space="preserve"><value>Invoiced</value></data>
  <data name="StatusCancelled" xml:space="preserve"><value>Cancelled</value></data>

  <!-- Tracker hero — customer-friendly status title per status -->
  <data name="HeroTitleDraft" xml:space="preserve"><value>Draft order</value></data>
  <data name="HeroTitlePending" xml:space="preserve"><value>In processing</value></data>
  <data name="HeroTitleApproved" xml:space="preserve"><value>Order approved</value></data>
  <data name="HeroTitleInvoiced" xml:space="preserve"><value>Delivered</value></data>
  <data name="HeroTitleCancelled" xml:space="preserve"><value>Order cancelled</value></data>

  <!-- Tracker hero — short "what happens next" hint per status -->
  <data name="HeroHintDraft" xml:space="preserve"><value>This order hasn't been submitted yet. Open your cart to review and submit it.</value></data>
  <data name="HeroHintPending" xml:space="preserve"><value>Your order has been sent to our team and is being reviewed.</value></data>
  <data name="HeroHintApproved" xml:space="preserve"><value>Your order has been approved and is waiting for its invoice.</value></data>
  <data name="HeroHintInvoiced" xml:space="preserve"><value>Your invoice has been issued. Thank you for your purchase!</value></data>
  <data name="HeroHintCancelled" xml:space="preserve"><value>This order was cancelled. Contact support if you have questions.</value></data>

  <!-- Progress steps counter — {0} = current step number, {1} = total steps -->
  <data name="StepCountFormat" xml:space="preserve"><value>Step {0} of {1}</value></data>

  <!-- Vertical timeline milestones -->
  <data name="OrderPlaced" xml:space="preserve"><value>Order placed</value></data>
  <data name="SubmittedForReview" xml:space="preserve"><value>Submitted for review</value></data>
  <data name="Approved" xml:space="preserve"><value>Approved</value></data>
  <data name="Invoiced" xml:space="preserve"><value>Invoiced</value></data>
  <data name="Cancelled" xml:space="preserve"><value>Cancelled</value></data>
  <data name="Waiting" xml:space="preserve"><value>Waiting</value></data>

  <!-- Timeline step 1 description — {0} = creator name -->
  <data name="CreatedByFormat" xml:space="preserve"><value>Placed by {0}</value></data>

  <!-- Summary card -->
  <data name="CustomerName" xml:space="preserve"><value>Customer</value></data>
  <data name="TotalAmount" xml:space="preserve"><value>Total amount</value></data>
</root>
