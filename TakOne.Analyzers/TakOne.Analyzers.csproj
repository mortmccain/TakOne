<Project Sdk="Microsoft.NET.Sdk">

	<!--
    TakOne.Analyzers — Roslyn analyzers enforcing security invariants that
    cannot be expressed by the type system alone.

    WHY A SEPARATE PROJECT:
      Roslyn analyzers MUST target netstandard2.0 (the TFM the Roslyn
      compiler hosts them on) and MUST NOT reference any of the application
      projects (Application, Infrastructure, WebUI). They run at build time,
      inside the compiler, so they can only see the Roslyn object model
      (Microsoft.CodeAnalysis.*) — never your runtime types.

    HOW IT'S CONSUMED:
      TakOne.WebUI.csproj references this project as an analyzer:
        <ProjectReference Include="..\TakOne.Analyzers\TakOne.Analyzers.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
      The analyzer DLL is loaded by the compiler at build time and runs
      against every C# file in the consuming project.

    CURRENT RULES:
      - TAKONE_LOGIN_001 (ForbiddenLoggingAnalyzer): flags any call to
        ILogger.Log* whose format string contains a banned credential-state
        or PII token. Severity: Error. See ForbiddenLoggingAnalyzer.cs
        for the full rationale and the banned-token list.
  -->

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<IsRoslynComponent>true</IsRoslynComponent>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<!-- Suppress the "analyzer should be in a folder named analyzers" warning;
         we ship via direct ProjectReference, not as a NuGet package. -->
		<NoWarn>$(NoWarn);RS1022</NoWarn>
		<!--
    RS2007 ("missing or invalid release header") is a known false-positive with
    Microsoft.CodeAnalysis.Analyzers 3.11.0 under .NET 10 SDK. Our
    AnalyzerReleases.Shipped.md and AnalyzerReleases.Unshipped.md files match the
    official Microsoft format exactly (verified against the .md files in
    dotnet/roslyn-analyzers' own projects — header `# Release Tracking` /
    `# Release Tracking - Unshipped`, version `## 1.0`, table with
    `AssemblyName:AnalyzerType` in the Notes column). RS2008 (the "enable
    release tracking" rule that prompted us to ADD these files in the first
    place) IS satisfied — the files exist, are declared as AdditionalFiles,
    and contain the proper table. RS2007 (the "validate header format" rule)
    fires anyway due to a parser quirk in 3.11.0 that is fixed in 4.x.
    Upgrading the analyzer to 4.x is non-trivial (requires .NET 8+ runtime
    for the analyzer host — but our analyzers project targets netstandard2.0
    for max compatibility, and 4.x drops some APIs we use).
    Safe to suppress: the release-tracking data is correct, the file IS
    shipping in the proper format, and the suppression is scoped to this
    project only (no global suppression of analyzer correctness rules).
  -->
		<NoWarn>$(NoWarn);RS2007</NoWarn>
		<Version>1.0.0</Version>
		<Description>TakOne security analyzers — flags credential-state/PII leakage in ILogger.Log* calls.</Description>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" />
	</ItemGroup>

	<!--
    Analyzer release tracking files (required by Roslyn RS2008).
    These files MUST be declared as AdditionalFiles for the RS2008 analyzer
    to recognize them. See:
      https://github.com/dotnet/roslyn-analyzers/blob/main/src/Microsoft.CodeAnalysis.Analyzers/ReleaseTrackingAnalyzers.Help.md
    The .md file content (rule ID + version table) is parsed by RS2008 to
    validate that diagnostic rule severities/categories/titles have not
    been silently changed across releases without bumping the rule's
    release version.
  -->
	<ItemGroup>
		<AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
		<AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
	</ItemGroup>

</Project>