<Project Sdk="Microsoft.NET.Sdk">

        <!--
    TakOne.Analyzers — Roslyn analyzers enforcing security invariants that
    cannot be expressed by the type system alone.

    WHY A SEPARATE PROJECT:
      Roslyn analyzers MUST target netstandard2.0 (the TFM the Roslyn
      compiler hosts them on) and MUST NOT reference any of the application
      projects (Application, Infrastructure, WebUI). They run at build time,
      inside the compiler, so they can only see the Roslyn object model
      (Microsoft.CodeAnalysis.*) — never your runtime types.

    HOW IT'S CONSUMED:
      TakOne.WebUI.csproj references this project as an analyzer:
        <ProjectReference Include="..\TakOne.Analyzers\TakOne.Analyzers.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
      The analyzer DLL is loaded by the compiler at build time and runs
      against every C# file in the consuming project.

    CURRENT RULES:
      - TAKONE_LOGIN_001 (ForbiddenLoggingAnalyzer): flags any call to
        ILogger.Log* whose format string contains a banned credential-state
        or PII token. Severity: Error. See ForbiddenLoggingAnalyzer.cs
        for the full rationale and the banned-token list.
  -->

        <PropertyGroup>
                <TargetFramework>netstandard2.0</TargetFramework>
                <Nullable>enable</Nullable>
                <LangVersion>latest</LangVersion>
                <IsRoslynComponent>true</IsRoslynComponent>
                <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
                <GenerateDocumentationFile>false</GenerateDocumentationFile>
                <!-- Suppress the "analyzer should be in a folder named analyzers" warning;
         we ship via direct ProjectReference, not as a NuGet package. -->
                <NoWarn>$(NoWarn);RS1022</NoWarn>
                <!--
    RS2007 HISTORY (resolved with the Roslyn 5.9.0 package bump):
    the release-file FORMAT changed in newer Microsoft.CodeAnalysis.Analyzers.
    The legacy format (top header `# Release Tracking` / `# Release Tracking
    - Unshipped`, bare `## 1.0` version line, header-only table) was replaced
    by `## Release 1.0` + `### New Rules`/`### Removed Rules`/`### Changed
    Rules` sections (see ReleaseTrackingAnalyzers.Help.md in dotnet/roslyn).
    Under the old 3.11.0 analyzers the legacy files were flagged by RS2007
    and suppressed via NoWarn; with Microsoft.CodeAnalysis.Analyzers
    5.9.0-1.26328.17 (ships with the Roslyn 5.9.0 packages) the files were
    migrated to the CURRENT format and the RS2007 suppression was REMOVED
    (verified: 0 warnings with the suppression dropped). Do NOT restore the
    `# Release Tracking` headers — the error text still mentions them, but
    the parser rejects them.
  -->
                <Version>1.0.0</Version>
                <Description>TakOne security analyzers — flags credential-state/PII leakage in ILogger.Log* calls.</Description>
        </PropertyGroup>

        <ItemGroup>
                <!--
      Compiler-layer Roslyn package ONLY. RS1038 (enforced by
      Microsoft.CodeAnalysis.Analyzers 4.x, which ships with the Roslyn 5.x
      packages) forbids compiler extensions (analyzers) from referencing
      Microsoft.CodeAnalysis.Workspaces: the Workspaces assembly is not
      provided by command-line compilation hosts, so an analyzer that
      references it can behave unpredictably outside the IDE. The
      ForbiddenLoggingAnalyzer uses ONLY compiler-layer APIs
      (Microsoft.CodeAnalysis / .CSharp / .CSharp.Syntax / .Diagnostics),
      so the Workspaces reference was dead weight and is removed.

      VERSION PIN: 5.9.0 is the EXACT Microsoft.CodeAnalysis version
      bundled with the .NET SDK this repo pins (10.0.401 ships compiler
      5.9.0-1.26423.113 — verify with
      `dotnet sdk/10.0.401/Roslyn/bincore/csc.dll -version`). Analyzer
      package references must be <= the host compiler's version (CS9057:
      a newer Microsoft.CodeAnalysis reference prevents the analyzer from
      loading at all), so this pin must only move when the pinned SDK
      moves.
    -->
                <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
        </ItemGroup>

        <!--
    Analyzer release tracking files (required by Roslyn RS2008).
    These files MUST be declared as AdditionalFiles for the RS2008 analyzer
    to recognize them. See:
      https://github.com/dotnet/roslyn-analyzers/blob/main/src/Microsoft.CodeAnalysis.Analyzers/ReleaseTrackingAnalyzers.Help.md
    The .md file content (rule ID + version table) is parsed by RS2008 to
    validate that diagnostic rule severities/categories/titles have not
    been silently changed across releases without bumping the rule's
    release version.
  -->
        <ItemGroup>
                <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
                <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
        </ItemGroup>

</Project>