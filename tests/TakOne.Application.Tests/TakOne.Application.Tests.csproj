<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TakOne.Application.Tests — unit tests for the Application layer.

    TESTS:
      Error catalogs (8 stable-code catalogs) — every Format() / TryParse()
        pairing, every prefix contract, every payload component, edge cases
        (null input, empty input, malformed input, productName containing
        the delimiter character itself).
      UnexpectedErrorCodes — uniqueness of every code (no two codes equal),
        format (length 7, alphabet restricted to 23456789+BCDFGHJKMNPQRSTVWXYZ,
        no 0/O/1/I/L), catalog completeness.
      NotificationErrors — every Format*() returns the documented stable string.
      Roles — the five role name constants match their seeded Identity names.
      Validators — FluentValidation AbstractValidator<T> rule coverage for the
        critical commands (CreateProduct, CreateCategory, etc.) — every NotEmpty,
        MaximumLength, GreaterThan, Must, When, ChildRules rule.
      Command handlers — at least one end-to-end handler test with NSubstitute
        mocks for every repository + IUnitOfWork + ICurrentUserService +
        ILogger<T>, asserting each branch (success path, auth rejection,
        uniqueness violation, cross-aggregate hierarchy rejection, duplicate
        purchase-limit entry, money-construction failure, persistence failure).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\TakOne.Application\TakOne.Application.csproj" />
    <ProjectReference Include="..\..\TakOne.Domain\TakOne.Domain.csproj" />
    <ProjectReference Include="..\..\TakOne.SharedKernel\TakOne.SharedKernel.csproj" />
    <ProjectReference Include="..\TakOne.Testing\TakOne.Testing.csproj" />
  </ItemGroup>

</Project>
