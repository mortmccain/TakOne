<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TakOne.SharedKernel.Tests — unit tests for the SharedKernel layer.

    TESTS:
      Result / Result<T>  — success/failure contracts, value semantics, the
                            InvalidOperationException thrown when the
                            success/error invariant is violated.
      PaginatedResult<T>  — pagination metadata (TotalPages, HasNextPage,
                            HasPreviousPage) and edge cases (zero items,
                            page 1 of 1, last page).
      Money               — value-object equality, all arithmetic operators
                            (+, -, *), currency-mismatch guards,
                            Zero(currency) factory, ToString format.
      BaseEntity          — identity equality semantics (same Id == equal,
                            transient entities never equal, type mismatch).
      BaseValueObject     — component-based equality + hashing.
      AggregateRoot       — domain-event collection (AddDomainEvent,
                            ClearDomainEvents, RemoveDomainEvents).
      DomainException     — message + inner-exception round-trip.
      BaseDomainEvent     — EventId uniqueness + OccurredOn stamping.
      MoneyDto            — init-only setter behavior.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\TakOne.SharedKernel\TakOne.SharedKernel.csproj" />
    <ProjectReference Include="..\TakOne.Testing\TakOne.Testing.csproj" />
  </ItemGroup>

</Project>
