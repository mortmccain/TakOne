<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TakOne.Testing — shared test infrastructure (builders, fixtures, helpers)
    used by ALL test projects.

    WHY A SHARED PROJECT:
      Enterprise test suites need consistent test-data builders (e.g. a
      ProductBuilder that yields a valid Product with one fluent override
      per property). Duplicating those builders across 5 test projects
      creates drift. A shared project centralizes them and lets each test
      project reference the same builders.

    DEPENDENCIES:
      References Domain + SharedKernel so it can construct domain entities
      for tests. Does NOT reference Application / Infrastructure / WebUI
      (those layers are tested separately and we don't want test-data
      builders accidentally depending on handler code).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bogus" Version="35.6.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\TakOne.Domain\TakOne.Domain.csproj" />
    <ProjectReference Include="..\..\TakOne.SharedKernel\TakOne.SharedKernel.csproj" />
  </ItemGroup>

</Project>
